{
  "name": "artbild-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/validate-tracking-config.mjs",
    "build": "node scripts/publishing-build.mjs",
    "test:content": "node --test tests/content-quality.test.mjs",
    "test:web-stories": "node scripts/validate-web-stories.mjs",
    "schema:files": "node scripts/normalize-structured-data.mjs",
    "test:structured-data": "node --test tests/structured-data.test.mjs",
    "social:cards": "node scripts/generate-social-cards.mjs",
    "social:cards:validate": "node scripts/validate-social-cards.mjs",
    "test:seo": "node --test tests/home-serp-metadata.test.mjs tests/page-serp-metadata.test.mjs",
    "test:image-sitemap": "node --test tests/image-sitemap.test.mjs",
    "images:webp": "node scripts/convert-delivered-jpegs-to-webp.mjs",
    "seo:files": "node scripts/generate-production-seo-files.mjs",
    "tracking:audit": "node scripts/audit-tracking-coverage.mjs",
    "test:pricing-tracking": "node --test tests/pricing-tracking.test.mjs",
    "report:pricing": "node scripts/collect-pricing-report.mjs",
    "setup:pricing-ga4": "node scripts/setup-pricing-ga4.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.toml",
    "preview": "astro preview --host 127.0.0.1",
    "start:bunny": "node server/bunny-server.mjs",
    "test:bunny": "node --test tests/bunny-runtime.test.mjs tests/bunny-mailer.test.mjs tests/admin-mfa.test.mjs tests/wordpress-redirects.test.mjs tests/agent-availability-trial.test.mjs tests/availability-observations.test.mjs",
    "test:migration-sanitizer": "node --test tests/migrated-html-sanitizer.test.mjs",
    "test:visual": "playwright test tests/visual/page-compare.spec.ts",
    "test:visual:headed": "playwright test tests/visual/page-compare.spec.ts --headed",
    "astro": "astro",
    "publishing:seo": "node scripts/publishing-seo.mjs",
    "build:site": "astro build && npm run social:cards && npm run images:webp && npm run social:cards:validate && npm run schema:files && npm run seo:files && npm run test:content && npm run publishing:seo"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "astro": "^7.4.4",
    "nodemailer": "^10.1.7",
    "otpauth": "9.5.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "amphtml-validator": "^1.0.38",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
