{
  "name": "artbild-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/validate-tracking-config.mjs",
    "build": "astro build && npm run social:cards && npm run images:webp && npm run social:cards:validate && npm run schema:files && npm run seo:files",
    "schema:files": "node scripts/normalize-structured-data.mjs",
    "test:structured-data": "node --test tests/structured-data.test.mjs",
    "social:cards": "node scripts/generate-social-cards.mjs",
    "social:cards:validate": "node scripts/validate-social-cards.mjs",
    "test:seo": "node --test tests/home-serp-metadata.test.mjs tests/page-serp-metadata.test.mjs",
    "images:webp": "node scripts/convert-delivered-jpegs-to-webp.mjs",
    "seo:files": "node scripts/generate-production-seo-files.mjs",
    "tracking:audit": "node scripts/audit-tracking-coverage.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.toml",
    "preview": "astro preview --host 127.0.0.1",
    "start:bunny": "node server/bunny-server.mjs",
    "test:bunny": "node --test tests/bunny-runtime.test.mjs tests/wordpress-redirects.test.mjs",
    "test:migration-sanitizer": "node --test tests/migrated-html-sanitizer.test.mjs",
    "test:visual": "playwright test tests/visual/page-compare.spec.ts",
    "test:visual:headed": "playwright test tests/visual/page-compare.spec.ts --headed",
    "astro": "astro"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "astro": "^7.1.6",
    "nodemailer": "^9.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.3",
    "wrangler": "^4.111.0"
  }
}
