uote .ws-verylong .ws-copy{padding-top:.3em}\n.ws-editorial .ws-photo{border:.06em solid var(--sand)}\n.ws-minimal .ws-brand{letter-spacing:.22em}\n.ws-minimal.ws-split .ws-photo{height:4.30em}\n.ws-minimal.ws-split .ws-long .ws-photo{height:3.66em}\n.ws-closing .ws-copy{bottom:1.55em}.ws-closing .ws-colophon{bottom:9.6429em}\n\n.ws-logo-box{display:inline-block;position:relative;width:1.5em;height:1.5em;vertical-align:middle;margin-right:.7em}\n</style></head><body><amp-story standalone supports-landscape title=\"Fotoshooting in Hamburg-Eppendorf\" publisher=\"Artbild-Fotografie\" publisher-logo-src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/publisher-logo.png\" poster-portrait-src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/poster.jpg\"><amp-story-page id=\"b85b4521-e781-413f-b4ea-b3a871254e0e\" class=\"ws-page ws-leon ws-full\"><amp-story-grid-layer template=\"vertical\" aspect-ratio=\"9:16\" style=\"padding:0\"><div class=\"ws-frame\"><div class=\"ws-brand\"><span><span class=\"ws-logo-box\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/publisher-logo.png\" width=\"192\" height=\"192\" layout=\"fill\" alt=\"Artbild-Fotografie\"></amp-img></span>ARTBILD</span><span>FOTOGRAFIE &amp; GESCHICHTEN</span></div><div class=\"ws-photo\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/eppendorf-f314a6243e8bb252.webp\" width=\"1600\" height=\"2400\" layout=\"fill\" alt=\"Junge Frau mit langem braunem Haar und schwarzem ärmellosem Top steht seitlich an einem weißen metallischen Geländer im Freien und blickt in die Kamera\" style=\"object-position:50% 50%\"></amp-img></div><div class=\"ws-copy\"><h1>Editorial in Hamburg-Eppendorf</h1><p class=\"ws-text\">Portrait-Fotosthooting in Hamburg-Eppendorf</p></div><div class=\"ws-colophon\"><span>York Augustin</span><span>1 / 7</span></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"a33e1497-7f6a-4dc5-97e6-0abd18f282df\" class=\"ws-page ws-leon ws-full\"><amp-story-grid-layer template=\"vertical\" aspect-ratio=\"9:16\" style=\"padding:0\"><div class=\"ws-frame ws-long\"><div class=\"ws-brand\"><span>ARTBILD</span><span>FOTOGRAFIE &amp; GESCHICHTEN</span></div><div class=\"ws-photo\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/eppendorf-8671bb763fb21244.webp\" width=\"1600\" height=\"2400\" layout=\"fill\" alt=\"Junge Frau in einem eleganten schwarzen Nadelstreifen-Anzug mit schwarzer Tasche geht selbstbewusst auf einem Gehweg entlang, umgeben von urbaner Bepflanzung und unscharfen Gebäuden im Hintergrund.\" style=\"object-position:50% 50%\"></amp-img></div><div class=\"ws-copy\"><p class=\"ws-kicker\">Hamburg-Eppendorf</p><h2>Editorial Shooting</h2><p class=\"ws-text\">Hamburg-Eppendorf ist voller schöner Orte, gepträgt von prächtigen  Fassaden, berankten Zäunen und vielen kleinen Perlen. </p></div><div class=\"ws-colophon\"><span>Artbild-Fotografie</span><span>2 / 7</span></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"96b8d440-ae1a-4fcc-8554-f97cf73c1724\" class=\"ws-page ws-leon ws-full\"><amp-story-grid-layer template=\"vertical\" aspect-ratio=\"9:16\" style=\"padding:0\"><div class=\"ws-frame ws-long ws-verylong\"><div class=\"ws-brand\"><span>ARTBILD</span><span>FOTOGRAFIE &amp; GESCHICHTEN</span></div><div class=\"ws-photo\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/eppendorf-fc8bba6cc23a2add.webp\" width=\"1600\" height=\"2400\" layout=\"fill\" alt=\"Visagistin beim Styling und Make-Up\" style=\"object-position:50% 50%\"></amp-img></div><div class=\"ws-copy\"><p class=\"ws-kicker\">Darum brauchst Du vor dem Shooting ein Styling</p><h2>Styling vor dem Fotoshooting</h2><p class=\"ws-text\">Egal für welche Art von Fotoshooting empfehle ich stets ein professionelles Styling und Make-Up. \n\nEs kommt nicht selten vor, dass die Visagistin einen neuen, perfekten Look vorschlägt</p></div><div class=\"ws-colophon\"><span>Artbild-Fotografie</span><span>3 / 7</span></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"22e6ebb3-6e4d-4cbe-a3b1-17650fcbe479\" class=\"ws-page ws-leon ws-full\"><amp-story-grid-layer template=\"vertical\" aspect-ratio=\"9:16\" style=\"padding:0\"><div class=\"ws-frame ws-long ws-verylong\"><div class=\"ws-brand\"><span>ARTBILD</span><span>FOTOGRAFIE &amp; GESCHICHTEN</span></div><div class=\"ws-photo\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/eppendorf-f367b0c1808e3f72.webp\" width=\"1600\" height=\"2400\" layout=\"fill\" alt=\"Make-Up\" style=\"object-position:50% 50%\"></amp-img></div><div class=\"ws-copy\"><h2>Look Veränderung?</h2><p class=\"ws-text\">Beim Fotoshooting können Look- oder Make-Up-Veränderungen vorgenommen werden.  Wer mag kann die Veränderung beibehalten oder nach dem Shooting wieder den alten Look tragen.</p></div><div class=\"ws-colophon\"><span>Artbild-Fotografie</span><span>4 / 7</span></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"99ac9e42-c8b1-4f72-9c9b-bead80ea4fb9\" class=\"ws-page ws-leon ws-full\"><amp-story-grid-layer template=\"vertical\" aspect-ratio=\"9:16\" style=\"padding:0\"><div class=\"ws-frame ws-long ws-verylong\"><div class=\"ws-brand\"><span>ARTBILD</span><span>FOTOGRAFIE &amp; GESCHICHTEN</span></div><div class=\"ws-photo\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/eppendorf-92ce2251dc1212a7.webp\" width=\"1600\" height=\"2400\" layout=\"fill\" alt=\"Seitliches Porträt einer jungen Frau mit langem dunklem Haar, die in einem gestreiften Oberteil sitzt und nach rechts schaut.\" style=\"object-position:50% 50%\"></amp-img></div><div class=\"ws-copy\"><h2>Dein Foto-Look</h2><p class=\"ws-text\">Natürlich ist es die Aufgabe des Fotografen Dich und Deinen tollen neuen Look entsprechend in Szene zu setzen. Hamburg-Eppendorf ist dabei ein hervoragender Ort zu jeder Jahreszeit um dies umzusetzen.</p></div><div class=\"ws-colophon\"><span>Artbild-Fotografie</span><span>5 / 7</span></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"c2f14142-5f71-4f18-a48f-c2eed34ce142\" class=\"ws-page ws-leon ws-full\"><amp-story-grid-layer template=\"vertical\" aspect-ratio=\"9:16\" style=\"padding:0\"><div class=\"ws-frame\"><div class=\"ws-brand\"><span>ARTBILD</span><span>FOTOGRAFIE &amp; GESCHICHTEN</span></div><div class=\"ws-photo\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/eppendorf-bd968f169f0ddd43.webp\" width=\"1600\" height=\"2400\" layout=\"fill\" alt=\"Junge Frau mit langen dunklen Haaren und dezentem Make-up trägt schwarzen Anzug mit feinen Streifen und steht seitlich an einer weißen Wand neben einer Tür mit Glaselementen.\" style=\"object-position:50% 13%\"></amp-img></div><div class=\"ws-copy\"><p class=\"ws-kicker\">Bereit für Deinen neuen Look?</p><h2>SPOTLIGHT ON!</h2><p class=\"ws-text\">Jetzt stehst Du im Rampenlicht. Bist Du bereit?</p></div><div class=\"ws-colophon\"><span>Artbild-Fotografie</span><span>6 / 7</span></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"5666f57d-2193-4f3a-88f5-d7127d4431d1\" class=\"ws-page ws-leon ws-full ws-closing\"><amp-story-grid-layer template=\"vertical\" aspect-ratio=\"9:16\" style=\"padding:0\"><div class=\"ws-frame ws-long\"><div class=\"ws-brand\"><span>ARTBILD</span><span>FOTOGRAFIE &amp; GESCHICHTEN</span></div><div class=\"ws-photo\"><amp-img src=\"/hub-assets/ce04ba82-9303-47be-b34e-2ecd3f708e6a/eppendorf-d95578789781adea.webp\" width=\"1600\" height=\"2400\" layout=\"fill\" alt=\"Junge Frau mit langen, gewellten Haaren trägt schwarzen, gestreiften Blazer und Hose, posiert selbstbewusst mit erhobenem Arm an einer weißen Wand im Freien.\" style=\"object-position:50% 50%\"></amp-img></div><div class=\"ws-copy\"><p class=\"ws-kicker\">Jetzt unverbindlich anfragen</p><h2>Dein Fotoshooting</h2><p class=\"ws-text\">Wenn Du bereit bist für ein tolles Fotoshooting in Hamburg-Eppendorf, frage mich jetzt unverbindlich an!</p></div><div class=\"ws-colophon\"><span>Artbild-Fotografie</span><span>7 / 7</span></div></div></amp-story-grid-layer><amp-story-page-outlink layout=\"nodisplay\" theme=\"dark\"><a href=\"https://artbild-fotografie.de/kontakt\">Jetzt unverbindlich anfragen!</a></amp-story-page-outlink></amp-story-page></amp-story></body></html>"}