---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialReviewQuote from "../../components/EditorialReviewQuote.astro";
import { googleReviews } from "../../data/reviews";
import anchorImage from "../../assets/impressum/anker-york-augustin.jpg";
import "../../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pageUrl = `${siteUrl}/kontakt/`;
const title = "Kontakt | Hochzeitsfotograf Hamburg anfragen";
const description =
  "Kontaktformular für Hochzeitsfotografie in Hamburg: freie Termine, Hochzeitsreportagen, Standesamt, Getting Ready und Paarshootings bei Artbild-Fotografie anfragen.";
const logoUrl = `${siteUrl}/images/logo-artbild-black.png`;
const primaryImage = new URL(anchorImage.src, siteUrl).href;


const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Anfrage", href: "/kontakt/" },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      dateModified: "2026-07-02T10:00:00+02:00",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: anchorImage.width,
        height: anchorImage.height,
        caption: "Kontakt mit Artbild-Fotografie Hamburg",
      },
      contentLocation: {
        "@type": "City",
        name: "Hamburg",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Hamburg",
          addressRegion: "Hamburg",
          addressCountry: "DE",
        },
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
      mainEntity: {
        "@type": "ContactPoint",
        contactType: "customer support",
        url: pageUrl,
        areaServed: [
          { "@type": "City", name: "Hamburg" },
          { "@type": "AdministrativeArea", name: "Norddeutschland" },
          { "@type": "Country", name: "Deutschland" },
        ],
        availableLanguage: ["de", "en"],
      },
      inLanguage: "de",
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
      },
      founder: {
        "@type": "Person",
        name: "York Augustin",
      },
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Country", name: "Deutschland" },
      ],
      serviceType: [
        "Hochzeitsfotografie",
        "Hochzeitsreportage",
        "Standesamtliche Trauung Hamburg",
        "Portraitshooting",
        "TFP Shooting",
      ],
      sameAs: [
        "https://www.instagram.com/artbild/",
        "https://www.facebook.com/artbildfotografie/",
        "https://www.pinterest.de/artbildf/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Artbild-Fotografie",
      publisher: {
        "@id": `${siteUrl}/#organization`,
      },
      inLanguage: "de",
    },

  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={anchorImage.width}>
    <meta property="og:image:height" content={anchorImage.height}>
    <meta property="og:image:alt" content="Kontakt mit Artbild-Fotografie Hamburg">
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="contact-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main id="main-content">
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />

      <section
        class="contact-hero"
        aria-labelledby="contact-title"
        data-track-section="kontakt_hero"
        data-content-topic="kontaktmoeglichkeiten"
        data-user-intent="kontaktseite_verstehen"
        data-journey-stage="anfrage"
        data-content-format="hero"
        data-position="main_top"
      >
        <div class="contact-hero__copy">
          <p class="contact-kicker">Anfrage & freie Termine</p>
          <h1 id="contact-title">Kontakt zu Artbild-Fotografie</h1>
          <p>
            Erzählt mir kurz von Eurer Hochzeit, dem Ort und dem gewünschten
            Datum. Ich melde mich persönlich zurück und prüfe, ob eine
            Hochzeitsreportage in Hamburg, Norddeutschland oder darüber hinaus
            möglich ist.
          </p>
        </div>
        <figure class="contact-hero__image">
          <Image
            src={anchorImage}
            widths={[420, 640, 860, 1100]}
            sizes="(max-width: 820px) 100vw, 38vw"
            format="webp"
            quality={88}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            alt="York Augustin von Artbild-Fotografie in Hamburg"
          />
        </figure>
      </section>

      <EditorialReviewQuote
        reviews={[
          googleReviews.philippBlanke,
          googleReviews.laraFriedrichs,
          googleReviews.marcelFischer,
        ]}
        sectionId="kontakt_review_philipp_blanke"
        heading="Transparent vom ersten Kontakt bis zur Galerie"
        contentTopic="kontakt_und_ablauf"
        userIntent="anfrage_vertrauen"
        journeyStage="anfrage"
        position="before_contact_form"
      />

      <section
        class="contact-shell"
        aria-labelledby="contact-form-title"
        data-track-section="kontakt_anfragebereich"
        data-content-topic="kontaktmoeglichkeiten"
        data-user-intent="kontakt_aufnehmen"
        data-journey-stage="anfrage"
        data-content-format="contact_section"
        data-position="main"
      >
        <div
          class="contact-aside"
          aria-label="Schneller Kontakt"
          data-track-section="kontaktmoeglichkeiten"
          data-content-topic="kontaktmoeglichkeiten"
          data-user-intent="kontaktweg_waehlen"
          data-journey-stage="anfrage"
          data-content-format="contact_options"
          data-position="contact_aside"
        >
          <h2>Schneller Kontakt</h2>
          <p>
            Schick mir gerne eine Whatsapp, eine Sprachnachricht per Instagram
            oder eine Email mit Deiner eigenen Mail-App
          </p>
          <dl>
            <div>
              <dt>E-Mail</dt>
              <dd>
                <button
                  class="contact-inline-button"
                  type="button"
                  data-mail-button
                  aria-describedby="contact-mail-hint"
                  data-track-event="contact_click"
                  data-cta-id="kontakt_email_reveal"
                  data-cta-type="email_reveal"
                  data-section-id="kontaktmoeglichkeiten"
                  data-content-topic="kontaktmoeglichkeiten"
                  data-user-intent="email_anzeigen"
                  data-journey-stage="anfrage"
                >
                  E-Mail-Adresse anzeigen
                </button>
                <span class="contact-mail-output" id="contact-mail-hint" data-mail-output>
                  Wird erst nach Klick angezeigt.
                </span>
              </dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd>
                <a
                  href="https://wa.me/4915161438120?text=Hallo%20York%2C%20ich%20m%C3%B6chte%20eine%20Hochzeit%20anfragen."
                  rel="noopener"
                  data-track-event="contact_click"
                  data-cta-id="kontakt_whatsapp"
                  data-cta-type="messenger"
                  data-section-id="kontaktmoeglichkeiten"
                  data-content-topic="kontaktmoeglichkeiten"
                  data-user-intent="whatsapp_starten"
                  data-journey-stage="anfrage"
                >
                  Kurznachricht senden
                </a>
              </dd>
            </div>
            <div>
              <dt>Instagram</dt>
              <dd>
                <a
                  href="https://ig.me/m/artbild"
                  rel="noopener"
                  data-track-event="contact_click"
                  data-cta-id="kontakt_instagram"
                  data-cta-type="social_message"
                  data-section-id="kontaktmoeglichkeiten"
                  data-content-topic="kontaktmoeglichkeiten"
                  data-user-intent="instagram_kontakt"
                  data-journey-stage="anfrage"
                >artbild kontaktieren</a>
              </dd>
            </div>
          </dl>
          <div class="contact-secure-note">
            <p id="secure-contact-audience">
              Mitarbeiter von Behörden und Organisationen mit Sicherheitsaufgaben,
              Angehörige des Diplomatischen Dienstes sowie Privatpersonen mit besonderem
              Sicherheitsbedarf sollten vor der Kontaktaufnahme die Informationen zum
              sicheren Kontakt lesen.
            </p>
            <a
              class="contact-secure-link"
              href="/sicherer-kontakt/"
              aria-describedby="secure-contact-audience"
              data-track-event="contact_click"
              data-cta-id="kontakt_sicherer_kontakt"
              data-cta-type="secure_contact"
              data-section-id="kontaktmoeglichkeiten"
              data-content-topic="sicherer_kontakt"
              data-user-intent="verschluesselt_kontaktieren"
              data-journey-stage="anfrage"
            >
              Kontakt mit öffentlichem PGP-Schlüssel
            </a>
          </div>
        </div>

        <form
          class="contact-form"
          action="/api/contact"
          method="post"
          enctype="multipart/form-data"
          aria-labelledby="contact-form-title"
          aria-describedby="contact-form-intro contact-form-status"
          data-contact-form
          data-track-form
          data-form-id="kontakt_anfrage_form"
          data-form-type="contact_request"
          data-track-section="kontakt_anfrageformular"
          data-content-topic="anfrageformular"
          data-user-intent="anfrage_senden"
          data-journey-stage="anfrage"
          data-content-format="contact_form"
          data-position="main_form"
        >
          <input type="hidden" name="source_path" value="/kontakt/">
          <input type="hidden" name="form_loaded_at" value="" data-contact-loaded-at>
          <input type="hidden" name="js_enabled" value="0" data-contact-js>

          <div class="contact-form__header">
            <p class="contact-kicker">Formular</p>
            <h2 id="contact-form-title">Termin anfragen</h2>
            <p id="contact-form-intro">
              Kurz reicht: Name, E-Mail, Ort und Wunschdatum. So kann ich zuerst
              prüfen, ob der Termin überhaupt frei ist.
            </p>
          </div>

          <div class="contact-form__honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input
              id="contact-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              data-agent-ignore="true"
            >
          </div>

          <fieldset>
            <legend>Anfrage</legend>
            <div class="contact-form__grid">
              <div class="contact-field">
                <label for="contact-request-type">Worum geht es? *</label>
                <select
                  id="contact-request-type"
                  name="request_type"
                  required
                  data-agent-field="request-type"
                  data-contact-request-type
                >
                  <option value="">Bitte auswählen</option>
                  <option value="hochzeit">Hochzeit</option>
                  <option value="standesamtliche-trauung">Standesamtliche Trauung</option>
                  <option value="portraitshooting">Portraitshooting</option>
                  <option value="tfp">TFP</option>
                </select>
                <p id="contact-request-type-hint" hidden data-contact-tfp-hint>
                  Bei TFP-Anfragen könnt Ihr unten bis zu drei Beispielbilder anhängen.
                </p>
              </div>

              <div class="contact-field">
                <label for="contact-name">Euer Name *</label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  minlength="2"
                  maxlength="120"
                  data-agent-field="full-name"
                >
              </div>

              <div class="contact-field">
                <label for="contact-email">E-Mail-Adresse *</label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                  data-agent-field="email"
                >
              </div>

              <div class="contact-field">
                <label for="contact-event-date">
                  Wunschdatum <span data-date-required-marker>*</span>
                </label>
                <input
                  id="contact-event-date"
                  name="event_date"
                  type="date"
                  autocomplete="off"
                  required
                  data-agent-field="event-date"
                  data-contact-date
                >
                <p id="contact-date-hint" hidden data-contact-date-hint>Für TFP darf das Datum offen bleiben.</p>
              </div>

              <div class="contact-field">
                <label for="contact-location">Ort oder Location *</label>
                <input
                  id="contact-location"
                  name="location"
                  type="text"
                  autocomplete="address-level2"
                  placeholder="z. B. Hamburg, Standesamt Altona"
                  required
                  minlength="2"
                  maxlength="160"
                  data-agent-field="event-location"
                >
              </div>

              <div class="contact-field">
                <label for="contact-security-year">Welches Jahr haben wir? *</label>
                <input
                  id="contact-security-year"
                  name="security_year"
                  type="text"
                  inputmode="numeric"
                  maxlength="4"
                  placeholder="JJJJ"
                  autocomplete="off"
                  required
                  aria-describedby="contact-security-year-hint"
                  data-agent-field="current-year-check"
                  data-current-year
                >
                <p id="contact-security-year-hint">
                  Bitte das aktuelle Jahr eintragen. Die Prüfung aktualisiert sich automatisch.
                </p>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Optional</legend>
            <div class="contact-field contact-field--wide">
              <label for="contact-message">Kurze Nachricht</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                maxlength="1200"
                aria-describedby="contact-message-hint"
                data-agent-field="message"
              ></textarea>
              <p id="contact-message-hint">
                Optional, falls etwas Besonderes wichtig ist. Bitte keine Links oder Code-Fragmente senden.
              </p>
            </div>

            <div
              class="contact-field contact-field--wide contact-field--tfp"
              hidden
              data-contact-tfp
            >
              <label for="contact-tfp-images">TFP-Bilder</label>
              <input
                id="contact-tfp-images"
                name="tfp_images"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                multiple
                aria-describedby="contact-tfp-images-hint"
                data-agent-field="tfp-image-upload"
                data-contact-tfp-images
              >
              <p id="contact-tfp-images-hint">
                Maximal drei Bilder, je 2 MB. Erlaubt sind nur JPG, PNG oder WebP.
              </p>
            </div>
          </fieldset>

          <label class="contact-consent" for="contact-privacy">
            <input
              id="contact-privacy"
              name="privacy"
              type="checkbox"
              value="yes"
              required
              data-agent-field="privacy-consent"
            >
            <span>
              Ich bin damit einverstanden, dass meine Angaben zur Bearbeitung
              der Anfrage verarbeitet werden. Weitere Informationen stehen in der
              <a
                href="/datenschutz/"
                data-track-event="cta_click"
                data-cta-id="kontakt_datenschutz"
                data-cta-type="legal_link"
                data-section-id="kontakt_anfrageformular"
                data-content-topic="datenschutz"
                data-user-intent="datenschutz_pruefen"
                data-journey-stage="anfrage"
              >Datenschutzerklärung</a>. *
            </span>
          </label>

          <p class="contact-status" id="contact-form-status" role="status" aria-live="polite" tabindex="-1" data-contact-status></p>

          <div class="contact-actions">
            <button
              class="contact-submit"
              type="submit"
              data-contact-submit
              data-track-event="cta_click"
              data-cta-id="kontakt_form_submit"
              data-cta-type="form_submit"
              data-section-id="kontakt_anfrageformular"
              data-content-topic="anfrageformular"
              data-user-intent="anfrage_senden"
              data-journey-stage="anfrage"
            >
              Anfrage senden
            </button>
            <button
              class="contact-mail-action"
              type="button"
              data-mail-button
              data-track-event="contact_click"
              data-cta-id="kontakt_email_open"
              data-cta-type="email"
              data-section-id="kontakt_anfrageformular"
              data-content-topic="kontaktmoeglichkeiten"
              data-user-intent="email_schreiben"
              data-journey-stage="anfrage"
            >
              E-Mail öffnen
            </button>
          </div>
        </form>
      </section>
    </main>

    <footer class="contact-footer">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/sicherer-kontakt/">Sicherer Kontakt</a>
    </footer>

    <script>
      const contactForm = document.querySelector("[data-contact-form]");

      if (contactForm instanceof HTMLFormElement) {
        const loadedAt = contactForm.querySelector("[data-contact-loaded-at]");
        const jsEnabled = contactForm.querySelector("[data-contact-js]");
        const requestType = contactForm.querySelector("[data-contact-request-type]");
        const dateField = contactForm.querySelector("[data-contact-date]");
        const dateRequiredMarker = contactForm.querySelector("[data-date-required-marker]");
        const dateHint = contactForm.querySelector("[data-contact-date-hint]");
        const tfpHint = contactForm.querySelector("[data-contact-tfp-hint]");
        const yearField = contactForm.querySelector("[data-current-year]");
        const tfpBlock = contactForm.querySelector("[data-contact-tfp]");
        const tfpImages = contactForm.querySelector("[data-contact-tfp-images]");
        const status = contactForm.querySelector("[data-contact-status]");
        const submit = contactForm.querySelector("[data-contact-submit]");
        const params = new URLSearchParams(window.location.search);
        let storedTermin = "";
        try {
          storedTermin = window.sessionStorage.getItem("artbild_requested_date") || "";
        } catch (_) {
          storedTermin = "";
        }
        const termin = params.get("termin") || storedTermin;

        if (loadedAt instanceof HTMLInputElement) loadedAt.value = String(Date.now());
        if (jsEnabled instanceof HTMLInputElement) jsEnabled.value = "1";
        if (dateField instanceof HTMLInputElement && termin && /^\d{4}-\d{2}-\d{2}$/.test(termin)) {
          dateField.value = termin;
          try {
            window.sessionStorage.removeItem("artbild_requested_date");
          } catch (_) {
            // Session storage may be unavailable in hardened browser modes.
          }
        }

        const syncRequestType = () => {
          const isTfp = requestType instanceof HTMLSelectElement && requestType.value === "tfp";
          if (dateField instanceof HTMLInputElement) {
            dateField.required = !isTfp;
            if (isTfp) {
              dateField.setAttribute("aria-describedby", "contact-date-hint");
            } else {
              dateField.removeAttribute("aria-describedby");
            }
          }
          if (dateRequiredMarker instanceof HTMLElement) {
            dateRequiredMarker.hidden = isTfp;
          }
          if (dateHint instanceof HTMLElement) {
            dateHint.hidden = !isTfp;
          }
          if (tfpHint instanceof HTMLElement) {
            tfpHint.hidden = !isTfp;
          }
          if (requestType instanceof HTMLSelectElement) {
            if (isTfp) {
              requestType.setAttribute("aria-describedby", "contact-request-type-hint");
            } else {
              requestType.removeAttribute("aria-describedby");
            }
          }
          if (tfpBlock instanceof HTMLElement) {
            tfpBlock.hidden = !isTfp;
          }
          if (!isTfp && tfpImages instanceof HTMLInputElement) {
            tfpImages.value = "";
          }
        };

        const validateYear = () => {
          if (!(yearField instanceof HTMLInputElement)) return;
          const expectedYear = yearField.dataset.currentYear || String(new Date().getFullYear());
          const enteredYear = yearField.value.trim();
          yearField.setCustomValidity(
            enteredYear === expectedYear
              ? ""
              : enteredYear.length === 0
                ? `Bitte das aktuelle Jahr ${expectedYear} eintragen.`
                : `Bitte als Sicherheitsfrage das aktuelle Jahr ${expectedYear} eintragen.`
          );
        };

        if (requestType instanceof HTMLSelectElement) {
          requestType.addEventListener("change", syncRequestType);
          syncRequestType();
        }

        if (yearField instanceof HTMLInputElement) {
          const expectedYear = new Intl.DateTimeFormat("de-DE", {
            timeZone: "Europe/Berlin",
            year: "numeric",
          }).format(new Date());
          yearField.dataset.currentYear = expectedYear;
          yearField.placeholder = expectedYear;
          yearField.addEventListener("input", () => {
            yearField.value = yearField.value.replace(/\D/g, "").slice(0, 4);
            validateYear();
          });
        }

        if (tfpImages instanceof HTMLInputElement) {
          tfpImages.addEventListener("change", () => {
            const files = Array.from(tfpImages.files || []);
            const invalidFile = files.find((file) => {
              return !["image/jpeg", "image/png", "image/webp"].includes(file.type)
                || file.size > 2 * 1024 * 1024;
            });
            tfpImages.setCustomValidity(
              files.length > 3
                ? "Bitte maximal drei Bilder auswählen."
                : invalidFile
                  ? "Bitte nur JPG, PNG oder WebP mit maximal 2 MB auswählen."
                  : ""
            );
          });
        }

        document.querySelectorAll("[data-mail-button]").forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.addEventListener("click", () => {
            const user = String.fromCharCode(105, 110, 102, 111);
            const host = ["artbild-fotografie", "de"].join(".");
            const address = `${user}@${host}`;
            const subject = encodeURIComponent("Hochzeitsanfrage über Artbild-Fotografie");
            const output = document.querySelector("[data-mail-output]");
            if (output instanceof HTMLElement) {
              output.textContent = address;
            }
            window.location.href = `mailto:${address}?subject=${subject}`;
          });
        });

        contactForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          validateYear();
          if (!contactForm.reportValidity()) return;
          if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) return;

          status.dataset.state = "loading";
          status.textContent = "Die Anfrage wird gesendet.";
          submit.disabled = true;

          try {
            const response = await fetch(contactForm.action, {
              method: "POST",
              body: new FormData(contactForm),
              headers: {
                Accept: "application/json",
                "X-Requested-With": "fetch",
              },
            });
            const data = await response.json();

            if (!response.ok || !data.ok) {
              throw new Error(data.message || "Die Anfrage konnte nicht gesendet werden.");
            }

            status.dataset.state = "success";
            status.textContent = data.message || "Vielen Dank. Eure Anfrage ist angekommen.";
            contactForm.reset();
            if (loadedAt instanceof HTMLInputElement) loadedAt.value = String(Date.now());
            if (jsEnabled instanceof HTMLInputElement) jsEnabled.value = "1";
            syncRequestType();
            status.focus();
            window.dispatchEvent(new CustomEvent("artbild:form_success", {
              detail: {
                formId: "kontakt_anfrage_form",
                formType: "contact_request",
                sectionId: "kontakt_anfrageformular",
                contentTopic: "anfrageformular",
              },
            }));
          } catch (error) {
            status.dataset.state = "error";
            status.textContent = error instanceof Error
              ? error.message
              : "Die Anfrage konnte nicht gesendet werden. Bitte schreibt direkt per E-Mail.";
            status.focus();
            window.dispatchEvent(new CustomEvent("artbild:form_error", {
              detail: {
                formId: "kontakt_anfrage_form",
                formType: "contact_request",
                sectionId: "kontakt_anfrageformular",
                contentTopic: "anfrageformular",
                result: "request_failed",
              },
            }));
          } finally {
            submit.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>

