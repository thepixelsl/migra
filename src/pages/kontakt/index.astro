---
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import anchorImage from "../../assets/impressum/anker-york-augustin.jpg";
import "../../styles/global.css";

const siteUrl = "https://artbild-fotografie.de";
const pageUrl = `${siteUrl}/kontakt/`;
const title = "Kontakt | Hochzeitsfotograf Hamburg anfragen";
const description =
  "Kontaktformular für Hochzeitsfotografie in Hamburg: freie Termine, Hochzeitsreportagen, Standesamt, Getting Ready und Paarshootings bei Artbild-Fotografie anfragen.";
const logoUrl = `${siteUrl}/images/logo-artbild-black.png`;
const primaryImage = new URL(anchorImage.src, siteUrl).href;

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      dateModified: "2026-07-02T10:00:00+02:00",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: anchorImage.width,
        height: anchorImage.height,
        caption: "Kontakt mit Artbild-Fotografie Hamburg",
      },
      contentLocation: {
        "@type": "City",
        name: "Hamburg",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Hamburg",
          addressRegion: "Hamburg",
          addressCountry: "DE",
        },
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
      mainEntity: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "info@artbild-fotografie.de",
        areaServed: [
          { "@type": "City", name: "Hamburg" },
          { "@type": "AdministrativeArea", name: "Norddeutschland" },
          { "@type": "Country", name: "Deutschland" },
        ],
        availableLanguage: ["de", "en"],
      },
      inLanguage: "de",
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
      },
      email: "info@artbild-fotografie.de",
      founder: {
        "@type": "Person",
        name: "York Augustin",
      },
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Country", name: "Deutschland" },
      ],
      serviceType: [
        "Hochzeitsfotografie",
        "Hochzeitsreportage",
        "Standesamtliche Trauung Hamburg",
        "Paarshooting",
      ],
      sameAs: [
        "https://www.instagram.com/artbild/",
        "https://www.facebook.com/artbildfotografie/",
        "https://www.pinterest.de/artbildf/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Artbild-Fotografie",
      publisher: {
        "@id": `${siteUrl}/#organization`,
      },
      inLanguage: "de",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Startseite",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Kontakt",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={anchorImage.width}>
    <meta property="og:image:height" content={anchorImage.height}>
    <meta property="og:image:alt" content="Kontakt mit Artbild-Fotografie Hamburg">
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="contact-page">
    <header class="gallery-header">
      <MobileNavigation />
      <nav class="gallery-nav" aria-label="Hauptnavigation">
        <ul class="gallery-nav__group">
          <li><a href="/">Start</a></li>
          <li><a href="/portfolio/">Portfolio</a></li>
          <li><a href="/kontakt/" aria-current="page">Kontakt</a></li>
        </ul>
        <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
          <img
            src="/images/logo-artbild-black.png"
            width="1200"
            height="480"
            alt="Artbild Fotografie"
          >
        </a>
        <ul class="gallery-nav__group">
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/about/">Über mich</a></li>
          <li><a href="/newsletter/">Newsletter</a></li>
          <li>
            <a class="gallery-search" href="/?s=" aria-label="Suche">⌕</a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main-content">
      <nav class="contact-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Startseite</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Kontakt</span>
      </nav>

      <section class="contact-hero" aria-labelledby="contact-title">
        <div class="contact-hero__copy">
          <p class="contact-kicker">Anfrage & freie Termine</p>
          <h1 id="contact-title">Kontakt zu Artbild-Fotografie</h1>
          <p>
            Erzählt mir kurz von Eurer Hochzeit, dem Ort und dem gewünschten
            Datum. Ich melde mich persönlich zurück und prüfe, ob eine
            Hochzeitsreportage in Hamburg, Norddeutschland oder darüber hinaus
            möglich ist.
          </p>
        </div>
        <figure class="contact-hero__image">
          <Image
            src={anchorImage}
            widths={[420, 640, 860, 1100]}
            sizes="(max-width: 820px) 100vw, 38vw"
            format="webp"
            quality={88}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            alt="York Augustin von Artbild-Fotografie in Hamburg"
          />
        </figure>
      </section>

      <section class="contact-shell" aria-labelledby="contact-form-title">
        <div class="contact-aside" aria-label="Direkte Kontaktwege">
          <p class="contact-kicker">Direkt</p>
          <h2>Für kurze Wege</h2>
          <p>
            Für kurzfristige Hochzeiten ist eine knappe Nachricht mit Datum,
            Ort und gewünschter Begleitdauer am hilfreichsten.
          </p>
          <dl>
            <div>
              <dt>E-Mail</dt>
              <dd>
                <a href="mailto:info@artbild-fotografie.de">info@artbild-fotografie.de</a>
              </dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd>
                <a
                  href="https://wa.me/4915161438120?text=Hallo%20York%2C%20ich%20m%C3%B6chte%20eine%20Hochzeit%20anfragen."
                  rel="noopener"
                >
                  Kurznachricht senden
                </a>
              </dd>
            </div>
            <div>
              <dt>Instagram</dt>
              <dd>
                <a href="https://ig.me/m/artbild" rel="noopener">artbild kontaktieren</a>
              </dd>
            </div>
          </dl>
          <a class="contact-secure-link" href="/sicherer-kontakt/">
            Sicherer Kontakt mit PGP und S/MIME
          </a>
        </div>

        <form
          class="contact-form"
          action="/api/contact"
          method="post"
          aria-labelledby="contact-form-title"
          aria-describedby="contact-form-intro contact-form-status"
          data-contact-form
        >
          <input type="hidden" name="source_path" value="/kontakt/">
          <input type="hidden" name="form_loaded_at" value="" data-contact-loaded-at>
          <input type="hidden" name="js_enabled" value="0" data-contact-js>

          <div class="contact-form__header">
            <p class="contact-kicker">Formular</p>
            <h2 id="contact-form-title">Hochzeit anfragen</h2>
            <p id="contact-form-intro">
              Pflichtfelder sind mit einem Stern markiert. Bitte sendet keine
              sensiblen Daten, bevor der Termin grundsätzlich bestätigt ist.
            </p>
          </div>

          <div class="contact-form__honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input
              id="contact-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              data-agent-ignore="true"
            >
          </div>

          <fieldset>
            <legend>Kontakt</legend>
            <div class="contact-form__grid">
              <div class="contact-field">
                <label for="contact-name">Euer Name *</label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  minlength="2"
                  data-agent-field="full-name"
                >
              </div>

              <div class="contact-field">
                <label for="contact-email">E-Mail-Adresse *</label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                  data-agent-field="email"
                >
              </div>

              <div class="contact-field">
                <label for="contact-phone">Telefon oder WhatsApp</label>
                <input
                  id="contact-phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  aria-describedby="contact-phone-hint"
                  data-agent-field="phone"
                >
                <p id="contact-phone-hint">Optional, falls ein kurzer Rückruf sinnvoll ist.</p>
              </div>

              <div class="contact-field">
                <label for="contact-request-type">Worum geht es? *</label>
                <select
                  id="contact-request-type"
                  name="request_type"
                  required
                  data-agent-field="request-type"
                >
                  <option value="">Bitte auswählen</option>
                  <option value="hochzeitsreportage">Hochzeitsreportage</option>
                  <option value="standesamt">Standesamtliche Trauung</option>
                  <option value="paarshooting">Paarshooting</option>
                  <option value="editorial">Editorial oder Portrait</option>
                  <option value="sonstiges">Sonstige Anfrage</option>
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Termin & Ort</legend>
            <div class="contact-form__grid">
              <div class="contact-field">
                <label for="contact-event-date">Wunschdatum</label>
                <input
                  id="contact-event-date"
                  name="event_date"
                  type="date"
                  autocomplete="off"
                  data-agent-field="event-date"
                  data-contact-date
                >
              </div>

              <div class="contact-field">
                <label for="contact-location">Ort oder Location</label>
                <input
                  id="contact-location"
                  name="location"
                  type="text"
                  autocomplete="address-level2"
                  placeholder="z. B. Hamburg, Standesamt Altona"
                  data-agent-field="event-location"
                >
              </div>

              <div class="contact-field">
                <label for="contact-coverage">Gewünschte Begleitung</label>
                <select id="contact-coverage" name="coverage" data-agent-field="coverage">
                  <option value="">Noch offen</option>
                  <option value="2-3-stunden">2-3 Stunden</option>
                  <option value="4-6-stunden">4-6 Stunden</option>
                  <option value="ganzer-tag">Ganzer Hochzeitstag</option>
                  <option value="mehrere-tage">Mehrere Tage oder Destination Wedding</option>
                </select>
              </div>

              <div class="contact-field">
                <label for="contact-guest-count">Anzahl Gäste</label>
                <input
                  id="contact-guest-count"
                  name="guest_count"
                  type="number"
                  min="0"
                  max="600"
                  inputmode="numeric"
                  data-agent-field="guest-count"
                >
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Nachricht</legend>
            <div class="contact-field contact-field--wide">
              <label for="contact-message">Was darf ich für Euch fotografieren? *</label>
              <textarea
                id="contact-message"
                name="message"
                rows="7"
                required
                minlength="20"
                maxlength="3600"
                aria-describedby="contact-message-hint"
                data-agent-field="message"
              ></textarea>
              <p id="contact-message-hint">
                Hilfreich sind Datum, Ort, gewünschte Dauer, Standesamt oder Location
                und was Euch an den Bildern wichtig ist.
              </p>
            </div>

            <div class="contact-field contact-field--wide">
              <label for="contact-referral">Wie habt Ihr Artbild-Fotografie gefunden?</label>
              <input
                id="contact-referral"
                name="referral"
                type="text"
                autocomplete="off"
                data-agent-field="referral"
              >
            </div>
          </fieldset>

          <label class="contact-consent" for="contact-privacy">
            <input
              id="contact-privacy"
              name="privacy"
              type="checkbox"
              value="yes"
              required
              data-agent-field="privacy-consent"
            >
            <span>
              Ich bin damit einverstanden, dass meine Angaben zur Bearbeitung
              der Anfrage verarbeitet werden. Weitere Informationen stehen in der
              <a href="/datenschutz/">Datenschutzerklärung</a>. *
            </span>
          </label>

          <p class="contact-status" id="contact-form-status" role="status" aria-live="polite" data-contact-status></p>

          <div class="contact-actions">
            <button class="contact-submit" type="submit" data-contact-submit>
              Anfrage senden
            </button>
            <a href="mailto:info@artbild-fotografie.de?subject=Hochzeitsanfrage%20%C3%BCber%20Artbild-Fotografie">
              Direkt per E-Mail
            </a>
          </div>
        </form>
      </section>
    </main>

    <footer class="contact-footer">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/sicherer-kontakt/">Sicherer Kontakt</a>
    </footer>

    <script>
      const contactForm = document.querySelector("[data-contact-form]");

      if (contactForm instanceof HTMLFormElement) {
        const loadedAt = contactForm.querySelector("[data-contact-loaded-at]");
        const jsEnabled = contactForm.querySelector("[data-contact-js]");
        const dateField = contactForm.querySelector("[data-contact-date]");
        const status = contactForm.querySelector("[data-contact-status]");
        const submit = contactForm.querySelector("[data-contact-submit]");
        const params = new URLSearchParams(window.location.search);
        const termin = params.get("termin");

        if (loadedAt instanceof HTMLInputElement) loadedAt.value = String(Date.now());
        if (jsEnabled instanceof HTMLInputElement) jsEnabled.value = "1";
        if (dateField instanceof HTMLInputElement && termin && /^\d{4}-\d{2}-\d{2}$/.test(termin)) {
          dateField.value = termin;
        }

        contactForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!contactForm.reportValidity()) return;
          if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) return;

          status.dataset.state = "loading";
          status.textContent = "Die Anfrage wird gesendet.";
          submit.disabled = true;

          try {
            const response = await fetch(contactForm.action, {
              method: "POST",
              body: new FormData(contactForm),
              headers: {
                Accept: "application/json",
                "X-Requested-With": "fetch",
              },
            });
            const data = await response.json();

            if (!response.ok || !data.ok) {
              throw new Error(data.message || "Die Anfrage konnte nicht gesendet werden.");
            }

            status.dataset.state = "success";
            status.textContent = data.message || "Vielen Dank. Eure Anfrage ist angekommen.";
            contactForm.reset();
            if (loadedAt instanceof HTMLInputElement) loadedAt.value = String(Date.now());
            if (jsEnabled instanceof HTMLInputElement) jsEnabled.value = "1";
            status.focus();
          } catch (error) {
            status.dataset.state = "error";
            status.textContent = error instanceof Error
              ? error.message
              : "Die Anfrage konnte nicht gesendet werden. Bitte schreibt direkt per E-Mail.";
            status.focus();
          } finally {
            submit.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .contact-page {
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .contact-page main {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: clamp(34px, 6vw, 82px) 0 clamp(68px, 8vw, 120px);
  }

  .contact-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: clamp(34px, 6vw, 74px);
    color: #827a72;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  .contact-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .contact-hero {
    display: grid;
    gap: clamp(28px, 5vw, 68px);
    align-items: end;
    margin-bottom: clamp(44px, 8vw, 110px);
  }

  .contact-kicker {
    margin: 0 0 14px;
    color: #7e746b;
    font-family: "Raleway", Arial, sans-serif;
    font-size: clamp(12px, 1.7vw, 14px);
    font-weight: 800;
    letter-spacing: .22em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .contact-hero h1,
  .contact-aside h2,
  .contact-form h2 {
    margin: 0;
    color: #1b1b1b;
    font-weight: 500;
    line-height: .98;
    letter-spacing: 0;
  }

  .contact-hero h1 {
    max-width: 9.5em;
    font-size: clamp(54px, 15vw, 146px);
  }

  .contact-hero__copy > p:last-child {
    max-width: 650px;
    margin: clamp(22px, 4vw, 34px) 0 0;
    color: #5f5953;
    font-size: clamp(20px, 3.8vw, 30px);
    line-height: 1.45;
  }

  .contact-hero__image {
    margin: 0;
    min-height: 0;
  }

  .contact-hero__image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 32%;
    background: var(--soft);
  }

  .contact-shell {
    display: grid;
    gap: clamp(28px, 5vw, 62px);
    align-items: start;
  }

  .contact-aside {
    padding-block: clamp(6px, 2vw, 22px);
  }

  .contact-aside h2,
  .contact-form h2 {
    font-size: clamp(38px, 8vw, 74px);
  }

  .contact-aside p,
  .contact-form__header p {
    margin: 18px 0 0;
    color: #655f59;
    font-size: clamp(18px, 2.3vw, 22px);
    line-height: 1.55;
  }

  .contact-aside dl {
    display: grid;
    gap: 16px;
    margin: 30px 0 0;
  }

  .contact-aside dl > div {
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }

  .contact-aside dt {
    color: #81776f;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .contact-aside dd {
    margin: 6px 0 0;
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.25;
  }

  .contact-aside a {
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
  }

  .contact-secure-link {
    min-height: 52px;
    margin-top: 24px;
    padding: 14px 18px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    color: #1b1b1b;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
  }

  .contact-form {
    padding: clamp(22px, 4vw, 46px);
    border: 1px solid var(--line);
    background: #fbfaf8;
  }

  .contact-form__header {
    margin-bottom: clamp(28px, 5vw, 46px);
  }

  .contact-form fieldset {
    margin: 0;
    padding: clamp(24px, 4vw, 36px) 0;
    display: grid;
    gap: 18px;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .contact-form legend {
    padding: 0 14px 0 0;
    color: #7e746b;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .contact-form__grid {
    display: grid;
    gap: 18px;
  }

  .contact-field {
    display: grid;
    gap: 8px;
  }

  .contact-field label,
  .contact-consent {
    color: #242424;
    font-size: clamp(19px, 2.3vw, 22px);
    line-height: 1.35;
  }

  .contact-field p {
    margin: 0;
    color: #706a64;
    font-size: 15px;
    line-height: 1.45;
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    width: 100%;
    min-height: 56px;
    padding: 14px 16px;
    border: 1px solid #cfc7bd;
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 18px;
    line-height: 1.35;
  }

  .contact-field textarea {
    min-height: 190px;
    resize: vertical;
  }

  .contact-field input::placeholder {
    color: #948b82;
  }

  .contact-field input:focus,
  .contact-field select:focus,
  .contact-field textarea:focus,
  .contact-consent input:focus-visible,
  .contact-submit:focus-visible,
  .contact-actions a:focus-visible,
  .contact-secure-link:focus-visible {
    outline: 3px solid #1f6688;
    outline-offset: 3px;
  }

  .contact-consent {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    align-items: start;
  }

