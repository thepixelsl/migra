---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import "../../styles/global.css";
import brideImage from "../../assets/trautermin-hamburg-online-reservieren/trautermin-hamburg-brautmoment.jpg";

const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/trautermin-hamburg-online-reservieren/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "Traukalender Hamburg: Trautermin online reservieren";
const description =
  "So findet ihr freie Trautermine in Hamburg, reserviert euren Wunschtermin online und plant eure standesamtliche Hochzeit mit fotografischem Zeitpuffer.";
const datePublished = "2026-07-08T09:00:00+02:00";
const dateModified = "2026-08-08T12:00:00+02:00";
const officialCalendarUrl = "https://standesamtstermine.hamburg.de/";
const onlineBookingNewsUrl =
  "https://www.hamburg.de/politik-und-verwaltung/behoerden/finanzbehoerde/aktuelles/heiraten-jetzt-mit-online-terminbuchung--1193966";
const marriageInfoUrl = "https://www.hamburg.de/service/info/111015833/n0/";
const registryOfficeUrl =
  "https://www.hamburg.de/politik-und-verwaltung/bezirke/bezirksthemen/standesamt/eheschliessung";
const heroImagePath =
  "/migrated-assets/gallery__paarshooting-in-hamburg/ART_9148_web_1.jpg";
const heroImageUrl = new URL(heroImagePath, siteUrl).toString();

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: "Traukalender Hamburg", href: pagePath },
];

const faqItems = [
  {
    question: "Kann man den Trautermin in Hamburg online reservieren?",
    answer:
      "Ja. Der offizielle Traukalender der Stadt Hamburg ermöglicht die Suche nach freien Trauterminen und die Online-Reservierung eines Wunschtermins. Maßgeblich sind die Hinweise im Traukalender und die anschließende Bestätigung des Standesamts.",
  },
  {
    question: "Muss man im eigenen Bezirk heiraten?",
    answer:
      "Nein. Die Ehe kann grundsätzlich bei einem anderen Standesamt geschlossen werden. Angemeldet wird die Eheschließung beim Standesamt am Haupt- oder Nebenwohnsitz einer der beiden Personen; Sonderfälle erklärt die Stadt Hamburg.",
  },
  {
    question: "Wie früh kann man die Eheschließung anmelden?",
    answer:
      "Die Anmeldung der Eheschließung ist in der Regel frühestens sechs Monate vor dem gewünschten Trautermin möglich. Prüft die aktuellen Angaben der Stadt Hamburg, weil die konkreten Abläufe und Unterlagen vom Einzelfall abhängen können.",
  },
  {
    question: "Was mache ich, wenn die Online-Terminbuchung nicht funktioniert?",
    answer:
      "Wenn die hamburgweite Suche langsam ist oder nicht lädt, hilft oft die gezielte Suche nach einem einzelnen Bezirk oder Trauort. Bleibt das Problem bestehen, nutzt die offiziellen Informationen der Stadt Hamburg oder kontaktiert das zuständige Standesamt.",
  },
  {
    question: "Wann sollte ich den Fotografen anfragen?",
    answer:
      "Sobald Datum, Uhrzeit und Trauort feststehen, kann der gewünschte Umfang konkret besprochen werden. Die passende Dauer hängt vom Ablauf, den gewünschten Motiven und den Wegen zwischen den Orten ab.",
  },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: `${siteUrl}/`,
      email: "info@artbild-fotografie.de",
      image: `${siteUrl}/images/logo-artbild-black.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Country", name: "Deutschland" },
      ],
      serviceType: ["Hochzeitsfotografie", "Hochzeitsreportage", "Standesamtliche Trauung"],
      priceRange: "ab 299 EUR",
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      isPartOf: {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        name: "Artbild-Fotografie",
        url: `${siteUrl}/`,
      },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: heroImageUrl,
      },
      inLanguage: "de",
    },
    {
      "@type": "Article",
      "@id": `${pageUrl}#article`,
      mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
      headline: title,
      description,
      image: heroImageUrl,
      datePublished,
      dateModified,
      author: {
        "@type": "Person",
        name: "York Augustin",
        url: `${siteUrl}/about/`,
      },
      publisher: { "@id": `${siteUrl}/#organization` },
      articleSection: "Journal",
      about: [
        "Traukalender Hamburg",
        "Trautermin online reservieren",
        "Standesamtliche Hochzeit Hamburg",
        "Hochzeitsplanung Hamburg",
      ],
      inLanguage: "de",
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
      inLanguage: "de",
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="article">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={heroImageUrl}>
    <meta property="og:image:alt" content="Eheringe auf einer handgeschriebenen Karte mit Eukalyptuszweig">
    <meta property="article:published_time" content={datePublished}>
    <meta property="article:modified_time" content={dateModified}>
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  </head>
  <body class="journal-article-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} siteUrl={siteUrl} currentUrl={pageUrl} />

      <article class="journal-article">
        <header
          class="journal-hero"
          data-track-section="traukalender_hamburg_article_hero"
          data-content-topic="trautermin_hamburg_online_reservieren"
          data-user-intent="termin_finden"
          data-journey-stage="orientierung"
          data-content-format="article_hero"
          data-position="hero"
        >
          <div class="journal-hero__text">
            <p class="eyebrow">Journal</p>
            <h1>Traukalender Hamburg: Trautermin online reservieren</h1>
            <p class="lead">
              Der Traukalender der Stadt Hamburg hilft Paaren dabei, freie Termine für die standesamtliche Trauung online zu finden und den gewünschten Termin zu reservieren.
            </p>
          </div>
          <figure class="journal-hero__image">
            <img
              src={heroImagePath}
              width="924"
              height="924"
              alt="Eheringe auf einer handgeschriebenen Karte mit Eukalyptuszweig"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
        </header>

        <section
          class="intro-note"
          aria-labelledby="kurz-erklaert"
          data-track-section="traukalender_hamburg_kurz_erklaert"
          data-content-topic="standesamttermin_hamburg"
          data-user-intent="kurzantwort_lesen"
          data-journey-stage="orientierung"
          data-content-format="summary_box"
          data-position="after_hero"
        >
          <h2 id="kurz-erklaert">Kurz erklärt:</h2>
          <p>
            Mit dem Traukalender der Stadt Hamburg können Paare online nach freien Trauterminen suchen und einen Termin reservieren. Besonders hilfreich ist die hamburgweite Suche, wenn der Bezirk oder Trauort noch nicht feststeht.
          </p>
        </section>

        <div class="article-flow">
          <section
            aria-labelledby="was-ist-traukalender"
            data-track-section="traukalender_hamburg_was_ist"
            data-content-topic="traukalender_stadt_hamburg"
            data-user-intent="service_verstehen"
            data-journey-stage="orientierung"
            data-content-format="article_section"
            data-position="content_1"
          >
            <p class="eyebrow">Offizieller Service</p>
            <h2 id="was-ist-traukalender">Was ist der Traukalender Hamburg?</h2>
            <p>
              Der Traukalender ist der offizielle Online-Service der Stadt Hamburg für die Suche und Reservierung freier Trautermine. Welche Standesämter und Trauorte aktuell angeboten werden, zeigt der Dienst selbst.
            </p>
            <p>
              Die Reservierung ersetzt nicht die Anmeldung der Eheschließung. Zuständig ist grundsätzlich das Standesamt am Haupt- oder Nebenwohnsitz einer der beiden Personen.
            </p>
          </section>

          <section
            aria-labelledby="was-ist-neu"
            data-track-section="traukalender_hamburg_was_ist_neu"
            data-content-topic="online_terminbuchung_hamburg"
            data-user-intent="neuigkeit_verstehen"
            data-journey-stage="orientierung"
            data-content-format="article_section"
            data-position="content_2"
          >
            <p class="eyebrow">Was ist neu?</p>
            <h2 id="was-ist-neu">Freie Trautermine online suchen und reservieren</h2>
            <p>
              Die Stadt Hamburg hat die Online-Terminbuchung im Juli 2026 nach einer Pilotphase auf weitere Bezirke ausgeweitet. Den aktuellen Umfang zeigt der offizielle Traukalender.
            </p>
            <p>
              Die Reservierung ist praktisch, ersetzt aber nicht die sorgfältige Prüfung der offiziellen Hinweise. Achtet besonders auf Fristen, Unterlagen und die E-Mail, die ihr nach der Reservierung bekommt.
            </p>
          </section>

          <section
            aria-labelledby="fuer-wen-hilfreich"
            data-track-section="traukalender_hamburg_zielgruppe"
            data-content-topic="hochzeitsplanung_hamburg"
            data-user-intent="planung_priorisieren"
            data-journey-stage="orientierung"
            data-content-format="article_section"
            data-position="content_3"
          >
            <p class="eyebrow">Planung</p>
            <h2 id="fuer-wen-hilfreich">Für wen ist der Traukalender hilfreich?</h2>
            <p>
              Der Traukalender eignet sich für die hamburgweite Suche und für die gezielte Auswahl eines Standesamts. Angezeigt werden nur die im offiziellen Dienst aktuell verfügbaren Termine und Trauorte.
            </p>
          </section>

          <section
            class="steps-section"
            aria-labelledby="so-nutzt-ihr"
            data-track-section="traukalender_hamburg_anleitung"
            data-content-topic="standesamt_hamburg_termin_online_buchen"
            data-user-intent="anleitung_lesen"
            data-journey-stage="vor_reservierung"
            data-content-format="ordered_steps"
            data-position="content_4"
          >
            <p class="eyebrow">Schritt für Schritt</p>
            <h2 id="so-nutzt-ihr">So nutzt ihr den Traukalender</h2>
            <ol>
              <li>Öffnet den offiziellen Traukalender der Stadt Hamburg.</li>
              <li>Sucht hamburgweit, wenn Bezirk oder Trauort noch offen sind.</li>
              <li>Wählt gezielt ein Standesamt aus, wenn ihr schon eine klare Präferenz habt.</li>
              <li>Prüft Datum, Uhrzeit und Trauort sorgfältig.</li>
              <li>Reserviert den Termin und lest anschließend die Bestätigung per E-Mail.</li>
              <li>Plant danach den Ablauf rund um Trauung, Gratulation, Fotos und Weiterfahrt.</li>
            </ol>
            <a
              class="text-link official-calendar-cta"
              href={officialCalendarUrl}
              target="_blank"
              rel="noopener"
              aria-label="Offiziellen Traukalender der Stadt Hamburg in einem neuen Tab öffnen"
              data-track-event="external_resource_click"
              data-resource-id="traukalender_hamburg"
              data-resource-type="official_city_service"
              data-cta-id="traukalender_hamburg_official"
              data-cta-type="external_official_service"
              data-section-id="traukalender_hamburg_anleitung"
              data-content-topic="standesamttermin_hamburg"
              data-user-intent="termin_finden"
              data-journey-stage="vor_reservierung"
            >
              Offiziellen Traukalender Hamburg öffnen
            </a>
          </section>

          <section
            aria-labelledby="bedeutung-planung"
            data-track-section="traukalender_hamburg_bedeutung_planung"
            data-content-topic="standesamtliche_hochzeit_hamburg"
            data-user-intent="ablauf_planen"
            data-journey-stage="planung"
            data-content-format="article_section"
            data-position="content_5"
          >
            <p class="eyebrow">Nach der Reservierung</p>
            <h2 id="bedeutung-planung">Was bedeutet der Termin für eure Hochzeitsplanung?</h2>
            <p>
              Für die fotografische Planung sind Datum, Uhrzeit, Trauort und die Wege danach entscheidend. Erst mit diesen Angaben lässt sich der Umfang sinnvoll abstimmen.
            </p>
            <p>
              Für eure Anfrage reichen oft wenige Informationen: Name, Ort, E-Mail und Wunschdatum. Wenn ihr schon mehr wisst, sind Uhrzeit und Standesamt natürlich hilfreich.
            </p>
          </section>

          <section
            class="timeline-section"
            aria-labelledby="fotografischer-tipp"
            data-track-section="traukalender_hamburg_fotografischer_tipp"
            data-content-topic="standesamtliche_reportage_hamburg"
            data-user-intent="fotografische_begleitung_planen"
            data-journey-stage="planung"
            data-content-format="timeline"
            data-position="content_6"
          >
            <div>
              <p class="eyebrow">Fotografischer Tipp</p>
              <h2 id="fotografischer-tipp">Ablauf nach dem Trautermin planen</h2>
              <p>
              Es gibt keine pauschal passende Dauer. Klärt zuerst, welche Teile ihr fotografiert haben möchtet und wie viel Weg zwischen Trauort, Gruppenfotos, Paarfotos und Feier liegt.
              </p>
            </div>
            <ol aria-label="Beispielhafter Ablauf einer standesamtlichen Trauung">
              <li><time>Vorher</time><span>Ankunft und gewünschte Aufnahmen vor der Trauung klären</span></li>
              <li><time>Trauung</time><span>Beginn und Hinweise des Standesamts bestätigen</span></li>
              <li><time>Danach</time><span>Gratulationen und Gruppenbilder einplanen</span></li>
              <li><time>Optional</time><span>Paarfotos und Wege zur nächsten Location abstimmen</span></li>
            </ol>
          </section>

          <section
            class="image-cta"
            aria-labelledby="standesamt-fotografie"
            data-track-section="traukalender_hamburg_standesamt_cta"
            data-content-topic="standesamtliche_trauung_hamburg"
            data-user-intent="leistung_pruefen"
            data-journey-stage="entscheidung"
            data-content-format="image_cta"
            data-position="before_faq"
          >
            <figure>
              <Image
                src={brideImage}
                alt="Braut lacht nach einer standesamtlichen Trauung in Hamburg"
                widths={[420, 640, 900]}
                sizes="(max-width: 820px) calc(100vw - 40px), 320px"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={90}
              />
            </figure>
            <div>
              <p class="eyebrow">Standesamtliche Hochzeitsfotografie</p>
              <h2 id="standesamt-fotografie">Wenn der Termin steht, wird der Ablauf konkret</h2>
              <p>
                Wenn euch eine ruhige, dokumentarische Begleitung eurer standesamtlichen Trauung wichtig ist, findet ihr auf der Preis- und Leistungsseite eine Orientierung für kurze Reportagen in Hamburg.
              </p>
              <div class="link-row" aria-label="Weiterführende interne Links">
                <a href="/standesamt-hamburg/">Standesämter in Hamburg</a>
                <a href="/hochzeitsfotograf-preise/">Preise & Leistungen</a>
                <a href="/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/">Standesamt Altona Reportage</a>
                <a href="/kontakt/">Anfrage senden</a>
              </div>
            </div>
          </section>

          <section
            class="faq-section"
            aria-labelledby="faq-title"
            data-track-section="traukalender_hamburg_faq"
            data-content-topic="trautermin_hamburg_online_reservieren"
            data-user-intent="fragen_klaeren"
            data-journey-stage="orientierung"
            data-content-format="faq"
            data-position="faq"
          >
            <p class="eyebrow">Häufige Fragen</p>
            <h2 id="faq-title">Häufige Fragen zum Traukalender Hamburg</h2>
            <div class="faq-list">
              {faqItems.map((item, index) => (
                <details
                  data-track-event="faq_open"
                  data-section-id="traukalender_hamburg_faq"
                  data-content-topic="trautermin_hamburg_online_reservieren"
                  data-user-intent="fragen_klaeren"
                  data-journey-stage="orientierung"
                  data-position={`faq_${index + 1}`}
                >
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>

          <section
            class="sources-section"
            aria-labelledby="quellen-aktualisierung"
            data-track-section="traukalender_hamburg_quellen"
            data-content-topic="offizielle_quellen_hamburg"
            data-user-intent="quelle_pruefen"
            data-journey-stage="validierung"
            data-content-format="source_list"
            data-position="after_faq"
          >
            <p class="eyebrow">Quellen & Aktualisierung</p>
            <h2 id="quellen-aktualisierung">Offizielle Quellen</h2>
            <p>
              Diese Seite wurde zuletzt am <time datetime={dateModified}>08.08.2026</time> anhand der unten verlinkten Primärquellen geprüft. Für Fristen, Unterlagen, Verfügbarkeit und rechtliche Details gelten immer die aktuellen Informationen der Stadt Hamburg und des zuständigen Standesamts.
            </p>
            <ul>
              <li><a href={officialCalendarUrl} target="_blank" rel="noopener">Offizieller Traukalender der Stadt Hamburg</a></li>
              <li><a href={onlineBookingNewsUrl} target="_blank" rel="noopener">Hamburg.de Meldung zur Online-Terminbuchung</a></li>
              <li><a href={marriageInfoUrl} target="_blank" rel="noopener">Hamburg.de Information zur Eheschließung</a></li>
              <li><a href={registryOfficeUrl} target="_blank" rel="noopener">Hamburg.de Standesamt / Eheschließung</a></li>
            </ul>
          </section>
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .journal-article-page {
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .journal-article {
    width: min(1180px, calc(100% - 44px));
    margin: 0 auto clamp(82px, 10vw, 150px);
  }

  .journal-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(300px, 0.62fr);
    gap: clamp(36px, 6vw, 84px);
    align-items: end;
    padding: clamp(46px, 6vw, 88px) 0 clamp(46px, 6vw, 82px);
  }

  .journal-hero__text,
  .journal-hero__image {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #7f7972;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .24em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #202633;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.04;
  }

  h1 {
    max-width: 820px;
    font-size: clamp(46px, 6.2vw, 94px);
  }

  h2 {
    font-size: clamp(34px, 4vw, 58px);
  }

  .lead,
  p,
  li {
    color: var(--muted);
    font-size: clamp(18px, 1.32vw, 22px);
    line-height: 1.76;
  }

  .lead {
    max-width: 720px;
    margin: clamp(24px, 3vw, 36px) 0 0;
    font-size: clamp(21px, 1.8vw, 27px);
  }

  .journal-hero__image {
    margin: 0;
  }

  .journal-hero__image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--soft);
  }

  .intro-note,
  .image-cta,
  .sources-section {
    border: 1px solid var(--line);
    background: #f7f3ee;
  }

  .intro-note {
    width: min(900px, 100%);
    margin: 0 auto clamp(64px, 8vw, 112px);
    padding: clamp(24px, 4vw, 42px);
  }

  .intro-note h2 {
    font-size: clamp(26px, 3vw, 40px);
  }

  .intro-note p {
    margin: 16px 0 0;
  }

  .article-flow {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .article-flow > section + section {
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: clamp(48px, 6vw, 82px);
    border-top: 1px solid var(--line);
  }

  .article-flow p {
    max-width: 820px;
    margin: 24px 0 0;
  }

  .steps-section ol,
  .timeline-section ol {
    display: grid;
    gap: 16px;
    margin: clamp(28px, 4vw, 42px) 0;
    padding: 0;
    list-style: none;
    counter-reset: steps;
  }

  .steps-section li,
  .timeline-section li {
    counter-increment: steps;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 18px;
    align-items: baseline;
  }

  .steps-section li::before {
    content: counter(steps, decimal-leading-zero);
