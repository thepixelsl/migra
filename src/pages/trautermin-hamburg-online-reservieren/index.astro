---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GalleryImageGrid from "../../components/GalleryImageGrid.astro";
import "../../styles/global.css";
import titleImage from "../../assets/trautermin-hamburg-online-reservieren/trautermin-hamburg-editorial-paar.jpg";
import brideImage from "../../assets/trautermin-hamburg-online-reservieren/trautermin-hamburg-brautmoment.jpg";
import groomImage from "../../assets/trautermin-hamburg-online-reservieren/trautermin-hamburg-braeutigam.webp";
import bouquetImage from "../../assets/trautermin-hamburg-online-reservieren/trautermin-hamburg-brautstrauss.webp";
import ringsImage from "../../assets/traumhochzeit-hamburg/ART_9148_web_1.jpg";
import coupleImage from "../../assets/traumhochzeit-hamburg/ART_0074-Bearbeitet_print-768x1151.jpg";

// Originalwortlaut aus den bisherigen Artbild-Seiten. Veränderliche Angaben
// zu Preisen, Jahren, Corona-Regeln und festen Reservierungsfristen bleiben aus.
const originalCopy = {
  calendarHeading: "Traukalender der Stadt Hamburg",
  calendarAvailability:
    "Freie Trautermine können für alle Standesämter hamburgweit online reserviert werden.",
  calendarCta: "Freie Trautermine in Hamburg online prüfen und buchen",
  calendarDescription:
    "Offizieller Traukalender der Stadt Hamburg für freie Trautermine in den Hamburger Standesämtern.",
  registryLink: "Weitere Kontaktinformationen der Standesämter in Hamburg",
  reachability:
    "Die Erreichbarkeiten können stark unterschiedlich sein, daher empfehle ich Euch, rechtzeitig Kontakt zu Eurem Standesamt aufzunehmen.",
  storyIntro:
    "Ich, als Hochzeitsfotograf in Hamburg, erzähle Eure Geschichte. Ich friere Eure Momente für die Ewigkeit ein.",
  storyMeaning:
    "Das ist es, worum es geht. Es geht um Euch und eure Liebe. Ich möchte Euch an eurem Tag wie ein guter Freund ein Stück auf eurem Weg begleiten und für Euch alle großen und kleinen Gänsehaut-Momente authentisch und ungestellt einfangen.",
  storyClosing:
    "Natürlich, unverfälscht und echt. Ich kreiere Erinnerungen, die Euch für immer bleiben, ganz egal wo auf der Welt. Wenn Ihr auf der Suche nach authentischen und emotionalen Hochzeitsfotos im Reportage-Stil seid, dann seid Ihr bei mir genau richtig!",
} as const;

const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/trautermin-hamburg-online-reservieren/";
const pageUrl = `${siteUrl}${pagePath}`;
const headline = originalCopy.calendarHeading;
const title = `${headline} | Artbild-Fotografie`;
const description = originalCopy.calendarDescription;
// datePublished wird erst beim tatsächlichen Go-live ergänzt.
const dateCreated = "2026-08-09";
const dateModified = "2026-08-09";
const officialCalendarUrl = "https://standesamtstermine.hamburg.de/";
const onlineBookingNewsUrl =
  "https://www.hamburg.de/politik-und-verwaltung/behoerden/finanzbehoerde/aktuelles/heiraten-jetzt-mit-online-terminbuchung--1193966";
const marriageInfoUrl = "https://www.hamburg.de/service/info/111015833/n0/";
const registryOfficeUrl =
  "https://www.hamburg.de/politik-und-verwaltung/bezirke/bezirksthemen/standesamt/eheschliessung";
const heroImageAlt = "Brautpaar in festlicher Kleidung im Gegenlicht am Wasser";
const heroImageUrl = new URL(titleImage.src, siteUrl).toString();
const galleryImages = [
  {
    image: groomImage,
    alt: "Bräutigam im dunklen Anzug vor einem Baum",
    aspect: "natural" as const,
  },
  {
    image: bouquetImage,
    alt: "Brautstrauß mit rosafarbenen und blauen Blüten auf einem Tisch",
    aspect: "natural" as const,
  },
  {
    image: ringsImage,
    alt: "Eheringe auf einer handgeschriebenen Karte mit Eukalyptuszweig",
    aspect: "natural" as const,
  },
  {
    image: coupleImage,
    alt: "Brautpaar bei einem Portrait an der Hamburger Alster",
    aspect: "natural" as const,
  },
];
const galleryColumns = [galleryImages];
const galleryImageUrls = galleryImages.map((item) =>
  new URL(item.image.src, siteUrl).toString(),
);

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: "Traukalender Hamburg", href: pagePath },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: `${siteUrl}/`,
      email: "info@artbild-fotografie.de",
      image: `${siteUrl}/images/logo-artbild-black.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Country", name: "Deutschland" },
      ],
      serviceType: ["Hochzeitsfotografie", "Hochzeitsreportage", "Standesamtliche Trauung"],
      priceRange: "ab 299 EUR",
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      isPartOf: {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        name: "Artbild-Fotografie",
        url: `${siteUrl}/`,
      },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        contentUrl: heroImageUrl,
        width: titleImage.width,
        height: titleImage.height,
        caption: heroImageAlt,
      },
      inLanguage: "de",
    },
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
      headline,
      description,
      image: [heroImageUrl, ...galleryImageUrls],
      hasPart: { "@id": `${pageUrl}#gallery` },
      dateCreated,
      dateModified,
      author: {
        "@type": "Person",
        name: "York Augustin",
        url: `${siteUrl}/about/`,
      },
      publisher: { "@id": `${siteUrl}/#organization` },
      articleSection: "Journal",
      about: [
        "Traukalender Hamburg",
        "Trautermin online reservieren",
        "Standesamtliche Hochzeit Hamburg",
        "Hochzeitsplanung Hamburg",
      ],
      inLanguage: "de",
    },
    {
      "@type": "ImageGallery",
      "@id": `${pageUrl}#gallery`,
      name: "Hochzeitsmomente in Hamburg",
      image: galleryImages.map((item, index) => ({
        "@type": "ImageObject",
        position: index + 1,
        contentUrl: galleryImageUrls[index],
        width: item.image.width,
        height: item.image.height,
        caption: item.alt,
      })),
      inLanguage: "de",
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="article">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={heroImageUrl}>
    <meta property="og:image:width" content={String(titleImage.width)}>
    <meta property="og:image:height" content={String(titleImage.height)}>
    <meta property="og:image:alt" content={heroImageAlt}>
    <meta property="article:modified_time" content={dateModified}>
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  </head>
  <body class="journal-article-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} siteUrl={siteUrl} currentUrl={pageUrl} />

      <article class="journal-article">
        <header
          class="journal-hero"
          data-track-section="traukalender_hamburg_article_hero"
          data-content-topic="trautermin_hamburg_online_reservieren"
          data-user-intent="termin_finden"
          data-journey-stage="orientierung"
          data-content-format="article_hero"
          data-position="hero"
        >
          <div class="journal-hero__text">
            <p class="eyebrow">Journal</p>
            <h1>{originalCopy.calendarHeading}</h1>
            <p class="lead">{originalCopy.calendarAvailability}</p>
          </div>
          <figure class="journal-hero__image">
            <Image
              src={titleImage}
              alt={heroImageAlt}
              widths={[540, 760, 1080]}
              sizes="(max-width: 900px) calc(100vw - 40px), 420px"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              format="webp"
              quality={88}
            />
          </figure>
        </header>

        <section
          class="intro-note"
          aria-labelledby="kurz-erklaert"
          data-track-section="traukalender_hamburg_kurz_erklaert"
          data-content-topic="standesamttermin_hamburg"
          data-user-intent="kurzantwort_lesen"
          data-journey-stage="orientierung"
          data-content-format="summary_box"
          data-position="after_hero"
        >
          <h2 id="kurz-erklaert">Kurz erklärt:</h2>
          <p>{originalCopy.calendarDescription}</p>
          <a
            class="text-link official-calendar-cta"
            href={officialCalendarUrl}
            target="_blank"
            rel="noopener"
            aria-label="Offiziellen Traukalender der Stadt Hamburg in einem neuen Tab öffnen"
            data-track-event="external_resource_click"
            data-resource-id="traukalender_hamburg"
            data-resource-type="official_city_service"
            data-cta-id="traukalender_hamburg_official"
            data-cta-type="external_official_service"
            data-section-id="traukalender_hamburg_kurz_erklaert"
            data-content-topic="standesamttermin_hamburg"
            data-user-intent="termin_finden"
            data-journey-stage="vor_reservierung"
          >
            {originalCopy.calendarCta}
          </a>
          <a class="text-link intro-note__registry-link" href="/standesamt-hamburg/">
            {originalCopy.registryLink}
          </a>
        </section>

        <div class="article-flow">
          <section
            aria-labelledby="termin-reservieren"
            data-track-section="traukalender_hamburg_reservierung"
            data-content-topic="traukalender_stadt_hamburg"
            data-user-intent="service_verstehen"
            data-journey-stage="orientierung"
            data-content-format="article_section"
            data-position="content_1"
          >
            <p class="eyebrow">Aktueller Hinweis</p>
            <h2 id="termin-reservieren">Reservierung und Anmeldung</h2>
            <p>
              Die Reservierung ersetzt nicht die Anmeldung der Eheschließung. Zuständig ist grundsätzlich das Standesamt am Haupt- oder Nebenwohnsitz einer der beiden Personen.
            </p>
            <p>
              Seit Juli 2026 steht die Online-Terminbuchung in allen sieben Hamburger Bezirken zur Verfügung. Welche Termine aktuell angeboten werden, zeigt der Traukalender.
            </p>
          </section>

          <section
            aria-labelledby="standesamt-kontakt"
            data-track-section="traukalender_hamburg_originaltext_kontakt"
            data-content-topic="standesamt_hamburg_kontakt"
            data-user-intent="standesamt_kontaktieren"
            data-journey-stage="planung"
            data-content-format="article_section"
            data-position="content_2"
          >
            <p class="eyebrow">Trauung im Standesamt</p>
            <h2 id="standesamt-kontakt">Standesämter in Hamburg</h2>
            <p>{originalCopy.reachability}</p>
          </section>

          <section
            class="article-gallery"
            aria-labelledby="hochzeitsmomente-hamburg"
            data-track-section="traukalender_hamburg_bildstrecke"
            data-content-topic="standesamtliche_hochzeit_hamburg"
            data-user-intent="bildsprache_ansehen"
            data-journey-stage="inspiration"
            data-content-format="image_gallery"
            data-position="content_3"
          >
            <p class="eyebrow">Bildstrecke</p>
            <h2 id="hochzeitsmomente-hamburg">Hochzeitsmomente in Hamburg</h2>
            <GalleryImageGrid
              columns={galleryColumns}
              galleryId="trautermin-hamburg-gallery"
              label="Hochzeitsmomente in Hamburg"
              dialogLabel="Hochzeitsmomente in Hamburg in Vollansicht"
              sectionId="traukalender_hamburg_bildstrecke"
              contentTopic="standesamtliche_hochzeit_hamburg"
              userIntent="bildsprache_ansehen"
              journeyStage="inspiration"
              position="content_3"
            />
          </section>

          <section
            class="image-cta"
            aria-labelledby="hochzeitsgeschichten"
            data-track-section="traukalender_hamburg_standesamt_cta"
            data-content-topic="standesamtliche_trauung_hamburg"
            data-user-intent="leistung_pruefen"
            data-journey-stage="entscheidung"
            data-content-format="image_cta"
            data-position="content_4"
          >
            <figure>
              <Image
                src={brideImage}
                alt="Braut lacht nach einer standesamtlichen Trauung in Hamburg"
                widths={[420, 640, 900]}
                sizes="(max-width: 820px) calc(100vw - 40px), 320px"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={90}
              />
            </figure>
            <div>
              <p class="eyebrow">Hochzeitsfotografie</p>
              <h2 id="hochzeitsgeschichten">Hochzeitsgeschichten</h2>
              <p>{originalCopy.storyIntro}</p>
              <p>{originalCopy.storyMeaning}</p>
              <p>{originalCopy.storyClosing}</p>
              <nav class="link-row" aria-label="Weiterführende interne Links">
                <a href="/standesamt-hamburg/">Standesämter in Hamburg</a>
                <a href="/hochzeitsfotograf-preise/">Preise & Leistungen</a>
                <a href="/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/">Standesamt Altona Reportage</a>
                <a href="/kontakt/">Anfrage senden</a>
              </nav>
            </div>
          </section>

          <section
            class="sources-section"
            aria-labelledby="quellen-aktualisierung"
            data-track-section="traukalender_hamburg_quellen"
            data-content-topic="offizielle_quellen_hamburg"
            data-user-intent="quelle_pruefen"
            data-journey-stage="validierung"
            data-content-format="source_list"
            data-position="article_end"
          >
            <p class="eyebrow">Quellen & Aktualisierung</p>
            <h2 id="quellen-aktualisierung">Offizielle Quellen</h2>
            <p>
              Geprüft am <time datetime={dateModified}>09.08.2026</time>. Für Fristen, Unterlagen und Verfügbarkeit gelten die aktuellen Angaben der Stadt Hamburg und des zuständigen Standesamts.
            </p>
            <ul>
              <li><a href={officialCalendarUrl} target="_blank" rel="noopener">Offizieller Traukalender der Stadt Hamburg</a></li>
              <li><a href={onlineBookingNewsUrl} target="_blank" rel="noopener">Hamburg.de Meldung zur Online-Terminbuchung</a></li>
              <li><a href={marriageInfoUrl} target="_blank" rel="noopener">Hamburg.de Information zur Eheschließung</a></li>
              <li><a href={registryOfficeUrl} target="_blank" rel="noopener">Hamburg.de Standesamt / Eheschließung</a></li>
            </ul>
          </section>
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .journal-article-page {
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .journal-article {
    width: min(1180px, calc(100% - 44px));
    margin: 0 auto clamp(82px, 10vw, 150px);
  }

  .journal-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(300px, 0.62fr);
    gap: clamp(36px, 6vw, 84px);
    align-items: end;
    padding: clamp(46px, 6vw, 88px) 0 clamp(46px, 6vw, 82px);
  }

  .journal-hero__text,
  .journal-hero__image {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #7f7972;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .24em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #202633;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.04;
  }

  h1 {
    max-width: 820px;
    font-size: clamp(46px, 6.2vw, 94px);
  }

  h2 {
    font-size: clamp(34px, 4vw, 58px);
  }

  .lead,
  p,
  li {
    color: var(--muted);
    font-size: clamp(18px, 1.32vw, 22px);
    line-height: 1.76;
  }

  .lead {
    max-width: 720px;
    margin: clamp(24px, 3vw, 36px) 0 0;
    font-size: clamp(21px, 1.8vw, 27px);
  }

  .journal-hero__image {
    margin: 0;
  }

  .journal-hero__image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--soft);
  }

  .intro-note,
  .image-cta,
  .sources-section {
    border: 1px solid var(--line);
    background: #f7f3ee;
  }

  .intro-note {
    width: min(900px, 100%);
    margin: 0 auto clamp(64px, 8vw, 112px);
    padding: clamp(24px, 4vw, 42px);
  }

  .intro-note h2 {
    font-size: clamp(26px, 3vw, 40px);
  }

  .intro-note p {
    margin: 16px 0 0;
  }

  .intro-note__registry-link {
    display: flex;
    width: fit-content;
    margin-inline: auto;
    border: 0;
    padding-inline: 4px;
    text-decoration: underline;
    text-underline-offset: .24em;
  }

  .article-flow {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .article-flow > section + section {
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: clamp(48px, 6vw, 82px);
    border-top: 1px solid var(--line);
  }

  .article-flow p {
    max-width: 820px;
    margin: 24px 0 0;
  }

  .article-gallery :global(.gallery-image-grid) {
    width: 100%;
    margin: clamp(34px, 5vw, 56px) 0 0;
  }

  .text-link,
  .link-row a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 12px;
    padding: 13px 18px;
    border: 1px solid #202633;
    color: #202633;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .15em;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .text-link:focus-visible,
  .link-row a:focus-visible,
  .sources-section a:focus-visible {
    outline: 2px solid #202633;
    outline-offset: 5px;
  }

  .official-calendar-cta {
    display: flex;
    width: min(100%, 380px);
    min-height: 54px;
    margin: 20px auto 0;
    padding: 14px 22px;
    border-color: rgba(32, 38, 51, .72);
    background: #fff;
    box-shadow: 0 10px 28px rgba(32, 38, 51, .05);
    transition:
      color 220ms ease,
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
    animation: official-calendar-cta-attention 1100ms cubic-bezier(.22, 1, .36, 1) 650ms 1 both;
  }

  .official-calendar-cta::after {
    content: "\2197";
    flex: 0 0 auto;
    margin-left: 12px;
    font-size: 15px;
    line-height: 1;
    transition: transform 220ms ease;
  }

  .official-calendar-cta:hover,
  .official-calendar-cta:focus-visible {
    border-color: #202633;
    background: #202633;
    color: #fff;
    box-shadow: 0 14px 32px rgba(32, 38, 51, .14);
    transform: translateY(-2px);
  }

  .official-calendar-cta:hover::after,
  .official-calendar-cta:focus-visible::after {
    transform: translate(2px, -2px);
  }

  @keyframes official-calendar-cta-attention {
    0% {
      box-shadow: 0 10px 28px rgba(32, 38, 51, .05);
      transform: translateY(8px);
    }

    48% {
      box-shadow: 0 14px 32px rgba(32, 38, 51, .12);
      transform: translateY(0);
    }

    72% {
      box-shadow: 0 16px 36px rgba(32, 38, 51, .15);
      transform: translateY(-2px);
    }

    100% {
      box-shadow: 0 10px 28px rgba(32, 38, 51, .05);
      transform: translateY(0);
    }
  }

  .image-cta {
    display: grid;
    grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 58px);
    align-items: center;
    padding: clamp(20px, 3vw, 34px);
  }

  .image-cta figure {
    margin: 0;
  }

  .image-cta img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--soft);
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(20px, 3vw, 30px);
  }

  .sources-section {
    padding: clamp(22px, 3vw, 34px);
  }

  .sources-section h2 {
    font-size: clamp(28px, 3vw, 40px);
  }

  .sources-section ul {
    display: grid;
    gap: 10px;
    margin: 20px 0 0;
    padding-left: 1.1em;
  }

  .sources-section li,
  .sources-section p,
  .sources-section a {
    font-size: clamp(15px, 1.05vw, 17px);
    line-height: 1.65;
  }

  .sources-section a {
    color: #202633;
    text-decoration-thickness: 1px;
    text-underline-offset: .18em;
  }

  @media (max-width: 900px) {
    .journal-article {
      width: min(100%, calc(100% - 40px));
    }

    .journal-hero,
    .image-cta {
      grid-template-columns: 1fr;
    }

    .journal-hero {
