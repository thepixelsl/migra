---
import FaviconHead from "../components/FaviconHead.astro";
import MobileNavigation from "../components/MobileNavigation.astro";
import DesktopNavigation from "../components/DesktopNavigation.astro";
import GalleryMasonryEnhancer from "../components/GalleryMasonryEnhancer.astro";
import NdFilterTable from "../components/NdFilterTable.astro";
import migratedPages from "../data/migratedPages.json";
import { modernizePrivacyContent } from "../lib/privacyContent";
import { getMigratedSeoPolicy } from "../lib/migratedSeoPolicy";
import { sanitizeMigratedHtml } from "../../scripts/lib/sanitize-migrated-html.mjs";
import "../styles/gallery-masonry.css";
import "../styles/global.css";

type MigratedImage = {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  eager?: boolean;
};

type MigratedPage = {
  path: string;
  sourceUrl: string;
  type: string;
  title: string;
  metaTitle: string;
  description: string;
  eyebrow: string;
  datePublished?: string;
  dateModified?: string;
  heroImage?: MigratedImage;
  contentHtml: string;
  galleryImages: MigratedImage[];
  keywords: string[];
};

export function getStaticPaths() {
  const dedicatedPaths = new Set([
    "/about/",
    "/blog/",
    "/braut-fotoshooting-fraser-suites-hamburg/",
    "/newsletter/",
    "/standesamt-hamburg/",
  ]);

  return (migratedPages as MigratedPage[])
    .filter((page) => !dedicatedPaths.has(page.path))
    .map((page) => ({
      params: {
        slug: page.path.replace(/^\/|\/$/g, ""),
      },
      props: { page },
    }));
}

const { page } = Astro.props as { page: MigratedPage };
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const seoPolicy = getMigratedSeoPolicy(page.path);
const pageUrl = `${siteUrl}${page.path}`;
const canonicalUrl = `${siteUrl}${seoPolicy.canonicalPath}`;
const isGallery = page.path.startsWith("/gallery/");
const heroTitleLines =
  page.path === "/gallery/engagement-shooting-in-hamburg/"
    ? ["Paarshooting", "in Hamburg"]
    : undefined;
const isStandesamtHamburgPage = page.path === "/standesamt-hamburg/";
const isNdFilterTablePage = page.path === "/nd-filter-tabelle/";
const isWeddingPhotoBackupPage = page.path === "/wie-sollte-man-hochzeitsfotos-sichern/";
const isLargeEnough = (image?: MigratedImage) =>
  Boolean(image?.width && image?.height && image.width >= 480 && image.height >= 280);
const getImageArea = (image: MigratedImage) => (image.width ?? 0) * (image.height ?? 0);
const getWordPressImageFamily = (src: string) =>
  src.replace(/-\d+x\d+(?=\.[a-z0-9]+$)/i, "");
const selectLargestImagePerFamily = (images: MigratedImage[]) => {
  const imageFamilies = new Map<string, MigratedImage>();

  for (const image of images) {
    const family = getWordPressImageFamily(image.src);
    const current = imageFamilies.get(family);

    if (!current || getImageArea(image) > getImageArea(current)) {
      imageFamilies.set(family, image);
    }
  }

  return [...imageFamilies.values()];
};
const gentlemenExcludedImageStems = [
  "bct-cloudflare-turnstile",
  "cb-facebook",
  "York-Augustin-Black",
  "York-Augustin-White",
  "ART_3680-Bearbeitet-Wiederhergestellt_web",
  "ART_6078-Bearbeitet_web",
  "ART_5111-Bearbeitet_web",
  "ART_6065-Bearbeitet_web",
];
const gentlemenGalleryImages = selectLargestImagePerFamily(
  page.galleryImages.filter(
    (image) =>
      !gentlemenExcludedImageStems.some((stem) => image.src.includes(stem)),
  ),
);
const heroImage = isLargeEnough(page.heroImage) ? page.heroImage : undefined;
const galleryImages = isGallery
  ? page.path === "/gallery/gentlemen/"
    ? gentlemenGalleryImages
    : page.galleryImages
  : page.galleryImages.filter((image) => isLargeEnough(image));
const hasGallery = galleryImages.length > 0;
const normalizedContentHtml = sanitizeMigratedHtml(page.contentHtml).replace(
  /\b(href|action)=["']https?:\/\/(?:www\.)?artbild-fotografie\.(?:de|ch)(\/[^"']*)?["']/gi,
  (_match, attribute, path = "/") => `${attribute}="${path}"`,
);
const contentHtml = modernizePrivacyContent(page.path, normalizedContentHtml);
const contentDateModified = ["/datenschutz/", "/datenschutzerklaerung/"].includes(page.path)
  ? "2026-08-17T00:00:00+02:00"
  : page.dateModified;
const primaryImage = heroImage
  ? `${siteUrl}${heroImage.src}`
  : `${siteUrl}/images/cropped-hochzeitsreportage_hamburg_festpreis-scaled-1.jpg`;
const gallerySchemaId = `${pageUrl}#gallery`;
const galleryImageObjects = galleryImages.map((image, index) => ({
  "@type": "ImageObject",
  position: index + 1,
  contentUrl: `${siteUrl}${image.src}`,
  width: image.width,
  height: image.height,
  caption: image.alt,
}));
const hasSupplementalGallery = hasGallery && !isGallery;
const articleImages = [
  primaryImage,
  ...galleryImageObjects.map((image) => image.contentUrl),
].filter((image, index, images) => images.indexOf(image) === index);
const breadcrumbLabel = isGallery ? "Galerie" : page.type === "post" ? "Blog" : "Seite";
const getImageOrientation = (image: MigratedImage) => {
  if (!image.width || !image.height) return "natural";
  if (Math.abs(image.width - image.height) < 8) return "square";
  return image.width > image.height ? "landscape" : "portrait";
};
const getGalleryImageStyle = (image: MigratedImage) => {
  const aspectWidth = image.width ?? 4;
  const aspectHeight = image.height ?? 3;

  return `--image-aspect: ${aspectWidth} / ${aspectHeight}`;
};

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      url: siteUrl,
      email: "info@artbild-fotografie.de",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
      ],
      serviceType: ["Hochzeitsfotografie", "Portraitfotografie", "Reisefotografie"],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Startseite", item: siteUrl },
        {
          "@type": "ListItem",
          position: 2,
          name: breadcrumbLabel,
          item: isGallery ? `${siteUrl}/portfolio/` : `${siteUrl}/blog/`,
        },
        { "@type": "ListItem", position: 3, name: page.title, item: pageUrl },
      ],
    },
    {
      "@type": isGallery ? "ImageGallery" : page.type === "post" ? "Article" : "WebPage",
      "@id": `${pageUrl}#primary`,
      url: pageUrl,
      name: page.metaTitle,
      headline: page.title,
      description: page.description,
      keywords: page.keywords,
      datePublished: page.datePublished,
      dateModified: contentDateModified,
      image: articleImages,
      ...(hasSupplementalGallery ? { hasPart: { "@id": gallerySchemaId } } : {}),
      mainEntityOfPage: {
        "@id": `${pageUrl}#webpage`,
      },
      author: {
        "@type": "Person",
        name: "York Augustin",
      },
      publisher: {
        "@id": `${siteUrl}/#organization`,
      },
      inLanguage: "de",
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: page.metaTitle,
      description: page.description,
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: heroImage?.width,
        height: heroImage?.height,
      },
      inLanguage: "de",
    },
    ...(hasSupplementalGallery
      ? [{
          "@type": "ImageGallery",
          "@id": gallerySchemaId,
          name: `Bildgalerie zu ${page.title}`,
          image: galleryImageObjects,
          inLanguage: "de",
        }]
      : []),
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{page.metaTitle}</title>
    <meta name="description" content={page.description}>
    <meta name="robots" content={seoPolicy.robots}>
    <link rel="canonical" href={canonicalUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content={page.type === "post" ? "article" : "website"}>
    <meta property="og:title" content={page.metaTitle}>
    <meta property="og:description" content={page.description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    {heroImage?.width && <meta property="og:image:width" content={String(heroImage.width)}>}
    {heroImage?.height && <meta property="og:image:height" content={String(heroImage.height)}>}
    <meta property="og:image:alt" content={heroImage?.alt ?? page.title}>
    <meta name="twitter:card" content="summary_large_image">
    {seoPolicy.indexable && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
    )}
  </head>
  <body class="migrated-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <article class:list={["migrated-article", { "is-gallery": isGallery, "is-post": page.type === "post", "is-nd-filter-table": isNdFilterTablePage }]}>
        <nav class="migrated-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Startseite</a>
          <span aria-hidden="true">/</span>
          <a href={isGallery ? "/portfolio/" : "/blog/"}>{breadcrumbLabel}</a>
          <span aria-hidden="true">/</span>
          <span>{page.title}</span>
        </nav>

        <header class:list={["migrated-hero", { "has-no-image": !heroImage }]}>
          <div>
            <p class="migrated-kicker">{page.eyebrow}</p>
            <h1 class:list={{ "has-controlled-lines": heroTitleLines }}>
              {heroTitleLines
                ? heroTitleLines.map((line, index) => (
                    <span>{line}{index < heroTitleLines.length - 1 ? " " : ""}</span>
                  ))
                : page.title}
            </h1>
            <p>{page.description}</p>
          </div>

          {heroImage && (
            <figure>
              <img
                src={heroImage.src}
                width={heroImage.width}
                height={heroImage.height}
                alt={heroImage.alt}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              >
            </figure>
          )}
        </header>

        {isStandesamtHamburgPage && (
          <aside
            class="standesamt-planning-note"
            aria-label="Hinweis zum Traukalender der Stadt Hamburg"
            data-track-section="standesamt_hamburg_traukalender_note"
            data-content-topic="standesamttermin_hamburg"
            data-user-intent="termin_finden"
            data-journey-stage="vor_reservierung"
            data-content-format="info_box"
            data-position="after_hero"
          >
            <div>
              <p class="migrated-kicker">Traukalender Stadt Hamburg</p>
              <p>
                Freie Trautermine können für alle Standesämter hamburgweit online reserviert werden.
              </p>
            </div>
            <a
              href="/trautermin-hamburg-online-reservieren/"
              data-track-event="cta_click"
              data-cta-id="standesamt_hamburg_traukalender_guide"
              data-cta-type="internal_guide_link"
              data-section-id="standesamt_hamburg_traukalender_note"
              data-content-topic="standesamttermin_hamburg"
              data-user-intent="ratgeber_lesen"
              data-journey-stage="vor_reservierung"
            >
              Freie Trautermine in Hamburg online prüfen und buchen
            </a>
          </aside>
        )}

        {isNdFilterTablePage && <NdFilterTable />}

        <section class="migrated-content" aria-label="Inhalt">
          <div set:html={contentHtml}></div>
        </section>

        {hasGallery && (
          <section class="migrated-gallery" aria-labelledby="migrated-gallery-title">
            <p class="migrated-kicker">Bildstrecke</p>
            <h2 id="migrated-gallery-title">{isGallery || page.type === "post" ? "Bildgalerie" : "Bilder zur Seite"}</h2>
            <div class="migrated-gallery__grid masonry-gallery" data-masonry-gallery>
              {galleryImages.map((image, index) => (
                <figure
                  class={`masonry-gallery__item is-${getImageOrientation(image)}`}
                  style={getGalleryImageStyle(image)}
                  data-gallery-index={index}
                  data-masonry-item
                  data-masonry-width={image.width ?? 4}
                  data-masonry-height={image.height ?? 3}
                >
                  <img
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt={image.alt}
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={index === 0 ? "high" : "auto"}
                  >
                </figure>
              ))}
            </div>
          </section>
        )}

        {isWeddingPhotoBackupPage && (
          <aside
            class="migrated-funnel"
            aria-labelledby="migrated-funnel-title"
            data-track-section="hochzeitsfotos_sichern_funnel"
            data-content-topic="hochzeitsfotografie_hamburg"
            data-user-intent="hochzeitsfotograf_pruefen"
            data-journey-stage="orientierung"
            data-content-format="cta_section"
            data-position="after_article"
          >
            <div>
              <p class="migrated-kicker">Von der Sicherung zur Reportage</p>
              <h2 id="migrated-funnel-title">Hochzeitsreportagen und Leistungen entdecken</h2>
            </div>
            <nav aria-label="Nächste Schritte zur Hochzeitsreportage">
              <a
                href="/portfolio/"
                data-track-event="cta_click"
                data-cta-id="hochzeitsfotos_sichern_portfolio"
                data-cta-type="portfolio_link"
                data-section-id="hochzeitsfotos_sichern_funnel"
                data-content-topic="hochzeitsreportage_hamburg"
                data-user-intent="beispielbilder_ansehen"
                data-journey-stage="auswahl"
              >Fertige Hochzeitsreportagen ansehen</a>
              <a
                href="/hochzeitsfotograf-preise/"
                data-track-event="cta_click"
                data-cta-id="hochzeitsfotos_sichern_preise"
                data-cta-type="pricing_link"
                data-section-id="hochzeitsfotos_sichern_funnel"
                data-content-topic="preise_pakete"
                data-user-intent="preise_pruefen"
                data-journey-stage="vergleich"
              >Pakete und Leistungen ansehen</a>
            </nav>
          </aside>
        )}

        <footer class="migrated-footer">
          <a href="/portfolio/">Portfolio ansehen</a>
          <a href="/sicherer-kontakt/">Kontakt aufnehmen</a>
        </footer>
        {hasGallery && <GalleryMasonryEnhancer />}
      </article>
    </main>
  </body>
</html>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .migrated-page {
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .migrated-page main {
    padding: clamp(48px, 6vw, 94px) 0 clamp(70px, 8vw, 130px);
  }

  .migrated-article {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .migrated-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: clamp(46px, 7vw, 94px);
    color: #8a837b;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .18em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  .migrated-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .migrated-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 520px);
    gap: clamp(34px, 6vw, 92px);
    align-items: center;
    margin-bottom: clamp(44px, 7vw, 96px);
  }

  .migrated-hero.has-no-image {
    display: block;
    width: min(860px, 100%);
  }

  .migrated-hero > div,
  .migrated-hero figure {
    min-width: 0;
  }

  .migrated-kicker {
    margin: 0 0 20px;
    color: #7f7972;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .26em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  .migrated-hero h1 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(58px, 7vw, 116px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: .98;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-wrap: balance;
  }

  .migrated-hero h1.has-controlled-lines {
    font-size: clamp(58px, 5.2vw, 90px);
  }

  .migrated-hero h1.has-controlled-lines span {
    display: block;
  }

  .migrated-hero p:not(.migrated-kicker) {
    max-width: 650px;
    margin: 28px 0 0;
    color: #77706a;
    font-size: clamp(20px, 2.1vw, 30px);
    line-height: 1.65;
  }

  .migrated-hero figure {
    margin: 0;
  }

  .migrated-hero img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .migrated-article.is-nd-filter-table .migrated-hero img {
    aspect-ratio: auto;
    object-fit: contain;
  }

  .migrated-content {
    width: min(820px, 100%);
    margin: 0 auto;
    color: #5f5953;
    font-size: clamp(20px, 1.8vw, 25px);
    line-height: 1.8;
  }

  .standesamt-planning-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(22px, 4vw, 46px);
    align-items: center;
    width: min(980px, 100%);
    margin: 0 auto clamp(46px, 6vw, 82px);
    padding: clamp(22px, 3.5vw, 38px);
    border: 1px solid var(--line);
    background: #f7f3ee;
  }

  .standesamt-planning-note p:not(.migrated-kicker) {
    max-width: 700px;
    margin: 0;
    color: #6f6a64;
    font-size: clamp(18px, 1.35vw, 22px);
    line-height: 1.72;
  }

  .standesamt-planning-note .migrated-kicker {
    margin-bottom: 12px;
  }

  .standesamt-planning-note a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 13px 18px;
    border: 1px solid #202633;
    color: #202633;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .15em;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .standesamt-planning-note a:focus-visible {
    outline: 2px solid #202633;
    outline-offset: 5px;
  }

  .migrated-content :global(h1),
  .migrated-content :global(h2),
  .migrated-content :global(h3) {
    margin: 2.2em 0 .65em;
    color: var(--ink);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .migrated-content :global(h1) {
    font-size: clamp(42px, 5vw, 72px);
  }

  .migrated-content :global(h2) {
    font-size: clamp(34px, 4vw, 56px);
  }

  .migrated-content :global(h3) {
    font-size: clamp(26px, 3vw, 38px);
  }

  .migrated-content :global(p),
  .migrated-content :global(ul),
  .migrated-content :global(ol),
  .migrated-content :global(blockquote) {
    margin: 0 0 1.25em;
  }

  .migrated-content :global(ul),
  .migrated-content :global(ol) {
    padding-left: 1.1em;
  }

  .migrated-content :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: .22em;
  }

  .migrated-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 18px;
  }

  .migrated-content :global(td),
  .migrated-content :global(th) {
    padding: 10px 12px;
    border: 1px solid var(--line);
  }

  .migrated-gallery {
    margin-top: clamp(58px, 8vw, 120px);
  }

  .migrated-gallery > .migrated-kicker,
  .migrated-gallery h2 {
    width: min(820px, 100%);
    margin-right: auto;
    margin-left: auto;
  }

  .migrated-gallery h2 {
    margin-top: 0;
    margin-bottom: 34px;
    font-size: clamp(42px, 5vw, 72px);
    font-weight: 400;
    line-height: 1.05;
  }

  .migrated-gallery > div {
    width: 89.0625vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .migrated-article.is-gallery .migrated-gallery,
  .migrated-article.is-post .migrated-gallery {
    width: min(1320px, 100%);
    margin-right: auto;
    margin-left: auto;
  }

  .migrated-gallery figure {
    margin: 0;
    background: transparent;
  }

  .migrated-gallery img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--image-aspect, auto);
    object-fit: contain;
  }

  .migrated-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    margin-top: clamp(58px, 8vw, 118px);
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }

  .migrated-funnel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, .8fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: center;
    margin-top: clamp(58px, 8vw, 118px);
    padding: clamp(34px, 4vw, 52px) 0;
    border-block: 1px solid var(--line);
  }

  .migrated-funnel h2 {
    margin: 0;
    font-size: clamp(30px, 3.5vw, 48px);
    font-weight: 400;
    line-height: 1.12;
  }

  .migrated-funnel nav {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .migrated-funnel a {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
