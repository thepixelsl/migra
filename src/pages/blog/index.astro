---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import migratedPages from "../../data/migratedPages.json";
import { isMigratedPageIndexable } from "../../lib/migratedSeoPolicy";
import "../../styles/global.css";
import trauterminCardImage from "../../assets/trautermin-hamburg-online-reservieren/trautermin-hamburg-editorial-paar.jpg";
import fraserCardImage from "../../assets/hochzeitsfotos-hamburg/b7165c174eaf06f9.jpg";

type MigratedImage = {
  src: string;
  alt: string;
  width?: number;
  height?: number;
};

type MigratedPost = {
  path: string;
  type: string;
  title: string;
  metaTitle?: string;
  description: string;
  eyebrow?: string;
  contentHtml?: string;
  datePublished?: string;
  heroImage?: MigratedImage;
};

const canonicalSiteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/blog/";
const pageUrl = `${canonicalSiteUrl}${pagePath}`;
const archivePage = (migratedPages as MigratedPost[]).find(
  (entry) => entry.path === pagePath && entry.type === "archive",
);
const title = archivePage?.metaTitle ?? "Blog | Artbild-Fotografie";
const description =
  archivePage?.description ??
  "Blog von Artbild-Fotografie mit Planungstipps, Hochzeitsreportagen und Fotografie-Archiv aus Hamburg.";
const journalEyebrow = archivePage?.eyebrow ?? "Journal";
const journalIntro =
  archivePage?.contentHtml
    ?.match(/<p>(.*?)<\/p>/s)?.[1]
    ?.replace(/<[^>]+>/g, "")
    .trim() ??
  "Planungstipps, Fotogeschichten und technische Notizen aus dem Archiv von Artbild-Fotografie.";
const trauterminCardImageAlt = "Brautpaar in festlicher Kleidung im Gegenlicht am Wasser";
const socialImageUrl = new URL(trauterminCardImage.src, `${canonicalSiteUrl}/`).toString();

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Blog", href: pagePath },
];

const technicalPostPaths = new Set([
  "/bildoptimierung-fuer-wordpress-2025/",
  "/bildoptimierung-in-wordpress-2025/",
  "/luminanzmasken-photoshop-aktion/",
  "/nd-filter-tabelle/",
]);
const travelPostPaths = new Set([
  "/location-scouting-in-paris/",
  "/unterwegs-in-baden-wuerttemberg/",
]);
const getPostCategory = (path: string) => {
  if (technicalPostPaths.has(path)) return "Technik & Bildbearbeitung";
  if (travelPostPaths.has(path)) return "Unterwegs & Editorial";
  return "Hochzeit & Planung";
};
const dedicatedPostCardImages: Record<string, MigratedImage> = {
  "/braut-fotoshooting-fraser-suites-hamburg/": {
    src: fraserCardImage.src,
    alt: "Brautportrait in den Fraser Suites Hamburg",
    width: fraserCardImage.width,
    height: fraserCardImage.height,
  },
};
const getPublishedTimestamp = (date?: string) => {
  if (!date) return 0;
  const timestamp = Date.parse(date);
  return Number.isNaN(timestamp) ? 0 : timestamp;
};
const formatPublishedDate = (date?: string) => {
  if (!date) return undefined;
  const timestamp = getPublishedTimestamp(date);
  if (!timestamp) return undefined;

  return new Intl.DateTimeFormat("de-DE", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(timestamp);
};
const blogPosts = (migratedPages as MigratedPost[])
  .filter(
    (entry) => entry.type === "post" && isMigratedPageIndexable(entry.path),
  )
  .sort(
    (left, right) =>
      getPublishedTimestamp(right.datePublished) - getPublishedTimestamp(left.datePublished),
  )
  .map((entry) => ({
    ...entry,
    category: getPostCategory(entry.path),
    formattedDate: formatPublishedDate(entry.datePublished),
    cardImage:
      dedicatedPostCardImages[entry.path] ??
      (entry.heroImage?.width &&
      entry.heroImage?.height &&
      entry.heroImage.width >= 480 &&
      entry.heroImage.height >= 280
        ? entry.heroImage
        : undefined),
  }));

const collectionItems = [
  {
    url: `${canonicalSiteUrl}/trautermin-hamburg-online-reservieren/`,
    name: "Traukalender der Stadt Hamburg",
  },
  ...blogPosts.map((post) => ({
    url: `${canonicalSiteUrl}${post.path}`,
    name: post.title,
  })),
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  isPartOf: {
    "@type": "WebSite",
    "@id": `${canonicalSiteUrl}/#website`,
    name: "Artbild-Fotografie",
    url: `${canonicalSiteUrl}/`,
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: collectionItems.length,
    itemListElement: collectionItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      ...item,
    })),
  },
  inLanguage: "de",
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={socialImageUrl}>
    <meta property="og:image:alt" content={trauterminCardImageAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImageUrl}>
    <meta name="twitter:image:alt" content={trauterminCardImageAlt}>
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  </head>
  <body class="journal-index-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} siteUrl={canonicalSiteUrl} currentUrl={pageUrl} />

      <section
        class="journal-index"
        aria-labelledby="journal-title"
        data-track-section="blog_index"
        data-content-topic="fotografie_hochzeit_reisen_editorial"
        data-user-intent="inspiration_und_information_finden"
        data-journey-stage="orientierung"
        data-content-format="blog_index"
        data-position="main"
      >
        <header class="journal-masthead">
          <p class="eyebrow">{journalEyebrow}</p>
          <h1 id="journal-title">Blog</h1>
          <p class="journal-intro">{journalIntro}</p>
        </header>

        <a
          class="pinned-post"
          href="/trautermin-hamburg-online-reservieren/"
          aria-label="Zum Artikel Traukalender der Stadt Hamburg"
          data-track-event="cta_click"
          data-cta-id="blog_index_traukalender_hamburg"
          data-cta-type="internal_article_link"
          data-section-id="blog_index"
          data-content-topic="traukalender_hamburg"
          data-user-intent="termin_finden"
          data-journey-stage="orientierung"
        >
          <span class="pinned-post__media">
            <Image
              src={trauterminCardImage}
              alt={trauterminCardImageAlt}
              widths={[420, 640, 900]}
              sizes="(max-width: 900px) calc(100vw - 40px), 520px"
              loading="eager"
              decoding="async"
              format="webp"
              quality={86}
            />
          </span>
          <span class="pinned-post__body">
            <span class="pinned-post__label">Aktuell</span>
            <strong>Traukalender der Stadt Hamburg</strong>
            <span class="pinned-post__description">
              Freie Trautermine können für alle Standesämter hamburgweit online reserviert werden.
            </span>
            <span class="pinned-post__cta">Zum Artikel</span>
          </span>
        </a>

        <section class="journal-archive" aria-labelledby="journal-archive-title">
          <div class="journal-archive__heading">
            <p class="eyebrow">Archiv</p>
            <h2 id="journal-archive-title">Alle Beiträge</h2>
            <p>{blogPosts.length} Artikel aus dem bisherigen Blog.</p>
          </div>

          <div class="journal-posts">
            {blogPosts.map((post, index) => {
              const titleId = `blog-post-${index + 1}`;

              return (
                <article
                  class:list={["journal-card", { "has-image": post.cardImage }]}
                  aria-labelledby={titleId}
                >
                  <a class="journal-card__link" href={post.path} aria-labelledby={titleId}>
                    {post.cardImage && (
                      <span class="journal-card__image">
                        <img
                          src={post.cardImage.src}
                          width={post.cardImage.width}
                          height={post.cardImage.height}
                          alt={post.cardImage.alt}
                          loading="lazy"
                          decoding="async"
                        >
                      </span>
                    )}
                    <div class="journal-card__body">
                      <span class="journal-card__meta">
                        <span>{post.category}</span>
                        {post.formattedDate && post.datePublished && (
                          <time datetime={post.datePublished}>{post.formattedDate}</time>
                        )}
                      </span>
                      <h3 id={titleId}>{post.title}</h3>
                      <span class="journal-card__description">{post.description}</span>
                      <span class="journal-card__cta">Beitrag lesen</span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      </section>
    </main>
  </body>
</html>

<style>
  .journal-index-page {
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .journal-index {
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto clamp(96px, 12vw, 168px);
    padding: clamp(50px, 7vw, 88px) 0 0;
  }

  .journal-masthead {
    display: flex;
    max-width: 700px;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    padding-bottom: clamp(84px, 10vw, 126px);
    text-align: center;
  }

  .journal-masthead::after {
    width: 54px;
    height: 1px;
    margin-top: clamp(30px, 4vw, 42px);
    background: #c9c0b6;
    content: "";
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #6f6962;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .32em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #252932;
    font-family: "Bestermind", "Playfair Display", Georgia, serif;
    font-size: clamp(48px, 6vw, 68px);
    font-weight: 400;
    letter-spacing: .01em;
    line-height: 1.12;
  }

  .journal-intro {
    max-width: 610px;
    margin: clamp(20px, 2.5vw, 28px) 0 0;
    color: var(--muted);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.8;
  }

  .pinned-post {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, .92fr);
    gap: clamp(50px, 8vw, 108px);
    align-items: center;
    padding: 0;
    color: inherit;
    text-decoration: none;
  }

  .pinned-post__media {
    display: block;
    width: min(100%, 520px);
    overflow: hidden;
    justify-self: start;
    background: #f3efe9;
  }

  .pinned-post__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 500ms ease;
  }

  .pinned-post__label,
  .pinned-post__cta {
    color: #70665e;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .28em;
    text-transform: uppercase;
  }

  .pinned-post__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .pinned-post__body strong {
    max-width: 440px;
    color: #252932;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(28px, 3vw, 37px);
    font-weight: 400;
    letter-spacing: .02em;
    line-height: 1.18;
  }

  .pinned-post__description {
    max-width: 420px;
    color: var(--muted);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.7;
  }

  .pinned-post__cta {
    margin-top: 14px;
    color: #70665e;
    text-decoration: underline;
    text-decoration-color: #a89c90;
    text-underline-offset: 7px;
  }

  .pinned-post:hover .pinned-post__media :global(img) {
    transform: scale(1.012);
  }

  .pinned-post:focus-visible {
    outline: 2px solid #202633;
    outline-offset: 10px;
  }

  .journal-archive {
    margin-top: clamp(110px, 14vw, 180px);
  }

  .journal-archive__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(70px, 9vw, 112px);
    text-align: center;
  }

  .journal-archive__heading .eyebrow {
    margin-bottom: 14px;
  }

  .journal-archive__heading h2 {
    margin: 0;
    color: #252932;
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: .02em;
    line-height: 1.12;
  }

  .journal-archive__heading > p:last-child {
    margin: 18px 0 0;
    color: #6f6962;
    font-size: 14px;
  }

  .journal-posts {
    display: grid;
    gap: clamp(82px, 9vw, 120px);
  }

  .journal-card {
    min-width: 0;
  }

  .journal-card__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .92fr);
    gap: clamp(48px, 8vw, 104px);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .journal-card:nth-child(even) .journal-card__image {
    grid-column: 2;
    grid-row: 1;
  }

  .journal-card:nth-child(even) .journal-card__body {
    grid-column: 1;
    grid-row: 1;
  }

  .journal-card__image {
    display: block;
    overflow: hidden;
    background: #f3efe9;
  }

  .journal-card__image img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 300ms ease, transform 500ms ease;
  }

  .journal-card__link:hover .journal-card__image img {
    opacity: .96;
    transform: scale(1.01);
  }

  .journal-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(16px, 3vw, 48px) 0;
    text-align: center;
  }

  .journal-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 14px;
    color: #70665e;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .journal-card h3 {
    max-width: 480px;
    margin: 22px 0 0;
    color: #252932;
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 400;
    letter-spacing: .02em;
    line-height: 1.3;
  }

  .journal-card__description {
    display: -webkit-box;
    max-width: 440px;
    overflow: hidden;
    margin: 22px 0 30px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .journal-card__cta {
    color: #202633;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .28em;
    text-decoration: underline;
    text-decoration-color: #a89c90;
    text-underline-offset: 7px;
    text-transform: uppercase;
  }

  .journal-card__link:focus-visible {
    outline: 2px solid #202633;
    outline-offset: 10px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pinned-post__media :global(img),
    .journal-card__image img {
      transition: none;
    }

    .pinned-post:hover .pinned-post__media :global(img),
    .journal-card__link:hover .journal-card__image img {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .journal-index {
      width: min(100%, calc(100% - 40px));
      padding-top: 40px;
    }

    .pinned-post,
    .journal-card__link {
      grid-template-columns: 1fr;
      gap: 30px;
      min-height: 0;
    }

    .pinned-post__media {
      justify-self: center;
    }

    .journal-card:nth-child(even) .journal-card__image,
    .journal-card:nth-child(even) .journal-card__body {
      grid-column: 1;
      grid-row: auto;
    }

    .journal-card__image {
      width: 100%;
      justify-self: center;
    }

    .journal-card__body {
      padding: 8px clamp(8px, 5vw, 36px) 0;
    }
  }

  @media (max-width: 520px) {
    .journal-index {
      width: min(100%, calc(100% - 32px));
    }

    .journal-masthead {
      padding-bottom: 72px;
    }

    .journal-masthead::after {
      margin-top: 28px;
    }

    .pinned-post {
      gap: 26px;
    }

    .pinned-post__body {
      padding: 0 8px;
    }

    .pinned-post__cta {
      margin-top: 6px;
    }

    .journal-archive {
      margin-top: 104px;
    }

    .journal-archive__heading {
      margin-bottom: 70px;
    }

    .journal-posts {
      gap: 64px;
    }

    .journal-card__link {
      gap: 26px;
    }

    .journal-card__description {
      margin-bottom: 26px;
    }
  }
</style>
