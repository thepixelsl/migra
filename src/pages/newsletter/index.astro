---
import { Image } from "astro:assets";
import FaviconHead from "../../components/FaviconHead.astro";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import heroImage from "../../assets/editorial/ART_6856-Bearbeitet.jpg";
import coupleImage from "../../assets/portfolio/lovebirds-elbstrand.jpg";
import "../../styles/global.css";

const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/newsletter/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "TFP Shootings Hamburg: aktuelle Ausschreibungen | Artbild-Fotografie";
const description =
  "Aktuelle TFP-Ausschreibungen von Artbild-Fotografie für Models, Schauspieler und Paare in Hamburg auf tfp.hamburg ansehen.";
const tfpUrl = "https://tfp.hamburg/termine/";
const conditionsUrl = "https://tfp.hamburg/konditionen/";
const primaryImage = new URL(heroImage.src, siteUrl).href;

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "TFP Shootings", href: pagePath },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      dateModified: "2026-08-31T00:00:00+02:00",
      about: [
        { "@type": "Thing", name: "TFP Shootings Hamburg" },
        { "@type": "Thing", name: "Model Calls Hamburg" },
        { "@type": "Thing", name: "Paarshootings Hamburg" },
      ],
      mainEntity: {
        "@type": "WebPage",
        name: "Aktuelle TFP-Ausschreibungen auf tfp.hamburg",
        url: tfpUrl,
      },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: heroImage.width,
        height: heroImage.height,
      },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      isPartOf: { "@id": `${siteUrl}/#website` },
      inLanguage: "de",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.label,
        item: new URL(item.href, siteUrl).href,
      })),
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      url: siteUrl,
      email: "info@artbild-fotografie.de",
      founder: { "@type": "Person", name: "York Augustin" },
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      serviceType: ["Hochzeitsfotografie", "Portraitfotografie", "TFP Shootings"],
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={heroImage.width}>
    <meta property="og:image:height" content={heroImage.height}>
    <meta property="og:image:alt" content="Editoriales Portrait als Beispiel für ein TFP-Shooting in Hamburg">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={primaryImage}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template tfp-landing-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main id="main-content">
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />

      <article class="tfp-landing">
        <header class="tfp-hero">
          <div class="tfp-hero__copy">
            <p class="tfp-script" aria-hidden="true">Time for pictures</p>
            <p class="tfp-kicker">TFP Shootings · Hamburg</p>
            <h1>Aktuelle TFP-Ausschreibungen</h1>
            <p class="tfp-hero__lead">
              Neue Bildideen brauchen Menschen, die Lust auf besondere Fotos und
              gemeinsame kreative Projekte haben. Alle offenen TFP-Shootings,
              Termine und Teilnahmebedingungen findest Du gesammelt auf tfp.hamburg.
            </p>
            <div class="tfp-actions">
              <a
                class="tfp-button tfp-button--primary"
                href={tfpUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track-event="cta_click"
                data-cta-id="tfp_hero_current_castings"
                data-cta-type="external_casting_board"
                data-section-id="tfp_hero"
                data-content-topic="tfp_shootings"
                data-user-intent="tfp_ausschreibungen_ansehen"
                data-journey-stage="entdeckung"
              >
                Aktuelle Ausschreibungen ansehen
                <span aria-hidden="true">↗</span>
                <span class="visually-hidden"> auf tfp.hamburg, öffnet in neuem Tab</span>
              </a>
              <a
                class="tfp-text-link"
                href={conditionsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Konditionen auf tfp.hamburg
                <span class="visually-hidden">, öffnet in neuem Tab</span>
              </a>
            </div>
          </div>

          <figure class="tfp-hero__portrait">
            <Image
              src={heroImage}
              widths={[520, 760, 980, 1240]}
              sizes="(max-width: 760px) calc(100vw - 32px), 42vw"
              format="webp"
              quality={90}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt="Editoriales Portrait als Beispiel für ein TFP-Shooting in Hamburg"
            />
            <figcaption>Editorial · Portrait · Social Content</figcaption>
          </figure>
        </header>

        <section class="tfp-intro" aria-labelledby="tfp-intro-title">
          <div>
            <p class="tfp-kicker">Gemeinsame Bildideen</p>
            <h2 id="tfp-intro-title">Was TFP bei Artbild bedeutet</h2>
          </div>
          <div class="tfp-intro__copy">
            <p>
              TFP steht für „Time for Pictures“: Es gibt keine bezahlte Buchung.
              Stattdessen entstehen Bilder, die beide Seiten entsprechend der
              vereinbarten Konditionen für Portfolio und Eigenwerbung nutzen können.
            </p>
            <p>
              Veröffentlichung gehört zu diesem Prinzip. Wenn Bilder privat bleiben
              sollen, ist ein regulär gebuchtes Shooting die passendere Wahl.
            </p>
          </div>
        </section>

        <section class="tfp-details" aria-label="Informationen zu den TFP-Ausschreibungen">
          <article>
            <span>01</span>
            <h2>Für wen?</h2>
            <p>
              Je nach Projekt richten sich die Ausschreibungen an volljährige
              weibliche oder männliche Models, Schauspieler und Paare.
            </p>
          </article>
          <article>
            <span>02</span>
            <h2>Was ist geplant?</h2>
            <p>
              Portraits, Editorials, Styled Wedding, Couple Shootings und Social
              Content – jeweils mit eigenem Thema, Ort und Anforderungsprofil.
            </p>
          </article>
          <article>
            <span>03</span>
            <h2>Wie bewerben?</h2>
            <p>
              Öffne die passende Ausschreibung, lies die Konditionen und nutze dann
              den dort genannten Kontaktweg für Deine Bewerbung.
            </p>
          </article>
        </section>

        <section class="tfp-board" aria-labelledby="tfp-board-title">
          <figure>
            <Image
              src={coupleImage}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 760px) calc(100vw - 32px), 52vw"
              format="webp"
              quality={90}
              loading="lazy"
              decoding="async"
              alt="Paar bei einem emotionalen Fotoshooting als Beispiel für eine TFP-Ausschreibung"
            />
          </figure>
          <div>
            <p class="tfp-kicker">Casting Board</p>
            <h2 id="tfp-board-title">Immer der aktuelle Stand</h2>
            <p>
              Konkrete Termine, freie Plätze, Anforderungen und bereits beendete
              Projekte werden ausschließlich auf tfp.hamburg gepflegt. So siehst Du
              dort direkt, welche Ausschreibungen gerade offen sind.
            </p>
            <a
              class="tfp-button tfp-button--light"
              href={tfpUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-event="cta_click"
              data-cta-id="tfp_board_all_castings"
              data-cta-type="external_casting_board"
              data-section-id="tfp_casting_board"
              data-content-topic="tfp_shootings"
              data-user-intent="tfp_ausschreibungen_ansehen"
              data-journey-stage="bewerbung"
            >
              Alle TFP-Termine ansehen
              <span aria-hidden="true">↗</span>
              <span class="visually-hidden"> auf tfp.hamburg, öffnet in neuem Tab</span>
            </a>
          </div>
        </section>
      </article>
    </main>

    <footer class="gallery-footer">
      <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
        <img
          src="/images/logo-artbild-black.png"
          width="1200"
          height="480"
          alt="Artbild Fotografie"
        >
      </a>
      <nav aria-label="Footer">
        <a href="/portfolio/">Portfolio</a>
        <a href="/kontakt/">Kontakt</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutzerklärung</a>
      </nav>
      <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
    </footer>
  </body>
</html>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .tfp-landing-page {
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .tfp-landing-page main {
    padding-top: clamp(48px, 6vw, 88px);
  }

  .tfp-landing {
    padding-bottom: clamp(76px, 9vw, 140px);
  }

  .tfp-hero,
  .tfp-intro,
  .tfp-details {
    width: min(1240px, calc(100% - 72px));
    margin-inline: auto;
  }

  .tfp-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, .82fr);
    gap: clamp(46px, 8vw, 118px);
    align-items: center;
    padding: clamp(42px, 5vw, 76px) 0 clamp(86px, 10vw, 150px);
  }

  .tfp-hero__copy,
  .tfp-board > div {
    min-width: 0;
  }

  .tfp-script {
    margin: 0 0 clamp(28px, 4vw, 54px);
    color: #30333b;
    font-family: "Bestermind", "Playfair Display", Georgia, serif;
    font-size: clamp(46px, 5.5vw, 82px);
    line-height: 1;
  }

  .tfp-kicker {
    margin: 0;
    color: #866b58;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .24em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .tfp-hero h1,
  .tfp-intro h2,
  .tfp-board h2,
  .tfp-details h2 {
    margin: 0;
    color: #262b2c;
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 400;
  }

  .tfp-hero h1 {
    max-width: 760px;
    margin-top: 16px;
    font-size: clamp(48px, 6.2vw, 92px);
    letter-spacing: -.035em;
    line-height: .98;
  }

  .tfp-hero__lead {
    max-width: 680px;
    margin: clamp(26px, 3vw, 40px) 0 0;
    color: #5c5955;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.85;
  }

  .tfp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 26px;
    align-items: center;
    margin-top: 34px;
  }

  .tfp-button {
    box-sizing: border-box;
    display: inline-flex;
    min-height: 52px;
    padding: 14px 24px;
    gap: 14px;
    align-items: center;
    justify-content: center;
    border: 1px solid #252929;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .13em;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color .2s ease, color .2s ease, transform .2s ease;
  }

  .tfp-button--primary {
    background: #252929;
    color: #fff;
  }

  .tfp-button:hover,
  .tfp-button:focus-visible {
    transform: translateY(-2px);
  }

  .tfp-button--primary:hover,
  .tfp-button--primary:focus-visible {
    background: #866b58;
    border-color: #866b58;
  }

  .tfp-text-link {
    box-sizing: border-box;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: #4f4a45;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    line-height: 1.5;
    text-decoration-color: #b6a79c;
    text-underline-offset: 6px;
    text-transform: uppercase;
  }

  .tfp-hero__portrait {
    margin: 0;
  }

  .tfp-hero__portrait :global(img) {
    display: block;
    width: 100%;
    max-height: 760px;
    object-fit: cover;
    object-position: center 30%;
  }

  .tfp-hero__portrait figcaption {
    margin-top: 13px;
    color: #827a73;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .19em;
    text-transform: uppercase;
  }

  .tfp-intro {
    display: grid;
    grid-template-columns: minmax(260px, .75fr) minmax(0, 1.1fr);
    gap: clamp(44px, 9vw, 136px);
    padding: clamp(76px, 9vw, 136px) 0;
    border-top: 1px solid #dcd5ce;
  }

  .tfp-intro h2,
  .tfp-board h2 {
    margin-top: 14px;
    font-size: clamp(34px, 4.1vw, 58px);
    line-height: 1.08;
  }

  .tfp-intro__copy p,
  .tfp-board p,
  .tfp-details p {
    color: #5d5955;
    font-size: 16px;
    line-height: 1.85;
  }

  .tfp-intro__copy p {
    margin: 0;
  }

  .tfp-intro__copy p + p {
    margin-top: 22px;
  }

  .tfp-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(26px, 4vw, 58px);
    padding-bottom: clamp(86px, 11vw, 160px);
  }

  .tfp-details article {
    padding-top: 24px;
    border-top: 1px solid #91877e;
  }

  .tfp-details span {
    color: #a48e7c;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .tfp-details h2 {
    margin-top: 26px;
    font-size: clamp(25px, 2.5vw, 36px);
    line-height: 1.2;
  }

  .tfp-details p {
    margin: 16px 0 0;
  }

  .tfp-board {
    width: min(1380px, calc(100% - 36px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);
    background: #252929;
  }

  .tfp-board figure {
    min-height: 560px;
    margin: 0;
  }

  .tfp-board figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tfp-board > div {
    display: flex;
    padding: clamp(52px, 7vw, 102px);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .tfp-board .tfp-kicker {
    color: #cbb9a9;
  }

  .tfp-board h2,
  .tfp-board p {
    color: #fff;
  }

  .tfp-board p {
    margin: 24px 0 32px;
  }

  .tfp-button--light {
    border-color: #fff;
    color: #fff;
  }

  .tfp-button--light:hover,
  .tfp-button--light:focus-visible {
    background: #fff;
    color: #252929;
  }

  @media (max-width: 900px) {
    .tfp-hero,
    .tfp-intro,
    .tfp-board {
      grid-template-columns: 1fr;
    }

    .tfp-hero {
      gap: 52px;
    }

    .tfp-hero__portrait {
      width: min(620px, 100%);
      justify-self: center;
    }

    .tfp-intro {
      gap: 32px;
    }

    .tfp-board figure {
      min-height: 440px;
    }
  }

  @media (max-width: 700px) {
    .tfp-landing-page main {
      padding-top: 26px;
    }

    .tfp-hero,
    .tfp-intro,
    .tfp-details {
      width: min(100% - 32px, 1240px);
    }

    .tfp-hero {
      padding: 38px 0 86px;
    }

    .tfp-script {
      margin-bottom: 30px;
      font-size: clamp(40px, 13vw, 62px);
    }

    .tfp-hero h1 {
      font-size: clamp(43px, 13vw, 62px);
    }

    .tfp-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .tfp-button,
    .tfp-text-link {
      width: 100%;
    }

    .tfp-details {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .tfp-board {
      width: 100%;
    }

    .tfp-board figure {
      min-height: 330px;
    }

    .tfp-board > div {
      padding: 52px 24px 58px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tfp-button {
      transition: none;
    }
  }
</style>
