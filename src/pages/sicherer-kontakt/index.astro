---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import secureHero from "../../assets/sicherer-kontakt/ART_8206-Bearbeitet.jpg";
import mallorcaCouple from "../../assets/paarshooting-mallorca/ART0759-Wiederhergestellt_thumb.jpg";
import "../../styles/global.css";

const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pageUrl = `${siteUrl}/sicherer-kontakt/`;
const title =
  "Kontakt und öffentlicher PGP-Schlüssel | Artbild-Fotografie";
const description =
  "Datensparsamer Erstkontakt mit Artbild-Fotografie und öffentlicher PGP-Schlüssel für technisch geeignete verschlüsselte Nachrichten.";
const logoUrl = `${siteUrl}/images/logo-artbild-black.png`;
const primaryImage = new URL(secureHero.src, siteUrl).href;
const pgpDownload = "/downloads/York-Augustin-2C86E0AD-Oeffentlich.asc";
const secureMailto = "mailto:info@artbild-fotografie.de";

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      datePublished: "2022-03-30T08:02:48+02:00",
      dateModified: "2026-08-08T12:00:00+02:00",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: [
        {
          "@type": "Thing",
          name: "Sicherer E-Mail-Kontakt",
        },
        {
          "@type": "Thing",
          name: "PGP-Schlüssel",
        },
        {
          "@type": "Thing",
          name: "Datensparsame Hochzeitsanfrage",
        },
      ],
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: secureHero.width,
        height: secureHero.height,
        caption: "Kontakt und öffentlicher PGP-Schlüssel von Artbild-Fotografie",
      },
      contentLocation: {
        "@type": "City",
        name: "Hamburg",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Hamburg",
          addressRegion: "Hamburg",
          addressCountry: "DE",
        },
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
      inLanguage: "de",
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
      },
      email: "info@artbild-fotografie.de",
      founder: {
        "@type": "Person",
        name: "York Augustin",
      },
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
      ],
      serviceType: [
        "Hochzeitsfotografie",
        "Hochzeitsreportage",
        "Kontakt",
      ],
      sameAs: [
        "https://www.instagram.com/artbild/",
        "https://www.facebook.com/artbildfotografie/",
        "https://www.pinterest.de/artbildf/",
      ],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Startseite",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Sicherer Kontakt",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={secureHero.width}>
    <meta property="og:image:height" content={secureHero.height}>
    <meta property="og:image:alt" content="Kontakt und öffentlicher PGP-Schlüssel von Artbild-Fotografie">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={primaryImage}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template secure-contact-template">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main id="main-content">
      <article class="secure-contact" aria-labelledby="secure-contact-title">
        <section class="secure-hero-shell" aria-labelledby="secure-contact-title">
          <div class="secure-hero">
            <Image
              src={secureHero}
              widths={[760, 1040, 1385]}
              sizes="(max-width: 760px) calc(100vw - 28px), 86vw"
              format="webp"
              quality={90}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt="Schwarz-Weiß-Aufnahme einer ruhigen Straße bei Nacht"
            />
            <div class="secure-hero__overlay"></div>
            <div class="secure-hero__content">
              <h1 id="secure-contact-title">Kontakt und PGP-Schlüssel</h1>
              <div>
                <p>
                  Für die erste Anfrage genügen Name, E-Mail-Adresse und
                  Wunschdatum. Vertrauliche Angaben sollten nicht in einer
                  unverschlüsselten Erstnachricht stehen.
                </p>
                <p>
                  Für technisch geeignete PGP-Programme steht unten ein
                  öffentlicher Schlüssel zum Download bereit.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="secure-copy" aria-labelledby="secure-copy-title">
          <header class="secure-copy__heading">
            <h2 id="secure-copy-title">
              Erstkontakt mit möglichst wenigen Angaben
            </h2>
          </header>

          <div class="secure-original-copy">
            <div>
              <p>
                Der Kontakt-Link auf dieser Seite öffnet eine normale E-Mail. Eine
                solche Nachricht ist nicht automatisch Ende-zu-Ende verschlüsselt.
              </p>
              <p>
                Wenn Sie PGP bereits in einem geeigneten E-Mail-Programm verwenden,
                können Sie diesen öffentlichen Schlüssel herunterladen:
              </p>
              <a
                class="secure-download"
                href={pgpDownload}
                download
                rel="nofollow"
                aria-label="York-Augustin-2C86E0AD-Oeffentlich.asc herunterladen"
              >
                York-Augustin-2C86E0AD-Oeffentlich.asc
              </a>
              <p>
                Prüfen Sie die Identität des Schlüssels vor der Übermittlung
                vertraulicher Daten über einen unabhängig vereinbarten Kontaktweg.
                Der Download allein verschlüsselt noch keine Nachricht.
              </p>
              <p>
                Wenn Ihre Organisation einen eigenen Kommunikationsweg vorgibt,
                nennen Sie ihn bitte zunächst ohne vertrauliche Inhalte. Die
                technische Eignung wird vor einem weiteren Austausch abgestimmt.
              </p>
            </div>
            <div>
              <p>
                Zunächst wird nur geprüft, ob der gewünschte Termin verfügbar ist.
                Dafür sind noch keine Angaben zu Schutzpersonen, Adressen oder
                internen Abläufen erforderlich.
              </p>
              <p>
                Teilen Sie weitere Informationen erst mit, wenn der Termin passt
                und ein geeigneter Kommunikationsweg vereinbart wurde.
              </p>
              <p>
                Die Verfügbarkeit Ihres Wunschtermins können Sie vorab über das
                Kontakt-Symbol (FAB) unten rechts mit „Termin noch frei?“ prüfen.
                Dafür genügt das gewünschte Datum.
              </p>
              <p>
                Diese Seite beschreibt lediglich die angebotenen Kontaktwege. Sie
                gibt keine Garantie für die Sicherheit fremder Geräte, Programme
                oder E-Mail-Systeme.
              </p>
              <p>Herzlichen Dank!</p>
            </div>
          </div>
        </section>

        <section
          class="secure-mail-cta"
          aria-labelledby="secure-cta-title"
          data-track-section="secure_mail_cta"
          data-content-topic="sicherer_kontakt"
          data-user-intent="erstkontakt_senden"
          data-journey-stage="conversion"
          data-content-format="contact_cta"
          data-position="after_security_information"
        >
          <h2 id="secure-cta-title">Erstkontakt per E-Mail</h2>
          <p>
            Der Mail-Link öffnet Ihr Standardprogramm. Die Nachricht wird dadurch
            nicht automatisch verschlüsselt.
          </p>
          <a
            class="secure-button"
            href={secureMailto}
            data-track-event="contact_click"
            data-cta-id="secure_contact_email"
            data-cta-type="email"
            data-section-id="secure_mail_cta"
            data-content-topic="sicherer_kontakt"
            data-user-intent="erstkontakt_senden"
            data-journey-stage="conversion"
            data-position="primary"
          >
            Kontakt
          </a>
        </section>

        <section class="secure-featured" aria-labelledby="secure-featured-title">
          <figure>
            <Image
              src={mallorcaCouple}
              widths={[520, 760, 1040, 1384]}
              sizes="(max-width: 760px) 100vw, 52vw"
              format="webp"
              quality={88}
              loading="lazy"
              decoding="async"
              alt="Paarshooting von Artbild-Fotografie auf Mallorca"
            />
          </figure>
          <div class="secure-featured__copy">
            <h2 id="secure-featured-title">Paarshooting-Fotogalerie</h2>
            <p>
              Mit einem tollen Paarshooting von Artbild-Fotografie hielt dieses
              Paar seine Erinnerungen an die gemeinsame Zeit in seiner Wohnung auf
              Mallorca fest. Die beiden haben mir erlaubt, Euch ein paar Bilder
              davon zu zeigen.
            </p>
            <a class="secure-button secure-button--light" href="/gallery/paarshooting-mallorca/">
              Jetzt ansehen!
            </a>
          </div>
        </section>
      </article>
    </main>

    <footer class="gallery-footer">
      <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
        <img
          src="/images/logo-artbild-black.png"
          width="1200"
          height="480"
          alt="Artbild Fotografie"
        >
      </a>
      <nav aria-label="Footer">
        <a href="/kontakt/">Kontakt</a>
        <a href="/blog/">Blog</a>
        <a href="/sicherer-kontakt/" aria-current="page">Sicherer Kontakt</a>
        <a href="/impressum/">Impressum</a>
      </nav>
      <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
    </footer>
  </body>
</html>

<style>
  .secure-contact-template {
    background: #fbfaf8;
  }

  .secure-contact-template main {
    overflow: hidden;
    padding-bottom: clamp(84px, 10vw, 150px);
  }

  .secure-breadcrumb,
  .secure-contact {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .secure-breadcrumb {
    margin-top: clamp(44px, 6vw, 82px);
    display: flex;
    align-items: center;
    gap: 10px;
    color: #807970;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .secure-breadcrumb a {
    text-decoration: none;
  }

  .secure-breadcrumb a:hover,
  .secure-breadcrumb a:focus-visible {
    color: #2c739c;
  }

  .secure-hero {
    min-height: clamp(520px, 62vw, 760px);
    padding: clamp(42px, 7vw, 92px) 0 clamp(58px, 8vw, 112px);
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr);
    gap: clamp(34px, 7vw, 96px);
    align-items: center;
    border-bottom: 1px solid #ddd7cf;
  }

  .secure-hero__copy {
    position: relative;
    z-index: 1;
  }

  .secure-section-number {
    margin: 0;
    color: #2c739c;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .secure-hero h1 {
    max-width: 760px;
    margin: 14px 0 26px;
    font-size: clamp(56px, 8.2vw, 118px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: .9;
  }

  .secure-hero__copy > p:last-of-type,
  .secure-intro p,
  .secure-card p,
  .secure-cta p {
    color: #5f5a54;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.72;
  }

  .secure-hero__copy > p:last-of-type {
    max-width: 560px;
    margin: 0;
  }

  .secure-hero__actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .secure-button,
  .secure-download {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .18em;
    line-height: 1.3;
    text-transform: uppercase;
    text-decoration: none;
  }

  .secure-button {
    padding: 15px 20px;
    border: 1px solid #202020;
    background: #202020;
    color: #fff;
  }

  .secure-button--ghost,
  .secure-download {
    background: transparent;
    color: #202020;
  }

  .secure-button--ghost {
    border-color: #9d9389;
  }

  .secure-button:hover,
  .secure-button:focus-visible {
    border-color: #2c739c;
    background: #2c739c;
    color: #fff;
  }

  .secure-button--ghost:hover,
  .secure-button--ghost:focus-visible {
    color: #fff;
  }

  .secure-hero__image {
    margin: 0;
    justify-self: stretch;
  }

  .secure-hero__image :global(img) {
    width: 100%;
    aspect-ratio: 1385 / 924;
    object-fit: cover;
  }

  .secure-intro {
    max-width: 980px;
    padding: clamp(56px, 8vw, 110px) 0 clamp(48px, 7vw, 92px);
  }

  .secure-intro h2,
  .secure-card h2,
  .secure-cta h2 {
    margin: 12px 0 20px;
    color: #202020;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.06;
  }

  .secure-intro h2 {
    font-size: clamp(38px, 5vw, 72px);
  }

  .secure-intro p {
    max-width: 780px;
    margin: 0;
  }

  .secure-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: #ddd7cf;
    border: 1px solid #ddd7cf;
  }

  .secure-card {
    min-width: 0;
    padding: clamp(30px, 5vw, 56px);
    background: #fbfaf8;
  }

  .secure-card--accent {
    background: #f0ece6;
  }

  .secure-card h2 {
    font-size: clamp(30px, 3.2vw, 46px);
  }

  .secure-card p {
    margin: 0 0 18px;
    font-size: clamp(16px, 1.35vw, 19px);
  }

  .secure-card p:last-child {
    margin-bottom: 0;
  }

  .secure-download {
    justify-content: flex-start;
    min-height: 44px;
    max-width: 100%;
    overflow-wrap: anywhere;
    border-bottom: 1px solid #9baab2;
  }

  .secure-download:hover,
  .secure-download:focus-visible {
    color: #2c739c;
  }

  .secure-cta {
    margin-top: clamp(56px, 8vw, 112px);
    padding: clamp(34px, 5vw, 58px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    background: #f0ece6;
    border-top: 3px solid #2c739c;
  }

  .secure-cta h2 {
    font-size: clamp(34px, 4.4vw, 62px);
  }

  .secure-cta p {
    max-width: 720px;
    margin: 0;
  }

  .secure-contact-template :is(a, button):focus-visible {
    outline: 2px solid #2c739c;
    outline-offset: 5px;
  }

  @media (max-width: 900px) {
    .secure-hero,
    .secure-cta {
      grid-template-columns: 1fr;
    }

    .secure-hero {
      min-height: 0;
    }

    .secure-hero__image {
      order: -1;
    }

    .secure-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .secure-breadcrumb,
    .secure-contact {
      width: min(100% - 28px, 1180px);
    }

    .secure-breadcrumb {
      margin-top: 30px;
      font-size: 9px;
      letter-spacing: .14em;
    }

    .secure-hero {
      padding-top: 30px;
      gap: 28px;
    }

    .secure-hero h1 {
      font-size: clamp(48px, 16vw, 70px);
    }

    .secure-hero__actions,
    .secure-button,
    .secure-download {
      width: 100%;
    }

    .secure-button,
    .secure-download {
      justify-content: center;
      text-align: center;
      letter-spacing: .13em;
    }

    .secure-card,
    .secure-cta {
      padding: 28px 22px;
    }

    .secure-intro h2,
    .secure-card h2,
    .secure-cta h2 {
      line-height: 1.12;
    }
  }
</style>

<style>
  /*
   * FloThemes-inspired page composition from the original page:
   * image hero, centered introduction, two editorial text columns,
   * a three-part mail CTA and the featured Mallorca gallery.
   */
  .secure-contact-template {
    background: #fff;
  }

  .secure-contact-template main {
    overflow: hidden;
    padding-bottom: 0;
  }

  .secure-contact {
    width: 100%;
    margin: 0;
  }

  .secure-hero-shell {
    padding: clamp(44px, 5vw, 72px) 0;
    background: #f0f1f2;
  }

  .secure-hero {
    position: relative;
    width: min(1180px, calc(100% - 140px));
    min-height: clamp(420px, 36vw, 520px);
    margin: 0 auto;
    padding: 0;
    display: block;
    overflow: hidden;
    border: 0;
    isolation: isolate;
  }

  .secure-hero :global(img) {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .secure-hero__overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: rgba(12, 12, 12, .25);
  }

  .secure-hero__content {
    min-height: inherit;
    padding: clamp(72px, 8vw, 118px) clamp(72px, 9vw, 145px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(48px, 8vw, 112px);
    align-items: start;
    color: #fff;
  }

  .secure-hero h1 {
    max-width: none;
    margin: 0;
    color: #fff;
    font-size: clamp(28px, 2.4vw, 38px);
    font-weight: 400;
    letter-spacing: .01em;
    line-height: 1.2;
  }

  .secure-hero__content p {
    margin: 0 0 16px;
    color: #fff;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.42;
  }

  .secure-hero__content p:last-child {
    margin-bottom: 0;
  }

  .secure-copy {
    width: min(1180px, calc(100% - 140px));
    margin: 0 auto;
    padding: clamp(64px, 7vw, 96px) clamp(46px, 4.8vw, 72px) clamp(72px, 8vw, 112px);
  }

  .secure-copy__heading {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .secure-copy__heading h2 {
    margin: 0 0 22px;
    color: #393939;
    font-size: clamp(28px, 3.2vw, 46px);
    font-weight: 400;
    letter-spacing: .035em;
    line-height: 1.18;
  }

  .secure-copy__heading > p:last-child {
    max-width: 680px;
    margin: 0 auto;
    color: #67615c;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.65;
  }

  .secure-original-copy {
    margin-top: clamp(52px, 6vw, 82px);
    padding: clamp(42px, 5vw, 68px) 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(54px, 7vw, 92px);
    border-top: 1px solid #d9d5d0;
    border-bottom: 1px solid #d9d5d0;
  }

  .secure-original-copy > div {
    min-width: 0;
  }

  .secure-original-copy p {
    margin: 0 0 20px;
    color: #605b56;
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.72;
  }

  .secure-original-copy .secure-download {
    margin: 2px 0 24px;
  }

  .secure-download {
    width: auto;
    min-height: 0;
    justify-content: flex-start;
    padding: 8px 0 5px;
    overflow-wrap: anywhere;
    border: 0;
    border-bottom: 1px solid #827b75;
    background: transparent;
    color: #4d4945;
    font-size: 9px;
    letter-spacing: .16em;
    text-align: left;
  }

  .secure-download:hover,
  .secure-download:focus-visible {
    color: #8c6b56;
  }

  .secure-mail-cta {
    width: min(1180px, calc(100% - 140px));
    margin: 0 auto;
    padding: clamp(56px, 7vw, 88px) clamp(46px, 5vw, 76px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
