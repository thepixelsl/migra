---
import FaviconHead from "../../components/FaviconHead.astro";
import MobileNavigation from "../../components/MobileNavigation.astro";
import "../../styles/global.css";

const title = "Admin Termine | Artbild-Fotografie";
const description = "Geschützte Terminverwaltung für Artbild-Fotografie Hamburg.";
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="noindex, nofollow">
  </head>
  <body class="availability-admin-page">
    <header class="gallery-header">
      <MobileNavigation showFloatingAction={false} />
    </header>

    <main class="availability-admin" aria-labelledby="availability-admin-title">
      <header class="availability-admin__hero">
        <p class="availability-admin__kicker">Artbild-Fotografie</p>
        <h1 id="availability-admin-title">Terminverwaltung</h1>
        <p>
          Blockierte Hochzeitstermine werden ohne Namen, Kontaktdaten oder Notizen
          gespeichert. Änderungen sind sofort im Schnellkontakt sichtbar.
        </p>
      </header>

      <section
        class="availability-admin__panel"
        aria-labelledby="availability-calendar-title"
        data-admin-availability
      >
        <div class="availability-admin__toolbar">
          <button type="button" data-admin-prev aria-label="Vorherigen Monat anzeigen">
            <span aria-hidden="true">←</span>
          </button>
          <div>
            <p class="availability-admin__eyebrow">Kalender</p>
            <h2 id="availability-calendar-title" data-admin-month-title></h2>
          </div>
          <button type="button" data-admin-next aria-label="Nächsten Monat anzeigen">
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <div class="availability-admin__status" role="status" aria-live="polite" data-admin-status>
          Termine werden geladen.
        </div>

        <div class="availability-admin__weekdays" aria-hidden="true">
          <span>Mo</span>
          <span>Di</span>
          <span>Mi</span>
          <span>Do</span>
          <span>Fr</span>
          <span>Sa</span>
          <span>So</span>
        </div>

        <div
          class="availability-admin__calendar"
          role="grid"
          aria-labelledby="availability-calendar-title"
          data-admin-calendar
        ></div>

        <div class="availability-admin__legend" aria-label="Legende">
          <span><i class="is-free" aria-hidden="true"></i> frei</span>
          <span><i class="is-blocked" aria-hidden="true"></i> blockiert</span>
          <span><i class="is-today" aria-hidden="true"></i> heute</span>
        </div>
      </section>

      <section
        class="availability-admin__panel availability-admin__agent-panel"
        aria-labelledby="agent-requests-title"
        data-admin-agent-requests
      >
        <div class="availability-admin__agent-toolbar">
          <div>
            <p class="availability-admin__eyebrow">Protokoll</p>
            <h2 id="agent-requests-title">KI-Agentenanfragen</h2>
          </div>
          <button type="button" data-agent-refresh>Aktualisieren</button>
        </div>

        <p class="availability-admin__agent-intro">
          Zeigt die letzten 100 gültigen API-Anfragen. Konkrete Wunschdaten und
          Ergebnisse bleiben 30 Tage sichtbar; rohe IP-Adressen, vollständige
          User-Agents und API-Schlüssel werden nicht gespeichert.
        </p>

        <div
          class="availability-admin__status"
          role="status"
          aria-live="polite"
          data-agent-status
        >
          Agentenanfragen werden geladen.
        </div>

        <div class="availability-admin__agent-list" data-agent-list></div>
      </section>
    </main>

    <script>
      const adminRoot = document.querySelector("[data-admin-availability]");

      if (adminRoot instanceof HTMLElement) {
        const elements = {
          prev: adminRoot.querySelector("[data-admin-prev]"),
          next: adminRoot.querySelector("[data-admin-next]"),
          title: adminRoot.querySelector("[data-admin-month-title]"),
          status: adminRoot.querySelector("[data-admin-status]"),
          calendar: adminRoot.querySelector("[data-admin-calendar]"),
        };

        const datePattern = /^\d{4}-\d{2}-\d{2}$/;
        const endpoint = "/api/admin/availability";
        const today = new Date();
        let monthCursor = new Date(today.getFullYear(), today.getMonth(), 1);
        let blockedDates = new Set();
        let isSaving = false;

        function setStatus(message, tone = "") {
          if (!(elements.status instanceof HTMLElement)) return;
          elements.status.textContent = message;
          elements.status.dataset.tone = tone;
        }

        function dateValue(date) {
          const year = date.getFullYear();
          const month = String(date.getMonth() + 1).padStart(2, "0");
          const day = String(date.getDate()).padStart(2, "0");
          return `${year}-${month}-${day}`;
        }

        function validDateValue(value) {
          if (typeof value !== "string" || !datePattern.test(value)) return false;
          const [year, month, day] = value.split("-").map(Number);
          const date = new Date(Date.UTC(year, month - 1, day));
          return date.getUTCFullYear() === year
            && date.getUTCMonth() === month - 1
            && date.getUTCDate() === day;
        }

        function monthTitle(date) {
          return new Intl.DateTimeFormat("de-DE", {
            month: "long",
            year: "numeric",
          }).format(date);
        }

        function dayLabel(date, blocked) {
          const label = new Intl.DateTimeFormat("de-DE", {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric",
          }).format(date);
          return blocked
            ? `${label}, aktuell blockiert. Zum Freigeben klicken.`
            : `${label}, aktuell frei. Zum Blockieren klicken.`;
        }

        function renderCalendar() {
          if (!(elements.calendar instanceof HTMLElement) || !(elements.title instanceof HTMLElement)) return;

          elements.title.textContent = monthTitle(monthCursor);
          elements.calendar.textContent = "";

          const year = monthCursor.getFullYear();
          const month = monthCursor.getMonth();
          const daysInMonth = new Date(year, month + 1, 0).getDate();
          const firstDay = new Date(year, month, 1).getDay();
          const leadingEmptyCells = (firstDay + 6) % 7;
          const todayValue = dateValue(today);

          for (let index = 0; index < leadingEmptyCells; index += 1) {
            const spacer = document.createElement("span");
            spacer.className = "availability-admin__day-spacer";
            spacer.setAttribute("aria-hidden", "true");
            elements.calendar.append(spacer);
          }

          for (let day = 1; day <= daysInMonth; day += 1) {
            const date = new Date(year, month, day);
            const value = dateValue(date);
            const isBlocked = blockedDates.has(value);
            const button = document.createElement("button");
            button.type = "button";
            button.className = "availability-admin__day";
            button.dataset.date = value;
            button.dataset.blocked = String(isBlocked);
            button.setAttribute("aria-label", dayLabel(date, isBlocked));
            button.setAttribute("aria-pressed", String(isBlocked));
            const dayNumber = document.createElement("span");
            dayNumber.textContent = String(day);
            const state = document.createElement("small");
            state.textContent = isBlocked ? " blockiert" : " frei";
            button.append(dayNumber, state);
            if (value === todayValue) button.dataset.today = "true";
            button.addEventListener("click", () => toggleDate(value));
            elements.calendar.append(button);
          }
        }

        async function loadBlockedDates() {
          try {
            const response = await fetch(endpoint, {
              method: "GET",
              credentials: "same-origin",
              cache: "no-store",
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data?.message || "load_failed");
            const dates = Array.isArray(data.blockedDates)
              ? data.blockedDates.filter(validDateValue)
              : [];
            blockedDates = new Set(dates);
            renderCalendar();
            setStatus(`${dates.length} blockierte Termine geladen.`, "ok");
          } catch {
            setStatus("Die Terminliste konnte nicht geladen werden. Prüfe bitte die Admin-Anmeldung und die Datenbank-Verbindung.", "error");
          }
        }

        async function toggleDate(value) {
          if (isSaving || !validDateValue(value)) return;
          isSaving = true;
          const action = blockedDates.has(value) ? "unblock" : "block";
          setStatus(action === "block" ? "Termin wird blockiert." : "Termin wird freigegeben.");

          try {
            const response = await fetch(endpoint, {
              method: "POST",
              credentials: "same-origin",
              cache: "no-store",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ date: value, action }),
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data?.message || "save_failed");
            const dates = Array.isArray(data.blockedDates)
              ? data.blockedDates.filter(validDateValue)
              : [];
            blockedDates = new Set(dates);
            renderCalendar();
            setStatus(action === "block" ? `${value} ist blockiert.` : `${value} ist wieder frei.`, "ok");
          } catch {
            setStatus("Die Änderung konnte nicht gespeichert werden.", "error");
          } finally {
            isSaving = false;
          }
        }

        if (elements.prev instanceof HTMLButtonElement) {
          elements.prev.addEventListener("click", () => {
            monthCursor = new Date(monthCursor.getFullYear(), monthCursor.getMonth() - 1, 1);
            renderCalendar();
          });
        }

        if (elements.next instanceof HTMLButtonElement) {
          elements.next.addEventListener("click", () => {
            monthCursor = new Date(monthCursor.getFullYear(), monthCursor.getMonth() + 1, 1);
            renderCalendar();
          });
        }

        renderCalendar();
        loadBlockedDates();
      }

      const agentRoot = document.querySelector("[data-admin-agent-requests]");

      if (agentRoot instanceof HTMLElement) {
        const status = agentRoot.querySelector("[data-agent-status]");
        const list = agentRoot.querySelector("[data-agent-list]");
        const refresh = agentRoot.querySelector("[data-agent-refresh]");
        const endpoint = "/api/admin/agent-requests";
        const datePattern = /^\d{4}-\d{2}-\d{2}$/;

        function setAgentStatus(message, tone = "") {
          if (!(status instanceof HTMLElement)) return;
          status.textContent = message;
          status.dataset.tone = tone;
        }

        function validAgentDate(value) {
          if (typeof value !== "string" || !datePattern.test(value)) return false;
          return Number.isFinite(Date.parse(`${value}T12:00:00Z`));
        }

        function formatAgentDate(value) {
          if (!validAgentDate(value)) return value;
          return new Intl.DateTimeFormat("de-DE", {
            weekday: "short",
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            timeZone: "Europe/Berlin",
          }).format(new Date(`${value}T12:00:00Z`));
        }

        function formatAgentTimestamp(value) {
          const timestamp = typeof value === "string" ? Date.parse(value) : NaN;
          if (!Number.isFinite(timestamp)) return "Unbekannter Zeitpunkt";
          return new Intl.DateTimeFormat("de-DE", {
            dateStyle: "medium",
            timeStyle: "short",
            timeZone: "Europe/Berlin",
          }).format(new Date(timestamp));
        }

        function responseLabel(code) {
          if (code === 200) return "Erfolgreich";
          if (code === 429) return "Abfragelimit erreicht";
          if (code >= 500) return "Technischer Fehler";
          return `HTTP ${code}`;
        }

        function createAgentRequestCard(item) {
          const article = document.createElement("article");
          article.className = "availability-admin__agent-card";

          const header = document.createElement("header");
          const identity = document.createElement("div");
          const client = document.createElement("h3");
          client.textContent = typeof item?.clientLabel === "string"
            ? item.clientLabel
            : "Nicht identifiziert";
          const timestamp = document.createElement("p");
          timestamp.textContent = formatAgentTimestamp(item?.requestedAt);
          identity.append(client, timestamp);

          const badge = document.createElement("span");
          badge.className = "availability-admin__agent-badge";
          badge.dataset.verified = String(item?.clientVerified === true);
          badge.textContent = item?.clientVerified === true ? "Bestätigt" : "Nur gemeldet";
          header.append(identity, badge);

          const dates = Array.isArray(item?.dates) ? item.dates.filter(validAgentDate) : [];
          const results = Array.isArray(item?.results) ? item.results : [];
          const dateList = document.createElement("ul");
          dateList.className = "availability-admin__agent-dates";
          dateList.setAttribute("aria-label", "Angefragte Termine");

          for (const date of dates) {
            const result = results.find((entry) => entry?.date === date);
            const row = document.createElement("li");
            const dateText = document.createElement("span");
            dateText.textContent = formatAgentDate(date);
            const outcome = document.createElement("strong");
            if (typeof result?.available === "boolean") {
              outcome.textContent = result.available ? "frei" : "belegt";
              outcome.dataset.available = String(result.available);
            } else {
              outcome.textContent = "nicht geprüft";
              outcome.dataset.available = "unknown";
            }
            row.append(dateText, outcome);
            dateList.append(row);
          }

          const footer = document.createElement("footer");
          const responseStatus = Number(item?.responseStatus);
          footer.textContent = responseLabel(responseStatus);
          footer.dataset.status = String(responseStatus);

          article.append(header, dateList, footer);
          return article;
        }

        function renderAgentRequests(requests) {
          if (!(list instanceof HTMLElement)) return;
          list.textContent = "";

          if (!Array.isArray(requests) || requests.length === 0) {
            const empty = document.createElement("p");
            empty.className = "availability-admin__agent-empty";
            empty.textContent = "Noch keine gültigen Agenten-Anfragen protokolliert.";
            list.append(empty);
            return;
          }

          for (const item of requests) list.append(createAgentRequestCard(item));
        }

        async function loadAgentRequests() {
          if (refresh instanceof HTMLButtonElement) refresh.disabled = true;
          setAgentStatus("Agentenanfragen werden geladen.");
          try {
            const response = await fetch(endpoint, {
              method: "GET",
              credentials: "same-origin",
              cache: "no-store",
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data?.message || "load_failed");
            const requests = Array.isArray(data?.requests) ? data.requests : [];
            renderAgentRequests(requests);
            setAgentStatus(
              requests.length === 1
                ? "1 Agentenanfrage geladen."
                : `${requests.length} Agentenanfragen geladen.`,
              "ok",
            );
          } catch {
            renderAgentRequests([]);
            setAgentStatus("Die Agentenanfragen konnten nicht geladen werden. Prüfe bitte die Admin-Anmeldung und die Datenbank-Verbindung.", "error");
          } finally {
            if (refresh instanceof HTMLButtonElement) refresh.disabled = false;
          }
        }

        if (refresh instanceof HTMLButtonElement) {
          refresh.addEventListener("click", loadAgentRequests);
        }
        loadAgentRequests();
      }
    </script>
  </body>
</html>

<style>
  .availability-admin-page {
    background: #f8f6f2;
  }

  .availability-admin {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: clamp(42px, 7vw, 96px) 0 clamp(64px, 8vw, 118px);
  }

  .availability-admin__hero {
    max-width: 820px;
    margin: 0 auto clamp(30px, 5vw, 58px);
    text-align: center;
  }

  .availability-admin__kicker,
  .availability-admin__eyebrow {
    margin: 0 0 10px;
    color: #7d756d;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .availability-admin h1 {
    font-size: clamp(44px, 7vw, 92px);
  }

  .availability-admin__hero p:last-child {
    max-width: 640px;
    margin: 22px auto 0;
    color: #6f6a64;
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.55;
  }

  .availability-admin__panel {
    padding: clamp(18px, 3vw, 34px);
    border: 1px solid #ded8cf;
    background: #fff;
  }

  .availability-admin__agent-panel {
    margin-top: clamp(24px, 4vw, 44px);
  }

  .availability-admin__agent-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .availability-admin__agent-toolbar h2 {
    font-size: clamp(30px, 4vw, 52px);
  }

  .availability-admin__agent-toolbar button {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid #1f2733;
    background: #1f2733;
    color: #fff;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .availability-admin__agent-toolbar button:disabled {
    cursor: wait;
    opacity: .58;
  }

  .availability-admin__agent-toolbar button:focus-visible {
    outline: 3px solid #9b6f4f;
    outline-offset: 3px;
  }

  .availability-admin__agent-intro {
    max-width: 780px;
    margin: 18px 0 0;
    color: #6f6a64;
    line-height: 1.55;
  }

  .availability-admin__agent-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  :global(.availability-admin__agent-card) {
    min-width: 0;
    padding: 18px;
    border: 1px solid #ded8cf;
    background: #fbfaf8;
  }

  :global(.availability-admin__agent-card header) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  :global(.availability-admin__agent-card h3) {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 21px;
  }

  :global(.availability-admin__agent-card header p) {
    margin: 5px 0 0;
    color: #6f6a64;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
  }

  :global(.availability-admin__agent-badge) {
    flex: 0 0 auto;
    padding: 6px 8px;
    border: 1px solid #c4bbb0;
    color: #6f6a64;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  :global(.availability-admin__agent-badge[data-verified="true"]) {
    border-color: #1d5b3a;
    background: #e8f3ec;
    color: #1d5b3a;
  }

  :global(.availability-admin__agent-dates) {
    margin: 16px 0;
    padding: 0;
    display: grid;
    gap: 7px;
    list-style: none;
  }

  :global(.availability-admin__agent-dates li) {
    min-width: 0;
    padding: 9px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid #e5ded5;
    background: #fff;
    font-size: 13px;
  }

  :global(.availability-admin__agent-dates strong) {
    flex: 0 0 auto;
    color: #6f6a64;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  :global(.availability-admin__agent-dates strong[data-available="true"]) {
    color: #1d5b3a;
  }

  :global(.availability-admin__agent-dates strong[data-available="false"]) {
    color: #9d232b;
  }

  :global(.availability-admin__agent-card footer) {
    color: #6f6a64;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  :global(.availability-admin__agent-card footer[data-status="200"]) {
    color: #1d5b3a;
  }

  :global(.availability-admin__agent-card footer[data-status="429"]),
  :global(.availability-admin__agent-card footer[data-status="503"]) {
    color: #9d232b;
  }

  :global(.availability-admin__agent-empty) {
    grid-column: 1 / -1;
    margin: 0;
    padding: 28px 18px;
    border: 1px dashed #cfc6bb;
    color: #6f6a64;
    text-align: center;
  }

  .availability-admin__toolbar {
    display: grid;
    grid-template-columns: 48px 1fr 48px;
    align-items: center;
    gap: 16px;
  }

  .availability-admin__toolbar h2 {
    font-size: clamp(28px, 4vw, 54px);
    text-align: center;
    text-transform: capitalize;
  }

  .availability-admin__toolbar button,
  :global(.availability-admin__day) {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid #d8d0c6;
    background: #fff;
    color: #171717;
    font: inherit;
    cursor: pointer;
  }

  .availability-admin__toolbar button {
    display: grid;
    place-items: center;
    font-size: 22px;
  }

  .availability-admin__toolbar button:focus-visible,
  :global(.availability-admin__day:focus-visible) {
    outline: 3px solid #171717;
    outline-offset: 3px;
  }

  .availability-admin__status {
    min-height: 44px;
    margin: 24px 0 16px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e5ded5;
    color: #6f6a64;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .08em;
    text-align: center;
    text-transform: uppercase;
  }

  .availability-admin__status[data-tone="ok"] {
    color: #1d5b3a;
  }

  .availability-admin__status[data-tone="error"] {
    color: #9d232b;
  }

  .availability-admin__weekdays,
  .availability-admin__calendar {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8px;
    align-items: stretch;
  }

  .availability-admin__weekdays {
    margin-bottom: 8px;
    color: #7d756d;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-align: center;
    text-transform: uppercase;
  }

  :global(.availability-admin__day-spacer) {
    min-height: clamp(62px, 9vw, 96px);
  }

  :global(.availability-admin__day) {
    width: 100%;
    min-height: clamp(62px, 9vw, 96px);
    padding: 10px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: 0;
    transition: background-color .16s ease, border-color .16s ease, color .16s ease;
  }

  :global(.availability-admin__day span) {
    display: block;
    font-size: clamp(20px, 3vw, 34px);
    line-height: 1;
  }

  :global(.availability-admin__day small) {
    display: inline-flex;
    min-height: 20px;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    border: 1px solid #d8d0c6;
    background: #fff;
    color: #6f6a64;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    line-height: 1;
    text-transform: uppercase;
  }

  :global(.availability-admin__day[data-blocked="true"]) {
    border-color: #1f2733;
    background: #1f2733;
    color: #fff;
  }

  :global(.availability-admin__day[data-blocked="true"] small) {
    border-color: rgba(255, 255, 255, .26);
    background: rgba(255, 255, 255, .12);
    color: #fff;
  }

  :global(.availability-admin__day[data-today="true"]) {
    box-shadow: 0 0 0 2px #9b6f4f inset;
  }

  :global(.availability-admin__day:hover) {
