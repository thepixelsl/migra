    height: valerieTimHomepageImage.height,
    alt: "Valerie und Tim bei ihrem Brautpaarshooting im Frühlingslicht",
  },
  {
    title: "Braut-Editorial Fraser Suites",
    kicker: "Braut-Editorial in Hamburg",
    text: "Ein Brautkleid-Shooting in den Fraser Suites Hamburg mit Zimmerportraits, Fensterlicht und Aufnahmen im historischen Treppenhaus.",
