      <a class="portfolio-showcase__link" href="/portfolio/" aria-label="Gesamtes Portfolio von Artbild-Fotografie ansehen" data-home-reveal data-track-event="cta_click" data-cta-id="home_portfolio_showcase_all" data-cta-type="portfolio_link" data-section-id="home_portfolio_showcase" data-content-topic="portfolio" data-user-intent="portfolio_ansehen" data-journey-stage="auswahl">Sieh Dir mein Portfolio an.</a>
    </section>

    <section class="vendor-section home-lower-section" aria-labelledby="vendor-title" data-track-section="home_vendor_recommendations" data-content-topic="hochzeitsdienstleister_hamburg" data-user-intent="dienstleister_finden" data-journey-stage="planung" data-content-format="vendor_carousel" data-position="home_vendor">
      <div class="section-heading" data-home-reveal>
        <p class="eyebrow">Empfehlungen für Eure Hochzeit</p>
        <h2 id="vendor-title">Dienstleister in Hamburg und Umgebung</h2>
        <p>Menschen und Anbieter, die an den gezeigten Shootings beteiligt waren oder bereits auf der früheren Artbild-Seite empfohlen wurden.</p>
      </div>
      <div class="vendor-carousel" data-vendor-carousel data-home-reveal data-home-reveal-delay="90">
        <p class="visually-hidden" id="vendor-carousel-instructions">
          Nutze die Pfeiltasten, wische horizontal oder verwende die Schaltflächen, um weitere Dienstleister anzusehen.
        </p>
        <span class="visually-hidden" role="status" aria-atomic="true" data-vendor-carousel-status>
          Dienstleister 1 bis 4 von {vendors.length}
        </span>

        <div class="vendor-carousel__controls" role="group" aria-label="Karussellsteuerung">
          <button
            type="button"
            aria-label="Vorherige Dienstleister"
            aria-controls="home-vendor-carousel"
            data-vendor-carousel-previous
            data-track-event="content_slider_interaction"
            data-slider-id="home_vendor_recommendations"
            data-slider-action="previous"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M19 12H5m6-6-6 6 6 6"></path>
            </svg>
          </button>
          <div class="vendor-carousel__position" aria-hidden="true">
            <span data-vendor-carousel-current>1–4</span>
            <span> / </span>
            <span>{vendors.length}</span>
          </div>
          <button
            type="button"
            aria-label="Nächste Dienstleister"
            aria-controls="home-vendor-carousel"
            data-vendor-carousel-next
            data-track-event="content_slider_interaction"
            data-slider-id="home_vendor_recommendations"
            data-slider-action="next"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </button>
        </div>

        <div
          class="vendor-carousel__viewport"
          id="home-vendor-carousel"
          tabindex="0"
          role="region"
          aria-roledescription="Karussell"
          aria-label="Dienstleister in Hamburg und Umgebung"
          aria-describedby="vendor-carousel-instructions"
          data-vendor-carousel-viewport
        >
          <div class="vendor-grid vendor-carousel__track" data-vendor-carousel-track>
            {vendors.map((vendor, index) => (
              <article
                aria-roledescription="Folie"
                aria-labelledby={`vendor-card-position-${index + 1} vendor-card-title-${index + 1}`}
                data-vendor-carousel-card
              >
                <span class="visually-hidden" id={`vendor-card-position-${index + 1}`}>
                  {index + 1} von {vendors.length}:
                </span>
                <h3 id={`vendor-card-title-${index + 1}`}>{vendor.name}</h3>
                <p>{vendor.text}</p>
                <a
                  href={vendor.href}
                  rel={vendor.href.startsWith("http") ? "noopener" : undefined}
                  data-track-event={vendor.href.startsWith("http") ? "external_resource_click" : "cta_click"}
                  data-resource-id={vendor.href.startsWith("http") ? `vendor_${trackingSlug(vendor.name)}` : undefined}
                  data-resource-type={vendor.href.startsWith("http") ? "vendor_website" : undefined}
                  data-cta-id={`home_vendor_${trackingSlug(vendor.name)}`}
                  data-cta-type="vendor_link"
                  data-section-id="home_vendor_recommendations"
                  data-content-topic="hochzeitsdienstleister_hamburg"
                  data-user-intent="dienstleister_ansehen"
                  data-journey-stage="planung"
                  data-position={`vendor_${index + 1}`}
                >
                  {vendor.cta}
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="social-section home-lower-section" aria-labelledby="social-title" data-track-section="home_social_links" data-content-topic="social_media" data-user-intent="aktuelle_arbeiten_verfolgen" data-journey-stage="bindung" data-content-format="social_links" data-position="home_social">
      <p class="eyebrow" data-home-reveal>Folge mir auf Social Media</p>
      <h2 id="social-title" data-home-reveal data-home-reveal-delay="70">Aktuelle Arbeiten und Einblicke</h2>
      <div class="social-links" aria-label="Social Media Profile von Artbild-Fotografie" data-home-reveal data-home-reveal-delay="130">
        <a href="https://www.facebook.com/artbildfotografie/" rel="me" data-track-event="external_resource_click" data-resource-id="facebook_artbild" data-resource-type="social_profile" data-cta-id="home_social_facebook" data-cta-type="social_profile" data-section-id="home_social_links" data-content-topic="social_media" data-user-intent="social_profile_oeffnen" data-journey-stage="bindung">Facebook</a>
        <a href="https://instagram.com/artbild" rel="me" data-track-event="external_resource_click" data-resource-id="instagram_artbild" data-resource-type="social_profile" data-cta-id="home_social_instagram" data-cta-type="social_profile" data-section-id="home_social_links" data-content-topic="social_media" data-user-intent="social_profile_oeffnen" data-journey-stage="bindung">Instagram</a>
        <a href="https://www.pinterest.de/artbild/" rel="me" data-track-event="external_resource_click" data-resource-id="pinterest_artbild" data-resource-type="social_profile" data-cta-id="home_social_pinterest" data-cta-type="social_profile" data-section-id="home_social_links" data-content-topic="social_media" data-user-intent="social_profile_oeffnen" data-journey-stage="bindung">Pinterest</a>
      </div>
    </section>

    <EditorialReviewQuote
      reviews={allGoogleReviews}
      sectionId="home_review_lara_friedrichs"
      heading="Ein Hochzeitstag, der sich leicht anfühlen darf"
      contentTopic="hochzeitsreportage_hamburg"
      userIntent="erfahrung_verstehen"
      journeyStage="orientierung"
      position="after_services"
      mergeFollowingSection
    />

    <section class="contact-note home-lower-section" id="kontakt" aria-labelledby="contact-note-title" data-track-section="home_contact_options" data-content-topic="kontaktmoeglichkeiten" data-user-intent="kontakt_aufnehmen" data-journey-stage="anfrage" data-content-format="contact_cta" data-position="home_bottom">
      <div data-home-reveal>
        <p class="eyebrow">Kontakt</p>
        <h2 id="contact-note-title">Kurzfristige Hochzeitsanfragen</h2>
        <p>Für kurzfristige Anfragen nutzt Ihr am besten den Kontakt-Button unten rechts. Dort könnt Ihr WhatsApp, Kontaktformular oder E-Mail wählen. Über „Termin noch frei?“ prüft Ihr vorab, ob Euer Hochzeitstag nach aktuellem Kalenderstand verfügbar ist.</p>
      </div>
      <div class="contact-note__actions" data-home-reveal data-home-reveal-delay="100">
        <a href="/kontakt/" aria-label="Schnellkontakt über den Kontakt-Button öffnen" data-floating-action-external-open data-track-event="cta_click" data-cta-id="home_contact_fab" data-cta-type="floating_action_trigger" data-section-id="home_contact_options" data-content-topic="kontaktmoeglichkeiten" data-user-intent="schnellkontakt_oeffnen" data-journey-stage="anfrage">Kontakt-Button öffnen</a>
        <a href="/kontakt/" aria-label="Terminprüfung im Kontakt-Button öffnen" data-floating-action-external-availability data-track-event="cta_click" data-cta-id="home_contact_availability" data-cta-type="availability_check" data-section-id="home_contact_options" data-content-topic="terminverfuegbarkeit" data-user-intent="termin_pruefen" data-journey-stage="anfrage">Termin prüfen</a>
      </div>
    </section>
  </main>

  <a class="site-footer-return" href="#top" aria-label="Zurück zum Seitenanfang">
    <svg viewBox="0 0 14 24" aria-hidden="true" focusable="false">
      <path d="M1.5 7 7 1.5 12.5 7M7 1.5v21" />
    </svg>
  </a>

  <footer class="site-footer">
    <div>
      <h2>Artbild-Fotografie</h2>
      <p><a
        href="mailto:info@artbild-fotografie.de"
        data-track-event="contact_click"
        data-cta-id="home_footer_email"
        data-cta-type="email"
        data-section-id="home_footer"
        data-content-topic="kontaktmoeglichkeiten"
        data-user-intent="email_schreiben"
        data-journey-stage="conversion"
      >info@artbild-fotografie.de</a></p>
      <p>Rahlstedter Bahnhofstraße 27, 22143 Hamburg</p>
    </div>
    <nav aria-label="Footer">
      <a
        href="/kontakt/"
        data-track-event="contact_click"
        data-cta-id="home_footer_contact"
        data-cta-type="contact_form"
        data-section-id="home_footer"
        data-content-topic="kontaktmoeglichkeiten"
        data-user-intent="kontaktseite_oeffnen"
        data-journey-stage="conversion"
      >Kontakt</a>
      <a href="/blog/">Blog</a>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </nav>
    <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
  </footer>

</body>
</html>
