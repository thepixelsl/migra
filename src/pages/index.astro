    ctaLabel: "Freie Trautermine in Hamburg online prüfen und buchen",
    ctaType: "official_service_guide",
    topic: "standesamttermin_hamburg",
    intent: "termin_finden",
    stage: "vor_reservierung",
  },
  {
    title: "Hochzeitsfotograf Hamburg Preise",
    tileKicker: "Hochzeitsfotograf",
    tileTitle: "Preise",
    tileClass: "planning-card--prices",
    tileText: "Pakete und Leistungen",
    text: "Die drei angebotenen Pakete mit Dauer, Preis und den jeweils aufgeführten Leistungen im direkten Vergleich.",
    href: "/hochzeitsfotograf-preise/",
    image: priceCardImage,
    width: 924,
    height: 924,
    alt: "Braut mit Brautstrauß als Hinweis auf Hochzeitsfotograf Hamburg Preise",
    ctaLabel: "Preise ansehen",
    ctaType: "pricing_link",
    topic: "preise_pakete",
    intent: "preise_pruefen",
    stage: "vergleich",
  },
];

const planningCards = [...articleCards].sort((a, b) =>
  Number(b.href === "/hochzeitsfotograf-preise/") - Number(a.href === "/hochzeitsfotograf-preise/")
);

const serviceCards = [
  {
    title: "Hochzeitsreportagen",
    text: "In den Reportagegalerien seht ihr nicht nur Paarportraits, sondern auch Vorbereitungen, Trauung, Gratulationen und Feier als zusammenhängende Serie.",
    href: "/portfolio/",
    linkLabel: "Hochzeitsreportagen ansehen",
    topic: "hochzeitsreportage_hamburg",
    intent: "reportage_verstehen",
    stage: "orientierung",
    schemaType: "Hochzeitsreportage",
    areaServed: ["Hamburg", "Norddeutschland"],
  },
  {
    title: "Standesamtliche Trauungen in Hamburg",
    text: "Die Galerie aus dem Standesamt Altona zeigt Trauung, Gratulationen, Gruppenbilder und das anschließende Paarshooting.",
    href: "/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/",
    linkLabel: "Standesamtliche Trauung in Altona ansehen",
    topic: "standesamtliche_trauung_hamburg",
    intent: "standesamt_reportage_ansehen",
    stage: "auswahl",
    schemaType: "Standesamtliche Trauung",
    areaServed: ["Hamburg"],
  },
  {
    title: "Verlobungsshooting",
    text: "Die Lovebirds-Galerie am Elbstrand zeigt ein Paarshooting am Wasser mit Spaziergang, Bewegung und Portraits zu zweit.",
    href: "/gallery/lovebirds-am-elbstrand/",
    linkLabel: "Verlobungsshooting ansehen",
    topic: "verlobungsshooting_hamburg",
    intent: "paarshooting_planen",
    stage: "inspiration",
    schemaType: "Verlobungsshooting",
    areaServed: ["Hamburg", "Elbstrand"],
  },
];

const portfolioShowcase: PortfolioShowcaseItem[] = [
  {
    title: "Traumhochzeit in Paris",
    category: "Editorial",
    href: "/gallery/traumhochzeit-in-paris/",
    image: portfolioParisImage,
    alt: "Braut vor der Glaspyramide des Louvre bei einer Traumhochzeit in Paris",
    format: "portrait",
  },
  {
    title: "Hotel Atlantic Hamburg",
    category: "Hochzeit im Hotel Atlantic",
    href: "/gallery/traumhochzeit-in-hamburg/",
    image: portfolioAtlanticImage,
    alt: "Brautpaar bei seiner Hochzeit im Hotel Atlantic Hamburg",
    format: "portrait",
  },
  {
    title: "Lovebirds am Elbstrand",
    category: "Lovebirds",
    href: "/gallery/lovebirds-am-elbstrand/",
    image: portfolioLovebirdsImage,
    alt: "Inniger Moment eines Paares beim Lovebirds-Shooting am Elbstrand",
    format: "landscape",
  },
  {
    title: "Getting Ready Hamburg",
    category: "Getting Ready",
    href: "/gallery/hochzeit-braut-fotoshooting-hamburg/",
    image: portfolioGettingReadyImage,
    alt: "Braut beim Getting Ready und Brautstyling in einem Hamburger Hotel",
    format: "landscape",
  },
  {
    title: "Bräutigam im Barberhouse Hamburg",
    category: "Groom Getting Ready",
    href: "/gallery/braeutigam-im-barberhouse-hamburg/",
