    alt: "Bräutigam beim Getting Ready im Barberhouse Hamburg",
    format: "landscape",
  },
  {
    title: "Florale Portraits",
    category: "Floral Art",
    href: "/gallery/floral-art/",
    image: portfolioFloralImage,
    alt: "Künstlerisches Portrait mit floralem Kopfschmuck",
    format: "square",
  },
];

const vendors = [
  {
    name: "Katharina Seidl",
    text: "Florale Arbeiten von Katharina Seidl sind in der Floral-Art-Bildstrecke zu sehen.",
    href: "https://www.instagram.com/katharina.seidl/",
    cta: "Instagram-Profil öffnen",
  },
  {
    name: "Foboxy",
    text: "Externer Anbieter einer Fotobox, der auf der früheren Artbild-Seite empfohlen wurde.",
    href: "https://foboxy.de/",
    cta: "Anbieter öffnen",
  },
  {
    name: "Ella Deck Couture",
    text: "Die Galerie zeigt Portraits und Kleider aus dem Editorial mit Ella Deck Couture.",
    href: "/gallery/ella-deck-couture/",
    cta: "Editorial ansehen",
  },
  {
    name: "Visagistin Manija Biebow",
    text: "Die Bildstrecke dokumentiert das Brautstyling mit Manija Biebow in den Fraser Suites Hamburg.",
    href: "/gallery/visagistin-manja-biebow/",
    cta: "Bildstrecke ansehen",
  },
  {
    name: "Yildiz Duman-Werner",
    text: "Yildiz Duman-Werner war am Styling des Zürcher Editorials mit Stephanie und Laurin beteiligt.",
    href: "/gallery/yildiz-duman-werner/",
    cta: "Zusammenarbeit ansehen",
  },
];

const homepageSiteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${homepageSiteUrl}/#organization`,
      name: "Artbild-Fotografie",
      url: `${homepageSiteUrl}/`,
      image: `${homepageSiteUrl}/images/logo-artbild-black.png`,
      email: "info@artbild-fotografie.de",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
      ],
      serviceType: [
        "Hochzeitsfotografie",
        "Hochzeitsreportage",
        "Standesamtliche Trauung",
        "Standesamtfotografie",
        "Ganztägige Hochzeitsbegleitung",
        "Paarshooting",
        "Verlobungsshooting",
        "Getting Ready Fotografie",
      ],
      hasOfferCatalog: { "@id": `${homepageSiteUrl}/#hochzeitsfotografie-leistungen` },
    },
    {
      "@type": "OfferCatalog",
      "@id": `${homepageSiteUrl}/#hochzeitsfotografie-leistungen`,
      name: "Leistungen Hochzeitsfotografie Hamburg",
      description: "Leistungsübersicht mit belegten Beispielen für Hochzeitsreportagen, standesamtliche Trauungen und Verlobungsshootings von Artbild-Fotografie.",
      itemListElement: serviceCards.map((service, index) => ({
        "@type": "Offer",
        position: index + 1,
        url: `${homepageSiteUrl}${service.href}`,
        itemOffered: {
          "@type": "Service",
          "@id": `${homepageSiteUrl}/#service-${trackingSlug(service.title)}`,
          name: service.title,
          description: service.text,
          serviceType: service.schemaType,
          provider: { "@id": `${homepageSiteUrl}/#organization` },
          audience: {
            "@type": "Audience",
            audienceType: "Brautpaare und Paare mit Interesse an Hochzeitsfotografie",
          },
          areaServed: service.areaServed.map((name) => ({
            "@type": "Place",
            name,
          })),
          url: `${homepageSiteUrl}${service.href}`,
        },
      })),
    },
    {
      "@type": "ItemList",
      "@id": `${homepageSiteUrl}/#home-lower-sections`,
      name: "Hochzeitsfotografie Hamburg und Empfehlungen",
      itemListElement: [
        ...storyCards.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.title,
          url: `${homepageSiteUrl}${item.href}`,
        })),
        ...articleCards.map((item, index) => ({
          "@type": "ListItem",
          position: storyCards.length + index + 1,
          name: item.title,
          url: item.href.startsWith("http") ? item.href : `${homepageSiteUrl}${item.href}`,
        })),
        {
          "@type": "ListItem",
          position: storyCards.length + articleCards.length + 1,
          name: "Standesamtfinder Hamburg",
          url: `${homepageSiteUrl}/standesamt-hamburg/`,
        },
        ...portfolioShowcase.map((item, index) => ({
          "@type": "ListItem",
          position: storyCards.length + articleCards.length + index + 2,
          name: item.title,
          url: `${homepageSiteUrl}${item.href}`,
        })),
      ],
    },
  ],
};
---
<!doctype html>
<html lang="de">
<head>
  <FaviconHead />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Hochzeitsfotograf York Augustin aus Hamburg: Reportagegalerien, standesamtliche Trauungen, Preise und Kontakt zu Artbild-Fotografie.">
  <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
  <link rel="canonical" href={`${homepageSiteUrl}/`}>
  <title>Hochzeitsfotograf Hamburg</title>
  <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)}></script>
  <script src="/js/hero-slider.js" defer></script>
  <script src="/js/home-reveal.js" defer></script>
  <script src="/js/story-carousel.js" defer></script>
  <script src="/js/portfolio-showcase-carousel.js" defer></script>
  <script src="/js/vendor-carousel.js" defer></script>
</head>
<body id="top">
  <header class="gallery-header">
    <MobileNavigation />
    <DesktopNavigation />
  </header>

  <main>
    <section
      class="hero-slider hero-slider--desktop"
      data-hero-slider
      data-mode="desktop"
      aria-label="Hero Slider Desktop"
      data-track-section="home_hero_slider_desktop"
      data-content-topic="hochzeitsfotograf_hamburg"
      data-user-intent="bildstil_erleben"
      data-journey-stage="orientierung"
      data-content-format="image_slider"
      data-position="hero"
    >
      <div class="hero-slider__viewport">
        <div class="hero-slider__stage">
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroOpeningImage}
              fallbackSrc="/images/cropped-hochzeitsreportage_hamburg_festpreis-scaled-1.jpg"
              alt="Brautportrait mit Blumenstrauß"
            />
          </figure>
          <figure class="hero-slider__slide is-initial" data-focus-x="72" data-focus-y="98">
            <HeroSliderImage
              src={heroParis17Image}
              fallbackSrc="/images/paris_braut_fotoshooting-17.jpg"
              alt="Braut beim Fotoshooting in Paris"
              deferred={false}
              priority
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="97" data-focus-y="61">
            <HeroSliderImage
              src={heroParis25Image}
              fallbackSrc="/images/paris_braut_fotoshooting-25.jpg"
              alt="Lachende Braut vor dem Eiffelturm"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroParis16Image}
              fallbackSrc="/images/paris_braut_fotoshooting-16.jpg"
              alt="Braut in kurzem Kleid in Paris"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroParis31Image}
              fallbackSrc="/images/paris_braut_fotoshooting-31.jpg"
              alt="Portrait einer Braut am See"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroStaircase3822Image}
              fallbackSrc="/images/art_3822-verbessert-rr-bearbeitet-bearbeitet-scaled-1.jpg"
              alt="Braut auf einer eleganten Treppe"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroStaircase4102Image}
              fallbackSrc="/images/art_4102-verbessert-rr-bearbeitet-scaled-1.jpg"
              alt="Braut mit Bouquet im Treppenhaus"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroCastleGardenImage}
              fallbackSrc="/images/art_4265-bearbeitet-2_web.jpg"
              alt="Brautjungfer im Schweriner Schlossgarten"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroVeil4632Image}
              fallbackSrc="/images/art_4632.jpg"
              alt="Brautportrait mit Schleier"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroVeil3143Image}
              fallbackSrc="/images/art_3143-bearbeitet-scaled-2.jpg"
              alt="Braut mit Schleier"
            />
          </figure>
          <figure class="hero-slider__slide" data-focus-x="50" data-focus-y="50">
            <HeroSliderImage
              src={heroGettingReadyImage}
              fallbackSrc="/images/getting_ready_hochzeitsfotograf_hamburg2372-scaled-2.jpg"
              alt="Getting-ready-Moment vor der Hochzeit"
            />
          </figure>
        </div>
      </div>
