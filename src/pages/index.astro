    linkLabel: "Braut-Editorial ansehen",
    imageAsset: hochzeitsfotosHamburgHomepageImage,
    width: hochzeitsfotosHamburgHomepageImage.width,
    height: hochzeitsfotosHamburgHomepageImage.height,
    alt: "Brautportrait mit Blumenstrauß in den Fraser Suites Hamburg",
  },
  {
    title: "Hochzeit im Hotel Atlantic",
    kicker: "Hochzeit an der Alster",
    text: "Getrenntes Getting Ready im Hotel, Paarportraits an der Alster und der Anschnitt der Hochzeitstorte als Abschluss der Bildstrecke.",
