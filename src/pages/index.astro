type StoryCard = {
  title: string;
  kicker: string;
  text: string;
  href: string;
  linkLabel: string;
  image?: string;
  imageAsset?: ImageMetadata;
  width: number;
  height: number;
  alt: string;
};

type PortfolioShowcaseItem = {
  title: string;
  category: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  format: "portrait" | "landscape" | "square";
};

const trackingSlug = (value: string) => value
  .toLowerCase()
  .replace(/ä/g, "ae")
  .replace(/ö/g, "oe")
  .replace(/ü/g, "ue")
  .replace(/ß/g, "ss")
  .replace(/[^a-z0-9]+/g, "_")
  .replace(/^_+|_+$/g, "");

const storyCards: StoryCard[] = [
  {
    title: "Hochzeit von Steffi & Dominik",
    kicker: "Hochzeit in der Nordheide",
    text: "Oldtimer, Ringtausch, Baumstammsägen, Paarbilder am See und die Feier in einer Hofscheune: die Stationen von Steffi und Dominiks Hochzeit in Buchholz.",
    href: "/gallery/steffi-dominik/",
    linkLabel: "Hochzeit von Steffi & Dominik ansehen",
    imageAsset: steffiDominikHomepageImage,
    width: steffiDominikHomepageImage.width,
    height: steffiDominikHomepageImage.height,
    alt: "Steffi und Dominik küssen sich bei ihrer Hochzeit in der Nordheide",
  },
  {
    title: "Hochzeit Jahrhunderthalle Bochum",
    kicker: "Hochzeit Ruhrgebiet",
    text: "Getting Ready, Portraits zwischen Backstein und Stahl sowie die Feier im Dampfgebläsehaus an der Jahrhunderthalle Bochum.",
