    linkLabel: "Hochzeit im Hotel Atlantic ansehen",
    imageAsset: portfolioAtlanticImage,
    width: portfolioAtlanticImage.width,
    height: portfolioAtlanticImage.height,
    alt: "Brautpaar bei seiner Hochzeit im Hotel Atlantic Hamburg",
  },
  {
    title: "Brautpaar in Zürich",
    kicker: "Styled Editorial in Zürich",
    text: "Das Styled Editorial mit Stephanie und Laurin führte an die Limmat und durch Zürich; beteiligt waren Connection-of-Us und Yildiz Duman-Werner.",
    href: "/brautpaar-in-zuerich/",
    linkLabel: "Brautpaarshooting in Zürich ansehen",
    imageAsset: brautpaarZuerichHomepageImage,
    width: brautpaarZuerichHomepageImage.width,
    height: brautpaarZuerichHomepageImage.height,
    alt: "Brautpaar unterwegs durch Zürich mit eleganter Hochzeitsinspiration",
  },
];

const articleCards = [
  {
    title: "Das perfekte Getting Ready für deine Hochzeit in Hamburg",
    tileKicker: "Hochzeit",
    tileTitle: "Getting Ready",
    tileClass: "planning-card--getting-ready",
    tileText: "Vorbereitung und Tipps",
    text: "Eine Planungshilfe zu Zimmerwahl, verfügbarem Licht, beteiligten Personen und dem zeitlichen Ablauf am Hochzeitsmorgen.",
    href: "/das-perfekte-getting-ready-fuer-deine-hochzeit-in-hamburg/",
    image: gettingReadyPlanningImage,
    width: gettingReadyPlanningImage.width,
    height: gettingReadyPlanningImage.height,
    alt: "Braut beim Getting Ready in Hamburg",
