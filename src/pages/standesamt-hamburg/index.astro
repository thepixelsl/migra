---
import FaviconHead from "../../components/FaviconHead.astro";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hamburgStadtteile } from "../../data/hamburgStadtteile";
import { standesaemter } from "../../data/standesaemter";
import { trauorte, type Trauort } from "../../data/trauorte";
import "../../styles/global.css";

const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/standesamt-hamburg/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "Standesamtfinder Hamburg: Adressen & Kontakt";
const description =
  "Standesamtfinder Hamburg: Wohnsitzstandesamt finden und besondere Trauorte in Hamburg und Umgebung mit Buchungsweg, Adresse und offiziellen Links vergleichen.";
const dateModified = "2026-08-08";
const heroImagePath =
  "/migrated-assets/standesamt-hamburg/rathaus-altona.jpg";
const heroImageUrl = `${siteUrl}${heroImagePath}`;
const traueCalendarUrl = "https://standesamtstermine.hamburg.de/";
const officialJurisdictionUrl =
  "https://www.hamburg.de/service/info/11266636/n0/";
const sortedHamburgStadtteile = [...hamburgStadtteile].sort((a, b) =>
  a.name.localeCompare(b.name, "de"),
);
const sortedTrauorte = [...trauorte].sort((a, b) => {
  if (a.region !== b.region) return a.region === "hamburg" ? -1 : 1;
  return a.name.localeCompare(b.name, "de");
});
const hamburgTrauorte = sortedTrauorte.filter((venue) => venue.region === "hamburg");
const umlandTrauorte = sortedTrauorte.filter((venue) => venue.region === "umland");
const compactPhoneSlots = [0, 1, 2];

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: "Standesamtfinder Hamburg", href: pagePath },
];

const addressQuery = (office: (typeof standesaemter)[number]) =>
  `${office.name}, ${office.street}, ${office.postalCode} ${office.city}`;

const googleMapsUrl = (office: (typeof standesaemter)[number]) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressQuery(office))}`;

const appleMapsUrl = (office: (typeof standesaemter)[number]) =>
  `https://maps.apple.com/?q=${encodeURIComponent(office.name)}&address=${encodeURIComponent(
    `${office.street}, ${office.postalCode} ${office.city}`,
  )}`;

const trauortAddress = (venue: Trauort) =>
  venue.address
    ? `${venue.address.street}, ${venue.address.postalCode} ${venue.address.city}`
    : venue.meetingPoint ?? "Ort vor der Buchung bestätigen";

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      dateModified,
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: heroImageUrl,
        width: 1384,
        height: 924,
      },
      mainEntity: { "@id": `${pageUrl}#standesaemter` },
      inLanguage: "de",
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#standesaemter`,
      name: "Standesämter in Hamburg und Norderstedt",
      numberOfItems: standesaemter.length,
      itemListElement: standesaemter.map((office, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "GovernmentOffice",
          name: office.name,
          url: office.officialUrl,
          email: office.email,
          telephone: office.phones[0]?.href.replace(/^tel:/, ""),
          address: {
            "@type": "PostalAddress",
            streetAddress: office.street,
            postalCode: office.postalCode,
            addressLocality: office.city,
            addressCountry: "DE",
          },
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={heroImageUrl}>
    <meta property="og:image:width" content="1384">
    <meta property="og:image:height" content="924">
    <meta
      property="og:image:alt"
      content="Rathaus Altona mit dem Kaiser-Wilhelm-Denkmal"
    >
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
    <script src="/js/standesamt-finder-fixed-20260731.js" defer></script>
    <script src="/js/standesamt-trauorte.js" defer></script>
  </head>
  <body class="standesamt-page">
    <header class="gallery-header">
      <MobileNavigation showFloatingAction={false} />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs
        items={breadcrumbs}
        siteUrl={siteUrl}
        currentUrl={pageUrl}
      />

      <article class="standesamt-finder" data-standesamt-finder>
        <header class="finder-hero">
          <div class="finder-hero__copy">
            <p class="eyebrow">Hamburg & Umgebung</p>
            <h1>
              <span>Standesamtfinder</span>
              {" "}
              <span>Hamburg</span>
            </h1>
            <p class="finder-hero__lead">
              Findet zuerst das Amt für die Anmeldung – und prüft danach
              besondere Trauorte mit Buchungsweg und offiziellen Links.
            </p>
            <p class="finder-hero__meta">
              {standesaemter.length} Standesämter
              <span aria-hidden="true">·</span>
              Hinweise zu besonderen Trauorten
              <span aria-hidden="true">·</span>
              Planungshilfe mit offiziellen Links
            </p>
          </div>

          <figure class="finder-hero__image">
            <img
              src={heroImagePath}
              width="1384"
              height="924"
              alt="Rathaus Altona mit dem Kaiser-Wilhelm-Denkmal"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            >
            <figcaption>Rathaus Altona · Platz der Republik</figcaption>
          </figure>
        </header>

        <section
          class="finder-section finder-task finder-task--office"
          aria-labelledby="finder-heading"
        >
          <header class="finder-task__header">
            <div class="finder-task__heading">
              <div class="finder-task__step">
                <span class="finder-task__number" aria-hidden="true">1</span>
                <p class="eyebrow">Für die Anmeldung</p>
              </div>
              <h2 id="finder-heading"><span>Wohnsitz</span><wbr><span>standesamt finden</span></h2>
            </div>
            <div class="finder-task__explanation">
              <p class="finder-task__question">Welches Amt ist zuständig?</p>
              <p>
                Wählt euren Wohnstadtteil. Das Ergebnis zeigt das Amt für die
                Anmeldung samt Kontaktdaten.
              </p>
            </div>
          </header>

          <div class="finder-task__body">

          <div class="finder-interaction">
            <div class="finder-toolbar">
              <form
                class="finder-search"
                aria-label="Standesamt anhand des Wohnstadtteils finden"
                data-finder-form
              >
                <div class="finder-search__label">
                  <label for="standesamt-district">
                    Wohnstadtteil
                  </label>
                </div>
                <div class="finder-district__field">
                  <select
                    id="standesamt-district"
                    aria-controls="standesamt-finder-result"
                    aria-describedby="standesamt-district-help"
                    data-finder-district
                  >
                    <option value="">Stadtteil auswählen</option>
                    {sortedHamburgStadtteile.map((district) => (
                      <option
                        value={district.officeId}
                        data-district={district.name}
                      >
                        {district.name}
                      </option>
                    ))}
                  </select>
                </div>
                <div class="finder-search__meta">
                  <p
                    class="finder-search__help"
                    id="standesamt-district-help"
                  >
                    Wohnsitz entscheidet
                  </p>

                  <div class="finder-search__actions">
                    <button type="button" data-finder-clear hidden>
                      Auswahl zurücksetzen
                    </button>
                    <a
                      class="finder-jurisdiction-link"
                      href={officialJurisdictionUrl}
                      target="_blank"
                      rel="noopener"
                      aria-label="Zuständiges Standesamt mit Straße und Hausnummer auf hamburg.de prüfen"
                      data-track-event="external_resource_click"
                      data-resource-id="hamburg_service_standesamt_zustaendigkeit"
                      data-resource-type="official_city_service"
                      data-cta-id="standesamtfinder_adresspruefung"
                      data-cta-type="external_official_service"
                      data-section-id="standesamtfinder_toolbar"
                      data-content-topic="standesamt_zustaendigkeit"
                      data-user-intent="zustaendigkeit_pruefen"
                      data-journey-stage="orientierung"
                    >
                      Mit Straße und Hausnummer amtlich prüfen
                    </a>
                  </div>
                </div>

                <noscript>
                  <p class="finder-noscript">
                    Die automatische Auswahl benötigt JavaScript. Alternativ könnt
                    ihr die amtliche Adressprüfung oder die Kontaktliste darunter
                    nutzen.
                  </p>
                </noscript>
              </form>
            </div>

            <section
              class="finder-result"
              id="standesamt-finder-result"
              data-finder-result
              data-state="empty"
              aria-labelledby="standesamt-finder-result-heading"
            >
              <header class="finder-result__header">
                <h3 id="standesamt-finder-result-heading">
                  Zuständiges Standesamt
                </h3>
                <span
                  class="finder-result__state"
                  aria-hidden="true"
                  data-finder-result-state
                >
                  Bitte wählen
                </span>
              </header>

              <div class="finder-result__body">
                <div
                  class="finder-result__placeholder"
                  data-finder-result-placeholder
                  aria-hidden="false"
                >
                  <p class="finder-result__placeholder-title">
                    Stadtteil auswählen
                  </p>
                  <p class="finder-result__placeholder-copy">
                    Das zuständige Standesamt erscheint genau hier.
                  </p>
                  <dl class="finder-result__preview" aria-hidden="true">
                    <div><dt>Adresse</dt><dd>—</dd></div>
                    <div><dt>Telefon</dt><dd>—</dd></div>
                    <div><dt>E-Mail</dt><dd>—</dd></div>
                  </dl>
                </div>

                <div
                  class="finder-result__content"
                  data-finder-result-content
                >
                  {standesaemter.map((office) => (
                    <article
                      class="finder-compact-card"
                      data-finder-result-card
                      data-office-id={office.id}
                      data-office-name={office.name}
                      aria-hidden="true"
                      inert
                    >
                      <header class="finder-compact-card__header">
                        <h4>{office.name}</h4>
                        <p>
                          Zuständig für <strong data-finder-result-district>&nbsp;</strong>
                        </p>
                      </header>

                      <dl class="finder-compact-card__contacts">
                        <div>
                          <dt>Adresse</dt>
                          <dd>
                            <address>
                              {office.street}<br>
                              {office.postalCode} {office.city}
                            </address>
                          </dd>
                        </div>
                        <div>
                          <dt>Telefon</dt>
                          <dd>
                            <ul>
                              {compactPhoneSlots.map((slot) => {
                                const phone = office.phones[slot];
                                return (
                                  <li class:list={{ "is-empty": !phone }}>
                                    {phone ? (
                                      <a
                                        href={phone.href}
                                        aria-label={phone.label
                                          ? `${phone.label}: ${phone.display}`
                                          : phone.display}
                                      >
                                        {phone.display}
                                      </a>
                                    ) : (
                                      <span aria-hidden="true">&nbsp;</span>
                                    )}
                                  </li>
                                );
                              })}
                            </ul>
                          </dd>
                        </div>
                        <div>
                          <dt>E-Mail</dt>
                          <dd>
                            <a href={`mailto:${office.email}`}>{office.email}</a>
                          </dd>
                        </div>
                      </dl>

                      <nav
                        class="finder-compact-card__links"
                        aria-label={`Links für ${office.name}`}
                      >
                        <a
                          href={googleMapsUrl(office)}
                          target="_blank"
                          rel="noopener"
                          aria-label={`${office.name} in Google Maps öffnen`}
                        >
                          Route öffnen
                        </a>
                        <a
                          href={office.officialUrl}
                          target="_blank"
                          rel="noopener"
                          aria-label={`Offizielle Seite von ${office.name} öffnen`}
                        >
                          Behördenseite
                        </a>
                      </nav>
                    </article>
                  ))}
                </div>
              </div>

              <p
                class="finder-status"
                role="status"
                aria-live="polite"
                aria-atomic="true"
                data-finder-status
              ></p>

            </section>
          </div>

          </div>
        </section>

        <section
          class="trauort-section finder-task finder-task--venue"
          data-trauort-finder
          aria-labelledby="trauort-heading"
        >
          <header class="finder-task__header">
            <div class="finder-task__heading">
              <div class="finder-task__step">
                <span class="finder-task__number" aria-hidden="true">2</span>
                <p class="eyebrow">Für die Trauung</p>
              </div>
              <h2 id="trauort-heading">Besonderen Trauort prüfen</h2>
            </div>
            <div class="finder-task__explanation">
              <p class="finder-task__question">Wo möchtet ihr heiraten?</p>
              <p>
                Wählt eine Location. Ihr seht Buchungsweg, zuständiges Amt und
                offizielle Anlaufstellen.
              </p>
              <p class="finder-task__notice">
                Diese Seite nennt bewusst keine Preise, Kapazitäten oder festen
                Trautage. Prüft diese Angaben vor jeder Buchung in der amtlichen
                Quelle und gegebenenfalls direkt bei der Location.
              </p>
            </div>
          </header>

          <div class="finder-task__body">
          <div class="trauort-interaction">
            <form
              class="trauort-search"
              aria-label="Besonderen standesamtlichen Trauort vergleichen"
            >
              <div class="trauort-search__label">
                <label for="besonderer-trauort">
                  Besonderen Trauort auswählen
                </label>
              </div>

              <div class="trauort-search__field">
                <select
                  id="besonderer-trauort"
                  data-trauort-select
                  aria-controls="trauort-finder-result"
                  aria-describedby="trauort-search-help"
                >
                  <option value="">Trauort auswählen</option>
                  <optgroup label="Hamburg">
                    {hamburgTrauorte.map((venue) => (
                      <option value={venue.id}>{venue.name}</option>
                    ))}
                  </optgroup>
                  <optgroup label="Hamburger Umland">
                    {umlandTrauorte.map((venue) => (
                      <option value={venue.id}>{venue.name}</option>
                    ))}
                  </optgroup>
                </select>
              </div>

              <p class="trauort-search__help" id="trauort-search-help">
                Anmeldung der Ehe weiterhin beim Wohnsitzstandesamt
              </p>

              <div class="trauort-search__reset-slot">
                <button
                  class="trauort-search__reset"
                  type="button"
                  data-trauort-reset
                  hidden
                  aria-hidden="true"
                >
                  Auswahl zurücksetzen
                </button>
              </div>

              <noscript>
                <p class="finder-noscript">
                  Die Auswahl benötigt JavaScript. Alle Trauorte und
                  Buchungswege stehen auch im Verzeichnis darunter.
                </p>
              </noscript>
            </form>

            <section
              class="trauort-result"
              id="trauort-finder-result"
              data-trauort-result
              data-state="empty"
              aria-labelledby="trauort-result-heading"
            >
              <header class="trauort-result__header">
                <h3 id="trauort-result-heading">Buchung des Trauorts</h3>
                <span
                  class="trauort-result__state"
                  aria-hidden="true"
                  data-trauort-result-state
                >
                  Bitte wählen
                </span>
              </header>

              <div class="trauort-result__body">
                <div
                  class="trauort-result__placeholder"
                  data-trauort-placeholder
                  aria-hidden="false"
                >
                  <p class="trauort-result__placeholder-title">
                    Trauort auswählen
                  </p>
                  <p class="trauort-result__placeholder-copy">
                    Buchungsweg, zuständiges Amt und die nötige Bestätigung
                    erscheinen genau hier.
                  </p>
                  <dl class="trauort-result__preview" aria-hidden="true">
                    <div><dt>Buchung</dt><dd>—</dd></div>
                    <div><dt>Standesamt</dt><dd>—</dd></div>
                    <div><dt>Bestätigung</dt><dd>—</dd></div>
                  </dl>
                </div>

                <div class="trauort-result__content">
                  {sortedTrauorte.map((venue) => (
                    <article
                      class="trauort-compact-card"
                      data-trauort-result-card
                      data-trauort-id={venue.id}
                      data-active="false"
                      hidden
                      aria-hidden="true"
                    >
                      <header class="trauort-compact-card__header">
                        <div class="trauort-compact-card__meta">
                          <span>{venue.region === "hamburg" ? "Hamburg" : "Umland"}</span>
                        </div>
                        <h4>{venue.name}</h4>
                        <p>{trauortAddress(venue)}</p>
                      </header>

                      <dl class="trauort-compact-card__facts">
                        <div>
                          <dt>Buchung</dt>
                          <dd>{venue.bookingModeLabel}</dd>
                        </div>
                        <div>
                          <dt>Standesamt</dt>
                          <dd>{venue.officeName}</dd>
                        </div>
                        <div>
                          <dt>Bestätigung</dt>
                          <dd>
                            Termin und Konditionen aktuell beim Standesamt und
                            gegebenenfalls bei der Location bestätigen.
                          </dd>
                        </div>
                      </dl>

                      <nav
                        class="trauort-compact-card__links"
                        aria-label={`Buchungslinks für ${venue.name}`}
                      >
                        <a
                          href={venue.bookingUrl ?? venue.officialAuthorityUrl}
                          target="_blank"
                          rel="noopener"
                          aria-label={`Trautermin für ${venue.name} beim zuständigen Standesamt prüfen`}
                          data-track-event="external_resource_click"
                          data-resource-id={`trauort_${venue.id}_standesamt`}
                          data-resource-type="official_authority"
                          data-cta-id={`trauortfinder_${venue.id}_termin`}
                          data-cta-type="external_official_service"
                          data-section-id="trauortfinder_ergebnis"
                          data-content-topic="aussentrauort_buchung"
                          data-user-intent="trautermin_pruefen"
                          data-journey-stage="vor_reservierung"
                        >
                          Trautermin prüfen
                        </a>
                        {venue.officialVenueUrl && (
                          <a
                            href={venue.officialVenueUrl}
                            target="_blank"
                            rel="noopener"
                            aria-label={`Offizielle Locationseite von ${venue.name} öffnen`}
                            data-track-event="external_resource_click"
                            data-resource-id={`trauort_${venue.id}_location`}
                            data-resource-type="venue_website"
                            data-cta-id={`trauortfinder_${venue.id}_location`}
                            data-cta-type="external_venue_information"
                            data-section-id="trauortfinder_ergebnis"
                            data-content-topic="aussentrauort_buchung"
                            data-user-intent="location_pruefen"
                            data-journey-stage="orientierung"
                          >
                            Location ansehen
                          </a>
                        )}
                      </nav>
                    </article>
                  ))}
                </div>
              </div>

              <p
                class="finder-status"
                role="status"
                aria-live="polite"
                aria-atomic="true"
                data-trauort-status
              ></p>
            </section>
          </div>

          </div>
        </section>

        <section class="finder-more" aria-labelledby="finder-more-heading">
          <header class="finder-more__header">
            <div>
              <p class="eyebrow">Planung & offizielle Quellen</p>
              <h2 id="finder-more-heading">Weitere Informationen</h2>
            </div>
            <p>
              Die ausführlichen Listen bleiben geschlossen, bis ihr sie
              benötigt. Alle Kontaktdaten und Buchungswege sind dennoch
              vollständig auf der Seite vorhanden.
            </p>
          </header>

          <div class="finder-more__resources">
          <details class="office-directory" data-finder-directory>
            <summary>Alle Standesämter und Kontaktdaten</summary>

            <div class="office-grid" id="standesamt-results">
              {standesaemter.map((office, index) => (
                <article
                  class="office-card"
                  id={office.id}
                  data-standesamt-card
                  data-office-id={office.id}
                  data-office-name={office.name}
                >
                  <header class="office-card__header">
                    <p class="office-card__number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <div>
                      <p class="office-card__location">{office.location}</p>
                      <h3>{office.name}</h3>
                    </div>
                  </header>

                  <dl class="office-card__contacts">
                    <div>
                      <dt>Adresse</dt>
                      <dd>
                        <address>
                          {office.street}<br>
                          {office.postalCode} {office.city}
                        </address>
                      </dd>
                    </div>
                    <div>
                      <dt>Telefon</dt>
                      <dd>
                        <ul>
                          {office.phones.map((phone) => (
                            <li>
                              <a href={phone.href}>{phone.display}</a>
                              {phone.label && <span>{phone.label}</span>}
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                    <div>
                      <dt>E-Mail</dt>
                      <dd>
                        <a href={`mailto:${office.email}`}>{office.email}</a>
                      </dd>
                    </div>
                  </dl>

                  <nav
                    class="office-card__links"
                    aria-label={`Links für ${office.name}`}
                  >
                    <a
                      href={googleMapsUrl(office)}
                      target="_blank"
                      rel="noopener"
                      aria-label={`${office.name} in Google Maps öffnen`}
                    >
                      Google Maps
                    </a>
                    <a
                      href={appleMapsUrl(office)}
                      target="_blank"
                      rel="noopener"
                      aria-label={`${office.name} in Apple Karten öffnen`}
                    >
                      Apple Karten
                    </a>
                    <a
                      href={office.officialUrl}
                      target="_blank"
                      rel="noopener"
                      aria-label={`Offizielle Seite von ${office.name} öffnen`}
                    >
                      Offizielle Seite
                    </a>
                  </nav>
                </article>
              ))}
            </div>
          </details>

          <details class="trauort-directory" data-trauort-directory>
            <summary>
              Mögliche Trauorte und offizielle Anlaufstellen
            </summary>

            <div class="trauort-directory__body">
              <p class="trauort-directory__intro">
