---
import { Image } from 'astro:assets';
import KirchenLayout from '../../layouts/KirchenLayout.astro';
import ChurchBooking from '../../components/ChurchBooking.astro';
import ChurchQuestion from '../../components/ChurchQuestion.astro';
import hero from '../../assets/kirchenfinder/kirche-alt-rahlstedt.jpg';
import { churches, churchRegions, finderPath, guidePath, kirchenStandLabel, churchCollection, catholicChurches, additionalChurchResearch, phoneHref } from '../../data/kirchen';
import finderScript from '../../scripts/kirchenfinder.js?url&no-inline';
const siteUrl=Astro.site?.toString().replace(/\/$/,'')??'https://artbild-fotografie.de';
const featured=['alt-rahlstedt','michel','gertrud-altenwerder'].map(id=>churches.find(church=>church.id===id)!);
---
<KirchenLayout title="Kirchen für Eure Hochzeit in Hamburg | Kirchenfinder" description={`Kirchlich heiraten in Hamburg: ${churches.length} Kirchen und Trauorte, davon ${catholicChurches.length} katholische Kirchen. Kontakte, Anmeldung, Voraussetzungen und Bauhinweise.`} pagePath={finderPath} collection image={hero.src} graph={[churchCollection(siteUrl)]} breadcrumbs={[{label:'Startseite',href:'/'},{label:'Kirchliche Trauung',href:guidePath},{label:'Kirchenfinder Hamburg',href:finderPath}]}>
  <div class="church-wrap">
    <header class="church-hero">
      <p class="church-eyebrow">Kirchenfinder · Hamburg & Braak</p>
      <h1>Kirchen für Eure Hochzeit<span>in Hamburg.</span></h1>
      <p class="church-hero__lead">Ihr möchtet kirchlich heiraten? Hier findet Ihr die Kontakte für Eure Wunschkirche, den Weg zur Anmeldung und die Bedingungen vor Ort. Von Alt-Rahlstedt bis Altenwerder, mit allen fünf Hamburger Hauptkirchen.</p>
      <div class="church-actions"><a class="church-button" href="#kirchen">Kirche finden</a><a class="church-text-link" href={guidePath}>Fragen zu Voraussetzungen, Kosten & Ablauf</a></div>
      <nav aria-label="Themen im Kirchenfinder"><ul class="church-jump-links"><li><a href="#kirchen">Kirchen & Kontakte</a></li><li><a href="#fragen-zur-kirchenwahl">Fragen zur Kirchenwahl</a></li></ul></nav>
    </header>
    <section class="church-intro" aria-labelledby="church-intro-title">
      <figure><Image src={hero} alt="Kirche Alt-Rahlstedt mit dem Weg zum Eingang im Gegenlicht" widths={[420,680,960,1386]} sizes="(max-width: 700px) calc(100vw - 48px), 508px" format="webp" loading="eager" fetchpriority="high" /><figcaption>Kirche Alt-Rahlstedt · Fotografie aus dem Artbild-Archiv</figcaption></figure>
      <div class="church-intro__copy"><p class="church-eyebrow">Von der Idee zur Anmeldung</p><h2 id="church-intro-title">Wo möchtet Ihr<br />kirchlich heiraten?</h2><p>Vielleicht soll es die Kirche sein, in der Ihr getauft wurdet. Vielleicht der Michel oder die kleine Kirche in Altenwerder. Auch wenn Ihr nicht zur Gemeinde gehört, lohnt sich eine Anfrage – viele Gemeinden beschreiben dafür einen eigenen Anmeldeweg.</p><p>Im Verzeichnis findet Ihr {churches.length} Kirchen und kirchliche Trauorte, darunter {catholicChurches.length} katholische Kirchen, das Immanuel-Haus und die Auferstehungskirche in Braak. Wo nur die Pfarrei einen Anmeldeweg veröffentlicht, steht das ausdrücklich dabei.</p><a class="church-text-link" href="#so-arbeiten-wir">Was die Angaben bedeuten</a></div>
    </section>
    <section id="kirchen" class="church-section church-reader" aria-labelledby="church-directory-title" data-church-finder>
      <header class="church-section__head"><div><p class="church-eyebrow">{churches.length} Kirchen & Trauorte · Kontakte & Anmeldung</p><h2 id="church-directory-title">Eure Wunschkirche finden.</h2></div><p>Sucht nach Kirche oder Stadtteil. Unter „Kontakt & Anmeldung“ findet Ihr direkt den Ansprechpartner und die Antworten auf Eure Planungsfragen.</p></header>
      <nav aria-label="Kirchen nach Konfession"><ul class="church-jump-links"><li><a href={finderPath+'#kirchen'}>Alle Kirchen</a></li><li><a href={finderPath+'?konfession=römisch-katholisch#kirchen'}>Katholische Kirchen ({catholicChurches.length})</a></li><li><a href="#weitere-katholische-kirchen">Weitere katholische Standorte</a></li></ul></nav>
      <form class="church-filter" action={finderPath+'#kirchen'} method="get" aria-label="Kirchen und Trauorte filtern" data-church-filter hidden>
        <div><label for="church-query">Kirche oder Stadtteil</label><input type="search" name="q" id="church-query" placeholder="z. B. Michel oder Altenwerder" maxlength="120" autocomplete="off" /></div>
        <div><label for="church-region">Bereich</label><select id="church-region" name="bereich"><option value="">Alle Bereiche</option>{churchRegions.map(region=><option value={region}>{region}</option>)}</select></div>
        <div><label for="church-denomination">Konfession</label><select id="church-denomination" name="konfession"><option value="">Alle Konfessionen</option><option value="evangelisch-lutherisch">Evangelisch-lutherisch</option><option value="römisch-katholisch">Katholisch</option></select></div>
        <div class="church-filter__actions"><button type="submit" class="church-button">Anzeigen</button><button type="button" class="church-button church-button--light" data-church-reset>Zurücksetzen</button></div>
      </form>
      <noscript><p>Alle Trauorte stehen im Verzeichnis. Ihr könnt die Buchungswege auch ohne JavaScript öffnen.</p></noscript>
      <div class="church-results-bar"><p role="status" aria-live="polite" aria-atomic="true" tabindex="-1" data-church-count>{churches.length} Trauorte im Verzeichnis</p><p>Quellen geprüft: <time datetime="2026-09-27">{kirchenStandLabel}</time></p></div>
      <div class="church-notice" data-church-empty hidden><p>Für diese Auswahl gibt es noch keinen Eintrag. Versucht einen anderen Namen oder einen größeren Bereich.</p><button type="button" class="church-button church-button--light" data-church-reset>Alle Trauorte anzeigen</button></div>
      <ul class="church-directory" aria-label="Kirchen mit örtlichem Traubeleg oder Anmeldeweg über die Pfarrei">
        {churches.map(church=><li id={church.id} data-church-entry data-search={`${church.name} ${church.area} ${church.region} ${church.name.startsWith('Hauptkirche')?'Hauptkirchen':''}`} data-region={church.region} data-denomination={church.isCatholic?'römisch-katholisch':church.denomination}>
          <article class="church-row" aria-labelledby={`name-${church.id}`}>
            <div><p class="church-row__meta">{church.area} · {church.isCatholic?'Katholisch':'Evangelisch'}</p><h3 id={`name-${church.id}`}>{church.name}</h3>{church.hasBuildingNote&&<span class="church-badge church-badge--restricted">{church.buildingLabel}</span>}{church.isParishOffer&&<span class="church-badge">Trauort mit Pfarrei klären</span>}{church.denomination==='katholisch (maronitisch)'&&<span class="church-badge">Maronitischer Ritus</span>}{church.scope==='Umland'&&<span class="church-badge">Braak · außerhalb Hamburgs</span>}{church.venueType!=='Kirche'&&<span class="church-badge">Gemeindezentrum</span>}</div>
            <div class="church-row__brief"><p>{church.highlight}</p>{church.portrait&&<a class="church-row__link" href={church.url}>Mehr zur Trauung in dieser Kirche →</a>}</div>
            <details class="church-details"><summary aria-label={`Kontakt und Anmeldung für ${church.name}`}>Kontakt & Anmeldung</summary><ChurchBooking church={church} /></details>
          </article>
        </li>)}
      </ul>
    </section>
    <section id="fragen-zur-kirchenwahl" class="church-section church-reader" aria-labelledby="finder-faq-title">
      <p class="church-eyebrow">Fragen zur Kirchenwahl</p><h2 id="finder-faq-title">Welche Kirche kommt für uns infrage?</h2>
      <div class="church-questions">
        <ChurchQuestion number={1} question="Kann man in allen fünf Hamburger Hauptkirchen heiraten?" open><p>Für St. Michaelis (Michel), St. Petri, St. Jacobi, St. Katharinen und St. Nikolai am Klosterstern gibt es offizielle Trauangebote. Die Kontakte und veröffentlichten Bedingungen stehen im Verzeichnis.</p><p>Bei St. Nikolai ist die heutige Hauptkirche am Klosterstern gemeint. Für St. Jacobi sind Bauarbeiten von 2028 bis 2034 angekündigt; fragt für Euer Datum nach den Auswirkungen.</p><a href={finderPath+'?q=Hauptkirchen#kirchen'}>Die fünf Hauptkirchen anzeigen →</a></ChurchQuestion>
        <ChurchQuestion number={2} question="Können wir in der Kirche in Altenwerder heiraten?"><p>Ja, die Thomasgemeinde nennt St. Gertrud Altenwerder ausdrücklich als Traukirche und begrüßt auch Paare aus anderen Gemeinden. Euren Termin fragt Ihr im Gemeindebüro der Thomasgemeinde an.</p><p>Die Kirche wurde am 7. September 2025 wiedereröffnet. Klärt mit dem Büro, ob für Euren Hochzeitstag Einschränkungen gelten und wie Eure Gäste die Kirche erreichen.</p><a href={finderPath+'st-gertrud-altenwerder/'}>Kontakt und Anmeldung für Altenwerder →</a></ChurchQuestion>
        <ChurchQuestion number={3} question="Müssen wir in der Gemeinde wohnen, in der wir heiraten möchten?"><p>Nicht unbedingt. Viele Gemeinden nehmen Traupaare von außerhalb an, haben dafür aber unterschiedliche Bedingungen. Manchmal braucht Ihr eine Bescheinigung Eurer Heimatgemeinde, manchmal müsst Ihr eine eigene Pastorin oder einen eigenen Pastor mitbringen.</p><p>In den Einträgen steht, was die Gemeinde dazu veröffentlicht. Fehlt eine Angabe, fragt beim Kirchenbüro nach, bevor Ihr weitere Termine festmacht.</p></ChurchQuestion>
        <ChurchQuestion number={4} question="Wo finden wir eine katholische Kirche für die Hochzeit?"><p>Im Finder stehen {catholicChurches.length} katholische Kirchen: vom St. Marien-Dom und Kleinen Michel über Mariä Himmelfahrt in Rahlstedt bis St. Petrus auf Finkenwerder und Heilig Kreuz in Neugraben. Wählt oben „Katholisch“, dann seht Ihr die passenden Einträge.</p><p>Beginnt bei Eurer katholischen Wohnsitzpfarrei und fragt parallel die Wunschkirche an. Eine Vormerkung der Kirche allein reicht noch nicht: Auch der Priester oder Diakon, Eure Unterlagen und die persönliche Ehevorbereitung müssen geklärt sein. Die örtlichen Regeln stehen beim jeweiligen Eintrag.</p><a href={finderPath+'?konfession=römisch-katholisch#kirchen'}>Katholische Kirchen und Kontakte anzeigen →</a><p>Für weitere Standorte ist der öffentliche Traunachweis noch offen. Diese findet Ihr <a href="#weitere-katholische-kirchen">mit dem zuständigen Kontakt weiter unten</a>. Die grundsätzlichen Voraussetzungen erklärt der <a href={guidePath+'#voraussetzungen'}>Ratgeber zur kirchlichen Trauung</a>.</p></ChurchQuestion>
        <ChurchQuestion number={5} question="Können wir auch bei Bauarbeiten eine Trauung anfragen?"><p>Ja, fragt nach der konkreten Nutzung an Eurem Datum. Bauarbeiten bedeuten nicht automatisch, dass die Gemeinde keine Trauungen anbietet. Ein Trauangebot allein bestätigt umgekehrt nicht, dass das Kirchengebäude dann nutzbar ist.</p><p>Bei der Matthias-Claudius-Kirche in Wohldorf-Ohlstedt läuft nach dem Brand der Wiederaufbau. Sprecht deshalb ausdrücklich ab, an welchem Ort Eure Trauung stattfinden könnte.</p><a href={finderPath+'#matthias-claudius'}>Bauhinweis und Gemeindekontakt ansehen →</a></ChurchQuestion>
      </div>
      <a class="church-text-link" href={guidePath}>Weitere Fragen zu Anmeldung, Kosten und Ablauf →</a>
    </section>
    <section class="church-section" aria-labelledby="church-portraits-title"><p class="church-eyebrow">Drei Kirchen, drei Anmeldewege</p><h2 id="church-portraits-title">Michel, Alt-Rahlstedt oder Altenwerder?</h2><div class="church-featured church-featured--numbered">{featured.map((church,index)=><article><span class="church-number" aria-hidden="true">0{index+1}</span><div><h3><a href={church.url}>{church.name}</a></h3><p>{church.portrait?.introduction}</p><a class="church-text-link" href={church.url}>Anmeldung Schritt für Schritt →</a></div></article>)}</div></section>
    <section id="weitere-katholische-kirchen" class="church-section church-reader" aria-labelledby="church-research-title">
      <p class="church-eyebrow">Weitere katholische Kirchen · Stand {kirchenStandLabel}</p>
      <h2 id="church-research-title">Eure Kirche ist noch nicht dabei?</h2>
      <p>Auch diese {additionalChurchResearch.length} Standorte haben wir geprüft. Für sie fehlt entweder ein konkreter öffentlicher Traunachweis, oder es gibt eine Schließung beziehungsweise Umnutzung. Sie zählen deshalb nicht zu den {churches.length} Einträgen oben. Ein fehlender Traunachweis bedeutet nicht, dass Ihr dort nicht heiraten könnt.</p>
      <div class="church-questions">
        {additionalChurchResearch.map((entry,index)=><ChurchQuestion number={index+1} question={`${entry.name} · ${entry.area}`}>
          <p>{entry.note}</p><p><strong>{entry.contact.role}</strong><br />{entry.contact.phone&&<a href={phoneHref(entry.contact.phone)}>{entry.contact.phone}</a>}{entry.contact.email&&<><br /><a href={`mailto:${entry.contact.email}`}>{entry.contact.email}</a></>}</p>
          <ul class="church-bullets">{entry.sources.map(source=><li><a href={source.url}>{source.title} ↗</a></li>)}</ul>
        </ChurchQuestion>)}
      </div>
    </section>
    <section id="so-arbeiten-wir" class="church-section church-explainer" aria-labelledby="church-evidence-title"><div><p class="church-eyebrow">Quellen & Umfang</p><h2 id="church-evidence-title">Welche Kirchen stehen im Finder?</h2><p>Wir unterscheiden zwischen einem Traubeleg für die einzelne Kirche und einem veröffentlichten Anmeldeweg der Pfarrei. Bei einem Pfarreiangebot müsst Ihr zusätzlich klären, ob die gewünschte Kirche für Eure Trauung genutzt werden kann. Beide Angaben sind bei den Einträgen gekennzeichnet. Das Verzeichnis umfasst noch nicht alle Hamburger Trauorte.</p><p>Die Angaben wurden am 27. September 2026 geprüft. Ob Euer Termin frei ist und Ihr dort heiraten könnt, bestätigt die jeweilige Gemeinde.</p></div><div><h3>Was Ihr noch erfragen müsst</h3><p>Nicht jede Gemeinde veröffentlicht alle Bedingungen. Diese Lücken stehen als Fragen beim jeweiligen Eintrag. Bekannte Bauarbeiten sind ebenfalls genannt; fragt bei längerfristiger Planung nach, ob sie Euren Termin betreffen.</p><p>Ihr möchtet die Angaben für Eure Planung weiterverwenden? Es gibt sie auch als <a href={`${finderPath}kompakt.md`}>kompakte Textfassung</a> und <a href={`${finderPath}daten.json`}>strukturierte Daten</a> bereit.</p></div></section>
    <section class="church-cta" aria-labelledby="church-photo-title"><p class="church-eyebrow">Hochzeitsfotografie · Hamburg</p><h2 id="church-photo-title">Eure Kirche steht fest?<br />Sprechen wir über Eure Fotos.</h2><p>Schreibt mir Euer Datum und den Namen der Kirche. Dann besprechen wir, welche Begleitung Ihr Euch wünscht und welche Aufnahmen Eure Gemeinde während der Trauung erlaubt.</p><a class="church-button" href="/kontakt/">Fotografische Begleitung anfragen</a></section>
  </div>
  <script is:inline src={finderScript} defer />
</KirchenLayout>
