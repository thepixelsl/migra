---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import "../../styles/global.css";
import heroImage from "../../assets/hochzeitsfotograf-ratgeber/hochzeitsfotograf-hamburg-ratgeber-art9666.jpg";
import standesamtImage from "../../assets/hochzeitsfotograf-ratgeber/standesamt-altona-hochzeitsreportage-01.jpg";
import reportImage from "../../assets/hochzeitsfotograf-ratgeber/standesamt-altona-hochzeitsreportage-02.jpg";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/hochzeitsfotograf-ratgeber/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "Hochzeitsfotograf buchen: Checkliste für Eure Hochzeit";
const heading = "Hochzeitsfotograf buchen";
const description =
  "Hochzeitsfotograf buchen: Checkliste für Bildstil, Zeitplan, Vorgespräch und Bildübergabe. So bereitet Ihr Eure Anfrage und Hochzeitsfotos in Hamburg vor.";
const primaryImage = new URL(heroImage.src, siteUrl).href;

const bookingChecklist = [
  {
    title: "Datum und Orte festhalten",
    text: "Für die erste Anfrage helfen Euer Hochzeitsdatum, das Standesamt oder die Traulocation und der Ort der Feier. Nennt auch, ob Ihr schon feste Uhrzeiten habt oder den Ablauf noch plant. So lässt sich klären, ob die Begleitung an Eurem Tag möglich ist.",
  },
  {
    title: "Ganze Bildstrecken vergleichen",
    text: "Schaut Euch mehrere zusammenhängende Hochzeitsreportagen an: Wie wirken die Bilder bei der Trauung, draußen und in Innenräumen? Achtet neben den Paarportraits auch auf Gäste, kleine Gesten und die Bearbeitung. So findet Ihr heraus, ob der Bildstil zu Eurem Tag passt.",
  },
  {
    title: "Die Dauer aus dem Ablauf ableiten",
    text: "Schreibt auf, welche Momente Euch wichtig sind: Getting Ready, Trauung, Gratulationen, Gruppenbilder, Paarshooting oder Feier. Rechnet Wege zwischen den Orten und einen Zeitpuffer mit ein. Daraus ergibt sich die passende Begleitdauer; sie muss nicht für jede Hochzeit gleich sein.",
  },
  {
    title: "Wunschmotive und wichtige Menschen sammeln",
    text: "Eine kurze Liste der gewünschten Familien- und Gruppenbilder erleichtert die Planung. Benennt eine vertraute Person, die beim Zusammenrufen helfen kann. Besprecht auch besondere Programmpunkte, damit genügend Raum für spontane Bilder bleibt.",
  },
  {
    title: "Arbeitsweise im Vorgespräch kennenlernen",
    text: "Fragt, wie der Fotograf während der Trauung arbeitet und Euch beim Paarshooting anleitet. Besprecht einen möglichen Ortswechsel bei Regen und die Regeln Eurer Location fürs Fotografieren. Ein Kennenlernshooting kann zusätzlich zeigen, wie Ihr Euch vor der Kamera fühlt.",
  },
  {
    title: "Leistungen und Bildübergabe schriftlich klären",
    text: "Zum Angebot gehören nicht nur die Stunden vor Ort. Klärt Bildauswahl, Bearbeitung, Lieferzeit, Dateiauflösung, private Nutzung und mögliche Zusatzkosten. Haltet auch fest, was bei einer Terminänderung oder einem Ausfall vereinbart ist, bevor Ihr verbindlich bucht.",
  },
];

const sections = [
  {
    title: "Stundenlohn vergleichen",
    text:
      "Wenn ein Hochzeitsfotograf nach Stunden abrechnet, lohnt sich ein genauer Vergleich: Was ist enthalten, wie viele Bilder werden geliefert und sind Vorgespräch, Bildbearbeitung und Anfahrt bereits eingerechnet?",
  },
  {
    title: "Preis pro Bild kritisch prüfen",
    text:
      "Ein günstiger Einstiegspreis kann teuer werden, wenn jedes weitere Bild einzeln berechnet wird. Gerade bei Trauung, Gratulationen, Paarshooting und Feier entstehen viele wichtige Momente in kurzer Zeit.",
  },
  {
    title: "Bildbearbeitung einplanen",
    text:
      "Professionelle Bearbeitung macht Licht, Farben und Stimmung konsistent. Achte darauf, ob die RAW-Bearbeitung finaler Bilder im Paket enthalten ist oder später zusätzliche Kosten entstehen.",
  },
  {
    title: "Fahrtkosten und Zeitfenster klären",
    text:
      "Bei Hochzeiten in Hamburg sind kurze Wege ein Vorteil. Trotzdem solltest du vorab klären, ob Fahrtkosten, Parkplatzsuche oder Ortswechsel zwischen Standesamt, Shooting und Location berechnet werden.",
  },
];

const faqItems = [
  {
    question: "Wann sollten wir unseren Hochzeitsfotografen buchen?",
    answer: "Fragt an, sobald Euer Datum und die wichtigsten Orte feststehen. Eine allgemeine Frist garantiert keinen freien Termin. Auch bei einer kurzfristigen Planung lohnt sich eine konkrete Anfrage mit Datum, Ort und gewünschter Dauer.",
  },
  {
    question: "Wie lange sollten wir den Hochzeitsfotografen buchen?",
    answer: "Das hängt von den Momenten ab, die Ihr festhalten möchtet. Plant die Begleitung vom ersten gewünschten Programmpunkt bis zum letzten und berücksichtigt Gratulationen, Gruppenbilder, Paarshooting sowie Fahrtwege. Für die reine Trauung ist ein anderer Zeitrahmen sinnvoll als für einen ganzen Hochzeitstag.",
  },
  {
    question: "Wie spare ich bei Hochzeitsfotos Geld, ohne Qualität zu verlieren?",
    answer:
      "Am besten vergleichst du vollständige Pakete statt einzelner Stundenpreise. Wichtig sind enthaltene Bilder, Bearbeitung, Anfahrt, Onlinegalerie und klare Vereinbarungen zu Zusatzkosten.",
  },
  {
    question: "Sind Festpreise für Hochzeitsfotografie sinnvoll?",
    answer:
      "Festpreise geben Planungssicherheit. Besonders bei standesamtlichen Trauungen oder klaren Reportage-Zeiten helfen sie, das Budget zuverlässig einzuhalten.",
  },
  {
    question: "Warum ist ein Kennenlernshooting hilfreich?",
    answer:
      "Ein Kennenlernshooting nimmt Unsicherheit vor der Kamera und zeigt früh, ob Stil, Sympathie und Arbeitsweise des Fotografen zu euch passen.",
  },
];

const relatedLinks = [
  {
    href: "/hochzeitsfotograf-preise/",
    label: "Aktuelle Preise & Pakete",
    text: "Klare Pakete für standesamtliche Trauungen und längere Reportagen.",
  },
  {
    href: "/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/",
    label: "Standesamt Altona",
    text: "Beispiel einer standesamtlichen Trauung in Hamburg-Altona.",
  },
  {
    href: "/gallery/lovebirds-am-elbstrand/",
    label: "Kennenlernshooting",
    text: "Warum ein Paarshooting vor der Hochzeit Vertrauen schafft.",
  },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${pageUrl}#article`,
      headline: title,
      description,
      datePublished: "2019-08-14T09:37:40+02:00",
      dateModified: "2026-09-23",
      author: { "@type": "Person", name: "York Augustin" },
      publisher: { "@id": `${siteUrl}/#organization` },
      image: primaryImage,
      mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
      contentLocation: { "@id": `${pageUrl}#hamburg` },
      keywords: [
        "Hochzeitsfotograf buchen",
        "Hochzeitsfotos Checkliste",
        "Fragen an den Hochzeitsfotografen",
        "Hochzeitsplanung Hamburg",
      ],
      inLanguage: "de",
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
      inLanguage: "de",
    },
    {
      "@type": "City",
      "@id": `${pageUrl}#hamburg`,
      name: "Hamburg",
      geo: { "@type": "GeoCoordinates", latitude: 53.5511, longitude: 9.9937 },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      url: siteUrl,
      email: "info@artbild-fotografie.de",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
      ],
      serviceType: ["Hochzeitsfotografie", "Hochzeitsreportage", "Standesamtliche Trauung"],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Startseite", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "Ratgeber", item: pageUrl },
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: heroImage.width,
        height: heroImage.height,
      },
      inLanguage: "de",
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="article">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={heroImage.width}>
    <meta property="og:image:height" content={heroImage.height}>
    <meta property="og:image:alt" content="Hochzeitsreportage in Hamburg als Ratgeberbild">
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template advice-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main id="ratgeber">
      <article>
        <div class="advice-shell">
          <nav class="advice-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Startseite</a><span aria-hidden="true">/</span>
            <a href="/brautstyling-hamburg/">Planung</a><span aria-hidden="true">/</span>
            <span aria-current="page">Hochzeitsfotograf buchen</span>
          </nav>

          <header class="advice-hero" data-track-section="advice_hero"
            data-content-topic="hochzeitsfotograf_buchen" data-user-intent="buchung_vorbereiten"
            data-journey-stage="consideration" data-content-format="article_hero" data-position="hero">
            <div class="advice-hero__copy">
              <p class="advice-kicker">Auswahl & Planung · Hamburg</p>
              <h1>{heading}</h1>
              <p class="advice-lead">
                Ihr möchtet einen Hochzeitsfotografen buchen und wisst noch nicht,
                welche Fragen Ihr stellen solltet? Diese Checkliste hilft Euch,
                Bildstil, Ablauf und Leistungen zu vergleichen und Eure Anfrage
                für eine Hochzeit in Hamburg vorzubereiten.
              </p>
              <a class="advice-link" href="#booking-checklist-title">Zur Checkliste <span aria-hidden="true">↗</span></a>
            </div>
            <figure class="advice-hero__image">
              <Image src={heroImage} widths={[480, 720, 1080, 1384]}
                sizes="(max-width: 900px) calc(100vw - 48px), 52vw"
                format="webp" quality={86} loading="eager" fetchpriority="high"
                alt="Paar lacht bei einem entspannten Kennenlernshooting" />
              <figcaption>Kennenlernshooting in Hamburg</figcaption>
            </figure>
          </header>

          <nav class="advice-index" aria-label="In diesem Ratgeber">
            <p class="advice-kicker">In diesem Ratgeber</p>
            <ol>
              <li><a href="#booking-checklist-title"><span>01</span> Vorbereitung</a></li>
              <li><a href="#budget-title"><span>02</span> Leistungen & Budget</a></li>
              <li><a href="#standesamt-title"><span>03</span> Standesamt</a></li>
              <li><a href="#faq-title"><span>04</span> Buchungsfragen</a></li>
            </ol>
          </nav>

          <section class="advice-booking advice-chapter" aria-labelledby="booking-checklist-title">
            <header class="advice-chapter__intro">
              <p class="advice-kicker">01 / Vor der Anfrage</p>
              <h2 id="booking-checklist-title">Eure Checkliste für die Hochzeitsfotos</h2>
              <p>Sechs Punkte, die Euch auf das Vorgespräch vorbereiten.</p>
              <p class="advice-note">
                Zum Vergleich findet Ihr hier <a href="/gallery-category/hochzeit/">Hochzeitsreportagen aus Hamburg und weiteren Orten</a>.
                Für den Morgen hilft Euch der <a href="/das-perfekte-getting-ready-fuer-deine-hochzeit-in-hamburg/">Ratgeber zum Getting Ready</a>.
              </p>
            </header>
            <ol class="advice-checklist">
              {bookingChecklist.map((item, index) => (
                <li>
                  <span class="advice-step" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <div><h3>{item.title}</h3><p>{item.text}</p></div>
                </li>
              ))}
            </ol>
          </section>
        </div>

        <section class="advice-budget" aria-labelledby="budget-title">
          <div class="advice-shell advice-chapter">
            <header class="advice-chapter__intro">
              <p class="advice-kicker">02 / Leistungen & Budget</p>
              <h2 id="budget-title">Angebote vergleichen</h2>
              <p>Was steckt im Preis – und was kommt möglicherweise hinzu?</p>
              <a class="advice-link" href="/hochzeitsfotograf-preise/"
                data-track-event="cta_click" data-cta-id="advice_budget_pricing" data-cta-type="pricing"
                data-section-id="advice_budget" data-content-topic="hochzeitsfotografie_budget"
                data-user-intent="preise_ansehen" data-journey-stage="decision" data-position="budget">
                Preise & Pakete <span aria-hidden="true">↗</span>
              </a>
            </header>
            <div class="advice-budget__items">
              {sections.map((section) => (
                <section><h3>{section.title}</h3><p>{section.text}</p></section>
              ))}
            </div>
          </div>
        </section>

        <div class="advice-shell">
          <section class="advice-feature" aria-labelledby="standesamt-title">
            <header class="advice-feature__heading">
              <p class="advice-kicker">03 / Beispiel Hamburg-Altona</p>
              <h2 id="standesamt-title">Standesamtliche Trauung ohne Kostenüberraschung</h2>
            </header>
            <div class="advice-feature__layout">
              <figure class="advice-feature__main-image">
                <Image src={standesamtImage} widths={[480, 720, 1080, 1384]}
                  sizes="(max-width: 900px) calc(100vw - 48px), 56vw" format="webp" quality={84}
                  loading="lazy" alt="Standesamtliche Trauung in Hamburg-Altona" />
                <figcaption>Die Trauung im Standesamt Hamburg-Altona.</figcaption>
              </figure>
              <div class="advice-feature__story">
                <p>
                  Für eine standesamtliche Trauung reichen oft wenige Stunden, wenn der
                  Ablauf gut geplant ist: Ankommen, Trauung, Gratulationen, Familienbilder
                  und ein kurzes Paarshooting. Genau hier helfen klare Festpreise.
                </p>
                <a class="advice-link" href="/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/">
                  Die Reportage ansehen <span aria-hidden="true">↗</span>
                </a>
                <figure>
                  <Image src={reportImage} widths={[480, 720, 920]}
                    sizes="(max-width: 900px) calc(100vw - 48px), 32vw" format="webp" quality={84}
                    loading="lazy" alt="Hochzeitsreportage nach dem Standesamt in Hamburg-Altona" />
                </figure>
              </div>
            </div>
          </section>

          <section class="advice-faq advice-chapter" aria-labelledby="faq-title"
            data-track-section="ratgeber_buchung_faq" data-content-topic="hochzeitsfotograf_buchen"
            data-user-intent="buchungsfragen_klaeren" data-journey-stage="information"
            data-content-format="faq" data-position="advice_faq">
            <header class="advice-chapter__intro">
              <p class="advice-kicker">04 / Kurz beantwortet</p>
              <h2 id="faq-title">Fragen vor der Buchung</h2>
              <p>Die passende Frage öffnen und in Ruhe weiterlesen.</p>
            </header>
            <div class="advice-faq__items">
              {faqItems.map((item, index) => (
                <details name="booking-faq" data-track-event="faq_open" data-faq-id={`ratgeber_buchung_${index + 1}`}>
                  <summary><h3>{item.question}</h3><span class="advice-faq__icon" aria-hidden="true"></span></summary>
                  <div class="advice-answer" data-track-section={`ratgeber_buchung_faq_${index + 1}`}
                    data-content-topic="hochzeitsfotograf_buchen" data-user-intent="buchungsfragen_lesen"
                    data-journey-stage="information" data-content-format="faq_answer" data-position={`faq_${index + 1}`}>
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </div>

        <section class="advice-next" aria-labelledby="advice-next-title">
          <div class="advice-shell">
            <p class="advice-kicker">Der nächste Schritt</p>
            <h2 id="advice-next-title">Eure Hochzeitsanfrage</h2>
            <p>Datum, Orte und Eure Wünsche: Erzählt mir von Euren Plänen.</p>
            <a class="advice-button" href="/kontakt/" data-track-event="cta_click"
              data-cta-id="advice_contact" data-cta-type="contact" data-section-id="advice_next"
              data-content-topic="hochzeitsfotograf_buchen" data-user-intent="anfrage_senden"
              data-journey-stage="decision" data-position="article_end">Hochzeit anfragen <span aria-hidden="true">↗</span></a>
            <nav class="advice-related" aria-label="Weiterführende Seiten">
              {relatedLinks.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
            </nav>
          </div>
        </section>
      </article>
    </main>

    <footer class="advice-footer advice-shell">
      <a href="/brautstyling-hamburg/">Zurück zu Brautstyling Hamburg</a>
      <p>Artbild-Fotografie · Hochzeitsfotograf Hamburg</p>
    </footer>
  </body>
</html>

<style>
  .advice-page {
    --advice-ink: #282725;
    --advice-muted: #655f58;
    --advice-line: #d8d0c5;
    --advice-paper: #fcfbf8;
    --advice-sand: #f0ece5;
    background: var(--advice-paper);
    color: var(--advice-ink);
  }

  .advice-shell { width: min(1240px, calc(100% - 112px)); margin-inline: auto; }
  .advice-page main { padding: 0; }
  .advice-page :is(h1, h2, h3, p, figure, ol) { margin: 0; }
  .advice-page :is(h1, h2, h3) {
    font-family: "Gilda Display", Georgia, serif;
    font-weight: 400;
    letter-spacing: -.025em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  .advice-page h1 { font-size: clamp(38px, 4.3vw, 64px); line-height: 1.08; }
  .advice-page h2 { font-size: clamp(32px, 3.35vw, 46px); line-height: 1.18; }
  .advice-page h3 { font-size: clamp(23px, 1.9vw, 28px); line-height: 1.3; letter-spacing: -.015em; }
  .advice-page p {
    font-family: "Gilda Display", Georgia, serif;
    font-size: 19px;
    line-height: 1.75;
    color: var(--advice-muted);
    text-wrap: pretty;
  }
  .advice-page .advice-kicker,
  .advice-breadcrumb,
  .advice-index a,
  .advice-step,
  .advice-page figcaption,
  .advice-link,
  .advice-button,
  .advice-related a {
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .advice-page .advice-kicker { color: var(--advice-muted); margin-bottom: 22px; }
  .advice-page :is(a, summary):focus-visible { outline: 2px solid var(--advice-ink); outline-offset: 6px; }
  .advice-page a { text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .advice-page :is(h2[id], section[id]) { scroll-margin-top: 110px; }
  .advice-hero :global(img), .advice-feature :global(img) { width: 100%; height: auto; display: block; }
  .advice-page figcaption { margin-top: 18px; font-size: 10px; letter-spacing: .07em; color: var(--advice-muted); }

  .advice-breadcrumb {
    display: flex; flex-wrap: wrap; gap: 8px 12px;
    margin-top: 32px; color: var(--advice-muted); font-size: 10px; letter-spacing: .09em;
  }
  .advice-breadcrumb a { text-decoration: none; }
  .advice-hero {
    display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    align-items: center; gap: clamp(48px, 6.7vw, 96px); padding-block: 72px 88px;
  }
  .advice-hero__copy { padding-block: 18px; }
  .advice-hero .advice-lead { margin-top: 30px; max-width: 46ch; }
  .advice-hero .advice-link { margin-top: 32px; }
  .advice-link {
    display: inline-flex; align-items: center; gap: 28px; min-height: 44px;
    padding-block: 10px; border-bottom: 1px solid var(--advice-ink); text-decoration: none;
  }
  .advice-link span, .advice-button span, .advice-related span { font-size: 21px; font-weight: 400; line-height: 1; letter-spacing: 0; }
  .advice-link:hover { color: #846b51; border-color: currentColor; }

  .advice-index { padding-block: 28px; border-block: 1px solid var(--advice-line); }
  .advice-index .advice-kicker { margin-bottom: 16px; font-size: 10px; }
  .advice-index ol { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 32px; list-style: none; padding: 0; }
  .advice-index a { display: inline-flex; align-items: center; gap: 14px; min-height: 44px; text-decoration: none; letter-spacing: .08em; }
  .advice-index a span { color: var(--advice-muted); font-size: 10px; }
