---
import { Image } from "astro:assets";
import FaviconHead from "../../components/FaviconHead.astro";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MonitorTestPattern from "../../components/MonitorTestPattern.astro";
import referencePhoto from "../../assets/valerie-und-tim/ART_7411.jpg";
import "../../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pageUrl = `${siteUrl}/bildschirm-check/`;
const title = "Bildschirm-Check: Hochzeitsfotos zu Hause ansehen | ARTBILD";
const description = "Prüft mit dem ARTBILD-Graustufentest, ob euer Bildschirm helle und dunkle Details zeigt. Mit einfacher Anleitung zum Betrachten eurer Hochzeitsfotos.";
const breadcrumbs = [{ label: "Startseite", href: "/" }, { label: "Bildschirm-Check", href: "/bildschirm-check/" }];
const schema = { "@context": "https://schema.org", "@type": "WebPage", "@id": `${pageUrl}#webpage`, url: pageUrl, name: title, description, inLanguage: "de-DE" };
---
<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
  </head>
  <body>
    <header class="gallery-header"><MobileNavigation /><DesktopNavigation /></header>
    <main>
      <Breadcrumbs items={breadcrumbs} siteUrl={siteUrl} currentUrl={pageUrl} />
      <div class="screen-shell">
        <section class="screen-test" aria-labelledby="test">
          <header class="screen-test__heading">
            <div>
              <h1 id="test">Bildschirm-Check</h1>
              <p>Schaut gerade auf den Bildschirm und vermeidet Spiegelungen. Welche Nachbarfelder könnt ihr unterscheiden?</p>
            </div>
            <button class="screen-button" type="button" data-open-screen-test aria-haspopup="dialog" aria-controls="screen-test-dialog" hidden>Test groß anzeigen <span aria-hidden="true">↗</span></button>
          </header>
          <MonitorTestPattern prefix="page" />
          <div class="screen-test__footer">
            <p>Verschmelzen schon gröbere Stufen, prüft Raumlicht und Bildschirmhelligkeit.</p>
            <a href="/downloads/artbild-bildschirm-check.png" download>Testbild herunterladen (PNG)</a>
          </div>
        </section>

        <section class="screen-reference" aria-labelledby="referenzfoto">
          <div>
            <h2 id="referenzfoto">Im Foto vergleichen</h2>
            <p>Erkennt ihr die Stickerei im Kleid und die Falten im dunklen Jackett?</p>
            <a href="/gallery/hochzeit-valerie-und-tim/">Zur Galerie von Valerie und Tim <span aria-hidden="true">→</span></a>
          </div>
          <Image
            src={referencePhoto}
            alt="Valerie und Tim im Nahportrait mit weiß besticktem Brautkleid und dunkelblauem Jackett"
            widths={[360, 620, 920, 1200]}
            sizes="(max-width: 800px) calc(100vw - 88px), 55vw"
            loading="lazy"
            decoding="async"
            class="screen-reference__photo"
          />
        </section>
        <footer class="gallery-footer screen-footer"><span>ARTBILD-Fotografie · York Augustin</span><nav aria-label="Rechtliches"><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a><a href="/kontakt/">Kontakt</a></nav></footer>
      </div>
    </main>
    <dialog class="screen-dialog" id="screen-test-dialog" aria-labelledby="screen-dialog-title">
      <div class="screen-dialog__inner">
        <header class="screen-dialog__header"><h2 id="screen-dialog-title">Bildschirm-Check</h2><button type="button" class="screen-button" data-close-screen-test>Schließen <span aria-hidden="true">×</span></button></header>
        <MonitorTestPattern prefix="dialog" heading="h3" />
      </div>
    </dialog>
  </body>
</html>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".screen-dialog");
  const open = document.querySelector<HTMLButtonElement>("[data-open-screen-test]");
  const close = document.querySelector<HTMLButtonElement>("[data-close-screen-test]");
  if (dialog && open && close && typeof dialog.showModal === "function") {
    open.hidden = false;
    open.addEventListener("click", () => { dialog.showModal(); document.documentElement.classList.add("screen-test-open"); });
    close.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => { document.documentElement.classList.remove("screen-test-open"); open.focus({ preventScroll: true }); });
  }
</script>

<style>
  main > :global(.site-breadcrumb){margin-top:clamp(12px,2vw,26px)}
  .screen-shell{width:min(calc(1100px + var(--desktop-width-extra, 0px)),calc(100% - 64px));margin-inline:auto;color:#303030}
  h1,h2{font-family:"Gilda Display",Georgia,serif;font-weight:400;letter-spacing:-.018em;line-height:1.2}
  h1{font-size:clamp(36px,4.3vw,54px);margin:0 0 8px;scroll-margin-top:24px}
  h2{font-size:clamp(26px,3vw,36px);margin:0 0 12px}
  .screen-test__heading{display:flex;align-items:flex-end;justify-content:space-between;gap:14px 24px;margin:clamp(16px,2vw,24px) 0 18px}
  .screen-test__heading p{max-width:76ch;margin:0;font-size:17px;line-height:1.55}
  .screen-button{display:inline-flex;flex:none;align-items:center;justify-content:center;gap:12px;min-height:44px;padding:9px 15px;background:transparent;color:#242424;border:1px solid #242424;font:600 13px/1.5 "Raleway",Arial,sans-serif;cursor:pointer;border-radius:0}
  .screen-button[hidden]{display:none}.screen-button:hover{background:#404040;color:#fff}
  .screen-shell :is(a,button):focus-visible,.screen-dialog button:focus-visible{outline:2px solid #242424;outline-offset:5px}
  .screen-test__footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 24px;margin:14px 0 0;font:400 13px/1.6 "Raleway",Arial,sans-serif}
  .screen-test__footer p{margin:0}
  .screen-reference{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,6fr);align-items:center;gap:clamp(20px,4vw,48px);padding:clamp(20px,4vw,40px);margin-top:clamp(32px,6vw,64px);background:#ededed}
  .screen-reference p{font-size:17px;line-height:1.55;margin:0 0 12px}.screen-reference a{font-size:16px;line-height:1.5}.screen-reference__photo{display:block;width:100%;height:auto}
  .screen-footer{display:flex;justify-content:space-between;gap:24px;margin-top:36px;padding:24px 0 36px;border-top:1px solid #dfd8cf;font-family:"Raleway",Arial,sans-serif;font-size:12px}.screen-footer nav{display:flex;flex-wrap:wrap;gap:20px}
  .screen-dialog{width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:24px;border:0;background:#b8b8b8;color:#171717;overflow:auto}
  .screen-dialog::backdrop{background:#b8b8b8}.screen-dialog__inner{max-width:1300px;margin:auto}.screen-dialog__header{display:flex;align-items:center;justify-content:space-between;gap:12px}.screen-dialog__header h2{font-size:22px;margin:0}
  :global(html.screen-test-open){overflow:hidden}
  @media(max-width:800px){.screen-reference{grid-template-columns:minmax(0,1fr)}}
  @media(max-width:600px){.screen-shell{width:calc(100% - 32px)}.screen-test__heading{align-items:flex-start;flex-direction:column}.screen-footer{flex-direction:column}.screen-dialog{padding:16px}.screen-dialog__header h2{font-size:19px}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
