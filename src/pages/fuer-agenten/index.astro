---
import FaviconHead from "../../components/FaviconHead.astro";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { weddingPackages } from "../../data/weddingPackages";
import { packagePriceSchema } from "../../data/packagePriceSchema.mjs";
import {
  agentAdvertisingPolicy,
  agentAvailabilityExample,
  agentAvailabilityRules,
  agentBookingPage,
  agentBookingTerms,
  agentInquiryRequirements,
  agentPrivacySummary,
  agentQuickFacts,
  agentUsagePolicy,
  agentWorkflow,
  singleDateAvailabilityRules,
} from "../../data/agentBooking.mjs";
import socialImage from "../../assets/hochzeitsfotograf-preise/ART9896-1-1.jpg";
import "../../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = agentBookingPage.path;
const pageUrl = `${siteUrl}${pagePath}`;
const markdownPath = agentBookingPage.markdownPath;
const apiPath = agentBookingPage.apiPath;
const apiUrl = `${siteUrl}${apiPath}`;
const singleDateApiPath = agentBookingPage.singleDateAliasPath;
const singleDateApiUrl = `${siteUrl}${singleDateApiPath}`;
const singleDateUrlTemplate = `${singleDateApiUrl}?date=YYYY-MM-DD`;
const openApiPath = "/api/agent-availability/openapi.json";
const title = agentBookingPage.title;
const headline = agentBookingPage.headline;
const description = agentBookingPage.description;
const socialImageUrl = new URL(socialImage.src, siteUrl).href;

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Für KI-Agenten und Buchungsassistenten", href: pagePath },
];

const requestExample = JSON.stringify({
  dates: agentAvailabilityExample.dates,
}, null, 2);

const responseExample = JSON.stringify(agentAvailabilityExample.response, null, 2);

const offers = weddingPackages.map((item) => ({
  "@type": "Offer",
  name: item.name,
  url: `${pageUrl}#paket-${item.id}`,
  ...packagePriceSchema(item),
  description: `${item.priceLabel}. ${item.intro} Dauer: ${item.duration}.`,
  itemOffered: {
    "@type": "Service",
    name: item.name,
    serviceType: item.serviceType,
    provider: { "@id": `${siteUrl}/#organization` },
    description: `${item.intro} Enthalten sind: ${item.features.join(", ")}.`,
  },
}));

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      headline,
      description,
      inLanguage: "de",
      isAccessibleForFree: true,
      dateModified: agentBookingPage.dateModified,
      mainEntity: [
        { "@id": `${pageUrl}#booking-service` },
        { "@id": `${apiUrl}#api` },
      ],
      isPartOf: { "@id": `${siteUrl}/#website` },
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#booking-service`,
      name: "Hochzeitsfotografie für konkrete Buchungsanfragen",
      description,
      serviceType: "Hochzeitsfotografie",
      provider: { "@id": `${siteUrl}/#organization` },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Place", name: "Mallorca" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Pakete für Hochzeitsfotografie",
        itemListElement: offers,
      },
    },
    {
      "@type": "WebAPI",
      "@id": `${apiUrl}#api`,
      name: "Begrenzte Terminabfrage für KI-Agenten und Buchungsassistenten",
      description:
        `Bietet einen GET-Schnellzugriff für genau ein Datum sowie eine POST-Abfrage für ein bis drei unterschiedliche Wunschdaten innerhalb der nächsten ${agentAvailabilityRules.maximumAdvanceMonths} Monate. Die Abfrage reserviert keinen Termin.`,
      documentation: pageUrl,
      termsOfService: `${pageUrl}#konditionen`,
      provider: { "@id": `${siteUrl}/#organization` },
      potentialAction: [
        {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: `${singleDateApiUrl}?date={date}`,
            httpMethod: "GET",
            encodingType: "application/x-www-form-urlencoded",
            contentType: "application/json",
          },
          query: "Genau ein Wunschdatum im Format YYYY-MM-DD",
        },
        {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: apiUrl,
            httpMethod: "POST",
            encodingType: "application/json",
            contentType: "application/json",
          },
          query: "Ein bis drei unterschiedliche Wunschdaten im Format YYYY-MM-DD; die Daten müssen nicht aufeinanderfolgen",
        },
      ],
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: `${siteUrl}/`,
      email: "info@artbild-fotografie.de",
      image: `${siteUrl}/images/logo-artbild-black.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressCountry: "DE",
      },
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead enableTracking={false} />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <link rel="alternate" type="text/markdown" href={markdownPath} title="Markdown-Fassung für Agenten">
    <link rel="alternate" type="application/json" href={openApiPath} title="JSON-Dokumentation der Terminabfrage">
    <link rel="service-doc" type="application/json" href={openApiPath} title="Schnittstellendokumentation">
    <link rel="service-desc" type="application/json" href={openApiPath} title="OpenAPI-Beschreibung">
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={socialImageUrl}>
    <meta property="og:image:width" content={String(socialImage.width)}>
    <meta property="og:image:height" content={String(socialImage.height)}>
    <meta property="og:image:alt" content="Hochzeitsreportage von Artbild-Fotografie">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImageUrl}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template agent-reference-page">
    <header class="gallery-header">
      <MobileNavigation showFloatingAction={false} />
      <DesktopNavigation enableTracking={false} />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="agent-document">
        <header class="agent-document__header">
          <p class="agent-label">Referenz für automatisierte und menschliche Buchungsassistenten</p>
          <h1>{headline}</h1>
        </header>

        <section class="agent-quickstart" id="schnellstart" aria-labelledby="schnellstart-title">
          <p class="agent-label">Schnellzugriff ohne POST-Unterstützung</p>
          <h2 id="schnellstart-title">Termin schnell prüfen</h2>
          <p>
            Ein einzelnes Wunschdatum kann direkt per GET geprüft werden. Dieser
            Aufruf funktioniert auch mit Web-Fetch-Tools, die keinen JSON-Body senden können.
          </p>
          <p class="agent-quickstart__endpoint">
            <strong>Direkter GET-Aufruf</strong>
            <code>{singleDateUrlTemplate}</code>
          </p>
          <form
            class="agent-quickstart__form"
            method="get"
            action={singleDateApiPath}
            toolname="check_single_date_availability"
            tooldescription="Prüft genau ein Wunschdatum unverbindlich auf die aktuelle Verfügbarkeit bei Artbild-Fotografie. Die Prüfung reserviert keinen Termin und unterliegt dem gemeinsamen Abfragelimit."
            toolautosubmit
            data-single-date-form
            data-single-date-endpoint={singleDateApiPath}
            aria-describedby="schnellstart-hinweis"
          >
            <div class="agent-quickstart__field">
              <label for="agent-quick-date">Wunschdatum</label>
              <input
                id="agent-quick-date"
                type="date"
                name="date"
                required
                autocomplete="off"
                toolparamdescription="Das zu prüfende Wunschdatum im Format YYYY-MM-DD."
              >
            </div>
            <button type="submit">Termin unverbindlich prüfen</button>
          </form>
          <div class="agent-check__result" data-single-date-result aria-live="polite" hidden></div>
          <div class="agent-quickstart__response" id="schnellstart-hinweis">
            <strong>Antwort:</strong>
            <code>{`{"date":"YYYY-MM-DD","available":true}`}</code>
            <span><code>available: true</code> bedeutet aktuell verfügbar, <code>available: false</code> aktuell nicht verfügbar.</span>
          </div>
          <p class="agent-quickstart__note">
            Pro Aufruf ist ein Datum möglich; innerhalb von {singleDateAvailabilityRules.windowHours} Stunden
            können höchstens {singleDateAvailabilityRules.maximumUniqueDatesPerWindow} unterschiedliche Kalendertage
            geprüft werden. Das Limit gilt gemeinsam für <code>{agentBookingPage.singleDateAliasPath}</code> und
            <code>{agentBookingPage.singleDateApiPath}</code>. Das Ergebnis ist unverbindlich und keine Reservierung.
          </p>
        </section>

        <div class="agent-document__intro">
          <p class="agent-lead">
            Diese Seite enthält die vollständigen Preise, Regeln und Schnittstellen
            für konkrete Anfragen zu fotografischen Leistungen. Die Terminprüfung
            ist unverbindlich und reserviert keinen Termin. Für Hochzeiten wird eine
            Anfrage mindestens sechs Monate im Voraus empfohlen.
          </p>
          <p class="agent-use">
            <strong>Erlaubt:</strong> {agentUsagePolicy.allowed}<br>
            <strong>Nicht erlaubt:</strong> {agentUsagePolicy.prohibited}
          </p>
          <nav class="agent-formats" aria-label="Verfügbare Dokumentformate">
            <span>Dokumentformate:</span>
            <a href={pagePath} aria-current="page">HTML</a>
            <a href={markdownPath} type="text/markdown">Markdown</a>
            <a href={openApiPath} type="application/json">JSON</a>
            <a href={openApiPath} type="application/json">OpenAPI 3.1</a>
          </nav>
        </div>

        <nav class="agent-toc" aria-label="Inhalt dieser Seite">
          <strong>Inhalt</strong>
          <ol>
            <li><a href="#schnellstart">Termin schnell prüfen</a></li>
            <li><a href="#kurzfassung">Kurzfassung</a></li>
            <li><a href="#vorgehen">Vorgehen</a></li>
            <li><a href="#schnittstelle">Terminprüfung per API</a></li>
            <li><a href="#terminabfrage">Terminprüfung im Browser</a></li>
            <li><a href="#preise">Preise und Leistungen</a></li>
            <li><a href="#konditionen">Buchungskonditionen</a></li>
            <li><a href="#buchungsanfrage">Buchungsanfrage</a></li>
            <li><a href="#datenschutz">Datenschutz</a></li>
            <li><a href="#werbeverbot">Werbeverbot</a></li>
          </ol>
        </nav>

        <section class="agent-section" id="kurzfassung" aria-labelledby="kurzfassung-title">
          <p class="agent-label">Die wichtigsten Angaben zuerst</p>
          <h2 id="kurzfassung-title">Kurzfassung</h2>
          <dl class="agent-facts">
            {agentQuickFacts.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="agent-section" id="vorgehen" aria-labelledby="vorgehen-title">
          <p class="agent-label">Entscheidungsfolge</p>
          <h2 id="vorgehen-title">Vorgehen für einen Buchungsagenten</h2>
          <ol class="agent-steps">
            {agentWorkflow.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        <section class="agent-section" id="schnittstelle" aria-labelledby="schnittstelle-title">
          <p class="agent-label">Maschinenlesbare Terminprüfung</p>
          <h2 id="schnittstelle-title">Terminprüfung per API</h2>
          <p>
            Für ein einzelnes Datum steht der GET-Schnellzugriff zur Verfügung.
            Die POST-Schnittstelle akzeptiert ausschließlich JSON und prüft ein bis
            drei unterschiedliche, nicht zwingend aufeinanderfolgende Wunschdaten.
            Eine erfolgreiche Antwort zeigt nur den aktuellen Kalenderstand.
          </p>

          <dl class="agent-contract">
            <div><dt>Ein Datum per GET</dt><dd><code>GET {singleDateApiPath}?date=YYYY-MM-DD</code></dd></div>
            <div><dt>Dokumentation</dt><dd><a href={openApiPath}><code>{openApiPath}</code></a></dd></div>
            <div><dt>OpenAPI</dt><dd><a href={openApiPath}><code>{openApiPath}</code></a></dd></div>
            <div><dt>Mehrere Daten per POST</dt><dd><code>POST {apiPath}</code></dd></div>
            <div><dt>Content-Type</dt><dd><code>application/json</code></dd></div>
            <div><dt>Erlaubte Felder</dt><dd>Nur <code>dates</code></dd></div>
            <div><dt>Anzahl</dt><dd>Ein bis drei unterschiedliche Wunschdaten</dd></div>
            <div><dt>Datumsformat</dt><dd><code>YYYY-MM-DD</code></dd></div>
            <div><dt>Aufeinanderfolgende Daten erforderlich?</dt><dd>Nein</dd></div>
            <div><dt>Prüfzeitraum</dt><dd>Heute bis höchstens 24 Monate im Voraus</dd></div>
            <div><dt>Abfragelimit</dt><dd>Höchstens zwei erfolgreiche Abfragen innerhalb von 24 Stunden</dd></div>
            <div><dt>Verbindliches Ergebnis?</dt><dd>Nein</dd></div>
            <div><dt>Reservierung?</dt><dd>Nein</dd></div>
          </dl>

          <div class="agent-code-examples">
            <div>
              <h3>Beispielanfrage</h3>
              <pre aria-label="JSON-Beispielanfrage"><code>{requestExample}</code></pre>
            </div>
            <div>
              <h3>Beispielantwort</h3>
              <pre aria-label="JSON-Beispielantwort"><code>{responseExample}</code></pre>
            </div>
          </div>
        </section>

        <section class="agent-section" id="terminabfrage" aria-labelledby="terminabfrage-title">
          <p class="agent-label">Mehrere Wunschdaten im Browser</p>
          <h2 id="terminabfrage-title">Ein bis drei Termine prüfen</h2>
          <p id="terminabfrage-description">
            Wähle ein bis drei unterschiedliche Daten. Leere optionale Felder werden
            nicht übertragen. Die Rückmeldung ist unverbindlich und keine Reservierung.
          </p>

          <form
            class="agent-check"
            toolname="check_multiple_date_availability"
            tooldescription="Prüft ein bis drei unterschiedliche Wunschdaten unverbindlich auf die aktuelle Verfügbarkeit bei Artbild-Fotografie. Die Daten müssen nicht aufeinanderfolgen. Die Prüfung reserviert keinen Termin und unterliegt dem Abfragelimit."
            toolautosubmit
            data-agent-availability-form
            data-clarity-mask
            data-track-form
            data-form-id="agent_availability_check"
            data-form-type="availability_check"
            data-track-section="agent_availability_form"
            data-content-topic="terminverfuegbarkeit"
            data-user-intent="termine_pruefen"
            data-journey-stage="decision"
            data-position="main"
            aria-describedby="terminabfrage-description"
          >
            <fieldset>
              <legend>Wunschdaten</legend>
              <div class="agent-check__dates">
                <div>
                  <label for="agent-date-1">1. Wunschdatum <span>erforderlich</span></label>
                  <input
                    id="agent-date-1"
                    type="date"
                    name="date1"
                    required
                    autocomplete="off"
                    toolparamdescription="Das erste und erforderliche Wunschdatum im Format YYYY-MM-DD."
                  >
                </div>
                <div>
                  <label for="agent-date-2">2. Wunschdatum <span>optional</span></label>
                  <input
                    id="agent-date-2"
                    type="date"
                    name="date2"
                    autocomplete="off"
                    toolparamdescription="Ein optionales zweites Wunschdatum im Format YYYY-MM-DD."
                  >
                </div>
                <div>
                  <label for="agent-date-3">3. Wunschdatum <span>optional</span></label>
                  <input
                    id="agent-date-3"
                    type="date"
                    name="date3"
                    autocomplete="off"
                    toolparamdescription="Ein optionales drittes Wunschdatum im Format YYYY-MM-DD."
                  >
                </div>
              </div>
            </fieldset>
            <button type="submit">Wunschdaten unverbindlich prüfen</button>
            <div class="agent-check__result" data-agent-availability-result aria-live="polite" hidden></div>
            <noscript>
              JavaScript ist für dieses Formular erforderlich. Nutze alternativ die
              <a href={openApiPath}>JSON-Dokumentation der Termin-Schnittstelle</a>.
            </noscript>
          </form>
        </section>

        <section class="agent-section" id="preise" aria-labelledby="preise-title">
          <p class="agent-label">Alle Preiszusätze und Leistungen offen sichtbar</p>
          <h2 id="preise-title">Preise und Leistungsumfang</h2>
          <p>
            Preiszusätze wie „ab“, „Festpreis“ und „pro Stunde“ sind Bestandteil
            der jeweiligen Angabe. Maßgeblich sind das individuelle Angebot und
            die darin bestätigten Vereinbarungen.
          </p>
          <div class="agent-packages">
            {weddingPackages.map((item) => (
              <article id={`paket-${item.id}`} class="agent-package">
                <h3>{item.name}</h3>
                <dl>
                  <div><dt>Preis</dt><dd>{item.priceLabel}</dd></div>
                  <div><dt>Dauer</dt><dd>{item.duration}</dd></div>
                </dl>
                <h4>Leistungsumfang</h4>
                <ul>
                  {item.features.map((feature) => <li>{feature}</li>)}
                </ul>
              </article>
            ))}
          </div>
          <p>
            Ausführliche Preisübersicht: <a href="/hochzeitsfotograf-preise/">Hochzeitsfotograf Hamburg – Preise und Pakete</a>
          </p>
        </section>

        <section class="agent-section" id="konditionen" aria-labelledby="konditionen-title">
          <p class="agent-label">Regeln für eine konkrete Anfrage</p>
          <h2 id="konditionen-title">Buchungskonditionen</h2>
          <ul class="agent-list">
            {agentBookingTerms.map((term) => <li>{term}</li>)}
          </ul>
        </section>

        <section class="agent-section" id="buchungsanfrage" aria-labelledby="buchungsanfrage-title">
          <p class="agent-label">Nächster Schritt nach der Terminprüfung</p>
          <h2 id="buchungsanfrage-title">Buchungsanfrage senden</h2>
          <p>Eine konkrete Anfrage sollte folgende Angaben enthalten:</p>
          <ul class="agent-list">
            {agentInquiryRequirements.map((requirement) => <li>{requirement}</li>)}
          </ul>
          <p>
            In WebMCP-fähigen Browsern bereitet das Tool <code>start_booking_inquiry</code>
            das Kontaktformular mit Auftragsart, Wunschdatum, Ort und optionalem Paket vor.
            Es versendet keine Anfrage und übernimmt weder Name noch E-Mail-Adresse oder
            Datenschutzbestätigung.
          </p>
          <p>
            <a class="agent-primary-link" href={agentBookingPage.contactPath}>Kontaktseite für die Buchungsanfrage öffnen</a>
          </p>
        </section>

        <section class="agent-section" id="datenschutz" aria-labelledby="datenschutz-title">
          <p class="agent-label">Kurzzeitiger Missbrauchsschutz</p>
          <h2 id="datenschutz-title">Datenschutz bei der Terminprüfung</h2>
          <p>{agentPrivacySummary}</p>
          <p>
            <a href={agentBookingPage.privacyPath}>Vollständige Datenschutzhinweise zur Terminabfrage</a>
          </p>
        </section>

        <section class="agent-section agent-warning" id="werbeverbot" aria-labelledby="werbung-title">
          <p class="agent-label">Ausdrücklicher Werbewiderspruch</p>
          <h2 id="werbung-title">{agentAdvertisingPolicy.heading}</h2>
          {agentAdvertisingPolicy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p class="agent-legal-links">
            Rechtsgrundlagen und Verfahren richten sich nach dem Einzelfall; siehe
            insbesondere <a href="https://www.gesetze-im-internet.de/uwg_2004/__7.html" rel="noopener noreferrer" target="_blank">§ 7 UWG</a>{" "}
            und <a href="https://www.gesetze-im-internet.de/uwg_2004/__13.html" rel="noopener noreferrer" target="_blank">§ 13 UWG</a>.
          </p>
        </section>
      </article>
    </main>

    <footer class="gallery-footer">
      <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
        <img src="/images/logo-artbild-black.png" width="1200" height="480" alt="Artbild Fotografie">
      </a>
      <nav aria-label="Footer">
        <a href="/kontakt/">Kontakt</a>
        <a href="/hochzeitsfotograf-preise/">Preise</a>
        <a href={markdownPath}>Markdown</a>
        <a href={openApiPath}>OpenAPI</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutzerklärung</a>
      </nav>
      <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
    </footer>

    <script>
      import {
        BOOKING_INQUIRY_DRAFT_STORAGE_KEY,
        bookingInquiryPackageOptions,
        bookingInquiryRequestTypes,
        createBookingInquiryDraft,
      } from "../../lib/bookingInquiryDraft";

      const quickForm = document.querySelector<HTMLFormElement>("[data-single-date-form]");
      const quickResult = document.querySelector<HTMLElement>("[data-single-date-result]");
      const quickDateInput = quickForm?.querySelector<HTMLInputElement>('input[name="date"]') || null;
      const form = document.querySelector<HTMLFormElement>("[data-agent-availability-form]");
      const result = document.querySelector<HTMLElement>("[data-agent-availability-result]");
      const dateInputs = form
        ? Array.from(form.querySelectorAll<HTMLInputElement>('input[type="date"]'))
        : [];

      const berlinToday = (() => {
        const parts = new Intl.DateTimeFormat("en-CA", {
          timeZone: "Europe/Berlin",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).formatToParts(new Date());
        const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
        return `${values.year}-${values.month}-${values.day}`;
      })();

      const maximumDate = (() => {
        const [year, month, day] = berlinToday.split("-").map(Number);
        const targetMonth = month - 1 + 24;
        const targetYear = year + Math.floor(targetMonth / 12);
        const normalizedMonth = targetMonth % 12;
        const lastDay = new Date(Date.UTC(targetYear, normalizedMonth + 1, 0)).getUTCDate();
        return [
          String(targetYear).padStart(4, "0"),
          String(normalizedMonth + 1).padStart(2, "0"),
          String(Math.min(day, lastDay)).padStart(2, "0"),
        ].join("-");
      })();

      type ImperativeWebMcpTool = {
        name: string;
        title: string;
        description: string;
        inputSchema: Record<string, unknown>;
        annotations: { readOnlyHint: boolean };
        execute: (input: unknown) => unknown;
      };

      type WebMcpDocument = Document & {
        modelContext?: {
          registerTool: (tool: ImperativeWebMcpTool) => Promise<unknown>;
        };
      };

      const modelContext = (document as WebMcpDocument).modelContext;
      if (modelContext) {
        void modelContext.registerTool({
          name: "start_booking_inquiry",
          title: "Buchungsanfrage vorbereiten",
          description: "Öffnet das Kontaktformular mit Auftragsart, Wunschdatum, Ort und optionalem Paket. Es wird keine Anfrage versendet.",
          inputSchema: {
            type: "object",
            properties: {
              requestType: {
                type: "string",
                enum: bookingInquiryRequestTypes,
                description: "Art des konkreten Fotoauftrags.",
              },
              date: {
                type: "string",
                format: "date",
                description: "Wunschdatum im Format YYYY-MM-DD.",
              },
              location: {
                type: "string",
                minLength: 2,
                maxLength: 160,
                description: "Ort oder Location des Fotoauftrags.",
              },
              packageId: {
                type: "string",
                enum: bookingInquiryPackageOptions.map(({ id }) => id),
                description: "Optionales veröffentlichtes Fotopaket.",
              },
            },
            required: ["requestType", "date", "location"],
            additionalProperties: false,
          },
          annotations: {
            readOnlyHint: false,
          },
          execute: (input) => {
            const result = createBookingInquiryDraft(input, {
              minDate: berlinToday,
              maxDate: maximumDate,
            });
            if (!result.ok) return result;

            try {
              sessionStorage.setItem(
                BOOKING_INQUIRY_DRAFT_STORAGE_KEY,
                JSON.stringify(result.draft),
              );
            } catch {
              return {
                ok: false,
                error: "draft_storage_unavailable",
                message: "Die Anfrage konnte nicht vorbereitet werden. Bitte öffne das Kontaktformular direkt.",
              };
            }

            const destination = "/kontakt/#kontaktformular";
            window.setTimeout(() => window.location.assign(destination), 0);
            return {
              ok: true,
              status: "draft_prepared",
              destination,
              submitted: false,
              message: "Das Kontaktformular wird zur persönlichen Prüfung geöffnet. Es wurde nichts versendet.",
            };
          },
        }).catch(() => {
          // Die bestehende HTML- und Formularfunktion bleibt ohne Imperative API erhalten.
        });
      }

      const allDateInputs = quickDateInput ? [quickDateInput, ...dateInputs] : dateInputs;

      allDateInputs.forEach((input) => {
        input.min = berlinToday;
        input.max = maximumDate;
      });

      const formatDate = (value: string) => new Intl.DateTimeFormat("de-DE", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        timeZone: "UTC",
      }).format(new Date(`${value}T00:00:00Z`));

      const showMessage = (
        target: HTMLElement | null,
        message: string,
        state: "success" | "error" | "pending",
      ) => {
        if (!target) return;
        target.hidden = false;
        target.dataset.state = state;
        target.replaceChildren();
        const paragraph = document.createElement("p");
        paragraph.textContent = message;
        target.append(paragraph);
      };

      type WebMcpSubmitEvent = SubmitEvent & {
        readonly agentInvoked?: boolean;
        respondWith?: (response: Promise<unknown>) => void;
      };

      const respondToWebMcp = (event: SubmitEvent, operation: Promise<unknown>) => {
        const webMcpEvent = event as WebMcpSubmitEvent;
        if (webMcpEvent.agentInvoked && typeof webMcpEvent.respondWith === "function") {
          webMcpEvent.respondWith(operation);
        }
      };

      const rateLimitFromHeaders = (headers: Headers) => {
        const limit = headers.get("X-RateLimit-Limit");
        const remaining = headers.get("X-RateLimit-Remaining");
        const resetAt = headers.get("X-RateLimit-Reset");

        return {
          limit: limit === null ? null : Number(limit),
          remaining: remaining === null ? null : Number(remaining),
          resetAt,
        };
      };

      const checkSingleDateAvailability = async () => {
        if (!quickForm || !quickDateInput || !quickForm.reportValidity()) {
          return {
            ok: false,
            error: "invalid_input",
            message: "Bitte gib genau ein gültiges Wunschdatum an.",
          };
        }

        const submit = quickForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const endpoint = quickForm.dataset.singleDateEndpoint || "/api/agent-availability";
        submit?.setAttribute("disabled", "");
        showMessage(quickResult, "Der Termin wird geprüft …", "pending");

        try {
          const response = await fetch(
            `${endpoint}?date=${encodeURIComponent(quickDateInput.value)}`,
            { headers: { Accept: "application/json" } },
          );
          const payload = await response.json();

          if (!response.ok) {
            const message = payload.message || "Die Terminprüfung ist gerade nicht möglich.";
            showMessage(quickResult, message, "error");
            return {
              ok: false,
              status: response.status,
              error: payload.error || "availability_check_failed",
              message,
              rateLimit: rateLimitFromHeaders(response.headers),
            };
          }

          if (quickResult) {
            quickResult.hidden = false;
            quickResult.dataset.state = "success";
            quickResult.replaceChildren();

            const heading = document.createElement("h3");
            heading.textContent = "Unverbindliches Ergebnis";
            quickResult.append(heading);

            const status = document.createElement("p");
            const date = document.createElement("strong");
            date.textContent = formatDate(payload.date);
            status.append(date, `: ${payload.available ? "aktuell verfügbar" : "aktuell nicht verfügbar"}`);
            quickResult.append(status);

            const note = document.createElement("p");
            note.textContent = "Der Kalenderstand ist unverbindlich und reserviert keinen Termin.";
            quickResult.append(note);

            const remaining = response.headers.get("X-RateLimit-Remaining");
            if (remaining !== null) {
              const remainingNote = document.createElement("p");
              remainingNote.className = "agent-check__remaining";
              remainingNote.textContent = `Noch ${remaining} unterschiedliche Kalendertag(e) in diesem 24-Stunden-Fenster.`;
              quickResult.append(remainingNote);
            }
          }

          return {
            ok: true,
            date: payload.date,
            available: payload.available,
            availabilityIsBinding: false,
            createsReservation: false,
            rateLimit: rateLimitFromHeaders(response.headers),
          };
        } catch {
          const message = "Die Terminprüfung ist gerade nicht erreichbar. Bitte versuche es später erneut.";
          showMessage(quickResult, message, "error");
          return {
            ok: false,
            error: "temporarily_unavailable",
            message,
          };
        } finally {
          submit?.removeAttribute("disabled");
        }
      };

      quickForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        const operation = checkSingleDateAvailability();
        respondToWebMcp(event, operation);
        void operation;
      });

      const checkMultipleDateAvailability = async () => {
        if (!form || !form.reportValidity()) {
          return {
            ok: false,
            error: "invalid_input",
            message: "Bitte gib mindestens ein gültiges Wunschdatum an.",
          };
        }

        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const dates = dateInputs.map((input) => input.value).filter(Boolean);
        const uniqueDates = [...new Set(dates)];

        if (uniqueDates.length !== dates.length) {
          const message = "Bitte wähle unterschiedliche Wunschdaten.";
          showMessage(result, message, "error");
          return {
            ok: false,
            error: "duplicate_dates",
            message,
          };
        }

        submit?.setAttribute("disabled", "");
        showMessage(result, "Die Termine werden geprüft …", "pending");

        try {
          const response = await fetch("/api/agent-availability", {
            method: "POST",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ dates: uniqueDates }),
          });
          const payload = await response.json();

          if (!response.ok) {
            const message = payload.message || "Die Terminprüfung ist gerade nicht möglich.";
            showMessage(result, message, "error");
            return {
              ok: false,
              status: response.status,
              error: payload.error || "availability_check_failed",
              message,
              rateLimit: payload.rateLimit || null,
            };
          }

          if (result) {
            result.hidden = false;
            result.dataset.state = "success";
            result.replaceChildren();

            const heading = document.createElement("h3");
            heading.textContent = "Ergebnis der unverbindlichen Terminprüfung";
            result.append(heading);

            const list = document.createElement("ul");
            for (const item of payload.results || []) {
              const listItem = document.createElement("li");
              const date = document.createElement("strong");
              date.textContent = formatDate(item.date);
              const status = document.createElement("span");
              status.textContent = item.available ? "aktuell verfügbar" : "aktuell nicht verfügbar";
              listItem.append(date, status);
              list.append(listItem);
            }
            result.append(list);

            const note = document.createElement("p");
            note.textContent = payload.advice?.message
              || "Der Kalenderstand ist unverbindlich und reserviert keinen Termin.";
            result.append(note);

            const remaining = document.createElement("p");
            remaining.className = "agent-check__remaining";
            remaining.textContent = `Noch ${payload.rateLimit?.remaining ?? 0} Abfrage(n) in diesem 24-Stunden-Fenster.`;
            result.append(remaining);
          }

          return {
            ok: true,
            results: payload.results || [],
            advice: payload.advice || null,
            rateLimit: payload.rateLimit || null,
            availabilityIsBinding: false,
            createsReservation: false,
          };
        } catch {
          const message = "Die Terminprüfung ist gerade nicht erreichbar. Bitte versuche es später erneut.";
          showMessage(result, message, "error");
          return {
            ok: false,
            error: "temporarily_unavailable",
            message,
          };
        } finally {
          submit?.removeAttribute("disabled");
        }
      };

      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        const operation = checkMultipleDateAvailability();
        respondToWebMcp(event, operation);
        void operation;
      });
    </script>
  </body>
</html>

