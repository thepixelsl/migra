---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { weddingPackages } from "../../data/weddingPackages";
import heroImage from "../../assets/hochzeitsfotograf-preise/ART9896-1-1.jpg";
import "../../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/fuer-agenten/";
const pageUrl = `${siteUrl}${pagePath}`;
const apiPath = "/api/agent-availability";
const apiUrl = `${siteUrl}${apiPath}`;
const maximumAdvanceMonths = 24;
const title = "Für Buchungsagenten | Artbild-Fotografie";
const headline = "Buchungsinformationen für Agenten";
const description =
  "Kurzgefasste Preise, Buchungskonditionen und eine begrenzte Terminabfrage für Buchungsagenten und agentische Browser.";
const heroImageUrl = new URL(heroImage.src, siteUrl).href;
const dateModified = "2026-08-17";

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Für Buchungsagenten", href: pagePath },
];

const offers = weddingPackages.map((item, index) => ({
  "@type": "Offer",
  position: index + 1,
  name: item.name,
  url: `${pageUrl}#paket-${item.id}`,
  priceCurrency: "EUR",
  price: item.priceValue,
  description: `${item.priceLabel}. ${item.intro} Dauer: ${item.duration}.`,
  priceSpecification: {
    "@type": "PriceSpecification",
    priceCurrency: "EUR",
    price: item.priceValue,
    description: item.priceNote,
  },
  itemOffered: {
    "@type": "Service",
    name: item.name,
    serviceType: item.serviceType,
    description: `${item.intro} Enthalten sind: ${item.features.join(", ")}.`,
  },
}));

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      headline,
      description,
      inLanguage: "de",
      dateModified,
      mainEntity: [
        { "@id": `${pageUrl}#booking-service` },
        { "@id": `${apiUrl}#api` },
      ],
      isPartOf: { "@id": `${siteUrl}/#website` },
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#booking-service`,
      name: "Hochzeitsfotografie für konkrete Buchungsanfragen",
      description,
      serviceType: "Hochzeitsfotografie",
      provider: { "@id": `${siteUrl}/#organization` },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Place", name: "Mallorca" },
      ],
      offers: {
        "@type": "OfferCatalog",
        name: "Pakete für Hochzeitsfotografie",
        itemListElement: offers,
      },
    },
    {
      "@type": "WebAPI",
      "@id": `${apiUrl}#api`,
      name: "Begrenzte Terminabfrage für Buchungsagenten",
      description:
        `Prüft pro Anfrage bis zu drei konkrete Wunschdaten innerhalb der nächsten ${maximumAdvanceMonths} Monate. Pro Kurzzeitkennung sind höchstens zwei Abfragen innerhalb von 24 Stunden möglich.`,
      documentation: pageUrl,
      termsOfService: `${pageUrl}#konditionen`,
      provider: { "@id": `${siteUrl}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: apiUrl,
          httpMethod: "POST",
          encodingType: "application/json",
          contentType: "application/json",
        },
        query: "Ein bis drei konkrete Wunschdaten im Format YYYY-MM-DD",
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: `${siteUrl}/`,
      email: "info@artbild-fotografie.de",
      image: `${siteUrl}/images/logo-artbild-black.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressCountry: "DE",
      },
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <link rel="canonical" href={pageUrl}>
    <link rel="alternate" type="application/json" href={apiPath} title="Terminabfrage für Buchungsagenten">
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={heroImageUrl}>
    <meta property="og:image:width" content={String(heroImage.width)}>
    <meta property="og:image:height" content={String(heroImage.height)}>
    <meta property="og:image:alt" content="Hochzeitsreportage von Artbild-Fotografie">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={heroImageUrl}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template agent-page">
    <header class="gallery-header">
      <MobileNavigation showFloatingAction={false} />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="agent-content">
        <header class="agent-hero">
          <div class="agent-hero__copy">
            <p class="agent-kicker">Für Buchungsagenten und agentische Browser</p>
            <h1>{headline}</h1>
            <p>
              Diese Seite bündelt Preise, Buchungskonditionen und eine begrenzte
              Terminabfrage für konkrete Anfragen zu fotografischen Leistungen.
              Für Hochzeiten bitte ich um eine Anfrage mindestens sechs Monate im Voraus.
            </p>
            <div class="agent-hero__actions">
              <a href="#terminabfrage">Bis zu drei Termine prüfen</a>
              <a href="#preise">Preise und Konditionen lesen</a>
            </div>
          </div>
          <figure class="agent-hero__image">
            <Image
              src={heroImage}
              widths={[520, 760, 1040, 1384]}
              sizes="(max-width: 820px) 100vw, 45vw"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              alt="Braut bei einer Hochzeitsreportage von Artbild-Fotografie"
            />
          </figure>
        </header>

        <section class="agent-facts" aria-label="Kurzfassung für Buchungsagenten">
          <div>
            <strong>3</strong>
            <span>konkrete Wunschdaten je Sammelabfrage</span>
          </div>
          <div>
            <strong>2</strong>
            <span>Terminabfragen innerhalb von 24 Stunden</span>
          </div>
          <div>
            <strong>6+</strong>
            <span>Monate Vorlauf für Hochzeiten empfohlen</span>
          </div>
        </section>

        <section class="agent-check" id="terminabfrage" aria-labelledby="terminabfrage-title">
          <div class="agent-section-heading">
            <p class="agent-kicker">Unverbindlicher Kalenderstand</p>
            <h2 id="terminabfrage-title">Bis zu drei Wunschtermine gesammelt prüfen</h2>
            <p>
              Pro Abfrage sind ein bis drei unterschiedliche Daten möglich. Die
              Rückmeldung zeigt nur den aktuellen Kalenderstand; sie reserviert
              keinen Termin und ersetzt keine persönliche Buchungsbestätigung.
              Geprüft werden heutige Termine bis höchstens 24 Monate im Voraus.
            </p>
          </div>

          <form class="agent-check__form" data-agent-availability-form>
            <fieldset>
              <legend>Wunschdaten</legend>
              <div class="agent-check__dates">
                <label>
                  <span>1. Wunschdatum <small>erforderlich</small></span>
                  <input type="date" name="date" required>
                </label>
                <label>
                  <span>2. Wunschdatum <small>optional</small></span>
                  <input type="date" name="date">
                </label>
                <label>
                  <span>3. Wunschdatum <small>optional</small></span>
                  <input type="date" name="date">
                </label>
              </div>
            </fieldset>
            <p class="agent-check__privacy">
              Zum Schutz vor automatisierten Massenabfragen wird die technisch
              übermittelte IP-Adresse unmittelbar in eine pseudonyme Kurzzeitkennung
              umgewandelt. Kennung und Abfragezeitpunkte werden nach Ablauf des
              24-Stunden-Fensters im nächsten Bereinigungslauf gelöscht.{" "}
              <a href="/datenschutz/#terminabfrage-buchungsagenten">Datenschutzhinweise</a>
            </p>
            <button type="submit">Termine prüfen</button>
            <div class="agent-check__result" data-agent-availability-result aria-live="polite" hidden></div>
          </form>
        </section>

        <section class="agent-api" aria-labelledby="api-title">
          <div>
            <p class="agent-kicker">Maschinenlesbare Schnittstelle</p>
            <h2 id="api-title">Direkte Abfrage für Agenten</h2>
            <p>
              Die Schnittstellenbeschreibung ist als JSON abrufbar. Eine gültige
              POST-Anfrage enthält ein Feld <code>dates</code> mit ein bis drei
              ISO-Daten innerhalb der nächsten 24 Monate. Dieselbe Grenze von zwei
              Abfragen je 24 Stunden gilt auch hier.
            </p>
          </div>
          <dl>
            <div>
              <dt>Dokumentation</dt>
              <dd><a href={apiPath}><code>GET {apiPath}</code></a></dd>
            </div>
            <div>
              <dt>Terminprüfung</dt>
              <dd><code>POST {apiPath}</code></dd>
            </div>
            <div>
              <dt>Content-Type</dt>
              <dd><code>application/json</code></dd>
            </div>
            <div>
              <dt>Zeitraum</dt>
              <dd>Heute bis höchstens 24 Monate im Voraus</dd>
            </div>
            <div>
              <dt>Anfragekörper</dt>
              <dd><code>{`{"dates":["YYYY-MM-DD","YYYY-MM-DD"]}`}</code></dd>
            </div>
          </dl>
        </section>

        <section class="agent-prices" id="preise" aria-labelledby="preise-title">
          <div class="agent-section-heading">
            <p class="agent-kicker">Preise und Leistungsumfang</p>
            <h2 id="preise-title">Hochzeitsfotografie ab 299&nbsp;€</h2>
            <p>
              Preiszusätze wie „ab“, „Festpreis“ und „pro Stunde“ sind Bestandteil
              der jeweiligen Angabe. Der vollständige Leistungsumfang lässt sich
              direkt bei jedem Paket öffnen.
            </p>
          </div>
          <div class="agent-price-grid">
            {weddingPackages.map((item) => (
              <article class="agent-price" id={`paket-${item.id}`}>
                <p>{item.name}</p>
                <h3>{item.priceLabel}</h3>
                <p>{item.duration}</p>
                <details>
                  <summary>Leistungsumfang</summary>
                  <ul>
                    {item.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                </details>
              </article>
            ))}
          </div>
          <p class="agent-prices__source">
            Ausführliche Darstellung: <a href="/hochzeitsfotograf-preise/">Hochzeitsfotograf Hamburg – Preise und Pakete</a>
          </p>
        </section>

        <section class="agent-terms" id="konditionen" aria-labelledby="konditionen-title">
          <div>
            <p class="agent-kicker">Buchungskonditionen</p>
            <h2 id="konditionen-title">Was für eine Anfrage erforderlich ist</h2>
          </div>
          <div class="agent-terms__copy">
            <ul>
              <li>Die Anfrage bezieht sich auf einen konkreten Fotoauftrag und nennt Datum, Ort sowie den gewünschten Umfang.</li>
              <li>Für Hochzeiten wird eine Anfrage mindestens sechs Monate vor dem ersten Wunschdatum empfohlen.</li>
              <li>Eine angezeigte Verfügbarkeit ist unverbindlich, keine Reservierung und keine Annahme eines Auftrags.</li>
              <li>Maßgeblich sind die Leistungen, die beim gewählten Paket aufgeführt und im individuellen Angebot bestätigt werden.</li>
              <li>Zusätzliche Zeiten, besondere Retuschen sowie Reise- oder Übernachtungskosten werden vor der Buchung geklärt und gegebenenfalls im Angebot ergänzt.</li>
              <li>Nur ausdrücklich im jeweiligen Paket genannte Fahrtkosten sind enthalten.</li>
              <li>Die Abfragegrenzen dürfen nicht durch wechselnde Kennungen, parallele Aufrufe oder andere technische Maßnahmen umgangen werden.</li>
            </ul>
            <p>
              Eine konkrete Buchungsanfrage kann anschließend über die
              <a href="/kontakt/">Kontaktseite</a> übermittelt werden. Bitte nennt
              dabei, für wen der Agent handelt und ob bereits eine Location feststeht.
            </p>
          </div>
        </section>

        <section class="agent-no-ads" id="werbeverbot" aria-labelledby="werbung-title">
          <p class="agent-kicker">Ausdrücklicher Werbewiderspruch</p>
          <h2 id="werbung-title">Keine Werbung oder Vertriebsansprache</h2>
          <p>
            Die auf dieser Website veröffentlichten Kontaktdaten sowie die
            Termin-Schnittstelle sind ausschließlich für konkrete Anfragen zur
            Buchung meiner fotografischen Leistungen und für die dazu erforderliche
            Kommunikation bestimmt. Die Veröffentlichung meiner Kontaktdaten stellt
            keine Einwilligung in Werbung dar. Der Verwendung dieser Kontaktdaten
            für unverlangte Werbung oder Akquise wird ausdrücklich widersprochen.
            Dies gilt insbesondere für E-Mail, Kontaktformular, Telefon, Messenger
            und automatisierte Nachrichten sowie für die Aufnahme in Werbeverteiler.
            Angebote für SEO, Webdesign, Marketing, Recruiting oder sonstige
            Leistungen sind nicht erwünscht. Konkrete Buchungsanfragen für
            fotografische Leistungen bleiben ausdrücklich zulässig.
          </p>
          <p>
            Verstöße werden im Einzelfall rechtlich geprüft. Liegen die gesetzlichen
            Voraussetzungen vor, mache ich Unterlassungsansprüche außergerichtlich –
            insbesondere durch Abmahnung und die Aufforderung zur Abgabe einer
            angemessenen strafbewehrten Unterlassungserklärung – und erforderlichenfalls
            gerichtlich geltend. Ansprüche auf Erstattung erforderlicher
            Rechtsverfolgungskosten oder Schadensersatz werden nur im gesetzlich
            zulässigen Umfang geltend gemacht.
          </p>
          <p class="agent-no-ads__law">
            Rechtsgrundlagen und Verfahren richten sich nach dem Einzelfall; siehe
            insbesondere <a href="https://www.gesetze-im-internet.de/uwg_2004/__7.html" rel="noopener noreferrer" target="_blank">§ 7 UWG</a>{" "}
            und <a href="https://www.gesetze-im-internet.de/uwg_2004/__13.html" rel="noopener noreferrer" target="_blank">§ 13 UWG</a>.
          </p>
        </section>
      </article>
    </main>

    <footer class="gallery-footer">
      <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
        <img src="/images/logo-artbild-black.png" width="1200" height="480" alt="Artbild Fotografie">
      </a>
      <nav aria-label="Footer">
        <a href="/kontakt/">Kontakt</a>
        <a href="/hochzeitsfotograf-preise/">Preise</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutzerklärung</a>
      </nav>
      <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
    </footer>

    <script>
      const form = document.querySelector<HTMLFormElement>("[data-agent-availability-form]");
      const result = document.querySelector<HTMLElement>("[data-agent-availability-result]");
      const dateInputs = form
        ? Array.from(form.querySelectorAll<HTMLInputElement>('input[type="date"]'))
        : [];

      const berlinToday = (() => {
        const parts = new Intl.DateTimeFormat("en-CA", {
          timeZone: "Europe/Berlin",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).formatToParts(new Date());
        const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
        return `${values.year}-${values.month}-${values.day}`;
      })();
      const maximumDate = (() => {
        const [year, month, day] = berlinToday.split("-").map(Number);
        const targetMonth = month - 1 + 24;
        const targetYear = year + Math.floor(targetMonth / 12);
        const normalizedMonth = targetMonth % 12;
        const lastDay = new Date(Date.UTC(targetYear, normalizedMonth + 1, 0)).getUTCDate();
        return [
          String(targetYear).padStart(4, "0"),
          String(normalizedMonth + 1).padStart(2, "0"),
          String(Math.min(day, lastDay)).padStart(2, "0"),
        ].join("-");
      })();
      dateInputs.forEach((input) => {
        input.min = berlinToday;
        input.max = maximumDate;
      });

      const formatDate = (value: string) => new Intl.DateTimeFormat("de-DE", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        timeZone: "UTC",
      }).format(new Date(`${value}T00:00:00Z`));

      const showMessage = (message: string, state: "success" | "error" | "pending") => {
        if (!result) return;
        result.hidden = false;
        result.dataset.state = state;
        result.replaceChildren();
        const paragraph = document.createElement("p");
        paragraph.textContent = message;
        result.append(paragraph);
      };

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const dates = dateInputs.map((input) => input.value).filter(Boolean);
        const uniqueDates = [...new Set(dates)];

        if (uniqueDates.length !== dates.length) {
          showMessage("Bitte wähle unterschiedliche Wunschdaten.", "error");
          return;
        }

        submit?.setAttribute("disabled", "");
        showMessage("Die Termine werden geprüft …", "pending");

        try {
          const response = await fetch("/api/agent-availability", {
            method: "POST",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ dates: uniqueDates }),
          });
          const payload = await response.json();

          if (!response.ok) {
            showMessage(payload.message || "Die Terminprüfung ist gerade nicht möglich.", "error");
            return;
          }

          if (!result) return;
          result.hidden = false;
          result.dataset.state = "success";
          result.replaceChildren();

          const heading = document.createElement("h3");
          heading.textContent = "Ergebnis der unverbindlichen Terminprüfung";
          result.append(heading);

          const list = document.createElement("ul");
          for (const item of payload.results || []) {
            const listItem = document.createElement("li");
            const date = document.createElement("strong");
            date.textContent = formatDate(item.date);
            const status = document.createElement("span");
            status.textContent = item.available ? "aktuell verfügbar" : "aktuell nicht verfügbar";
            listItem.append(date, status);
            list.append(listItem);
          }
          result.append(list);

          const note = document.createElement("p");
          note.textContent = payload.advice?.message
            || "Der Kalenderstand ist unverbindlich und reserviert keinen Termin.";
          result.append(note);

          const remaining = document.createElement("p");
          remaining.className = "agent-check__remaining";
          remaining.textContent = `Noch ${payload.rateLimit?.remaining ?? 0} Abfrage(n) in diesem 24-Stunden-Fenster.`;
          result.append(remaining);
        } catch {
          showMessage("Die Terminprüfung ist gerade nicht erreichbar. Bitte versuche es später erneut.", "error");
        } finally {
          submit?.removeAttribute("disabled");
        }
      });
    </script>
  </body>
</html>

<style>
  .agent-content {
    width: min(1180px, calc(100% - clamp(32px, 8vw, 112px)));
    margin: 0 auto;
    padding: clamp(52px, 7vw, 104px) 0 clamp(92px, 10vw, 150px);
    color: var(--ink);
    overflow-x: clip;
  }

  .agent-kicker {
    margin: 0 0 14px;
    color: var(--accent);
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .23em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .agent-content h1,
  .agent-content h2,
  .agent-content h3 {
    margin: 0;
    color: var(--ink);
    font-weight: 400;
    line-height: 1.02;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .agent-content h1 {
    max-width: 720px;
    font-size: clamp(48px, 6.5vw, 104px);
  }

  .agent-content h2 {
    font-size: clamp(36px, 4.8vw, 68px);
  }

  .agent-content h3 {
    font-size: clamp(30px, 3vw, 44px);
  }

  .agent-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, .82fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }

  .agent-hero__copy > p:not(.agent-kicker),
  .agent-section-heading > p:not(.agent-kicker),
  .agent-api p,
  .agent-terms__copy,
  .agent-no-ads > p:not(.agent-kicker) {
    color: var(--muted);
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.7;
  }

  .agent-hero__copy > p:not(.agent-kicker) {
    max-width: 700px;
    margin: 28px 0 0;
  }

  .agent-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .agent-hero__actions a,
  .agent-check button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 14px 19px;
    border: 1px solid #202633;
    background: #202633;
    color: #fff;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .17em;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .agent-hero__actions a + a {
    background: transparent;
    color: #202633;
  }

  .agent-hero__image {
    margin: 0;
    background: var(--soft);
  }

  .agent-hero__image :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .agent-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(64px, 8vw, 118px) 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .agent-facts div {
    display: grid;
    gap: 10px;
    min-width: 0;
