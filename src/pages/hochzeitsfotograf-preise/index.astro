---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import "../../styles/global.css";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialReviewQuote from "../../components/EditorialReviewQuote.astro";
import { googleReviews } from "../../data/reviews";
import { weddingPackages } from "../../data/weddingPackages";
import { packagePriceSchema } from "../../data/packagePriceSchema.mjs";
import heroImage from "../../assets/hochzeitsfotograf-preise/ART9896-1-1.jpg";
import pureMomentsImage from "../../assets/hochzeitsfotograf-niedersachsen/Hochzeit_Lauenbrueck_7587.jpg";
import standesamtImage from "../../assets/hochzeitsfotograf-preise/ART_0074-Bearbeitet_print.jpg";
import reportageImage from "../../assets/hochzeitsfotograf-preise/ART_3680-Bearbeitet-Wiederhergestellt_web.jpg";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/hochzeitsfotograf-preise/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "Hochzeitsfotograf Hamburg Preise";
const description =
  "Preise und Pakete für Hochzeitsfotografie in Hamburg mit dem jeweils aufgeführten Leistungsumfang und Hinweisen zum individuellen Angebot.";
const primaryImage = new URL(heroImage.src, siteUrl).href;

const packageMedia = {
  "pure-moments": {
    image: pureMomentsImage,
    alt: "Brautpaar in Lauenbrück als Beispiel für das Pure Moments Paket",
    imageOrientation: "portrait",
  },
  "standesamt-paket": {
    image: standesamtImage,
    alt: "Brautportrait als Beispiel für das Standesamt Paket in Hamburg",
    imageOrientation: "portrait",
  },
  "rundum-sorglos-paket": {
    image: reportageImage,
    alt: "Brautpaarshooting als Beispiel für eine längere Hochzeitsreportage",
    imageOrientation: "portrait",
  },
} as const;

const packages = weddingPackages.map((item) => ({
  ...item,
  ...packageMedia[item.id],
}));

const packageOffers = packages.map((item) => ({
  "@type": "Offer",
  "@id": `${pageUrl}#angebot-${item.id}`,
  name: item.name,
  description: item.intro,
  url: `${pageUrl}#paket-${item.id}`,
  ...packagePriceSchema(item),
  category: "Hochzeitsfotografie",
  image: new URL(item.image.src, siteUrl).href,
  itemOffered: {
    "@type": "Service",
    "@id": `${pageUrl}#leistung-${item.id}`,
    name: item.name,
    serviceType: item.serviceType,
    description: `${item.intro} Dauer: ${item.duration}. Enthalten sind: ${item.features.join(", ")}.`,
    provider: {
      "@id": `${siteUrl}/#organization`,
    },
    areaServed: [
      { "@type": "City", name: "Hamburg" },
      { "@type": "AdministrativeArea", name: "Norddeutschland" },
    ],
  },
}));

const faqItems = [
  {
    question: "Was berechnest Du für die Anfahrt in Hamburg?",
    answer:
      "Innerhalb Hamburgs ist die Anfahrt kostenlos.",
  },
  {
    question: "Welche Fahrtkosten berechnest Du für die Anfahrt?",
    answer:
      "Ich berechne die tatsächlich angefallenen Kosten. Ein Pauschale rechne ich nicht ab.",
  },
  {
    question: "Berechnest Du die Fahrzeit als Arbeitszeit?",
    answer:
      "Nein, die Fahrzeit berechne ich nicht als Arbeitszeit. Hierfür entstehen keine zusätzlichen Kosten.",
  },
  {
    question:
      "Bearbeitest Du wirklich sämtliche Bilder ohne Extrakosten, auch wenn zum Beispiel AI Credits genutzt werden müssten?",
    answer:
      "Ja alle Bilder erhalten eine dezente Bearbeitung, sowie die Korrektur kleinerer Schönheitsfehler, wie zum Beispiel ein Fussel auf dem Anzug oder plötzlich aufgetretene Hautunreinheiten. Auch AI Credits sind bereits eingepreist.",
  },
  {
    question:
      "Wir möchten Verona, Italien heiraten und die Kosten pro Flug betragen 179,89€. Das Shooting dauert 4 Stunden und der Rückflug ist am selben Tag möglich. Benötigst Du dann noch eine Übernachtung?",
    answer:
      "Nein, für ein 4 Stunden Paket mit An- und Abreise am selben Tag wird keine Übernachtung benötigt. Die Reisekosten sind immer die tatsächlich entstandenen Kosten.",
  },
  {
    question:
      "Manchmal kommt das Leben oder auch ein Wirbelsturm dazwischen, der das Dach abgedeckt hat. Können wir Dein Honorar auch in Raten zahlen?",
    answer:
      "Ja auch Ratenzahlung mit Paypal Plus ist möglich.",
  },
  {
    question: "Was passiert wenn Du erkrankst und unsere Hochzeit nicht fotografieren kannst?",
    answer:
      "Ich bin gut vernetzt und werde einen zuverlässigen Ersatzfotografen für Eure Hochzeit finden.",
  },
  {
    question:
      "Wir möchten auch ein professionelles Video von unserer Hochzeit haben, kennst Du gute Videografen?",
    answer:
      "Ja, ich habe sehr zuverlässige und qualitativ gute Videografen in meinem Netzwerk.",
  },
  {
    question:
      "Was passiert wenn unsere Hochzeit nicht stattfinden kann, obwohl wir Dich schon per Vertrag gebucht haben. Müssen wir dann den vollen Preis zahlen?",
    answer:
      "Nein, findet die Hochzeit nicht statt, müsst Ihr nicht den vollen Preis zahlen. Nur bereits entstandene Kosten,  z. B. Flugbuchungen, nicht stornierbare Übernachtungen, Anzahlungen müssen getragen werden)",
  },
  {
    question:
      "Wir möchten schöne Bilder, in der Dämmerung mit Lichterketten von unserer Hochzeitsfeier.",
    answer:
      "Ich kann Sonnenrichtung, Zeiten für Sonnenauf- und Untergang für jedes Datum und jeden beliebigen Ort entsprechend vorhersagen. Wenn Ihr oder die Hochzeitsplanung mich in die Lichtplanung mit einbezieht,  könnt Ihr richtig tolle Bilder im Sonnenuntergang mit toller Stimmung erhalten.",
  },
  {
    question: "Was kostet eine Hochzeit?",
    answer:
      "Entscheidend ist die Anzahl der Gäste. Kostenfaktoren sind das Catering (Buffet mit Selbstbedienung oder Service am Sitzplatz), die Location (evtl. noch die Reisekosten bis zur Location), die Dekoration und Papeterie sowie die Kosten für Dienstleister Kleider und Anzug und für eine Hochzeitsreise. Schnell übersteigen die Kosten 10.000€. Vorabzahlungen können den Betrag erträglicher splitten, so dass die Kostenlast nicht auf einmal anfällt.",
  },
  {
    question: "Was kostet ein Hochzeitsfotograf?",
    answer:
      "Es ist bei uns üblich, dass das Brautpaar lediglich die fotografische Arbeit vor Ort bezahlt. Die Bildbearbeitung, das Bereitstellen der Bilder und die ganze nachträgliche Arbeit, die anfällt um die Hochzeitsbilder entsprechend bereitzustellen sind dort bereits eingepreist. Die Kosten steigen jedoch momentan schnell, in der Regel durch EU-Verordnungen im Datenschutz sowie mit der geplanten Rentenversicherungspflicht aller Einkünfte.",
  },
  {
    question: "Welche Zahlungsarten akzeptierst Du?",
    answer:
      "Barzahlung, Überweisung, PayPal Plus werden akzeptiert.",
  },
  {
    question:
      "Was passiert wenn wir Dich den ganzen Tag bis 22:00Uhr gebucht haben und die Torte verzögert sich um über 1 Stunde durch Verzögerungen, auf die wir keinen Einfluss hatten?",
    answer:
      "Niemals würde ich einfach abhauen und Euch im Regen stehen lassen, egal aus welchem Grund. Es ist eine Frage von Vertrauen und hanseatischer Redlichkeit einen so wichtigen Moment festzuhalten und nicht einfach die Hochzeit zu verlassen weil die Zeit abgelaufen war.",
  },
  {
    question:
      "Was passiert wenn wir ein 2 Stunden Paket gebucht haben aber nun 4 Stunden vor Ort möchten?",
    answer:
      "Fragt mich einfach vor Ort. Wenn es keine Folgebuchung gibt, können wir ganz unkompliziert die Zeit erweitern.",
  },
  {
    question: "Wie übergibst Du uns die Bilder?",
    answer:
      "Ihr erhaltet die Bilder in einer für Euch drei Monate lang kostenlosen, passwortgeschützten Online Galerie der Firma Picdrop aus Berlin.",
  },
];

const relatedLinks = [
  {
    href: "/das-perfekte-getting-ready-fuer-deine-hochzeit-in-hamburg/",
    label: "Getting Ready in Hamburg planen",
  },
  {
    href: "/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/",
    label: "Standesamtliche Trauung in Altona ansehen",
  },
  {
    href: "/gallery/traumhochzeit-in-hamburg/",
    label: "Hochzeit im Hotel Atlantic ansehen",
  },
  {
    href: "/portfolio/",
    label: "Portfolio ansehen",
  },
];


const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Preise & Leistungen", href: pagePath },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      mainEntity: {
        "@id": `${pageUrl}#service`,
      },
      datePublished: "2019-08-14T09:37:40+02:00",
      dateModified: "2026-08-18T00:00:00+02:00",
      inLanguage: "de",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: heroImage.width,
        height: heroImage.height,
        caption: "Hochzeitsfotograf Hamburg Preise",
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Hochzeitsfotografie Hamburg Preise",
      description,
      serviceType: "Hochzeitsfotografie",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        "@id": `${pageUrl}#pakete`,
        name: "Pakete für Hochzeitsfotografie in Hamburg",
        itemListElement: packageOffers,
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: siteUrl,
      email: "info@artbild-fotografie.de",
      image: `${siteUrl}/images/logo-artbild-black.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Place", name: "Mallorca" },
        { "@type": "Country", name: "Deutschland" },
      ],
      serviceType: ["Hochzeitsfotografie", "Hochzeitsreportage", "Standesamtliche Trauung"],
    },

  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={heroImage.width}>
    <meta property="og:image:height" content={heroImage.height}>
    <meta property="og:image:alt" content="Hochzeitsfotograf Hamburg Preise">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={primaryImage}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template pricing-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="pricing">
        <header class="pricing-hero">
          <div class="pricing-hero__copy">
            <p class="pricing-kicker">Hochzeitsfotograf Hamburg · Preise & Pakete</p>
            <h1>{title}</h1>
            <p>
              Hier findet ihr drei Pakete mit dem jeweils aufgeführten Preis und
              Leistungsumfang. Für einen abweichenden Ablauf erhaltet ihr ein
              individuelles Angebot vor der Buchung.
            </p>
            <div
              class="pricing-hero__actions"
              aria-label="Preis-Seite Aktionen"
              data-track-section="pricing_hero_actions"
              data-content-topic="hochzeitsfotografie_preise"
              data-user-intent="angebot_pruefen"
              data-journey-stage="decision"
              data-content-format="cta_group"
              data-position="hero"
            >
              <a
                href="#pakete"
                data-track-event="cta_click"
                data-cta-id="pricing_hero_packages"
                data-cta-type="anchor_navigation"
                data-section-id="pricing_hero_actions"
                data-content-topic="hochzeitsfotografie_preise"
                data-user-intent="pakete_ansehen"
                data-journey-stage="decision"
                data-position="hero_primary"
              >Pakete ansehen</a>
              <a
                href="/kontakt/"
                data-track-event="contact_click"
                data-cta-id="pricing_hero_contact"
                data-cta-type="contact_form"
                data-section-id="pricing_hero_actions"
                data-content-topic="hochzeitsfotografie_preise"
                data-user-intent="termin_anfragen"
                data-journey-stage="conversion"
                data-position="hero_secondary"
              >Termin anfragen</a>
            </div>
          </div>
          <figure class="pricing-hero__image">
            <Image
              src={heroImage}
              widths={[520, 760, 1040, 1384]}
              sizes="(max-width: 760px) 100vw, 48vw"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              alt="Braut bei einer Hochzeitsreportage in Hamburg"
            />
          </figure>
        </header>

        <nav
          class="pricing-toc"
          aria-label="Inhaltsübersicht Hochzeitsfotograf Preise"
          data-track-section="pricing_table_of_contents"
          data-content-topic="hochzeitsfotografie_preise"
          data-user-intent="preisdetails_navigieren"
          data-journey-stage="consideration"
          data-content-format="table_of_contents"
          data-position="after_hero"
        >
          <a href="#pakete" data-track-event="cta_click" data-cta-id="pricing_toc_packages" data-cta-type="anchor_navigation">Pakete</a>
          <a href="#enthalten" data-track-event="cta_click" data-cta-id="pricing_toc_included" data-cta-type="anchor_navigation">Enthaltene Leistungen</a>
          <a href="#faq" data-track-event="cta_click" data-cta-id="pricing_toc_faq" data-cta-type="anchor_navigation">FAQ</a>
          <a href="#anfrage" data-track-event="contact_click" data-cta-id="pricing_toc_contact" data-cta-type="anchor_navigation">Anfrage</a>
        </nav>

        <section class="pricing-intro" aria-labelledby="pricing-intro-title">
          <p class="pricing-kicker">Planbare Hochzeitsfotografie</p>
          <h2 id="pricing-intro-title">Was ist im Preis enthalten?</h2>
          <div class="pricing-copy">
            <p>
              Es gibt keine versteckten Kosten. Für sämtliche Bilder, ist die
              RAW-Bearbeitung aller Bilder bereits im Preis enthalten. Ihr müsst
              Euch also später nicht für oder gegen ein Bild entscheiden und die
              Bearbeitung der Bilder ändert auch nicht den vereinbarten Festpreis.
            </p>
            <p>
              Wenn Bilder gedruckt werden sollen so berate ich Euch gerne und führe
              auch wenn benötigt, die Farbkalibrierung (Colorproof) für die
              Druckvorbereitung für die zu druckenden Bilder durch. Für Euch ist
              dieser Extraservice im Preis mit inbegriffen.
            </p>
          </div>
        </section>

        <section class="pricing-packages" id="pakete" aria-labelledby="packages-title">
          <div class="pricing-section-heading">
            <p class="pricing-kicker">Pakete</p>
            <h2 id="packages-title">Hochzeitsreportage in Hamburg 299 €</h2>
          </div>
          <div class="pricing-package-grid">
            {packages.map((item, index) => (
              <article
                class={`pricing-package is-${item.imageOrientation}`}
                id={`paket-${item.id}`}
                aria-labelledby={`paket-${item.id}-name paket-${item.id}-title`}
                aria-describedby={item.showIntro === false ? undefined : `paket-${item.id}-intro`}
                data-schema-id={`${pageUrl}#angebot-${item.id}`}
              >
                <figure aria-label={`${item.name} Beispielbild`}>
                  <Image
                    src={item.image}
                    widths={[360, 520, 760]}
                    sizes="(max-width: 760px) 100vw, 31vw"
                    format="webp"
                    quality={88}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    alt={item.alt}
                  />
                </figure>
                <div class="pricing-package__body">
                  <p id={`paket-${item.id}-name`}>{item.name}</p>
                  <h3 id={`paket-${item.id}-title`}>{item.priceLabel}</h3>
                  {item.showIntro !== false && <p id={`paket-${item.id}-intro`}>{item.intro}</p>}
                  <ul aria-label={`Enthaltene Leistungen: ${item.name}`}>
                    {item.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <EditorialReviewQuote
          reviews={[
            googleReviews.manuelR,
            googleReviews.laraFriedrichs,
            googleReviews.freddyNa,
          ]}
          sectionId="preise_review_manuel_r"
          heading="Sicher vor der Kamera und gut vorbereitet"
          contentTopic="hochzeitspakete"
          userIntent="leistung_einschaetzen"
          journeyStage="vergleich"
          position="after_pricing_packages"
        />

        <section class="pricing-split" id="enthalten" aria-labelledby="included-title">
          <div>
            <p class="pricing-kicker">Leistungen</p>
            <h2 id="included-title">Bildbearbeitung und Retusche</h2>
          </div>
          <div class="pricing-copy">
            <p>
              Die RAW Bildbearbeitung ist im Preis enthalten. Dies beinhaltet konkret
              die Farbharmonisierung, Anpassung von Helligkeit, Licht und Schatten,
              groben Störungen, wie dem Entfernen von Pickeln oder punktuellen
              Hautunreinheiten.
            </p>
            <p>
              Die Retusche ist für ausgewählte Bilder möglich. Retusche erfolgt zwar
              durch KI unterstützt (auf Wunsch auch gänzlich ohne KI) jedoch immer noch
              weitestgehend manuell. Durch die dadurch garantierte Konsistenz können nur
              bestimmte, ausgewählte Bilder hochwertig retuschiert werden.
            </p>
          </div>
        </section>

        <section
          class="pricing-faq"
          id="faq"
          aria-labelledby="faq-title"
          data-track-section="preise_faq"
          data-content-topic="preise_pakete"
          data-user-intent="preisfragen_klaeren"
          data-journey-stage="vergleich"
          data-content-format="faq"
          data-position="pricing_faq"
        >
          <figure class="pricing-faq__media">
            <Image
              src={reportageImage}
              alt="Brautpaarshooting als Beispiel für eine Hochzeitsreportage mit klaren Preisen"
              widths={[420, 640, 768, 960]}
              sizes="(max-width: 760px) calc(100vw - 48px), (max-width: 1180px) 40vw, 470px"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={90}
            />
            <figcaption>Transparente Pakete, klare Leistungen und planbare Kosten</figcaption>
          </figure>

          <div class="pricing-faq__content">
            <p class="pricing-kicker">Fragen & Antworten</p>
            <h2 id="faq-title">Häufige Fragen zu Hochzeitsfotograf Preisen</h2>
            <p>
              Hier wird bewusst zwischen der Paketübersicht und dem verbindlichen
              individuellen Angebot unterschieden.
            </p>

            <div class="pricing-faq__list" aria-label="Häufige Fragen zu Hochzeitsfotograf Preisen">
              {faqItems.map((item, index) => (
                <details
                  class="pricing-faq__item"
                  data-track-event="faq_open"
                  data-faq-id={`preise_faq_${index + 1}`}
                  data-section-id="preise_faq"
                  data-content-topic="preise_pakete"
                  data-user-intent="preisfragen_klaeren"
                  data-journey-stage="vergleich"
                >
                  <summary class="pricing-faq__summary">
                    <span class="pricing-faq__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <span>{item.question}</span>
                    <span class="pricing-faq__toggle" aria-hidden="true"></span>
                  </summary>
                  <div class="pricing-faq__panel">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>

        <section
          class="pricing-related"
          aria-labelledby="related-title"
          data-track-section="preise_related_links"
          data-content-topic="hochzeitsplanung"
          data-user-intent="weiter_planen"
          data-journey-stage="vergleich"
          data-content-format="related_links"
          data-position="after_faq"
        >
          <p class="pricing-kicker">Weiter planen</p>
          <h2 id="related-title">Hilfreiche Seiten für eure Hochzeit</h2>
          <div>
            {relatedLinks.map((item, index) => (
              <a
                href={item.href}
                data-track-event="cta_click"
                data-cta-id={`preise_related_${index + 1}`}
                data-cta-type="internal_resource"
                data-section-id="preise_related_links"
                data-content-topic="hochzeitsplanung"
                data-user-intent="weiter_planen"
                data-journey-stage="vergleich"
              >{item.label}</a>
            ))}
          </div>
        </section>

        <section
          class="pricing-cta"
          id="anfrage"
          aria-labelledby="cta-title"
          data-track-section="preise_anfrage_cta"
          data-content-topic="terminverfuegbarkeit"
          data-user-intent="termin_anfragen"
          data-journey-stage="anfrage"
          data-content-format="cta_section"
          data-position="page_bottom"
        >
          <p class="pricing-kicker">Ist euer Termin noch frei?</p>
          <h2 id="cta-title">Fragt euren Hochzeitstermin unverbindlich an</h2>
          <p>
            Erzählt mir kurz, wann und wo ihr heiratet, welche Begleitung ihr
            euch wünscht und ob bereits eine Location feststeht.
          </p>
          <div>
            <a
              href="/kontakt/"
