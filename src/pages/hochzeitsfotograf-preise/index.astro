---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import "../../styles/global.css";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialReviewQuote from "../../components/EditorialReviewQuote.astro";
import ThankYouDiscount from "../../components/ThankYouDiscount.astro";
import { googleReviews } from "../../data/reviews";
import { weddingBookingHoursRule, weddingGalleryMonths, weddingPackages } from "../../data/weddingPackages";
import { packagePriceSchema } from "../../data/packagePriceSchema.mjs";
import { PACKAGE_NAMES } from "../../lib/pricingTracking.mjs";
import heroImage from "../../assets/hochzeitsfotograf-preise/ART9896-1-1.jpg";
import pureMomentsImage from "../../assets/hochzeitsfotograf-niedersachsen/Hochzeit_Lauenbrueck_7587.jpg";
import standesamtImage from "../../assets/hochzeitsfotograf-preise/ART_0074-Bearbeitet_print.jpg";
import reportageImage from "../../assets/hochzeitsfotograf-preise/ART_3680-Bearbeitet-Wiederhergestellt_web.jpg";

import content from '../../data/pricing-page.json';
import {pricingText,formatPricingEuro} from '../../lib/pricing-content.mjs';
const expand=(text:string)=>pricingText(text,content);
const t=(key:keyof typeof content.texts)=>expand(content.texts[key]);
const originals={'original:hero':heroImage,'original:pure':pureMomentsImage,'original:standesamt':standesamtImage,'original:reportage':reportageImage};
const media=(src:string)=>originals[src as keyof typeof originals] || src;
const heroMedia=media(content.images.hero.src), faqMedia=media(content.images.faq.src);
const heroSize=typeof heroMedia==='string'?content.images.hero:heroMedia;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/hochzeitsfotograf-preise/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = t('seoTitle');
const description = t('seoDescription');
const primaryImage = new URL(typeof heroMedia==='string'?heroMedia:heroMedia.src, siteUrl).href;
const [pureMoments, standesamtPackage, reportagePackage] = weddingPackages;
const formatPrice = formatPricingEuro;
const calculatorOptions = Array.from({ length: 10 }, (_, index) => {
  const hours = index + 1;
  const item = weddingPackages.filter(item=>hours>=item.minimumHours && hours<=item.maximumHours)
    .sort((a,b)=>(a.billingUnit==='hour'?hours*a.priceValue:a.priceValue)-(b.billingUnit==='hour'?hours*b.priceValue:b.priceValue))[0];
  return {hours, package:item, total:item.billingUnit==='hour'?hours*item.priceValue:item.priceValue,
    calculation:item.billingUnit==='hour'?`${hours} Stunden × ${formatPrice(item.priceValue)}`:`Festpreis für ${hours===1?'1 Stunde':`${hours} Stunden`}`};
});
const initialCalculation=calculatorOptions.find(option=>option.hours===6)!;
const pricingExamples = content.examples.map(example=>{
  const item=weddingPackages.find(item=>item.id===example.packageId)!;
  return {...example,title:expand(example.title),steps:example.steps.map(expand),calculation:expand(example.calculation),package:item,total:item.billingUnit==='hour'?example.hours*item.priceValue:item.priceValue};
});
const packages=weddingPackages.map(item=>({...item,image:media(item.image.src),alt:item.image.alt,imageOrientation:'portrait',imageWidth:item.image.width,imageHeight:item.image.height}));
const packageOffers=packages.map(item=>({
  '@type':'Offer','@id':`${pageUrl}#angebot-${item.id}`,name:item.name,description:item.intro,url:`${pageUrl}#paket-${item.id}`,...packagePriceSchema(item),category:'Hochzeitsfotografie',
  image:new URL(typeof item.image==='string'?item.image:item.image.src,siteUrl).href,
  itemOffered:{'@type':'Service','@id':`${pageUrl}#leistung-${item.id}`,name:item.name,serviceType:item.serviceType,
    description:`${item.intro} Dauer: ${item.duration}. ${weddingBookingHoursRule} Enthalten sind: ${item.features.join(', ')}.`,provider:{'@id':`${siteUrl}/#organization`},areaServed:[{'@type':'City',name:'Hamburg'},{'@type':'AdministrativeArea',name:'Norddeutschland'}]}
}));
const faqItems=content.faq.map(item=>({...item,question:expand(item.question),answer:expand(item.answer)}));
const relatedLinks=content.relatedLinks;

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Preise & Leistungen", href: pagePath },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      mainEntity: {
        "@id": `${pageUrl}#service`,
      },
      datePublished: "2019-08-14T09:37:40+02:00",
      dateModified: content.updatedAt || "2026-09-25T00:00:00+02:00",
      inLanguage: "de",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: heroSize.width,
        height: heroSize.height,
        caption: "Hochzeitsfotograf Hamburg Preise",
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Hochzeitsfotografie Hamburg Preise",
      description,
      serviceType: "Hochzeitsfotografie",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        "@id": `${pageUrl}#pakete`,
        name: "Pakete für Hochzeitsfotografie in Hamburg",
        itemListElement: packageOffers,
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: siteUrl,
      email: "info@artbild-fotografie.de",
      image: `${siteUrl}/images/logo-artbild-black.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Place", name: "Mallorca" },
        { "@type": "Country", name: "Deutschland" },
      ],
      serviceType: ["Hochzeitsfotografie", "Hochzeitsreportage", "Standesamtliche Trauung"],
    },

  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={heroSize.width}>
    <meta property="og:image:height" content={heroSize.height}>
    <meta property="og:image:alt" content="Hochzeitsfotograf Hamburg Preise">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={primaryImage}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template pricing-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="pricing">
        <header class="pricing-hero">
          <div class="pricing-hero__copy">
            <p class="pricing-kicker">{t('heroKicker')}</p>
            <h1>{t('heroTitleFirst')} <span>{t('heroTitleSecond')}</span></h1>
            <p>{t('heroIntro')}</p>
            <p class="pricing-hero__prices">
              {pureMoments.duration}: {pureMoments.priceLabel} · {standesamtPackage.duration}: {standesamtPackage.priceLabel}<br />
              {reportagePackage.duration}: {reportagePackage.priceLabel}
            </p>
            <div
              class="pricing-hero__actions"
              aria-label="Preis-Seite Aktionen"
              data-track-section="pricing_hero_actions"
              data-content-topic="hochzeitsfotografie_preise"
              data-user-intent="angebot_pruefen"
              data-journey-stage="decision"
              data-content-format="cta_group"
              data-position="hero"
            >
              <a
                href="#pakete"
                data-track-event="cta_click"
                data-cta-id="pricing_hero_packages"
                data-cta-type="anchor_navigation"
                data-section-id="pricing_hero_actions"
                data-content-topic="hochzeitsfotografie_preise"
                data-user-intent="pakete_ansehen"
                data-journey-stage="decision"
                data-position="hero_primary"
              >{t('heroPackagesLabel')}</a>
              <a
                href={content.links.contactHref}
                data-track-event="contact_click"
                data-cta-id="pricing_hero_contact"
                data-cta-type="contact_form"
                data-section-id="pricing_hero_actions"
                data-content-topic="hochzeitsfotografie_preise"
                data-user-intent="termin_anfragen"
                data-journey-stage="conversion"
                data-position="hero_secondary"
              >{t('heroContactLabel')}</a>
            </div>
          </div>
          <figure class="pricing-hero__image">
            <Image
              src={heroMedia}
              width={heroSize.width}
              height={heroSize.height}
              widths={[520, 760, 1040, 1384]}
              sizes="(max-width: 620px) calc(100vw - 56px), (max-width: 1099px) 400px, 460px"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              alt={content.images.hero.alt}
            />
          </figure>
        </header>

        <nav
          class="pricing-toc"
          aria-label="Inhaltsübersicht Hochzeitsfotograf Preise"
          data-track-section="pricing_table_of_contents"
          data-content-topic="hochzeitsfotografie_preise"
          data-user-intent="preisdetails_navigieren"
          data-journey-stage="consideration"
          data-content-format="table_of_contents"
          data-position="after_hero"
        >
          <a href="#pakete" data-track-event="cta_click" data-cta-id="pricing_toc_packages" data-cta-type="anchor_navigation">Pakete</a>
          <a href="#preisbeispiele" data-track-event="cta_click" data-cta-id="pricing_toc_examples" data-cta-type="anchor_navigation">Preisrechner & Beispiele</a>
          <a href="#dankeschoen">{content.discount.percent} % Dankeschön</a>
          <a href="#enthalten" data-track-event="cta_click" data-cta-id="pricing_toc_included" data-cta-type="anchor_navigation">Enthaltene Leistungen</a>
          <a href="#druckvorbereitung" data-track-event="cta_click" data-cta-id="pricing_toc_print" data-cta-type="anchor_navigation">Druckvorbereitung</a>
          <a href="#faq" data-track-event="cta_click" data-cta-id="pricing_toc_faq" data-cta-type="anchor_navigation">FAQ</a>
          <a href="#anfrage" data-track-event="contact_click" data-cta-id="pricing_toc_contact" data-cta-type="anchor_navigation">Anfrage</a>
        </nav>

        <section class="pricing-intro" aria-labelledby="pricing-intro-title">
          <div>
            <p class="pricing-kicker">{t('introKicker')}</p>
            <h2 id="pricing-intro-title">{t('introHeading')}</h2>
          </div>
          <div class="pricing-copy">
            <p>{t('introBodyFirst')}</p>
            <p>{t('introBodySecond')}</p>
            <a class="pricing-text-link" href={content.links.aboutHref}>{t('aboutLabel')}</a>
          </div>
        </section>

        <section class="pricing-packages" id="pakete" aria-labelledby="packages-title">
          <div class="pricing-section-heading">
            <p class="pricing-kicker">Pakete</p>
            <h2 id="packages-title">{t('packagesHeading')}</h2>
            <p>{weddingBookingHoursRule}</p>
          </div>
          <div class="pricing-package-grid">
            {packages.map((item, index) => (
              <article
                class={`pricing-package is-${item.imageOrientation}`}
                id={`paket-${item.id}`}
                aria-labelledby={`paket-${item.id}-name paket-${item.id}-title`}
                aria-describedby={item.showIntro === false ? undefined : `paket-${item.id}-intro`}
                data-schema-id={`${pageUrl}#angebot-${item.id}`}
                data-pricing-package={PACKAGE_NAMES[item.id]}
                data-pricing-hours={item.minimumHours === item.maximumHours ? item.minimumHours : undefined}
              >
                <figure aria-label={`${item.name} Beispielbild`}>
                  <Image
                    src={item.image}
                    width={item.image.width || item.imageWidth}
                    height={item.image.height || item.imageHeight}
                    widths={[323, 420, 640, 840, 1040]}
                    sizes="(max-width: 620px) calc(100vw - 56px), (min-width: 1441px) min(calc(15vw + 107px), 503px), 323px"
                    format="webp"
                    quality={88}
                    loading="lazy"
                    alt={item.alt}
                  />
                </figure>
                <div class="pricing-package__body">
                  <p class="pricing-package__index"><span aria-hidden="true">0{index + 1} / </span>{item.duration}</p>
                  <h3 id={`paket-${item.id}-name`}>{item.name}</h3>
                  <p class="pricing-package__price" id={`paket-${item.id}-title`}>{item.priceLabel}</p>
                  {item.showIntro !== false && <p id={`paket-${item.id}-intro`}>{item.intro}</p>}
                  <ul aria-label={`Enthaltene Leistungen: ${item.name}`}>
                    {item.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                  <a class="pricing-package__contact" href={content.links.contactHref} aria-label={`${item.name} unverbindlich anfragen`}>{t('packageContactLabel')} <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
          <aside class="pricing-delivery" aria-labelledby="delivery-title">
            <div>
              <p class="pricing-kicker">{t('deliveryKicker')}</p>
              <h3 id="delivery-title">{t('deliveryHeading')}</h3>
            </div>
            <div class="pricing-copy">
              <p>{t('deliveryTiming')}</p>
              <p>{t('deliveryException')}</p>
              <p>{t('deliveryRetouch')}</p>
            </div>
          </aside>
        </section>

        <div class="pricing-price-context" id="preisgestaltung">
          <section aria-labelledby="price-quality-title">
            <h2 id="price-quality-title">{t('qualityHeading')}</h2>
            <p>{t('qualityBody')}</p>
          </section>
          <section aria-labelledby="price-hourly-title">
            <h2 id="price-hourly-title">{t('hourlyHeading')}</h2>
            <p>{t('hourlyBody')}</p>
          </section>
          <section aria-labelledby="price-composition-title">
            <h2 id="price-composition-title">{t('compositionHeading')}</h2>
            <p>{t('compositionBody')}</p>
            <p>{t('compositionBodySecond')}</p>
          </section>
        </div>

        <EditorialReviewQuote
          reviews={[
            googleReviews.manuelR,
            googleReviews.laraFriedrichs,
            googleReviews.freddyNa,
          ]}
          sectionId="preise_review_manuel_r"
          heading={t('reviewsHeading')}
          contentTopic="hochzeitspakete"
          userIntent="leistung_einschaetzen"
          journeyStage="vergleich"
          position="after_pricing_packages"
        />

        <section class="pricing-examples" id="preisbeispiele" aria-labelledby="examples-title">
          <div class="pricing-section-heading">
            <p class="pricing-kicker">{t('examplesKicker')}</p>
            <h2 id="examples-title">{t('examplesHeading')}</h2>
            <p>{t('examplesIntro')}</p>
          </div>
          <div class="pricing-calculator" data-pricing-calculator hidden>
            <div class="pricing-calculator__input">
              <p class="pricing-kicker">Preisrechner</p>
              <h3>{t('calculatorHeading')}</h3>
              <label for="pricing-duration">{t('calculatorLabel')}</label>
              <select id="pricing-duration" aria-describedby="pricing-calculator-hint">
                {calculatorOptions.map((option) => (
                  <option
                    value={option.hours}
                    selected={option.hours === 6}
                    data-total={option.total}
                    data-package-name={option.package.name}
                    data-package-id={option.package.id}
                    data-calculation={option.calculation}
                  >{option.hours === 1 ? "1 Stunde" : `${option.hours} Stunden`}</option>
                ))}
              </select>
              <p id="pricing-calculator-hint">{t('calculatorHint')}</p>
            </div>
            <div class="pricing-calculator__result">
              <output for="pricing-duration" aria-live="polite" aria-atomic="true">
                <span class="pricing-calculator__label">{t('calculatorResultLabel')}</span>
                <strong data-calculator-total>{formatPrice(initialCalculation.total)}</strong>
                <span data-calculator-package>{initialCalculation.package.name}</span>
                <span data-calculator-calculation>{initialCalculation.calculation}</span>
              </output>
              <p>{t('calculatorIncluded')}</p>
              <a data-calculator-package-link href={`#paket-${initialCalculation.package.id}`}>{t('calculatorPackageLink')}</a>
            </div>
            <p class="pricing-calculator__note">{t('calculatorNote')}</p>
          </div>
          <div class="pricing-example-grid">
            {pricingExamples.map((example) => (
              <article class="pricing-example" aria-labelledby={`beispiel-${example.id}-title`}>
                <p class="pricing-kicker">{example.hours} Stunden Begleitung</p>
                <h3 id={`beispiel-${example.id}-title`}>{example.title}</h3>
                <p class="pricing-example__price">{formatPrice(example.total)} <span>Gesamtpreis</span></p>
                <p class="pricing-example__calculation">{example.calculation}</p>
                <p>Möglicher Ablauf:</p>
                <ul>
                  {example.steps.map((step) => <li>{step}</li>)}
                </ul>
                <div class="pricing-example__links">
                  <a href={`#paket-${example.package.id}`}>Enthaltene Paketleistungen ansehen</a>
                  <a href={example.galleryHref}>{example.galleryLabel}</a>
                </div>
              </article>
            ))}
          </div>
          <p class="pricing-examples__note">{t('examplesNote')}</p>
        </section>



        <ThankYouDiscount content={content} />

        <section class="pricing-split" id="enthalten" aria-labelledby="included-title">
          <div>
            <p class="pricing-kicker">{t('includedKicker')}</p>
            <h2 id="included-title">{t('includedHeading')}</h2>
          </div>
          <div class="pricing-copy">
            <p>{t('includedBodyFirst')}</p>
            <p>{t('includedBodySecond')}</p>
          </div>
        </section>

        <section class="pricing-split" id="druckvorbereitung" aria-labelledby="print-title">
          <div>
            <p class="pricing-kicker">{t('printKicker')}</p>
            <h2 id="print-title">{t('printHeading')}</h2>
          </div>
          <div class="pricing-copy">
            <p>{t('printBodyFirst')}</p>
            <p>{t('printBodySecond')}</p>
            <p>
              <a href={content.links.printHref} data-track-event="cta_click" data-cta-id="pricing_color_proofing_article" data-cta-type="internal_article_link">{t('printLinkLabel')}</a>
            </p>
          </div>
        </section>

        <section
          class="pricing-faq"
          id="faq"
          aria-labelledby="faq-title"
          data-track-section="preise_faq"
          data-content-topic="preise_pakete"
          data-user-intent="preisfragen_klaeren"
          data-journey-stage="vergleich"
          data-content-format="faq"
          data-position="pricing_faq"
        >
          <figure class="pricing-faq__media">
            <Image
              src={faqMedia}
              width={typeof faqMedia==='string'?content.images.faq.width:faqMedia.width}
              height={typeof faqMedia==='string'?content.images.faq.height:faqMedia.height}
              alt={content.images.faq.alt}
              widths={[264, 323]}
              sizes="(max-width: 379px) calc(100vw - 56px), 323px"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={90}
            />
            <figcaption>{t('faqCaption')}</figcaption>
          </figure>

          <div class="pricing-faq__content">
            <p class="pricing-kicker">{t('faqKicker')}</p>
            <h2 id="faq-title">{t('faqHeading')}</h2>
            <p>{t('faqIntro')}</p>

            <div class="pricing-faq__list" aria-label={t('faqHeading')}>
              {faqItems.map((item, index) => (
                <details
                  class="pricing-faq__item"
                  data-track-event="faq_open"
                  data-faq-id={item.id}
                  data-section-id="preise_faq"
                  data-content-topic="preise_pakete"
                  data-user-intent="preisfragen_klaeren"
                  data-journey-stage="vergleich"
                >
                  <summary class="pricing-faq__summary">
                    <span class="pricing-faq__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <span>{item.question}</span>
                    <span class="pricing-faq__toggle" aria-hidden="true"></span>
                  </summary>
                  <div class="pricing-faq__panel">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>

        <section
          class="pricing-related"
          aria-labelledby="related-title"
          data-track-section="preise_related_links"
          data-content-topic="hochzeitsplanung"
          data-user-intent="weiter_planen"
          data-journey-stage="vergleich"
          data-content-format="related_links"
          data-position="after_faq"
        >
          <p class="pricing-kicker">{t('relatedKicker')}</p>
          <h2 id="related-title">{t('relatedHeading')}</h2>
          <div>
            {relatedLinks.map((item, index) => (
              <a
                href={item.href}
                data-track-event="cta_click"
                data-cta-id={`preise_related_${index + 1}`}
                data-cta-type="internal_resource"
                data-section-id="preise_related_links"
                data-content-topic="hochzeitsplanung"
                data-user-intent="weiter_planen"
                data-journey-stage="vergleich"
              >{item.label}</a>
            ))}
          </div>
        </section>

        <section
          class="pricing-cta"
          id="anfrage"
          aria-labelledby="cta-title"
          data-track-section="preise_anfrage_cta"
          data-content-topic="terminverfuegbarkeit"
          data-user-intent="termin_anfragen"
          data-journey-stage="anfrage"
          data-content-format="cta_section"
