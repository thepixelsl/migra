<script>
  document.querySelectorAll<HTMLElement>("[data-pricing-calculator]").forEach((calculator) => {
    const duration = calculator.querySelector<HTMLSelectElement>("select");
    const total = calculator.querySelector<HTMLElement>("[data-calculator-total]");
    const packageName = calculator.querySelector<HTMLElement>("[data-calculator-package]");
    const calculation = calculator.querySelector<HTMLElement>("[data-calculator-calculation]");
    const packageLink = calculator.querySelector<HTMLAnchorElement>("[data-calculator-package-link]");
    if (!duration || !total || !packageName || !calculation || !packageLink) return;
    const formatAmount = (amount:number) => new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR", minimumFractionDigits:Number.isInteger(amount)?0:2, maximumFractionDigits:2 }).format(amount);
    const update = () => {
      const option = duration.selectedOptions[0];
      const amount = Number(option.dataset.total);
      if (!Number.isFinite(amount) || !option.dataset.packageId) return;
      total.textContent = formatAmount(amount);
      packageName.textContent = option.dataset.packageName ?? "";
      calculation.textContent = option.dataset.calculation ?? "";
      packageLink.href = `#paket-${option.dataset.packageId}`;
    };
    duration.addEventListener("change", update);
    update();
    calculator.hidden = false;
  });
</script>

