---
import FaviconHead from "../../components/FaviconHead.astro";
import { Image } from "astro:assets";
import "../../styles/global.css";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialReviewQuote from "../../components/EditorialReviewQuote.astro";
import { googleReviews } from "../../data/reviews";
import { weddingBookingHoursRule, weddingGalleryMonths, weddingPackages } from "../../data/weddingPackages";
import { packagePriceSchema } from "../../data/packagePriceSchema.mjs";
import heroImage from "../../assets/hochzeitsfotograf-preise/ART9896-1-1.jpg";
import pureMomentsImage from "../../assets/hochzeitsfotograf-niedersachsen/Hochzeit_Lauenbrueck_7587.jpg";
import standesamtImage from "../../assets/hochzeitsfotograf-preise/ART_0074-Bearbeitet_print.jpg";
import reportageImage from "../../assets/hochzeitsfotograf-preise/ART_3680-Bearbeitet-Wiederhergestellt_web.jpg";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/hochzeitsfotograf-preise/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "Hochzeitsfotograf Hamburg Preise";
const description =
  "Preise und Pakete für Hochzeitsfotografie in Hamburg mit dem jeweils aufgeführten Leistungsumfang und Hinweisen zum individuellen Angebot.";
const primaryImage = new URL(heroImage.src, siteUrl).href;
const [pureMoments, standesamtPackage, reportagePackage] = weddingPackages;
const formatPrice = (value: number) =>
  new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(value);
const calculatorOptions = Array.from({ length: 10 }, (_, index) => {
  const hours = index + 1;
  const item = weddingPackages
    .filter((item) => hours >= item.minimumHours && hours <= item.maximumHours)
    .sort((a, b) => (a.billingUnit === "hour" ? hours * a.priceValue : a.priceValue)
      - (b.billingUnit === "hour" ? hours * b.priceValue : b.priceValue))[0];
  return {
    hours,
    package: item,
    total: item.billingUnit === "hour" ? hours * item.priceValue : item.priceValue,
    calculation: item.billingUnit === "hour"
      ? `${hours} Stunden × ${formatPrice(item.priceValue)}`
      : `Festpreis für ${hours === 1 ? "1 Stunde" : `${hours} Stunden`}`,
  };
});

const pricingExamples = [
  {
    id: "standesamt",
    title: "Standesamt und Paarbilder",
    hours: standesamtPackage.minimumHours,
    package: standesamtPackage,
    total: standesamtPackage.priceValue,
    calculation: "Festpreis für das Standesamt Paket",
    steps: [
      "Ankommen, Trauung und Gratulationen",
      "Gemeinsame Bilder mit Familie und Gästen",
      "Paarshooting in der Nähe des Trauorts",
    ],
    galleryHref: "/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/",
    galleryLabel: "Hochzeitsreportage aus Altona ansehen",
  },
  {
    id: "reportage",
    title: "Vom Getting Ready bis zum Empfang",
    hours: 6,
    package: reportagePackage,
    total: 6 * reportagePackage.priceValue,
    calculation: `6 Stunden × ${formatPrice(reportagePackage.priceValue)}`,
    steps: [
      "Vorbereitungen und erste Portraits",
      "Trauung, Gratulationen und Empfang",
      "Paarshooting und Gruppenbilder",
    ],
    galleryHref: "/gallery/traumhochzeit-in-hamburg/",
    galleryLabel: "Hochzeitsreportage im Hotel Atlantic ansehen",
  },
];

const packageMedia = {
  "pure-moments": {
    image: pureMomentsImage,
    alt: "Brautpaar in Lauenbrück als Beispiel für das Pure Moments Paket",
    imageOrientation: "portrait",
  },
  "standesamt-paket": {
    image: standesamtImage,
    alt: "Brautportrait als Beispiel für das Standesamt Paket in Hamburg",
    imageOrientation: "portrait",
  },
  "rundum-sorglos-paket": {
    image: reportageImage,
    alt: "Braut mit Blumenstrauß vor dem Eiffelturm in Paris",
    imageOrientation: "portrait",
  },
} as const;

const packages = weddingPackages.map((item) => ({
  ...item,
  ...packageMedia[item.id],
}));

const packageOffers = packages.map((item) => ({
  "@type": "Offer",
  "@id": `${pageUrl}#angebot-${item.id}`,
  name: item.name,
  description: item.intro,
  url: `${pageUrl}#paket-${item.id}`,
  ...packagePriceSchema(item),
  category: "Hochzeitsfotografie",
  image: new URL(item.image.src, siteUrl).href,
  itemOffered: {
    "@type": "Service",
    "@id": `${pageUrl}#leistung-${item.id}`,
    name: item.name,
    serviceType: item.serviceType,
    description: `${item.intro} Dauer: ${item.duration}. ${weddingBookingHoursRule} Enthalten sind: ${item.features.join(", ")}.`,
    provider: {
      "@id": `${siteUrl}/#organization`,
    },
    areaServed: [
      { "@type": "City", name: "Hamburg" },
      { "@type": "AdministrativeArea", name: "Norddeutschland" },
    ],
  },
}));

const faqItems = [
  {
    id: "preise_faq_12",
    question: "Was kostet ein Hochzeitsfotograf in Hamburg bei Artbild?",
    answer: `Pure Moments umfasst 1 Stunde Begleitung für ${formatPrice(pureMoments.priceValue)}. Das Standesamt Paket kostet ${formatPrice(standesamtPackage.priceValue)} für 2 Stunden. Längere Reportagen von ${reportagePackage.minimumHours} bis ${reportagePackage.maximumHours} Stunden berechne ich mit ${formatPrice(reportagePackage.priceValue)} pro Stunde. Sechs Stunden kosten damit ${formatPrice(6 * reportagePackage.priceValue)}, acht Stunden ${formatPrice(8 * reportagePackage.priceValue)}. Die enthaltenen Leistungen findet ihr direkt beim jeweiligen Paket.`,
  },
  {
    id: "preise_faq_17",
    question: "Wie viele Stunden passen zu unserer Hochzeit?",
    answer: "Für eine kurze Begleitung kommt Pure Moments mit einer Stunde infrage. Zwei Stunden geben euch mehr Zeit für die Trauung, Gratulationen und Paarbilder. Wenn ihr auch Vorbereitungen, Empfang oder Feier festhalten möchtet, planen wir eine längere Reportage. Entscheidend sind eure gewünschten Momente und die Wege zwischen den Orten. Das besprechen wir vor der Buchung gemeinsam.",
  },
  {
    id: "preise_faq_19",
    question: "Wie wird der Preis berechnet, wenn wir an zwei Tagen heiraten?",
    answer: `Es zählen eure gesamten Begleitungsstunden, unabhängig von der Anzahl der Tage. Für diese Stundenzahl wird automatisch das günstigste passende Paket gewählt. Zum Beispiel ergeben eine Stunde Standesamt und sechs Stunden freie Trauung zusammen sieben Stunden: ${formatPrice(7 * reportagePackage.priceValue)} im Rundum-Sorglos-Paket. Pakete sind nicht miteinander kombinierbar. Reisekosten außerhalb Hamburgs stimmen wir vorab ab.`,
  },
  {
    id: "preise_faq_18",
    question: "Ist ein Kennenlernshooting enthalten?",
    answer: "Im Standesamt Paket und im Rundum-Sorglos-Paket ist ein Kennenlernshooting enthalten. Dabei erlebt ihr, wie ich arbeite, und könnt euch vor der Hochzeit mit dem Fotografiertwerden vertraut machen. Pure Moments enthält ein persönliches Vorgespräch, aber kein Kennenlernshooting.",
  },
  {
    id: "preise_faq_4",
    question: "Ist die Bearbeitung unserer Bilder im Preis enthalten?",
    answer: "Ja. Die Bildbearbeitung ist im Paketpreis enthalten: Ich stimme Farben, Helligkeit und Kontraste aufeinander ab und korrigiere kleine störende Details. Retusche einzelner ausgewählter Bilder besprechen wir gemeinsam. Für die im Paket enthaltene Bearbeitung entstehen euch keine zusätzlichen Kosten.",
  },
  {
    id: "preise_faq_16",
    question: "Wie bekommen wir unsere Bilder und wie lange bleibt die Galerie verfügbar?",
    answer: `Ihr erhaltet eure Bilder in einer passwortgeschützten Onlinegalerie bei PicDrop. Die Galerie ist bei allen Paketen ${weddingGalleryMonths} Monate kostenlos verfügbar. Ladet eure Bilder innerhalb dieser Zeit herunter und sichert sie für euch.`,
  },
  {
    id: "preise_faq_1",
    question: "Welche Fahrtkosten kommen hinzu?",
    answer: "Innerhalb Hamburgs ist die Anfahrt bei allen Paketen enthalten. Außerhalb Hamburgs berechne ich die tatsächlich anfallenden Reisekosten, keine pauschale Fahrtgebühr. Die Fahrzeit stelle ich nicht als Arbeitszeit in Rechnung. Die Reisekosten stimmen wir vor der Buchung ab.",
  },
  {
    id: "preise_faq_15",
    question: "Können wir die Begleitung spontan verlängern?",
    answer: "Sprecht mich gerne darauf an. Wenn es keine Folgebuchung gibt, können wir die Begleitung verlängern. Den zusätzlichen Zeitraum und den Preis vereinbaren wir miteinander. Für wichtige Programmpunkte planen wir am besten schon im Vorgespräch genügend Zeit ein.",
  },
  {
    id: "preise_faq_7",
    question: "Was passiert, wenn du krank wirst?",
    answer: "Ich bin gut vernetzt und werde einen zuverlässigen Ersatzfotografen für eure Hochzeit finden.",
  },
  {
    id: "preise_faq_9",
    question: "Was passiert, wenn unsere Hochzeit nicht stattfinden kann?",
    answer: "Wenn eure Hochzeit nicht stattfindet, müsst ihr nicht das volle Honorar bezahlen. Bereits entstandene Kosten, etwa für gebuchte Flüge, nicht stornierbare Übernachtungen oder Anzahlungen, müssen übernommen werden.",
  },
  {
    id: "preise_faq_13",
    question: "Welche Zahlungsarten sind möglich?",
    answer: "Ihr könnt per Überweisung, bar oder mit PayPal Plus bezahlen. Über PayPal Plus ist auch Ratenzahlung möglich.",
  },
  {
    id: "preise_faq_8",
    question: "Kannst du uns auch einen Videografen empfehlen?",
    answer: "Ja, ich arbeite mit zuverlässigen Videografen zusammen und empfehle euch gerne einen passenden Kontakt. Eine Videobegleitung ist in den Fotopaketen nicht enthalten.",
  },
];

const relatedLinks = [
  {
    href: "/das-perfekte-getting-ready-fuer-deine-hochzeit-in-hamburg/",
    label: "Getting Ready in Hamburg planen",
  },
  {
    href: "/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/",
    label: "Standesamtliche Trauung in Altona ansehen",
  },
  {
    href: "/gallery/traumhochzeit-in-hamburg/",
    label: "Hochzeit im Hotel Atlantic ansehen",
  },
  {
    href: "/portfolio/",
    label: "Portfolio ansehen",
  },
];


const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Preise & Leistungen", href: pagePath },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      mainEntity: {
        "@id": `${pageUrl}#service`,
      },
      datePublished: "2019-08-14T09:37:40+02:00",
      dateModified: "2026-09-12T00:00:00+02:00",
      inLanguage: "de",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: heroImage.width,
        height: heroImage.height,
        caption: "Hochzeitsfotograf Hamburg Preise",
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Hochzeitsfotografie Hamburg Preise",
      description,
      serviceType: "Hochzeitsfotografie",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        "@id": `${pageUrl}#pakete`,
        name: "Pakete für Hochzeitsfotografie in Hamburg",
        itemListElement: packageOffers,
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      legalName: "Artbild-Fotografie",
      url: siteUrl,
      email: "info@artbild-fotografie.de",
      image: `${siteUrl}/images/logo-artbild-black.png`,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "AdministrativeArea", name: "Norddeutschland" },
        { "@type": "Place", name: "Mallorca" },
        { "@type": "Country", name: "Deutschland" },
      ],
      serviceType: ["Hochzeitsfotografie", "Hochzeitsreportage", "Standesamtliche Trauung"],
    },

  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={heroImage.width}>
    <meta property="og:image:height" content={heroImage.height}>
    <meta property="og:image:alt" content="Hochzeitsfotograf Hamburg Preise">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={primaryImage}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template pricing-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="pricing">
        <header class="pricing-hero">
          <div class="pricing-hero__copy">
            <p class="pricing-kicker">Hochzeitsfotograf Hamburg · Preise & Pakete</p>
            <h1>Hochzeitsfotograf <span>Hamburg Preise</span></h1>
            <p>
              Ob standesamtliche Trauung oder längere Hochzeitsreportage: Gemeinsam
              planen wir, welche Momente ich für euch festhalte. Hier seht ihr die
              Preise, die enthaltenen Leistungen und Beispiele für euren Tag.
            </p>
            <p class="pricing-hero__prices">
              1 Stunde: {formatPrice(pureMoments.priceValue)} · 2 Stunden: {formatPrice(standesamtPackage.priceValue)}<br />
              3–10 Stunden: {formatPrice(reportagePackage.priceValue)} pro Stunde
            </p>
            <div
              class="pricing-hero__actions"
              aria-label="Preis-Seite Aktionen"
              data-track-section="pricing_hero_actions"
              data-content-topic="hochzeitsfotografie_preise"
              data-user-intent="angebot_pruefen"
              data-journey-stage="decision"
              data-content-format="cta_group"
              data-position="hero"
            >
              <a
                href="#pakete"
                data-track-event="cta_click"
                data-cta-id="pricing_hero_packages"
                data-cta-type="anchor_navigation"
                data-section-id="pricing_hero_actions"
                data-content-topic="hochzeitsfotografie_preise"
                data-user-intent="pakete_ansehen"
                data-journey-stage="decision"
                data-position="hero_primary"
              >Pakete ansehen</a>
              <a
                href="/kontakt/"
                data-track-event="contact_click"
                data-cta-id="pricing_hero_contact"
                data-cta-type="contact_form"
                data-section-id="pricing_hero_actions"
                data-content-topic="hochzeitsfotografie_preise"
                data-user-intent="termin_anfragen"
                data-journey-stage="conversion"
                data-position="hero_secondary"
              >Termin anfragen</a>
            </div>
          </div>
          <figure class="pricing-hero__image">
            <Image
              src={heroImage}
              widths={[520, 760, 1040, 1384]}
              sizes="(max-width: 620px) calc(100vw - 56px), (max-width: 1099px) 400px, 460px"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              alt="Brautpaar im Gegenlicht bei einer Hochzeitsreportage"
            />
          </figure>
        </header>

        <nav
          class="pricing-toc"
          aria-label="Inhaltsübersicht Hochzeitsfotograf Preise"
          data-track-section="pricing_table_of_contents"
          data-content-topic="hochzeitsfotografie_preise"
          data-user-intent="preisdetails_navigieren"
          data-journey-stage="consideration"
          data-content-format="table_of_contents"
          data-position="after_hero"
        >
          <a href="#pakete" data-track-event="cta_click" data-cta-id="pricing_toc_packages" data-cta-type="anchor_navigation">Pakete</a>
          <a href="#preisbeispiele" data-track-event="cta_click" data-cta-id="pricing_toc_examples" data-cta-type="anchor_navigation">Preisrechner & Beispiele</a>
          <a href="#enthalten" data-track-event="cta_click" data-cta-id="pricing_toc_included" data-cta-type="anchor_navigation">Enthaltene Leistungen</a>
          <a href="#faq" data-track-event="cta_click" data-cta-id="pricing_toc_faq" data-cta-type="anchor_navigation">FAQ</a>
          <a href="#anfrage" data-track-event="contact_click" data-cta-id="pricing_toc_contact" data-cta-type="anchor_navigation">Anfrage</a>
        </nav>

        <section class="pricing-intro" aria-labelledby="pricing-intro-title">
          <div>
            <p class="pricing-kicker">Persönlich begleitet</p>
            <h2 id="pricing-intro-title">Ihr wisst vorab, was euch erwartet.</h2>
          </div>
          <div class="pricing-copy">
            <p>
              Ich bin York. Im persönlichen Vorgespräch erzählt ihr mir von eurer
              Hochzeit und davon, welche Bilder euch wichtig sind. Daraus ergibt
              sich die passende Begleitung mit einem vereinbarten Gesamtpreis.
            </p>
            <p>
              Die Bildbearbeitung, die Anfahrt innerhalb Hamburgs und eure
              passwortgeschützte Onlinegalerie für {weddingGalleryMonths} Monate
              sind in jedem Paket enthalten. Die Galerie ist in dieser Zeit
              kostenlos verfügbar. Bei Hochzeiten außerhalb Hamburgs stimmen wir
              die Reisekosten vor der Buchung ab.
            </p>
            <a class="pricing-text-link" href="/about/">Mehr über mich und meine Arbeitsweise</a>
          </div>
        </section>

        <section class="pricing-packages" id="pakete" aria-labelledby="packages-title">
          <div class="pricing-section-heading">
            <p class="pricing-kicker">Pakete</p>
            <h2 id="packages-title">Pakete und Leistungen im Überblick</h2>
            <p>{weddingBookingHoursRule}</p>
          </div>
          <div class="pricing-package-grid">
            {packages.map((item) => (
              <article
                class={`pricing-package is-${item.imageOrientation}`}
                id={`paket-${item.id}`}
                aria-labelledby={`paket-${item.id}-name paket-${item.id}-title`}
                aria-describedby={item.showIntro === false ? undefined : `paket-${item.id}-intro`}
                data-schema-id={`${pageUrl}#angebot-${item.id}`}
              >
                <figure aria-label={`${item.name} Beispielbild`}>
                  <Image
                    src={item.image}
                    widths={[360, 520, 760]}
                    sizes="(max-width: 620px) calc(100vw - 64px), (max-width: 1099px) 34vw, 340px"
                    format="webp"
                    quality={88}
                    loading="lazy"
                    alt={item.alt}
                  />
                </figure>
                <div class="pricing-package__body">
                  <h3 id={`paket-${item.id}-name`}>{item.name}</h3>
                  <p class="pricing-package__price" id={`paket-${item.id}-title`}>{item.priceLabel}</p>
                  {item.showIntro !== false && <p id={`paket-${item.id}-intro`}>{item.intro}</p>}
                  <ul aria-label={`Enthaltene Leistungen: ${item.name}`}>
                    {item.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                  <a class="pricing-package__contact" href="/kontakt/" aria-label={`${item.name} unverbindlich anfragen`}>Unverbindlich anfragen <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <EditorialReviewQuote
          reviews={[
            googleReviews.manuelR,
            googleReviews.laraFriedrichs,
            googleReviews.freddyNa,
          ]}
          sectionId="preise_review_manuel_r"
          heading="Wie Paare die Begleitung erlebt haben"
          contentTopic="hochzeitspakete"
          userIntent="leistung_einschaetzen"
          journeyStage="vergleich"
          position="after_pricing_packages"
        />

        <section class="pricing-examples" id="preisbeispiele" aria-labelledby="examples-title">
          <div class="pricing-section-heading">
            <p class="pricing-kicker">Euer Ablauf, euer Gesamtpreis</p>
            <h2 id="examples-title">Was kostet eure fotografische Begleitung?</h2>
            <p>
              Diese Beispiele helfen euch bei der Planung einer Hochzeit in Hamburg.
              Wie viel Zeit ihr für einzelne Momente und Wege braucht, stimmen wir
              gemeinsam ab. Die verlinkten Reportagen zeigen meine Arbeit; die
              Beispielpreise beziehen sich auf die hier beschriebenen Abläufe.
            </p>
          </div>
          <div class="pricing-calculator" data-pricing-calculator hidden>
            <div class="pricing-calculator__input">
              <p class="pricing-kicker">Preisrechner</p>
              <h3>Wie lange darf ich euch begleiten?</h3>
              <label for="pricing-duration">Gesamte Begleitungsstunden</label>
              <select id="pricing-duration" aria-describedby="pricing-calculator-hint">
                {calculatorOptions.map((option) => (
                  <option
                    value={option.hours}
                    selected={option.hours === 6}
                    data-total={option.total}
                    data-package-name={option.package.name}
                    data-package-id={option.package.id}
                    data-calculation={option.calculation}
                  >{option.hours === 1 ? "1 Stunde" : `${option.hours} Stunden`}</option>
                ))}
              </select>
              <p id="pricing-calculator-hint">Zählt alle gewünschten Begleitungsstunden zusammen, auch an unterschiedlichen Tagen. Der Rechner wählt automatisch das günstigste passende Paket.</p>
            </div>
            <div class="pricing-calculator__result">
              <output for="pricing-duration" aria-live="polite" aria-atomic="true">
                <span class="pricing-calculator__label">Gesamtpreis in Hamburg</span>
                <strong data-calculator-total>{formatPrice(6 * reportagePackage.priceValue)}</strong>
                <span data-calculator-package>{reportagePackage.name}</span>
                <span data-calculator-calculation>{`6 Stunden × ${formatPrice(reportagePackage.priceValue)}`}</span>
