---
import FaviconHead from "../../components/FaviconHead.astro";
import "../../styles/global.css";
import MobileNavigation from "../../components/MobileNavigation.astro";
import DesktopNavigation from "../../components/DesktopNavigation.astro";
import StoryLanguageCta from "../../components/StoryLanguageCta.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PortfolioGrid from "../../components/PortfolioGrid.astro";
import EditorialReviewQuote from "../../components/EditorialReviewQuote.astro";
import { googleReviews } from "../../data/reviews";
import { portfolioEntries, portfolioFilters } from "../../data/portfolio";

const portfolioPageEntries = [...portfolioEntries];
const editorialIndex = portfolioPageEntries.findIndex(
  (entry) => entry.href === "/gallery/editorial/",
);
const parisEditorialIndex = portfolioPageEntries.findIndex(
  (entry) => entry.href === "/gallery/brautkleid-editorial-paris/",
);

if (editorialIndex >= 0 && parisEditorialIndex >= 0) {
  [portfolioPageEntries[editorialIndex], portfolioPageEntries[parisEditorialIndex]] = [
    portfolioPageEntries[parisEditorialIndex],
    portfolioPageEntries[editorialIndex],
  ];
}

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pageUrl = `${siteUrl}/portfolio/`;
const title = "Portfolio";
const metaTitle = "Portfolio - Hochzeitsfotografie Hamburg | Artbild-Fotografie";
const description = "Portfolio von Artbild-Fotografie: Hochzeitsbilder, Paarshootings, Travel- und Peoplefotografie aus Hamburg und darüber hinaus.";
const primaryImage = `${siteUrl}/images/getting-ready-gallery-2.jpg`;

const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Hochzeitsportfolio", href: "/portfolio/" },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#collection`,
  "url": pageUrl,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": "Artbild-Fotografie",
    "url": siteUrl,
  },
  "about": [
    "Hochzeitsfotografie Hamburg",
    "Portfolio",
    "Peoplefotografie",
    "Travel Fotografie",
  ],
  "mainEntity": {
    "@type": "ItemList",
    "name": "Portfolio Galerien",
    "numberOfItems": portfolioPageEntries.length,
    "itemListElement": portfolioPageEntries.map((entry, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": entry.href.startsWith("http") ? entry.href : `${siteUrl}${entry.href}`,
      "name": entry.title,
      "description": `${entry.category} Portfolio vom ${entry.date}`,
      "image": `${siteUrl}${entry.image.src}`,
    })),
  },
};
---
<!doctype html>
<html lang="de">
<head>
  <FaviconHead />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{metaTitle}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
  <link rel="canonical" href={pageUrl}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:type" content="website">
  <meta property="og:title" content={metaTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="Artbild-Fotografie">
  <meta property="og:image" content={primaryImage}>
  <meta property="og:image:alt" content="Portfolio Artbild-Fotografie Hochzeitsfotografie Hamburg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={metaTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={primaryImage}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
</head>
<body class="gallery-template portfolio-template">
  <header class="gallery-header">
    <MobileNavigation />
    <DesktopNavigation />
  </header>

  <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />

    <section class="portfolio-hero" aria-labelledby="portfolio-title">
      <p class="portfolio-kicker">Galleries</p>
      <h1 id="portfolio-title">Portfolio</h1>
      <p>
        Egal ob Landschaftsbilder oder Peoplefotografie - ich liebe es zu fotografieren.<br>
        Schaut Euch um, schreibt mich an und stellt Fragen.
      </p>
    </section>

    <PortfolioGrid entries={portfolioPageEntries} filters={portfolioFilters} />

    <EditorialReviewQuote
      reviews={[
        googleReviews.patrickDeku,
        googleReviews.laraFriedrichs,
        googleReviews.markusNerger,
      ]}
      sectionId="portfolio_review_patrick_deku"
      heading="Bilder, die den ganzen Tag wieder lebendig machen"
      contentTopic="hochzeitsportfolio"
      userIntent="bildsprache_bewerten"
      journeyStage="auswahl"
      position="after_portfolio_grid"
    />

    <section
      class="portfolio-funnel"
      aria-label="Nächste Schritte"
      data-track-section="portfolio_next_steps"
      data-content-topic="portfolio_navigation"
      data-user-intent="naechsten_schritt_waehlen"
      data-journey-stage="decision"
      data-content-format="cta_group"
      data-position="after_portfolio_grid"
    >
      <a
        href="/gallery-category/hochzeit/"
        data-track-event="cta_click"
        data-cta-id="portfolio_next_reports"
        data-cta-type="portfolio_navigation"
        data-section-id="portfolio_next_steps"
        data-user-intent="hochzeitsreportagen_ansehen"
        data-position="step_1"
      >
        <span>01</span>
        Hochzeitsreportagen ansehen
      </a>
      <a
        href="/hochzeitsfotograf-preise/"
        data-track-event="cta_click"
        data-cta-id="portfolio_next_pricing"
        data-cta-type="pricing"
        data-section-id="portfolio_next_steps"
        data-user-intent="preise_ansehen"
        data-position="step_2"
      >
        <span>02</span>
        Preise ansehen
      </a>
      <a
        href="/kontakt/"
        data-track-event="contact_click"
        data-cta-id="portfolio_next_availability"
        data-cta-type="contact_form"
        data-section-id="portfolio_next_steps"
        data-user-intent="verfuegbarkeit_anfragen"
        data-journey-stage="conversion"
        data-position="step_3"
      >
        <span>03</span>
        Verfügbarkeit anfragen
      </a>
    </section>

    <section class="portfolio-instagram">
      <p>Folgt mir auf Instagram für kostenlose TFP-Shootings!</p>
      <a
        href="https://www.instagram.com/artbild/"
        data-track-event="external_resource_click"
        data-resource-id="instagram_artbild"
        data-resource-type="social_profile"
        data-section-id="portfolio_instagram"
        data-content-topic="social_media"
        data-user-intent="instagram_oeffnen"
        data-journey-stage="retention"
      >@ARTBILD</a>
    </section>
      <StoryLanguageCta kind="portfolio" />
    </main>

  <footer class="gallery-footer">
    <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
      <img src="/images/logo-artbild-black.png" width="1200" height="480" alt="Artbild Fotografie">
    </a>
    <nav aria-label="Footer">
      <a href="/kontakt/">Kontakt</a>
      <a href="/blog/">Blog</a>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutzerklärung</a>
    </nav>
    <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
  </footer>
</body>
</html>

<style>
  .portfolio-template main {
    padding-bottom: 34px;
  }

  .portfolio-breadcrumb {
    width: min(1040px, calc(100% - 44px));
    margin: clamp(52px, 6vw, 86px) auto 0;
    display: flex;
    gap: 10px;
    align-items: center;
    color: #8a837b;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .portfolio-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .portfolio-hero {
    width: min(760px, calc(100% - 44px));
    margin: clamp(92px, 11vw, 168px) auto 0;
    text-align: center;
  }

  .portfolio-kicker {
    margin: 0 0 28px;
    color: #8a837b;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .34em;
    text-transform: uppercase;
  }

  .portfolio-hero h1 {
    color: #222631;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(58px, 8vw, 112px);
    font-weight: 400;
    line-height: 1;
  }

  .portfolio-hero p {
    margin: clamp(34px, 4vw, 52px) auto 0;
    color: #5f5a54;
    font-size: clamp(18px, 1.55vw, 22px);
    line-height: 1.72;
  }

  .portfolio-funnel {
    width: min(1040px, calc(100% - 44px));
    margin: clamp(120px, 13vw, 210px) auto 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid #e8e2da;
    border-bottom: 1px solid #e8e2da;
  }

  .portfolio-funnel a {
    display: flex;
    gap: 18px;
    align-items: center;
    justify-content: space-between;
    min-height: 84px;
    padding: 22px 0;
    color: #222631;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.16;
    text-decoration: none;
    border-top: 1px solid #e8e2da;
  }

  .portfolio-funnel a:first-child {
    border-top: 0;
  }

  .portfolio-funnel span {
    color: #8a837b;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .24em;
  }

  .portfolio-instagram {
    width: min(760px, calc(100% - 44px));
    margin: clamp(104px, 12vw, 180px) auto 0;
    text-align: center;
  }

  .portfolio-instagram p {
    margin: 0;
    color: #222631;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(28px, 4vw, 54px);
    line-height: 1.16;
  }

  .portfolio-instagram a {
    display: inline-block;
    margin-top: 34px;
    color: #8a6d5a;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .28em;
    text-decoration: none;
  }

  @media (min-width: 860px) {
    .portfolio-funnel {
      grid-template-columns: repeat(3, 1fr);
    }

    .portfolio-funnel a {
      min-height: 190px;
      padding: 32px;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      border-top: 0;
      border-left: 1px solid #e8e2da;
    }

    .portfolio-funnel a:first-child {
      border-left: 0;
    }
  }
</style>
