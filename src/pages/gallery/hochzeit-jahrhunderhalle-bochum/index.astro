---
import FaviconHead from "../../../components/FaviconHead.astro";
import { getImage, Image } from "astro:assets";
import "../../../styles/global.css";
import MobileNavigation from "../../../components/MobileNavigation.astro";
import DesktopNavigation from "../../../components/DesktopNavigation.astro";
import StoryLanguageCta from "../../../components/StoryLanguageCta.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import GalleryImageGrid from "../../../components/GalleryImageGrid.astro";

const imageModules = import.meta.glob(
  [
    "../../../assets/hochzeit-jahrhunderhalle-bochum/*.{jpg,jpeg}",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_1602.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_2214.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_0055.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_4608.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_5669.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_6761.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_6765.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_6771.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_6789.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_6838.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_0604.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_0659.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_0673.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_0805.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_0917.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_4201.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_4206.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_4210.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_4208.jpg",
    "!../../../assets/hochzeit-jahrhunderhalle-bochum/ART_4940.jpg",
  ],
  { eager: true, import: "default" },
) as Record<string, ImageMetadata>;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/gallery/hochzeit-jahrhunderhalle-bochum/";
const pageUrl = `${siteUrl}${pagePath}`;
const heading = "Hochzeit Jahrhunderthalle Bochum";
const title = "Hochzeit Jahrhunderthalle Bochum | Artbild-Fotografie";
const description =
  "Hochzeitsreportage an der Jahrhunderthalle Bochum und im Dampfgebläsehaus: Industriearchitektur, Getting Ready, Brautpaarshooting und Feierdetails im Ruhrgebiet.";
const logoUrl = `${siteUrl}/images/logo-artbild-black.png`;
const venueUrl = "https://www.jahrhunderthalle-bochum.de/";
const publishedAt = "2026-07-04T10:20:00+02:00";

const modulesByFile = Object.fromEntries(
  Object.entries(imageModules).map(([path, image]) => [
    path.split("/").pop() ?? path,
    image,
  ]),
) as Record<string, ImageMetadata>;

const preferredOrder = [
  "ART_1916-Bearbeitet.jpg",
  "ART_0905-Pano-2.jpg",
  "ART_1601.jpg",
  "ART_1602.jpg",
  "ART_2343-Bearbeitet.jpg",
  "ART_2632-Bearbeitet.jpg",
  "ART_2632-hochformat.jpg",
  "ART_3162.jpg",
  "ART_3183.jpg",
  "ART_3217.jpg",
  "ART_3318.jpg",
  "ART_0719-Bearbeitet.jpg",
  "ART_2193-Bearbeitet.jpg",
  "ART_2214.jpg",
  "ART_2219.jpg",
  "ART_2275.jpg",
  "ART_0014.jpg",
  "ART_0033.jpg",
  "ART_0055.jpg",
  "ART_0276-Bearbeitet.jpg",
  "ART_0277-Bearbeitet.jpg",
  "ART_0289.jpg",
  "ART_0311.jpg",
  "ART_4325-Bearbeitet.jpg",
  "ART_4399.jpg",
  "ART_4547-Bearbeitet.jpg",
  "ART_4564.jpg",
  "ART_4608.jpg",
  "ART_4774.jpg",
  "ART_4806-Bearbeitet.jpg",
  "ART_4908-Bearbeitet.jpg",
  "ART_5053.jpg",
  "ART_5267.jpg",
  "ART_5669.jpg",
  "ART_6761.jpg",
  "ART_6765.jpg",
  "ART_6771.jpg",
  "ART_6789.jpg",
  "ART_6838.jpg",
  "ART_7778.jpg",
  "ART_7795.jpg",
  "ART_7802.jpg",
  "ART_7894.jpg",
  "ART_7897.jpg",
  "ART_8250.jpg",
  "ART_8326.jpg",
  "ART_8477-Bearbeitet.jpg",
  "ART_8670.jpg",
  "ART_8898-2.jpg",
  "ART_9000-3.jpg",
  "ART_9030-Bearbeitet.jpg",
  "ART_9178.jpg",
  "ART_9856.jpg",
  "ART_9985.jpg",
];

const imageFiles = [
  ...preferredOrder.filter((file) => modulesByFile[file]),
  ...Object.keys(modulesByFile)
    .filter((file) => !preferredOrder.includes(file))
    .sort((a, b) => a.localeCompare(b, "de")),
];

const altByFile: Record<string, string> = {
  "ART_1916-Bearbeitet.jpg":
    "Hochzeitsgesellschaft vor der Industriearchitektur der Jahrhunderthalle Bochum",
  "ART_0905-Pano-2.jpg":
    "Festlich gedeckte Hochzeitstische im Dampfgebläsehaus der Jahrhunderthalle Bochum",
  "ART_1601.jpg":
    "Brautpaarshooting an der Jahrhunderthalle Bochum mit historischem Wasserturm",
  "ART_2343-Bearbeitet.jpg":
    "Leuchtende LOVE Buchstaben als Hochzeitsdekoration im Dampfgebläsehaus",
  "ART_2632-Bearbeitet.jpg":
    "Eröffnungstanz im Dampfgebläsehaus bei einer Hochzeit in Bochum",
  "ART_2632-hochformat.jpg":
    "Brautpaar beim Tanz vor LOVE Buchstaben in der Jahrhunderthalle Bochum",
  "ART_3162.jpg":
    "Hochzeitstorte mit Wunderkerzen bei einer Feier in der Jahrhunderthalle Bochum",
  "ART_3318.jpg":
    "Beleuchtete Kühltürme am Abend auf dem Gelände der Jahrhunderthalle Bochum",
  "ART_0719-Bearbeitet.jpg":
    "Brautpaar mit Brautstrauß vor Industriekulisse im Ruhrgebiet",
  "ART_4325-Bearbeitet.jpg":
    "Helles Brautportrait beim Getting Ready vor der Hochzeit in Bochum",
  "ART_7802.jpg":
    "Trauringe in einer Glasbox als Detail einer Hochzeit in Bochum",
};

const fallbackAlt = (index: number) =>
  `Hochzeit an der Jahrhunderthalle Bochum und im Dampfgebläsehaus, Bild ${index + 1}`;

const galleryImages = await Promise.all(
  imageFiles.map(async (file, index) => {
    const image = modulesByFile[file];
    const fullImage = await getImage({
      src: image,
      width: image.width,
      format: "webp",
    });

    return {
      id: file.replace(/\.(jpe?g)$/i, ""),
      image,
      fullSrc: fullImage.src,
      format: "webp" as const,
      alt: altByFile[file] ?? fallbackAlt(index),
      aspect:
        image.width > image.height ? "landscape" as const : "portrait" as const,
      eager: index < 2,
    };
  }),
);

const galleryColumns = [galleryImages];

const heroImage = modulesByFile["ART_1916-Bearbeitet.jpg"] ?? galleryImages[0].image;
const hallImage = modulesByFile["ART_0905-Pano-2.jpg"] ?? galleryImages[1]?.image ?? heroImage;
const architectureImage = modulesByFile["ART_1601.jpg"] ?? galleryImages[2]?.image ?? heroImage;
const gettingReadyImage = modulesByFile["ART_4325-Bearbeitet.jpg"] ?? galleryImages[3]?.image ?? heroImage;
const primaryImage = new URL(heroImage.src, siteUrl).href;

const venuePlace = {
  "@type": "EventVenue",
  "@id": `${pageUrl}#jahrhunderthalle-bochum`,
  name: "Jahrhunderthalle Bochum",
  url: venueUrl,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bochum",
    addressRegion: "Nordrhein-Westfalen",
    addressCountry: "DE",
  },
  containedInPlace: {
    "@type": "Place",
    name: "Westpark Bochum",
  },
};

const dampfgeblaesehausPlace = {
  "@type": "EventVenue",
  "@id": `${pageUrl}#dampfgeblaesehaus`,
  name: "Dampfgebläsehaus",
  containedInPlace: {
    "@id": `${pageUrl}#jahrhunderthalle-bochum`,
  },
  address: venuePlace.address,
};


const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Hochzeitsportfolio", href: "/portfolio/" },
  { label: heading, href: pagePath },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${pageUrl}#article`,
      headline: heading,
      name: title,
      description,
      keywords: [
        "Hochzeit Jahrhunderthalle Bochum",
        "Dampfgebläsehaus Hochzeit",
        "Hochzeitsfotograf Bochum",
        "Hochzeitsfotograf Ruhrgebiet",
        "Industriekulisse Hochzeit",
        "Hochzeitslocation Bochum",
      ],
      datePublished: publishedAt,
      dateModified: publishedAt,
      author: {
        "@type": "Person",
        name: "York Augustin",
      },
      publisher: {
        "@id": `${siteUrl}/#organization`,
      },
      image: primaryImage,
      mainEntityOfPage: {
        "@id": `${pageUrl}#webpage`,
      },
      contentLocation: [
        { "@id": `${pageUrl}#jahrhunderthalle-bochum` },
        { "@id": `${pageUrl}#dampfgeblaesehaus` },
      ],
      about: [
        { "@type": "Thing", name: "Hochzeit in Bochum" },
        { "@type": "Thing", name: "Hochzeitsfotografie Ruhrgebiet" },
        { "@type": "Thing", name: "Industriekultur" },
      ],
      inLanguage: "de",
    },
    {
      "@type": "ImageGallery",
      "@id": `${pageUrl}#gallery`,
      name: "Hochzeit an der Jahrhunderthalle Bochum",
      description,
      contentLocation: {
        "@id": `${pageUrl}#dampfgeblaesehaus`,
      },
      image: galleryImages.map((item, index) => ({
        "@type": "ImageObject",
        position: index + 1,
        caption: item.alt,
        contentUrl: new URL(item.fullSrc, siteUrl).href,
        width: item.image.width,
        height: item.image.height,
      })),
    },
    venuePlace,
    dampfgeblaesehausPlace,
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "Artbild-Fotografie",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
      },
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rahlstedter Bahnhofstraße 27",
        postalCode: "22143",
        addressLocality: "Hamburg",
        addressRegion: "Hamburg",
        addressCountry: "DE",
      },
      areaServed: [
        { "@type": "City", name: "Hamburg" },
        { "@type": "City", name: "Bochum" },
        { "@type": "AdministrativeArea", name: "Ruhrgebiet" },
        { "@type": "AdministrativeArea", name: "Nordrhein-Westfalen" },
      ],
      serviceType: [
        "Hochzeitsfotografie",
        "Hochzeitsreportage",
      ],
      sameAs: [
        "https://www.instagram.com/artbild/",
        "https://www.facebook.com/artbildfotografie/",
        "https://www.pinterest.de/artbildf/",
      ],
    },

    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      datePublished: publishedAt,
      dateModified: publishedAt,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        caption: altByFile["ART_1916-Bearbeitet.jpg"],
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
      inLanguage: "de",
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <FaviconHead />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    >
    <link rel="canonical" href={pageUrl}>
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="article">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content="Artbild-Fotografie">
    <meta property="article:published_time" content={publishedAt}>
    <meta property="article:modified_time" content={publishedAt}>
    <meta property="og:image" content={primaryImage}>
    <meta property="og:image:width" content={heroImage.width}>
    <meta property="og:image:height" content={heroImage.height}>
    <meta property="og:image:alt" content={altByFile["ART_1916-Bearbeitet.jpg"]}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={primaryImage}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="gallery-template jahrhunderthalle-page">
    <header class="gallery-header">
      <MobileNavigation />
      <DesktopNavigation />
    </header>

    <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="jahrhunderthalle">
        <header class="jahrhunderthalle-hero">
          <div class="jahrhunderthalle-hero__copy">
            <p class="jahrhunderthalle-kicker">Hochzeit · Bochum · Ruhrgebiet</p>
            <h1>
              <span>Hochzeit</span>
              <span>Jahrhunderthalle</span>
              <span>Bochum</span>
            </h1>
            <p>
              Die Reportage zeigt Gruppenbilder vor der Jahrhunderthalle,
              Paarportraits zwischen Backstein und Stahl sowie die Feier im
              Dampfgebläsehaus.
            </p>
          </div>
          <figure>
            <Image
              src={heroImage}
              widths={[760, 1120, 1600, 1920]}
              sizes="(max-width: 760px) 100vw, 58vw"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt={altByFile["ART_1916-Bearbeitet.jpg"]}
            />
            <figcaption>Hochzeit an der Jahrhunderthalle Bochum</figcaption>
          </figure>
        </header>

        <section class="jahrhunderthalle-intro" aria-labelledby="jahrhunderthalle-intro-title">
          <div>
            <p class="jahrhunderthalle-kicker">Jahrhunderthalle und Dampfgebläsehaus</p>
            <h2 id="jahrhunderthalle-intro-title">
              Die beiden Orte dieser Hochzeitsreportage
            </h2>
          </div>
          <div class="jahrhunderthalle-intro__copy">
            <p>
              Die <a href={venueUrl} target="_blank" rel="noopener noreferrer">Jahrhunderthalle Bochum</a>
              gehört zu den markanten Orten der Industriekultur im Ruhrgebiet.
              Was früher Teil der Energie- und Produktionslandschaft des
              Bochumer Vereins war, ist heute ein Ort für Konzerte, Kultur und
              besondere Veranstaltungen.
            </p>
            <p>
              In der Galerie treffen die Stahl- und Backsteinfassaden des Geländes
              auf festlich gedeckte Tische, LOVE-Buchstaben und farbiges Licht bei
              der Feier.
            </p>
          </div>
        </section>

        <section class="jahrhunderthalle-feature" aria-label="Dampfgebläsehaus als Hochzeitslocation">
          <figure>
            <Image
              src={hallImage}
              widths={[640, 920, 1280, 1600]}
              sizes="(max-width: 760px) 100vw, 48vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
              alt={altByFile["ART_0905-Pano-2.jpg"]}
            />
          </figure>
          <div>
            <p class="jahrhunderthalle-kicker">Dampfgebläsehaus</p>
            <h2>Festlich gedeckte Tische im Dampfgebläsehaus</h2>
            <p>
              Das Panorama zeigt die vorbereitete Halle mit langen Tischreihen,
              Backsteinwänden und der sichtbaren Stahlkonstruktion des Gebäudes.
            </p>
            <p>
              Weitere Bilder halten den Eröffnungstanz, die Hochzeitstorte und die
              beleuchtete Außenansicht am Abend fest.
            </p>
          </div>
        </section>

        <section class="jahrhunderthalle-architecture" aria-labelledby="jahrhunderthalle-architecture-title">
          <div>
            <p class="jahrhunderthalle-kicker">Brautpaarshooting Ruhrgebiet</p>
            <h2 id="jahrhunderthalle-architecture-title">
              Stahl, Backstein und Wasserturm im Brautpaarshooting
            </h2>
            <p>
              Die Paarportraits entstanden vor Rohrleitungen, Backsteinfassaden
              und dem Wasserturm auf dem Gelände der Jahrhunderthalle.
            </p>
          </div>
          <figure>
            <Image
              src={architectureImage}
              widths={[560, 840, 1120, 1440]}
              sizes="(max-width: 760px) 100vw, 42vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
              alt={altByFile["ART_1601.jpg"]}
            />
          </figure>
        </section>

        <GalleryImageGrid
          columns={galleryColumns}
          galleryId="hochzeit-jahrhunderhalle-bochum"
          label="Hochzeitsreportage an der Jahrhunderthalle Bochum und im Dampfgebläsehaus"
          dialogLabel="Hochzeit Jahrhunderthalle Bochum in Vollansicht"
        />

        <aside class="jahrhunderthalle-meta" aria-label="Galeriethemen">
          <span>Themen:</span>
          <a href="/portfolio/">Hochzeitsreportage</a>
          <a href="/portfolio/">Industriekultur</a>
          <a href="/hochzeitsfotograf-preise/">Hochzeitsfotograf Preise</a>
          <a href="/kontakt/">Verfügbarkeit anfragen</a>
        </aside>

        <section class="jahrhunderthalle-location" aria-labelledby="jahrhunderthalle-location-title">
          <figure>
            <Image
              src={gettingReadyImage}
              widths={[460, 720, 960, 1200]}
              sizes="(max-width: 760px) 100vw, 36vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
              alt={altByFile["ART_4325-Bearbeitet.jpg"]}
            />
          </figure>
          <div>
            <p class="jahrhunderthalle-kicker">Getting Ready & Feier</p>
            <h2 id="jahrhunderthalle-location-title">
              Vom Getting Ready bis zur Abendfeier
            </h2>
            <p>
              Neben Architektur- und Paarmotiven enthält die Serie Aufnahmen vom
              Getting Ready, von den Trauringen, vom Eröffnungstanz und von der
              Hochzeitstorte mit Wunderkerzen.
            </p>
          </div>
        </section>

        <nav class="jahrhunderthalle-related" aria-label="Weitere passende Seiten">
          <a href="/portfolio/">
            <span>Portfolio</span>
            Weitere Hochzeitsreportagen ansehen
          </a>
          <a href="/hochzeitsfotograf-preise/">
            <span>Planung</span>
            Hochzeitsfotograf Preise und Pakete
          </a>
          <a href="/gallery/hochzeitsfotograf-niedersachsen/">
            <span>Reportage</span>
            Hochzeit mit industriellem und norddeutschem Charakter
          </a>
        </nav>
      </article>
      <StoryLanguageCta kind="wedding" />
    </main>

    <footer class="gallery-footer">
      <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
        <img
          src="/images/logo-artbild-black.png"
          width="1200"
          height="480"
          alt="Artbild Fotografie"
        >
      </a>
      <nav aria-label="Footer">
        <a href="/kontakt/">Kontakt</a>
        <a href="/blog/">Blog</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutzerklärung</a>
      </nav>
      <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
    </footer>
  </body>
</html>

<style>
  .jahrhunderthalle {
    padding-top: clamp(58px, 6vw, 94px);
  }

  .jahrhunderthalle-hero,
  .jahrhunderthalle-feature,
  .jahrhunderthalle-architecture,
  .jahrhunderthalle-location,
  .jahrhunderthalle-guide {
    width: min(1320px, calc(100% - 72px));
    margin-inline: auto;
  }

  .jahrhunderthalle-hero {
    display: grid;
    grid-template-columns: minmax(360px, .88fr) minmax(0, 1.12fr);
    gap: clamp(44px, 6vw, 86px);
    align-items: center;
  }

  .jahrhunderthalle-kicker {
    margin: 0;
    color: #846b58;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .jahrhunderthalle-hero h1 {
    margin: 20px 0 0;
    color: #292c35;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(48px, 5vw, 76px);
    font-weight: 400;
    line-height: .98;
  }

  .jahrhunderthalle-hero h1 span {
    display: block;
  }

  .jahrhunderthalle-hero__copy > p:last-child {
    margin: 32px 0 0;
    color: #69635e;
    font-size: clamp(18px, 1.45vw, 22px);
    line-height: 1.68;
  }

  .jahrhunderthalle-hero figure,
  .jahrhunderthalle-feature figure,
  .jahrhunderthalle-architecture figure,
  .jahrhunderthalle-location figure {
    margin: 0;
  }

  .jahrhunderthalle-hero figure :global(img),
  .jahrhunderthalle-feature figure :global(img),
  .jahrhunderthalle-architecture figure :global(img),
  .jahrhunderthalle-location figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .jahrhunderthalle-hero figcaption {
    margin-top: 12px;
    color: #817a72;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 9px;
    letter-spacing: .16em;
    text-align: right;
    text-transform: uppercase;
  }

  .jahrhunderthalle-intro {
    width: min(1140px, calc(100% - 92px));
    margin: clamp(90px, 9vw, 142px) auto 0;
    padding: clamp(58px, 7vw, 92px);
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    gap: clamp(44px, 7vw, 104px);
    background: #f3f1ed;
  }

  .jahrhunderthalle-intro h2,
  .jahrhunderthalle-feature h2,
  .jahrhunderthalle-architecture h2,
  .jahrhunderthalle-location h2,
  .jahrhunderthalle-guide h2 {
    margin: 18px 0 0;
