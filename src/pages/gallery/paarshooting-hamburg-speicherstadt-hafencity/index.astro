---
import { Image } from "astro:assets";
import FaviconHead from "../../../components/FaviconHead.astro";
import MobileNavigation from "../../../components/MobileNavigation.astro";
import DesktopNavigation from "../../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import GalleryImageGrid from "../../../components/GalleryImageGrid.astro";
import selection from "../../../data/paarshootingSpeicherstadt.json";
import hamburgTravel from "../../../assets/travel-galleries/hamburg/ART_4908-Bearbeitet.jpg";
import "../../../styles/global.css";

const modules = import.meta.glob("../../../assets/paarshooting-speicherstadt-hafencity/*.webp", {
  eager: true, import: "default",
}) as Record<string, ImageMetadata>;
const byFile = Object.fromEntries(Object.entries(modules).map(([path, image]) => [path.split("/").pop(), image]));
const images = selection.map((item) => {
  const image = byFile[item.file];
  if (!image) throw new Error(`Missing couple gallery image: ${item.file}`);
  return { ...item, image, format: "webp" as const, aspect: "natural" as const };
});
const groups = Array.from({ length: 10 }, (_, index) => images.filter((item) => item.group === index + 1));
const hero = images.find((item) => item.number === 4706)!;
const metaImage = images.find((item) => item.number === 4839)!;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/gallery/paarshooting-hamburg-speicherstadt-hafencity/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "Paarshooting Hamburg: Speicherstadt & HafenCity | Domenic & Liza";
const description = "Paarshooting Hamburg mit Domenic & Liza: Speicherstadt, HafenCity und Kehrwiederspitze. Tipps für Paarfotos am Hübenerkai, an den Terrassen und mit Elbphilharmonie.";
const primaryImage = new URL(metaImage.image.src, siteUrl).href;
const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Portfolio", href: "/portfolio/" },
  { label: "Domenic & Liza · Hamburg", href: pagePath },
];
const schema = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebPage", "@id": `${pageUrl}#webpage`, url: pageUrl, name: title, description,
      inLanguage: "de", datePublished: "2026-10-04", dateModified: "2026-10-10",
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` }, primaryImageOfPage: { "@id": `${pageUrl}#primaryimage` } },
    { "@type": "Article", "@id": `${pageUrl}#article`, headline: "Paarshooting in Hamburg – Domenic & Liza",
      description, datePublished: "2026-10-04", dateModified: "2026-10-10", inLanguage: "de",
      author: { "@type": "Person", name: "York Augustin", url: `${siteUrl}/about/` },
      publisher: { "@type": "Organization", name: "Artbild-Fotografie", url: siteUrl },
      image: primaryImage, mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
      keywords: ["Paarshooting Hamburg", "Paar Fotoshooting Hamburg", "Verlobungsshooting Hamburg", "Speicherstadt Hamburg", "HafenCity Hamburg", "Marco Polo Terrassen Hamburg", "Strandkai Hamburg", "Elbphilharmonie Hamburg", "Michel Hamburg"],
      about: ["Speicherstadt Hamburg", "HafenCity Hamburg", "Jungfernbrücke", "Kehrwiedersteg", "Hübenerkai", "Strandkai", "Marco-Polo-Terrassen", "Kehrwiederspitze", "Elbphilharmonie", "Flussschifferkirche", "Hauptkirche St. Michaelis"].map((name) => ({ "@type": "Place", name })) },
    { "@type": "ImageObject", "@id": `${pageUrl}#primaryimage`, url: primaryImage, contentUrl: primaryImage,
      caption: metaImage.alt, width: metaImage.image.width, height: metaImage.image.height },
    ...["Speicherstadt", "HafenCity", "Kehrwiederspitze"].map((location) => ({
      "@type": "ImageGallery", "@id": `${pageUrl}#${location.toLowerCase()}-gallery`,
      name: `${location} Hamburg – Domenic & Liza`, isPartOf: { "@id": `${pageUrl}#webpage` },
      image: images.filter((item) => item.location === location).map((item, index) => ({
        "@type": "ImageObject", position: index + 1, caption: item.alt,
        contentUrl: new URL(item.image.src, siteUrl).href, width: item.image.width, height: item.image.height,
      })),
    })),
  ],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FaviconHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Artbild-Fotografie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={primaryImage} />
    <meta property="og:image:alt" content={metaImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={primaryImage} />
    <meta name="twitter:image:alt" content={metaImage.alt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="gallery-template couple-hamburg-page">
    <a class="skip-link" href="#paarshooting">Zur Paarshooting-Galerie</a>
    <header class="gallery-header"><MobileNavigation /><DesktopNavigation /></header>
    <main id="paarshooting">
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="couple-story">
        <header class="couple-hero">
          <div class="couple-hero__copy">
            <p class="handwritten" aria-hidden="true">Domenic &amp; Liza</p>
            <p class="eyebrow">Paarfotos mit Domenic &amp; Liza · September 2026</p>
            <h1>Paarshooting <br />in Hamburg</h1>
            <p class="couple-hero__places">Speicherstadt &amp; HafenCity</p>
            <p class="intro">Mit Domenic und Liza durch Hamburg: von den Backsteingassen und Brücken der Speicherstadt ans Wasser in der HafenCity. Zum Abschluss fotografieren wir im Gegenlicht an der Kehrwiederspitze. Diese Paarfotos entstanden an einem Septembernachmittag.</p>
            <nav class="chapter-nav" aria-label="Kapitel dieser Paarshooting-Galerie">
              <a href="#speicherstadt"><span>01</span> Speicherstadt</a>
              <a href="#hafencity"><span>02</span> HafenCity</a>
              <a href="#kehrwiederspitze"><span>03</span> Kehrwiederspitze</a>
              <a href="#hamburg-entdecken"><span>04</span> Shooting planen</a>
            </nav>
          </div>
          <figure class="couple-hero__photo">
            <Image src={hero.image} widths={[460, 720, 1000, 1400]} sizes="(max-width: 767px) calc(100vw - 48px), 38vw" format="webp" quality={88} loading="eager" fetchpriority="high" alt={hero.alt} />
            <figcaption>Domenic &amp; Liza · Hamburg, September 2026</figcaption>
          </figure>
        </header>

        <section id="speicherstadt" class="chapter" aria-labelledby="speicherstadt-title">
          <header class="story-copy story-copy--chapter">
            <div><p class="eyebrow">01 / Speicherstadt</p><h2 id="speicherstadt-title">Zwischen Backstein und Fleeten</h2></div>
            <div class="copy"><p>Unser Paarshooting beginnt in der Speicherstadt. Zwischen den roten Fassaden, schmalen Gassen und Brücken finden wir Plätze für die ersten Portraits von Domenic und Liza.</p><p>Ihr braucht keine Erfahrung vor der Kamera. Wir beginnen mit einfachen Anregungen zum Stehen und Gehen und lassen Euch Zeit, im Shooting anzukommen.</p></div>
          </header>
          <GalleryImageGrid columns={[groups[0]]} galleryId="domenic-liza-01" label="Speicherstadt – Jungfernbrücke und Zollkanal" />
          <section class="story-copy" aria-labelledby="backstein-title">
            <div><p class="eyebrow">Brücken &amp; Wasser</p><h3 id="backstein-title">Paarfotos am Fleet</h3></div>
            <div class="copy"><p>Auf den Brücken öffnet sich der Blick entlang der Speicher. Domenic und Liza sitzen, lachen und begegnen sich vor den Backsteinfassaden. Wir wechseln zwischen nahen Portraits und Bildern, die mehr von der Umgebung zeigen.</p><p>Die Plätze teilen wir mit Spaziergängern. Wir wählen freie Stellen und lassen andere Menschen passieren.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[2]]} galleryId="domenic-liza-03" label="Speicherstadt – Brücken und Speicher am Fleet" />
        </section>

        <section id="hafencity" class="chapter" aria-labelledby="hafencity-title">
          <header class="story-copy story-copy--chapter">
            <div><p class="eyebrow">02 / HafenCity</p><h2 id="hafencity-title">Vom Fleet an die Elbe</h2></div>
            <div class="copy"><p>Von der Speicherstadt gehen wir weiter in die HafenCity. Moderne Fassaden und offene Promenaden verändern den Hintergrund unserer Paarfotos. Am Grasbrookhafen kommt mehr Licht und Weite ins Bild.</p><p>Wenn Ihr beide Orte verbinden möchtet, planen wir die Fußwege mit ein. Treffpunkt und Strecke stimmen wir auf Eure Lieblingsmotive ab.</p></div>
          </header>
          <GalleryImageGrid columns={[groups[3]]} galleryId="domenic-liza-04" label="HafenCity – am Grasbrookhafen" />
          <section class="story-copy" aria-labelledby="ufer-title">
            <div><p class="eyebrow">Hübenerkai &amp; Strandkai</p><h3 id="ufer-title">Nähe am Wasser</h3></div>
            <div class="copy"><p>Am Hübenerkai liegt der Grasbrookhafen vor uns. Die südliche Promenade am Strandkai führt entlang der Elbe. Hier stehen die Umarmungen und Küsse von Domenic und Liza im Mittelpunkt, mit dem Wasser im Hintergrund.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[4]]} galleryId="domenic-liza-05" label="HafenCity – Strandkai und Elbufer" />
          <section class="story-copy" aria-labelledby="bewegung-title">
            <div><p class="eyebrow">Paarshooting am Elbufer</p><h3 id="bewegung-title">Lachen, tanzen, loslassen</h3></div>
            <div class="copy"><p>Zwischendurch kommt Bewegung in das Shooting: Domenic dreht Liza unter seinem Arm, die beiden tanzen und lachen miteinander. Solche kleinen Anregungen geben Euch etwas zu tun und lassen Raum für Eure eigenen Gesten.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[5]]} galleryId="domenic-liza-06" label="HafenCity – Paarshooting am Elbufer" />
          <section class="story-copy" aria-labelledby="terrassen-title">
            <div><p class="eyebrow">Marco-Polo-Terrassen</p><h3 id="terrassen-title">Eine Pause am Ufer</h3></div>
            <div class="copy"><p>An den Marco-Polo-Terrassen wird es ruhiger. Stufen und Plätze am Wasser bieten Motive im Sitzen. Gegenlicht fällt zwischen die Fassaden, während Liza sich an Domenic lehnt.</p><p>Für kurze Wege lassen sich die Terrassen mit der angrenzenden Promenade am Hübenerkai verbinden.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[6]]} galleryId="domenic-liza-07" label="HafenCity – Marco-Polo-Terrassen" />
        </section>

        <section id="kehrwiederspitze" class="chapter" aria-labelledby="kehrwiederspitze-title">
          <header class="story-copy story-copy--chapter">
            <div><p class="eyebrow">03 / Kehrwiederspitze</p><h2 id="kehrwiederspitze-title">Ein Kuss im Gegenlicht</h2></div>
            <div class="copy"><p>Zum Abschluss geht es an die Kehrwiederspitze. Domenic und Liza küssen sich im warmen Gegenlicht; hinter ihnen liegen Wasser und Hafen. Mit wenigen Schritten ändern sich Perspektive und Hintergrund.</p><p>Für Eure Paarfotos können wir den Blick zur Elbphilharmonie oder über den Hafen wählen. Den Treffpunkt und die zugänglichen Plätze stimmen wir kurz vor Eurem Termin ab.</p></div>
          </header>
          <GalleryImageGrid columns={[groups[7]]} galleryId="domenic-liza-08" label="Kehrwiederspitze – Paarfotos mit Elbphilharmonie und Hafenblick" />
          <section class="story-copy" aria-labelledby="gegenlicht-title">
            <div><p class="eyebrow">Licht am Hafen</p><h3 id="gegenlicht-title">Noch einen Moment bleiben</h3></div>
            <div class="copy"><p>Am Geländer halten wir den Moment fest, bevor wir den Blick zurück auf Hamburg richten. Für Gegenlichtaufnahmen stimmen wir Tageszeit und Blickrichtung auf Euren Termin ab – das Licht verändert sich mit der Jahreszeit.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[8]]} galleryId="domenic-liza-09" label="Kehrwiederspitze – Paarfotos am Hafenufer" />
          <section class="story-copy" aria-labelledby="michel-title">
            <div><p class="eyebrow">Hamburger Stadtsilhouette</p><h3 id="michel-title">Flussschifferkirche und Michel</h3></div>
            <div class="copy"><p>Die letzten Bilder verbinden Domenic und Liza mit der Umgebung: die Flussschifferkirche im Binnenhafen und der Michel hinter dem Paar. Wenn Ihr Euch eine kirchliche Hochzeit in Hamburg wünscht, findet Ihr <a href="/kirchliche-trauungen-hamburg/">Kirchen und Planungshilfen in der Übersicht</a>.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[9]]} galleryId="domenic-liza-10" label="Kehrwiederspitze – mit Flussschifferkirche und Michel" />
        </section>

        <section id="hamburg-entdecken" class="story-copy light-story" aria-labelledby="planung-title">
          <div><p class="eyebrow">Euer Paarshooting in Hamburg</p><h2 id="planung-title">So planen wir Eure Bilder</h2></div>
          <div class="copy">
            <p>Schreibt mir, welche Orte Euch gefallen und wann Ihr Zeit habt. Dann besprechen wir Strecke, Licht und Kleidung – auch für ein <a href="/gallery/lovebirds-am-elbstrand/">Verlobungsshooting in Hamburg</a>.</p>
            <details class="shooting-tip"><summary>Kleidung, Wege und Wetter</summary><p>Tragt Kleidung, in der Ihr Euch beim Gehen und Sitzen wohlfühlt. Bequeme Schuhe helfen auf Pflaster und Treppen; nehmt Eure Fotoschuhe bei Bedarf zusätzlich mit. Am offenen Elbufer ist eine Jacke für die Wege und Pausen hilfreich. Wetter und Sonnenstand prüfen wir passend zu Eurem Termin.</p></details>
            <details class="shooting-tip"><summary>Anreise zur Kehrwiederspitze</summary><p>Die U-Bahn-Station Baumwall kommt für die Anreise infrage. Hinweise zu Bauarbeiten und Wegeführung findet Ihr bei <a href="https://www.hamburg.de/politik-und-verwaltung/behoerden/finanzbehoerde/aktuelles/sanierung-der-kaimauern-an-der-kehrwiederspitze-1146216" target="_blank" rel="noopener">Hamburg zur Kehrwiederspitze</a>. Den konkreten Treffpunkt vereinbaren wir kurz vor dem Shooting.</p></details>
            <details class="shooting-tip"><summary>Barkassenfahrt oder Hochzeit am Hafen</summary><p>Wenn Ihr eine Fahrt nach dem Shooting plant, stimmen wir den Fototermin auf die Abfahrt ab. Möglichkeiten für Hochzeitsfahrten beschreiben <a href="https://www.barkassenvermietung-hamburg.com/barkasse-mieten/hochzeiten.html" target="_blank" rel="noopener">Barkassenbetrieb Bülow</a> und <a href="https://www.barkassen-meyer.de/schiff-charter/trauungen-hochzeiten" target="_blank" rel="noopener">Barkassen-Meyer</a>. Einstieg, Fahrtdauer und mögliche Route klärt Ihr mit der Reederei.</p></details>
            <a class="text-link" href="/kontakt/">Paarshooting in Hamburg anfragen <span aria-hidden="true">→</span></a>
          </div>
        </section>

        <aside class="travel-link" aria-labelledby="travel-title">
          <a href="/gallery/hamburg/" aria-label="Hamburg Fotografie: Travel-Galerie ansehen"><Image src={hamburgTravel} widths={[500, 800, 1200]} sizes="(max-width: 767px) calc(100vw - 48px), 48vw" format="webp" alt="Hamburger Architektur und Spiegelungen im Wasser zur blauen Stunde" loading="lazy" /></a>
          <div><p class="eyebrow">Hamburg Fotografie · Travel</p><h2 id="travel-title">Weitere Fotoorte in Hamburg</h2><p>Wenn Ihr für Euer Paarshooting noch zwischen mehreren Hamburger Orten überlegt, schaut auch in meine Hamburg-Travel-Galerie. Dort findet Ihr Stadt- und Hafenansichten sowie Architektur bei Tages- und Abendlicht. Schickt mir gern den Link zu einem Motiv, dessen Umgebung Euch für Eure Paarfotos gefällt.</p><a class="text-link" href="/gallery/hamburg/">Hamburg-Fotografie ansehen <span aria-hidden="true">→</span></a></div>
        </aside>
        <nav class="related-links" aria-label="Weitere Paarshootings und Portfolio"><a href="/gallery/lovebirds-am-elbstrand/">Paarshooting am Elbstrand</a><a href="/gallery/paarshooting-mallorca/">Paarshooting auf Mallorca</a><a href="/portfolio/">Zurück zum Portfolio</a></nav>
      </article>
    </main>
    <footer class="gallery-footer"><a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite"><img src="/images/logo-artbild-black.png" width="1200" height="480" alt="Artbild Fotografie" loading="lazy" /></a><nav aria-label="Footer"><a href="/kontakt/">Kontakt</a><a href="/blog/">Blog</a><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutzerklärung</a></nav><p>Copyright York Augustin. Alle Rechte vorbehalten.</p></footer>
  </body>
</html>

<style>
  :global(.couple-hamburg-page) { background: #fff; color: #30333b; }
  .skip-link { position: fixed; top: -100px; left: 24px; z-index: 1000; padding: 14px; background: #fff; }
  .skip-link:focus { top: 16px; }
  .couple-story { padding-top: clamp(40px, 5vw, 80px); }
  .couple-hero { width: min(1240px, calc(100% - 80px)); margin: 0 auto 100px; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(48px, 7vw, 100px); align-items: center; }
  .handwritten { font: clamp(54px, 5.5vw, 88px)/1.15 "Bestermind", Georgia, serif; margin: 0 0 32px; }
  .eyebrow { font: 600 10px/1.7 "Raleway", Arial, sans-serif; letter-spacing: .19em; text-transform: uppercase; color: #7b6555; margin: 0 0 20px; }
  h1, h2, h3 { font-family: "Gilda Display", Georgia, serif; font-weight: 400; margin: 0; }
  h1 { font-size: clamp(48px, 5.1vw, 78px); line-height: 1.1; }
  .couple-hero__places { font-size: 22px; margin: 24px 0; }
  .intro, .copy, .travel-link p:not(.eyebrow) { color: #605d59; font: 18px/1.85 "Gilda Display", Georgia, serif; }
  .couple-hero .intro { max-width: 540px; text-align: left; }
  .couple-hero__photo { margin: 0; }
  .couple-hero__photo :global(img) { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 16px; font: 9px/1.6 "Raleway", Arial, sans-serif; letter-spacing: .15em; text-transform: uppercase; color: #716b66; text-align: right; }
  .chapter-nav { display: flex; flex-wrap: wrap; gap: 16px 24px; border-top: 1px solid #e5e0db; padding-top: 24px; margin-top: 30px; }
  .chapter-nav a { color: #30333b; font: 11px/1.7 "Raleway", Arial, sans-serif; text-decoration: none; }
  .chapter-nav span { color: #7b6555; padding-right: 6px; }
  .chapter, #hamburg-entdecken { scroll-margin-top: 110px; }
  .story-copy { background: #fff; width: min(1100px, calc(100% - 96px)); margin: 0 auto; padding: clamp(64px, 7vw, 106px) 0 8px; display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 7vw, 100px); align-items: start; }
  .story-copy--chapter { padding-top: 78px; border-top: 1px solid #e5e0db; }
  h2 { font-size: clamp(34px, 3.5vw, 52px); line-height: 1.17; }
  h3 { font-size: clamp(32px, 3.1vw, 46px); line-height: 1.2; }
  .copy p { margin: 0 0 20px; text-align: left; }
  .copy p:last-child { margin-bottom: 0; }
  :global(.couple-hamburg-page .gallery-image-grid) { width: min(1280px, calc(100vw - 64px)); margin-top: 46px; --masonry-gap: 28px; }
  .chapter + .chapter { margin-top: 100px; }
  .text-link { display: inline-block; color: #30333b; font: 600 11px/1.9 "Raleway", Arial, sans-serif; letter-spacing: .07em; text-decoration: underline; text-underline-offset: 6px; }
  .source-link { font-size: 10px; font-weight: 400; letter-spacing: .02em; }
  .source-links { display: flex; flex-direction: column; align-items: start; gap: 14px; margin-top: 30px; }
  .shooting-tip { border-top: 1px solid #e5e0db; padding: 16px 0; }
  .shooting-tip summary { cursor: pointer; color: #30333b; }
  .shooting-tip p { margin-top: 16px; font-size: 16px; }
  .light-story { margin-top: 90px; border-top: 1px solid #e5e0db; }
  .travel-link { width: min(1200px, calc(100% - 80px)); margin: 110px auto 80px; display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(40px, 6vw, 86px); align-items: center; }
  .travel-link :global(img) { display: block; width: 100%; height: auto; }
  .travel-link h2 { margin-bottom: 24px; }
  .related-links { width: min(1200px, calc(100% - 80px)); margin: 0 auto 80px; display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; padding: 30px 0; border-block: 1px solid #e5e0db; }
  .related-links a { color: #30333b; font: 14px/1.6 "Gilda Display", Georgia, serif; text-underline-offset: 5px; }
  a:focus-visible { outline: 2px solid #7b6555; outline-offset: 6px; }
  @media (max-width: 900px) { .couple-hero { gap: 40px; } .story-copy { gap: 40px; } }
  @media (min-width: 768px) {
    :global(.couple-hamburg-page #kehrwiederspitze .masonry-gallery) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      height: auto !important;
    }
    :global(.couple-hamburg-page #kehrwiederspitze .masonry-gallery__item) {
      position: static;
      width: auto !important;
      height: auto !important;
      transform: none !important;
    }
  }
  @media (max-width: 767px) {
    .couple-hero { width: calc(100% - 48px); grid-template-columns: 1fr; gap: 24px; margin-bottom: 64px; }
    .couple-hero__copy { display: contents; }
    .couple-hero .handwritten { order: 1; font-size: 58px; margin: 0; text-align: center; }
    .couple-hero .eyebrow { order: 2; margin: 0; text-align: center; }
    h1 { order: 3; font-size: clamp(46px, 11vw, 68px); text-align: center; }
    .couple-hero__places { order: 4; margin: 0; text-align: center; }
    .couple-hero__photo { order: 5; width: min(100%, 420px); margin: 8px auto; }
    .couple-hero .intro { order: 6; margin: 0 auto; font-size: 17px; text-align: center; }
    .chapter-nav { order: 7; justify-content: center; gap: 14px 18px; margin-top: 0; }
    figcaption { text-align: center; font-size: 8px; }
    .story-copy { width: calc(100% - 48px); grid-template-columns: 1fr; gap: 28px; padding-top: 64px; }
    .copy { font-size: 17px; }
    .story-copy--chapter { padding-top: 52px; }
    :global(.couple-hamburg-page .gallery-image-grid) { width: calc(100vw - 48px); margin-top: 32px; --masonry-gap: 24px; }
    .chapter + .chapter { margin-top: 64px; }
    .light-story { margin-top: 64px; }
