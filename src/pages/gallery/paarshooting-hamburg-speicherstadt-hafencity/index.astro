---
import { Image } from "astro:assets";
import FaviconHead from "../../../components/FaviconHead.astro";
import MobileNavigation from "../../../components/MobileNavigation.astro";
import DesktopNavigation from "../../../components/DesktopNavigation.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import GalleryImageGrid from "../../../components/GalleryImageGrid.astro";
import selection from "../../../data/paarshootingSpeicherstadt.json";
import hamburgTravel from "../../../assets/travel-galleries/hamburg/ART_4908-Bearbeitet.jpg";
import "../../../styles/global.css";

const modules = import.meta.glob("../../../assets/paarshooting-speicherstadt-hafencity/*.webp", {
  eager: true, import: "default",
}) as Record<string, ImageMetadata>;
const byFile = Object.fromEntries(Object.entries(modules).map(([path, image]) => [path.split("/").pop(), image]));
const images = selection.map((item) => {
  const image = byFile[item.file];
  if (!image) throw new Error(`Missing couple gallery image: ${item.file}`);
  return { ...item, image, format: "webp" as const, aspect: "natural" as const };
});
const groups = Array.from({ length: 10 }, (_, index) => images.filter((item) => item.group === index + 1));
const hero = images.find((item) => item.number === 4706)!;
const metaImage = images.find((item) => item.number === 4839)!;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/gallery/paarshooting-hamburg-speicherstadt-hafencity/";
const pageUrl = `${siteUrl}${pagePath}`;
const title = "Paarshooting Hamburg: Speicherstadt & HafenCity | Domenic & Liza";
const description = "Paarshooting Hamburg mit Domenic & Liza: Speicherstadt, HafenCity und Kehrwiederspitze. Tipps für Paarfotos am Hübenerkai, an den Terrassen und mit Elbphilharmonie.";
const primaryImage = new URL(metaImage.image.src, siteUrl).href;
const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Portfolio", href: "/portfolio/" },
  { label: "Domenic & Liza · Hamburg", href: pagePath },
];
const schema = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebPage", "@id": `${pageUrl}#webpage`, url: pageUrl, name: title, description,
      inLanguage: "de", datePublished: "2026-10-04", dateModified: "2026-10-04",
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` }, primaryImageOfPage: { "@id": `${pageUrl}#primaryimage` } },
    { "@type": "Article", "@id": `${pageUrl}#article`, headline: "Paarshooting in Hamburg – Domenic & Liza",
      description, datePublished: "2026-10-04", dateModified: "2026-10-04", inLanguage: "de",
      author: { "@type": "Person", name: "York Augustin", url: `${siteUrl}/about/` },
      publisher: { "@type": "Organization", name: "Artbild-Fotografie", url: siteUrl },
      image: primaryImage, mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
      keywords: ["Paarshooting Hamburg", "Paar Fotoshooting Hamburg", "Verlobungsshooting Hamburg", "Speicherstadt Hamburg", "HafenCity Hamburg", "Marco Polo Terrassen Hamburg", "Strandkai Hamburg", "Elbphilharmonie Hamburg", "Michel Hamburg"],
      about: ["Speicherstadt Hamburg", "HafenCity Hamburg", "Jungfernbrücke", "Kehrwiedersteg", "Hübenerkai", "Strandkai", "Marco-Polo-Terrassen", "Kehrwiederspitze", "Elbphilharmonie", "Flussschifferkirche", "Hauptkirche St. Michaelis"].map((name) => ({ "@type": "Place", name })) },
    { "@type": "ImageObject", "@id": `${pageUrl}#primaryimage`, url: primaryImage, contentUrl: primaryImage,
      caption: metaImage.alt, width: metaImage.image.width, height: metaImage.image.height },
    ...["Speicherstadt", "HafenCity", "Kehrwiederspitze"].map((location) => ({
      "@type": "ImageGallery", "@id": `${pageUrl}#${location.toLowerCase()}-gallery`,
      name: `${location} Hamburg – Domenic & Liza`, isPartOf: { "@id": `${pageUrl}#webpage` },
      image: images.filter((item) => item.location === location).map((item, index) => ({
        "@type": "ImageObject", position: index + 1, caption: item.alt,
        contentUrl: new URL(item.image.src, siteUrl).href, width: item.image.width, height: item.image.height,
      })),
    })),
  ],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FaviconHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Artbild-Fotografie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={primaryImage} />
    <meta property="og:image:alt" content={metaImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={primaryImage} />
    <meta name="twitter:image:alt" content={metaImage.alt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="gallery-template couple-hamburg-page">
    <a class="skip-link" href="#paarshooting">Zur Paarshooting-Galerie</a>
    <header class="gallery-header"><MobileNavigation /><DesktopNavigation /></header>
    <main id="paarshooting">
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
      <article class="couple-story">
        <header class="couple-hero">
          <div class="couple-hero__copy">
            <p class="handwritten" aria-hidden="true">Domenic &amp; Liza</p>
            <p class="eyebrow">Paarfotos mit Domenic &amp; Liza · September 2026</p>
            <h1>Paarshooting <br />in Hamburg</h1>
            <p class="couple-hero__places">Speicherstadt &amp; HafenCity</p>
            <p class="intro">Für ein Paarshooting in Hamburg lassen sich die Speicherstadt und die HafenCity gut verbinden. An den Fleeten fotografieren wir zwischen Backsteinspeichern und historischen Brücken. Rund um Hübenerkai, Strandkai und Marco-Polo-Terrassen kommen moderne Gebäude und Hafenblicke dazu. An der Kehrwiederspitze könnt Ihr Euch Paarfotos mit der Elbphilharmonie wünschen. Die Fotos von Domenic und Liza entstanden an einem Septembernachmittag.</p>
            <nav class="chapter-nav" aria-label="Kapitel dieser Paarshooting-Galerie">
              <a href="#speicherstadt"><span>01</span> Speicherstadt</a>
              <a href="#hafencity"><span>02</span> HafenCity</a>
              <a href="#kehrwiederspitze"><span>03</span> Kehrwiederspitze</a>
              <a href="#hamburg-entdecken"><span>04</span> Hamburg entdecken</a>
            </nav>
          </div>
          <figure class="couple-hero__photo">
            <Image src={hero.image} widths={[460, 720, 1000, 1400]} sizes="(max-width: 767px) calc(100vw - 48px), 38vw" format="webp" quality={88} loading="eager" fetchpriority="high" alt={hero.alt} />
            <figcaption>Domenic &amp; Liza · Hamburg, September 2026</figcaption>
          </figure>
        </header>

        <section id="speicherstadt" class="chapter" aria-labelledby="speicherstadt-title">
          <header class="story-copy story-copy--chapter">
            <div><p class="eyebrow">01 / Speicherstadt</p><h2 id="speicherstadt-title">Paarshooting in der Speicherstadt</h2></div>
            <div class="copy"><p>Die Speicherstadt Hamburg passt zu Euch, wenn Ihr Euch Paarfotos mit Backstein, Brücken und Wasser wünscht. An der Jungfernbrücke über dem Zollkanal liegen die Altstadt und die historischen Speicher direkt nebeneinander. Die Fußgängerbrücke und die benachbarte Kannengießerbrücke sind gute Ausgangspunkte für ein Shooting in diesem Teil der Speicherstadt.</p><p>Auf der Brücke teilen wir den Platz mit Spaziergängern. Für Eure Paarfotos wählen wir deshalb freie Stellen und lassen andere Menschen passieren. Wenn Ihr Euch vor der Kamera noch unsicher fühlt, beginnen wir mit einfachen Anregungen zum Stehen und Gehen. Ihr braucht keine Erfahrung vor der Kamera.</p></div>
          </header>
          <GalleryImageGrid columns={[groups[0]]} galleryId="domenic-liza-01" label="Speicherstadt – Jungfernbrücke und Zollkanal" />

          <section class="story-copy" aria-labelledby="backstein-title">
            <div><p class="eyebrow">Tageszeit &amp; Licht</p><h3 id="backstein-title">Licht in den Gassen der Speicherstadt</h3></div>
            <div class="copy"><p>Die Speicherstadt entstand zwischen 1883 und 1927 als Lagerhausviertel. Die hohen Backsteinspeicher stehen dicht an den Fleeten; dadurch liegen einzelne Wege und Fassaden auch an sonnigen Tagen im Schatten. Für Euer Shooting wählen wir die Tageszeit passend zu den gewünschten Brücken und Blickrichtungen.</p><p>Wünscht Ihr Euch weicheres Licht, suchen wir schattige Bereiche oder planen den Termin näher am Abend. Für sonnige Paarfotos können wir auf die offeneren Brücken wechseln. Wolken sind ebenfalls gut zum Fotografieren geeignet. Die Uhrzeit stimmen wir für Euren Termin ab, denn das Licht verändert sich mit der Jahreszeit.</p><a class="text-link source-link" href="https://www.hamburg.de/politik-und-verwaltung/behoerden/behoerde-fuer-kultur-und-medien/themen/unesco-welterbe/welterbe-erklaert-speicherstadt-105900" target="_blank" rel="noopener">Hintergrund zur Speicherstadt bei hamburg.de ↗</a></div>
          </section>
          <GalleryImageGrid columns={[groups[1]]} galleryId="domenic-liza-02" label="Speicherstadt – am Kehrwiederfleet" />

          <section class="story-copy" aria-labelledby="weiter-title">
            <div><p class="eyebrow">Zwei Orte in einem Shooting</p><h3 id="weiter-title">Von der Speicherstadt in die HafenCity</h3></div>
            <div class="copy"><p>Wenn Ihr Speicherstadt und HafenCity kombinieren möchtet, bietet sich ein Weg vom Kehrwiedersteg über Am Sandtorkai und Großer Grasbrook zu den Marco-Polo-Terrassen an. Damit verbindet Ihr die historischen Speicher mit den Plätzen und Promenaden der westlichen HafenCity.</p><p>Für ein Paarshooting in Hamburg mit beiden Orten planen wir den Fußweg mit ein. Bequeme Schuhe sind auf dem Pflaster und den Treppen hilfreich. Möchtet Ihr für die Fotos andere Schuhe tragen, nehmt sie einfach zusätzlich mit. Wenn Ihr lieber an einer einzigen Location bleiben möchtet, legen wir vorab fest, welcher Teil der Strecke Euch am besten gefällt.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[2]]} galleryId="domenic-liza-03" label="Speicherstadt – Brücken und Speicher am Fleet" />
        </section>

        <section id="hafencity" class="chapter" aria-labelledby="hafencity-title">
          <header class="story-copy story-copy--chapter">
            <div><p class="eyebrow">02 / HafenCity</p><h2 id="hafencity-title">Paarshooting in der HafenCity</h2></div>
            <div class="copy"><p>In der HafenCity Hamburg liegen rund um den Grasbrookhafen mehrere Orte für Paarfotos nah beieinander. An den Marco-Polo-Terrassen seht Ihr über das Hafenbecken zu den Gebäuden am Dalmannkai. Der Marco-Polo-Tower mit seinen gedrehten Etagen und das frühere Unilever-Haus helfen Euch, den Bereich auf dem Stadtplan zu finden.</p><p>Die HafenCity eignet sich für Euch, wenn Ihr moderne Architektur und Wasser auf Euren Fotos möchtet. Vor dem Shooting besprechen wir, ob Ihr lieber an den Terrassen, am Hübenerkai oder direkt am Elbufer fotografiert werden möchtet. Davon hängen unser Treffpunkt und die weitere Strecke ab.</p></div>
          </header>
          <GalleryImageGrid columns={[groups[3]]} galleryId="domenic-liza-04" label="HafenCity – am Grasbrookhafen" />

          <section class="story-copy" aria-labelledby="licht-title">
            <div><p class="eyebrow">Promenaden am Wasser</p><h3 id="licht-title">Hübenerkai und Strandkai</h3></div>
            <div class="copy"><p>Der Hübenerkai liegt am Grasbrookhafen, auf der Nordseite der Strandkai-Halbinsel. Von hier aus blickt Ihr auf die Gebäude am Dalmannkai. Die Promenade auf der Südseite führt an der Elbe entlang und bietet den Blick auf den Hafen.</p><p>Der Strandkai in Hamburg ist eine gute Ergänzung, wenn Ihr neben Stadtansichten auch Paarfotos mit viel Wasser im Hintergrund möchtet. An den offenen Promenaden kann es windiger sein als zwischen den Speichern. Nehmt für die Wege und Pausen eine Jacke mit, auch wenn Ihr sie auf den Fotos ausziehen möchtet.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[4]]} galleryId="domenic-liza-05" label="HafenCity – Strandkai und Elbufer" />

          <section class="story-copy" aria-labelledby="bewegung-title">
            <div><p class="eyebrow">Shooting draußen</p><h3 id="bewegung-title">Licht und Kleidung am Elbufer</h3></div>
            <div class="copy"><p>Für ein Paarshooting draußen in Hamburg schauen wir neben der Wettervorhersage auch auf den Sonnenstand. Am offenen Strandkai gibt es weniger Schatten durch die Speichergebäude. Wenn Ihr Euch Licht von hinten oder seitlich wünscht, wählen wir die Uhrzeit und die Blickrichtung entsprechend. Ein Septembernachmittag ist dabei anders zu planen als ein Termin im Juni.</p><p>Tragt Kleidung, in der Ihr Euch auch beim Gehen und Sitzen wohlfühlt. Auf den Promenaden wechseln sich Pflaster, Stufen und glatte Beläge ab. Für die Auswahl Eurer Outfits könnt Ihr mir vorab Fotos schicken; dann schauen wir gemeinsam, was zu den Backsteinfassaden der Speicherstadt oder den helleren Gebäuden der HafenCity passt.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[5]]} galleryId="domenic-liza-06" label="HafenCity – Paarshooting am Elbufer" />

          <section class="story-copy" aria-labelledby="erinnerung-title">
            <div><p class="eyebrow">Treppen &amp; Holzdecks</p><h3 id="erinnerung-title">Paarfotos an den Marco-Polo-Terrassen</h3></div>
            <div class="copy"><p>Die Marco-Polo-Terrassen in Hamburg liegen am Grasbrookhafen. Mit Holzdecks, Stufen und Bäumen bieten sie auch Plätze für Paarfotos im Sitzen. Wenn Ihr Euch einen Termin mit kurzen Wegen wünscht, können wir die Terrassen mit der angrenzenden Promenade am Hübenerkai verbinden.</p><p>Auch für ein <a href="/gallery/lovebirds-am-elbstrand/">Verlobungsshooting in Hamburg</a> kommen diese Orte infrage. Schreibt mir, welche Location Euch gefällt, wann Ihr Zeit habt und ob Ihr Speicherstadt und HafenCity kombinieren möchtet. Dann besprechen wir die passende Strecke und Tageszeit für Euer Paarshooting.</p><a class="text-link" href="/kontakt/">Paarshooting in Hamburg anfragen <span aria-hidden="true">→</span></a></div>
          </section>
          <GalleryImageGrid columns={[groups[6]]} galleryId="domenic-liza-07" label="HafenCity – Marco-Polo-Terrassen" />
        </section>

        <section id="kehrwiederspitze" class="chapter" aria-labelledby="kehrwiederspitze-title">
          <header class="story-copy story-copy--chapter">
            <div><p class="eyebrow">03 / Kehrwiederspitze</p><h2 id="kehrwiederspitze-title">Paarshooting mit Blick auf die Elbphilharmonie</h2></div>
            <div class="copy"><p>Die Kehrwiederspitze am westlichen Ende der Speicherstadt eignet sich für Euch, wenn Ihr Wasser und die Elbphilharmonie Hamburg auf Euren Paarfotos möchtet. Vom Sandtorkai aus lässt sich dieser Bereich mit einem Shooting in der HafenCity verbinden. Wir können hier zur Elbphilharmonie fotografieren oder den Blick über den Hafen als Hintergrund wählen.</p><p>Für Eure Anreise kommt die U-Bahn-Station Baumwall infrage. Seit 2026 werden die Kaimauern an der Kehrwiederspitze saniert, mit Änderungen an der Wegeführung. Den genauen Treffpunkt und die zugänglichen Fotoplätze stimmen wir deshalb kurz vor Eurem Termin ab.</p><a class="text-link source-link" href="https://www.hamburg.de/politik-und-verwaltung/behoerden/finanzbehoerde/aktuelles/sanierung-der-kaimauern-an-der-kehrwiederspitze-1146216" target="_blank" rel="noopener">Hamburg informiert zur Sanierung und Anreise ↗</a></div>
          </header>
          <GalleryImageGrid columns={[groups[7]]} galleryId="domenic-liza-08" label="Kehrwiederspitze – Paarfotos mit Elbphilharmonie und Hafenblick" />

          <section class="story-copy" aria-labelledby="barkassen-title">
            <div><p class="eyebrow">Auf dem Wasser feiern</p><h3 id="barkassen-title">Barkassenfahrt und Hochzeit im Hamburger Hafen</h3></div>
            <div class="copy"><p>Wenn Ihr nach Eurem Paarshooting eine Barkassenfahrt plant, stimmt die Abfahrtszeit vorher mit dem Fototermin ab. Auch für eine Hochzeitsfeier oder den Transfer Eurer Gäste kommt eine private Fahrt infrage. <a href="https://www.barkassenvermietung-hamburg.com/barkasse-mieten/hochzeiten.html" target="_blank" rel="noopener">Barkassenbetrieb Bülow</a> nennt die Kehrwiederspitze ausdrücklich als möglichen Ein- und Ausstieg für Hochzeitsfahrten. <a href="https://www.barkassen-meyer.de/schiff-charter/trauungen-hochzeiten" target="_blank" rel="noopener">Barkassen-Meyer</a> bietet ebenfalls Hochzeitsfeiern und Fahrten zur Hochzeitslocation an; den Anleger vereinbart Ihr mit der Reederei.</p><p>Gebt bei Eurer Anfrage die Gästezahl, den gewünschten Einstieg und die Fahrtdauer an. Wenn Eure Paarfotos vor dem Ablegen entstehen sollen, planen wir Zeit für den Weg zum Schiff mit ein. Klärt mit dem Anbieter auch, ob Eure gewünschte Route durch die Fleete der Speicherstadt beim Wasserstand an Eurem Termin möglich ist.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[8]]} galleryId="domenic-liza-09" label="Kehrwiederspitze – Paarfotos am Hafenufer" />

          <section class="story-copy" aria-labelledby="michel-title">
            <div><p class="eyebrow">Blick zum Binnenhafen</p><h3 id="michel-title">Flussschifferkirche und Michel</h3></div>
            <div class="copy"><p>Die Flussschifferkirche liegt im Binnenhafen an der Hohen Brücke 2. Wenn Ihr Euch eine Trauung auf dem Wasser wünscht, ist das Kirchenschiff eine Adresse für Eure Planung. Der Verein informiert über <a href="https://www.flussschifferkirche.de/de/raumvergabe-amtshandlungen/amtshandlungen" target="_blank" rel="noopener">Hochzeiten an Bord der Flussschifferkirche</a>. Besprecht dort zuerst Euren Termin und den Ablauf; anschließend können wir die Paarfotos in der Umgebung und einen möglichen Barkassentransfer darauf abstimmen.</p><p>Auch der Michel in Hamburg ist von der Kehrwiederspitze aus zu sehen. Der 132 Meter hohe Turm der Hauptkirche St. Michaelis gehört zur Stadtsilhouette. Wenn Ihr ihn auf Euren Paarfotos möchtet, können wir an diesem Teil des Ufers bleiben. Für einen gemeinsamen Ausflug nach dem Shooting findet Ihr auf der <a href="https://www.st-michaelis.de/michel-besuch/bauwerk/turm" target="_blank" rel="noopener">Website des Michel</a> Informationen zum Turmbesuch.</p></div>
          </section>
          <GalleryImageGrid columns={[groups[9]]} galleryId="domenic-liza-10" label="Kehrwiederspitze – Paarfotos mit Flussschifferkirche und Michel" />
        </section>

        <section id="hamburg-entdecken" class="story-copy light-story" aria-labelledby="lichtkunst-title">
          <div><p class="eyebrow">04 / Nach dem Shooting</p><h2 id="lichtkunst-title">Speicherstadt am Abend: Lichtkunst und Patenschaften</h2></div>
          <div class="copy"><p>Wenn Ihr nach Eurem Paarshooting noch in Hamburg bleiben möchtet, lohnt sich ein Spaziergang durch die Speicherstadt am Abend. Die beleuchteten Fassaden lassen sich dann von den Brücken aus ansehen. Die Fotos mit Domenic und Liza entstanden bei Tageslicht. Wünscht Ihr Euch Paarfotos mit der Beleuchtung, planen wir dafür Zeit nach Einbruch der Dunkelheit ein.</p><p>Das Lichtkonzept stammt von Michael Batz. Der Verein Licht-Kunst-Speicherstadt finanzierte die Beleuchtung über viele Jahre durch Beiträge, Spenden und Brückenpatenschaften, unter anderem für die Jungfernbrücke. Seit 2025 trägt die HHLA dauerhaft die Verantwortung für die Fassadenbeleuchtung.</p><p>Wenn Ihr Euch für eine Patenschaft oder andere Unterstützung interessiert, findet Ihr beim Verein die Geschichte der Brückenpaten und einen Kontakt für aktuelle Möglichkeiten.</p><div class="source-links"><a class="text-link" href="https://licht-kunst-speicherstadt.de/vereinsmitglieder-und-paten/" target="_blank" rel="noopener">Licht-Kunst-Speicherstadt: Mitglieder &amp; Patenschaften ↗</a><a class="text-link source-link" href="https://licht-kunst-speicherstadt.de/lichtkunst/" target="_blank" rel="noopener">Das Lichtkonzept der Speicherstadt ↗</a><a class="text-link source-link" href="https://hhla.de/medien/news/detailansicht/zukunft-der-beleuchtung-des-unesco-welterbes-hamburger-speicherstadt-gesichert" target="_blank" rel="noopener">HHLA zur Fassadenbeleuchtung ↗</a></div></div>
        </section>

        <aside class="travel-link" aria-labelledby="travel-title">
          <a href="/gallery/hamburg/" aria-label="Hamburg Fotografie: Travel-Galerie ansehen"><Image src={hamburgTravel} widths={[500, 800, 1200]} sizes="(max-width: 767px) calc(100vw - 48px), 48vw" format="webp" alt="Hamburger Architektur und Spiegelungen im Wasser zur blauen Stunde" loading="lazy" /></a>
          <div><p class="eyebrow">Hamburg Fotografie · Travel</p><h2 id="travel-title">Weitere Fotoorte in Hamburg</h2><p>Wenn Ihr für Euer Paarshooting noch zwischen mehreren Hamburger Orten überlegt, schaut auch in meine Hamburg-Travel-Galerie. Dort findet Ihr Stadt- und Hafenansichten sowie Architektur bei Tages- und Abendlicht. Schickt mir gern den Link zu einem Motiv, dessen Umgebung Euch für Eure Paarfotos gefällt.</p><a class="text-link" href="/gallery/hamburg/">Hamburg-Fotografie ansehen <span aria-hidden="true">→</span></a></div>
        </aside>
        <nav class="related-links" aria-label="Weitere Paarshootings und Portfolio"><a href="/gallery/lovebirds-am-elbstrand/">Paarshooting am Elbstrand</a><a href="/gallery/paarshooting-mallorca/">Paarshooting auf Mallorca</a><a href="/portfolio/">Zurück zum Portfolio</a></nav>
      </article>
    </main>
    <footer class="gallery-footer"><a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite"><img src="/images/logo-artbild-black.png" width="1200" height="480" alt="Artbild Fotografie" loading="lazy" /></a><nav aria-label="Footer"><a href="/kontakt/">Kontakt</a><a href="/blog/">Blog</a><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutzerklärung</a></nav><p>Copyright York Augustin. Alle Rechte vorbehalten.</p></footer>
  </body>
</html>

<style>
  :global(.couple-hamburg-page) { background: #fff; color: #30333b; }
  .skip-link { position: fixed; top: -100px; left: 24px; z-index: 1000; padding: 14px; background: #fff; }
  .skip-link:focus { top: 16px; }
  .couple-story { padding-top: clamp(40px, 5vw, 80px); }
  .couple-hero { width: min(1240px, calc(100% - 80px)); margin: 0 auto 100px; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(48px, 7vw, 100px); align-items: center; }
  .handwritten { font: clamp(54px, 5.5vw, 88px)/1.15 "Bestermind", Georgia, serif; margin: 0 0 32px; }
  .eyebrow { font: 600 10px/1.7 "Raleway", Arial, sans-serif; letter-spacing: .19em; text-transform: uppercase; color: #7b6555; margin: 0 0 20px; }
  h1, h2, h3 { font-family: "Gilda Display", Georgia, serif; font-weight: 400; margin: 0; }
