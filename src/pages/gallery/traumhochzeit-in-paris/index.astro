---
import FaviconHead from "../../../components/FaviconHead.astro";
import "../../../styles/global.css";
import MobileNavigation from "../../../components/MobileNavigation.astro";
import DesktopNavigation from "../../../components/DesktopNavigation.astro";
import StoryLanguageCta from "../../../components/StoryLanguageCta.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import GalleryImageGrid from "../../../components/GalleryImageGrid.astro";
import EditorialReviewQuote from "../../../components/EditorialReviewQuote.astro";
import { googleReviews } from "../../../data/reviews";

const imageModules = import.meta.glob(
  "../../../assets/traumhochzeit-paris-2019/*.jpg",
  { eager: true, import: "default" },
) as Record<string, ImageMetadata>;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://artbild-fotografie.de";
const pagePath = "/gallery/traumhochzeit-in-paris/";
const pageUrl = `${siteUrl}${pagePath}`;
const heading = "Traumhochzeit in Paris";
const title = "Traumhochzeit in Paris | Hochzeitsfotografie Artbild-Fotografie";
const description =
  "Editoriale Hochzeitsfotografie in Paris: Brautportrait, Destination Wedding Inspiration und moderne Hochzeitsbilder mit französischem Stadtgefühl.";

const altByFile: Record<string, string> = {
  "ART_3680-Bearbeitet-Wiederhergestellt_web.jpg":
    "Brautportrait bei einer editorialen Traumhochzeit in Paris",
  "ART_4059_web.jpg":
    "Braut in Paris mit elegantem editorialem Hochzeitslook",
  "ART_4447-Bearbeitet_web.jpg":
    "Braut mit kurzem Kleid bei einem stilvollen Paris Fotoshooting",
  "ART_4661-Bearbeitet_web.jpg":
    "Braut beim Destination Wedding Shooting mit Pariser Stadtgefühl",
  "ART_4661-Bearbeitet_web_1.jpg":
    "Moderne Braut in Paris vor heller Architektur",
  "ART_5057-Bearbeitet_web.jpg":
    "Braut beim modernen Hochzeitsfotoshooting auf einer Straße in Paris",
  "ART_5057-Bearbeitet_web_1.jpg":
    "Braut beim modernen Hochzeitsfotoshooting auf einer Straße in Paris",
  "ART_5093_web.jpg":
    "Braut in Paris mit kurzem Hochzeitskleid und klassischer Stadtkulisse",
  "ART_5093_web_1.jpg":
    "Braut in Paris mit kurzem Hochzeitskleid und klassischer Stadtkulisse",
  "ART_5111-Bearbeitet_web.jpg":
    "Brautportrait in Paris mit moderner Hochzeitsbildsprache",
  "ART_5851_web.jpg":
    "Editoriales Brautbild in einer Pariser Straße",
  "ART_5992-Bearbeitet_web.jpg":
    "Brautportrait mit französischer Leichtigkeit bei einer Traumhochzeit in Paris",
  "ART_6065-Bearbeitet_web.jpg":
    "Editoriales Hochzeitsportrait einer Braut in Paris",
  "ART_6078-Bearbeitet_web.jpg":
    "Braut in Paris mit urbaner Destination-Wedding-Stimmung",
  "ART_6080-Bearbeitet_web.jpg":
    "Brautportrait in Paris mit elegantem kurzen Hochzeitskleid",
  "ART_6329-Bearbeitet_web.jpg":
    "Hochzeitsfoto einer Braut in Paris mit urbaner Eleganz",
  "ART_6601-Bearbeitet_web.jpg":
    "Braut in Paris mit editorialer Destination-Wedding-Atmosphäre",
  "ART_6874-Bearbeitet_web.jpg":
    "Modernes Brautportrait in Paris mit französischem Stadtlicht",
  "ART_6929-Bearbeitet_web.jpg":
    "Brautportrait in Paris mit eleganter Pose",
  "ART_7009-Bearbeitet_web.jpg":
    "Editoriales Brautportrait in Paris mit moderner Bildsprache",
};

const modulesByFile = Object.fromEntries(
  Object.entries(imageModules).map(([path, image]) => [
    path.split("/").pop() ?? path,
    image,
  ]),
) as Record<string, ImageMetadata>;

const preferredFiles = [
  "ART_5851_web.jpg",
  "ART_3680-Bearbeitet-Wiederhergestellt_web.jpg",
  "ART_4059_web.jpg",
  "ART_4447-Bearbeitet_web.jpg",
  "ART_4661-Bearbeitet_web.jpg",
  "ART_4661-Bearbeitet_web_1.jpg",
  "ART_5057-Bearbeitet_web.jpg",
  "ART_5057-Bearbeitet_web_1.jpg",
  "ART_5093_web.jpg",
  "ART_5093_web_1.jpg",
  "ART_5111-Bearbeitet_web.jpg",
  "ART_5992-Bearbeitet_web.jpg",
  "ART_6065-Bearbeitet_web.jpg",
  "ART_6078-Bearbeitet_web.jpg",
  "ART_6080-Bearbeitet_web.jpg",
  "ART_6329-Bearbeitet_web.jpg",
  "ART_6601-Bearbeitet_web.jpg",
  "ART_6874-Bearbeitet_web.jpg",
  "ART_6929-Bearbeitet_web.jpg",
  "ART_7009-Bearbeitet_web.jpg",
];

const galleryFiles = [
  ...preferredFiles.filter((file) => modulesByFile[file]),
  ...Object.keys(modulesByFile)
    .filter((file) => !preferredFiles.includes(file))
    .sort((a, b) => a.localeCompare(b, "de")),
];

const galleryImages = galleryFiles.map((file, index) => ({
  id: file.replace(/\.(jpe?g)$/i, ""),
  image: modulesByFile[file],
  alt:
    altByFile[file] ??
    `Hochzeitsfoto aus der Paris-Galerie von Artbild-Fotografie, Bild ${index + 1}`,
  aspect:
    modulesByFile[file].width > modulesByFile[file].height
      ? "landscape" as const
      : "portrait" as const,
  eager: index < 2,
}));

const galleryColumns = [galleryImages];

const previewImageFile = "ART_5851_web.jpg";
const primaryGalleryImage = modulesByFile[previewImageFile] ?? galleryImages[0].image;
const primaryGalleryAlt = altByFile[previewImageFile] ?? galleryImages[0].alt;
const primaryImage = new URL(primaryGalleryImage.src, siteUrl).href;
const parisPlace = {
  "@type": "City",
  "@id": `${pageUrl}#paris`,
  name: "Paris",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Paris",
    addressCountry: "FR",
  },
  containedInPlace: {
    "@type": "Country",
    name: "Frankreich",
  },
};


const breadcrumbs = [
  { label: "Startseite", href: "/" },
  { label: "Hochzeitsportfolio", href: "/portfolio/" },
  { label: heading, href: pagePath },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${pageUrl}#article`,
      headline: heading,
      name: title,
      description,
      keywords: [
        "Traumhochzeit Paris",
        "Destination Wedding Paris",
        "Hochzeitsfotografie Paris",
        "Braut Fotoshooting Paris",
        "Hochzeitsfotograf Hamburg Destination Wedding",
      ],
      datePublished: "2019-07-05T12:52:02+02:00",
      dateModified: "2026-07-09T15:45:00+02:00",
      author: {
        "@type": "Person",
        name: "York Augustin",
      },
      publisher: {
        "@id": `${siteUrl}/#organization`,
      },
      image: primaryImage,
      mainEntityOfPage: {
        "@id": `${pageUrl}#webpage`,
      },
      contentLocation: {
        "@id": `${pageUrl}#paris`,
      },
      inLanguage: "de",
    },
    {
      "@type": "ImageGallery",
      "@id": `${pageUrl}#gallery`,
      name: "Traumhochzeit in Paris",
      description,
      contentLocation: {
        "@id": `${pageUrl}#paris`,
      },
      image: galleryImages.map((item, index) => ({
        "@type": "ImageObject",
        position: index + 1,
        caption: item.alt,
        contentUrl: new URL(item.image.src, siteUrl).href,
        width: item.image.width,
        height: item.image.height,
      })),
    },
    parisPlace,
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      datePublished: "2019-07-05T12:52:02+02:00",
      dateModified: "2026-07-07T16:55:00+02:00",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: primaryImage,
        width: primaryGalleryImage.width,
        height: primaryGalleryImage.height,
        caption: primaryGalleryAlt,
      },
      breadcrumb: {
        "@id": `${pageUrl}#breadcrumb`,
      },
      inLanguage: "de",
    },
  ],
};
---

<!doctype html>
<html lang="de">
<head>
  <FaviconHead />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
  <link rel="canonical" href={pageUrl}>
  <meta property="og:locale" content="de_DE">
  <meta property="og:type" content="article">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="Artbild-Fotografie">
  <meta property="article:published_time" content="2019-07-05T12:52:02+02:00">
  <meta property="article:modified_time" content="2026-07-07T16:55:00+02:00">
  <meta property="og:image" content={primaryImage}>
  <meta property="og:image:width" content={primaryGalleryImage.width}>
  <meta property="og:image:height" content={primaryGalleryImage.height}>
  <meta property="og:image:alt" content={primaryGalleryAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={primaryImage}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
</head>
<body class="gallery-template paris-gallery-page">
  <header class="gallery-header">
    <MobileNavigation />
    <DesktopNavigation />
  </header>

  <main>
      <Breadcrumbs items={breadcrumbs} currentUrl={pageUrl} />
    <article class="paris-gallery">
      <header class="paris-hero">
        <p class="paris-hero__script" aria-hidden="true">Paris</p>
        <p class="paris-hero__kicker">Destination Wedding · Frankreich</p>
        <h1>{heading}</h1>
        <p>
          Ein editoriales Brautshooting in Paris: leicht, modern und mit jener
          eleganten Stadtstimmung, die Hochzeitsbilder sofort nach Reise,
          Freiheit und großer Liebe aussehen lässt.
        </p>
      </header>

      <section class="paris-story" aria-labelledby="paris-story-title">
        <div class="paris-story__heading">
          <p>Editoriale Hochzeitsfotografie</p>
          <h2 id="paris-story-title">Brautportrait, Stadtraum und französische Leichtigkeit</h2>
        </div>
        <div class="paris-story__copy">
          <div>
            <h3>Destination Feeling</h3>
            <p>
              Paris eignet sich für Hochzeitsbilder, die nicht inszeniert
              wirken müssen. Straßen, Architektur und Licht erzählen bereits
              viel von der Atmosphäre einer Reise.
            </p>
          </div>
          <div>
            <h3>Editorialer Look</h3>
            <p>
              Kurze Kleider, klare Linien und natürliche Bewegung geben den
              Bildern eine moderne, magazinartige Ruhe statt klassischer
              Posen.
            </p>
          </div>
          <div>
            <h3>Für Paare aus Hamburg</h3>
            <p>
              Artbild-Fotografie begleitet Hochzeiten und Paarshootings in
              Hamburg und als Destination Wedding auch an europäischen Orten
              wie Paris.
            </p>
          </div>
        </div>
      </section>

      <GalleryImageGrid
        columns={galleryColumns}
        galleryId="traumhochzeit-paris"
        label="Traumhochzeit in Paris mit Brautportrait und Destination Wedding Bildern"
        dialogLabel="Traumhochzeit in Paris in Vollansicht"
      />

      <EditorialReviewQuote
        reviews={[
          googleReviews.kristin,
          googleReviews.heikeLupkeBoettiger,
          googleReviews.gunnarJabadabaich,
        ]}
        sectionId="paris_review_kristin"
        heading="Ein entspanntes Fotoshooting in Paris"
        contentTopic="fotoshooting_paris"
        userIntent="destination_erfahrung_pruefen"
        journeyStage="auswahl"
        position="after_gallery"
      />

      <aside class="paris-meta" aria-label="Galeriethemen">
        <span>Themen:</span>
        <a href="/gallery-tag/paris/">Paris</a>
        <a href="/gallery-tag/destination-wedding/">Destination Wedding</a>
        <a href="/gallery-tag/braut/">Brautportrait</a>
        <a href="/gallery-tag/hochzeit/">Hochzeit</a>
      </aside>

      <section class="paris-service" aria-labelledby="paris-service-title">
        <div>
          <p class="paris-service__kicker">Hochzeitsfotografie unterwegs</p>
          <h2 id="paris-service-title">Destination Wedding mit klarer Planung</h2>
        </div>
        <div>
          <p>
            Für Hochzeiten außerhalb Hamburgs sind Zeitplan, Reisewege und
            Lichtfenster besonders wichtig. Die fotografische Begleitung wird
            deshalb vorab ruhig geplant, damit vor Ort Raum für echte Bilder
            bleibt.
          </p>
          <p>
            Ob Paris, Mallorca oder Norddeutschland: Entscheidend ist eine
            Bildsprache, die den Ort spürbar macht und trotzdem bei Euch bleibt.
          </p>
          <div class="paris-service__actions">
            <a href="/portfolio/">Weitere Galerien ansehen</a>
            <a class="is-primary" href="/kontakt/">Destination Wedding anfragen</a>
          </div>
        </div>
      </section>

      <nav class="paris-related" aria-label="Weitere Destination- und Hochzeitsgalerien">
        <a href="/gallery/paarshooting-mallorca/">
          <span>Mallorca</span>
          Paarshooting Mallorca
        </a>
        <a href="/brautpaar-in-zuerich/">
          <span>Zürich</span>
          Brautpaar in Zürich
        </a>
        <a href="/gallery/traumhochzeit-in-hamburg/">
          <span>Hamburg</span>
          Traumhochzeit in Hamburg
        </a>
      </nav>
    </article>
      <StoryLanguageCta kind="editorial" />
    </main>

  <footer class="gallery-footer">
    <a class="gallery-logo" href="/" aria-label="Artbild-Fotografie Startseite">
      <img src="/images/logo-artbild-black.png" width="1200" height="480" alt="Artbild Fotografie">
    </a>
    <nav aria-label="Footer">
      <a href="/kontakt/">Kontakt</a>
      <a href="/blog/">Blog</a>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutzerklärung</a>
    </nav>
    <p>Copyright York Augustin. Alle Rechte vorbehalten.</p>
  </footer>
</body>
</html>

<style>
  .paris-gallery {
    padding-top: clamp(74px, 7.4vw, 104px);
  }

  .paris-hero {
    width: min(1050px, calc(100% - 44px));
    margin: 0 auto;
    text-align: center;
  }

  .paris-hero__script {
    margin: 0;
    color: #30333b;
    font-family: "Bestermind", "Playfair Display", Georgia, serif;
    font-size: clamp(46px, 6vw, 86px);
    line-height: 1;
  }

  .paris-hero__kicker,
  .paris-story__heading p,
  .paris-service__kicker {
    color: #8d6e5a;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .paris-hero__kicker {
    margin: clamp(66px, 6.4vw, 94px) 0 0;
  }

  .paris-hero h1 {
    margin: 20px 0 0;
    color: #282b34;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(46px, 5.8vw, 82px);
    font-weight: 400;
    line-height: 1.08;
  }

  .paris-hero > p:last-child {
    width: min(780px, 100%);
    margin: 30px auto 0;
    color: #69635e;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.68;
  }

  .paris-story {
    width: min(1220px, calc(100% - 92px));
    margin: clamp(92px, 9vw, 138px) auto 0;
    padding: clamp(68px, 7vw, 102px) clamp(34px, 6vw, 86px);
    background: #f4f0ed;
  }

  .paris-story__heading {
    width: min(820px, 100%);
  }

  .paris-story__heading p,
  .paris-service__kicker {
    margin: 0;
  }

  .paris-story h2,
  .paris-service h2 {
    margin: 20px 0 0;
    color: #292c35;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(34px, 4.2vw, 58px);
    font-weight: 400;
    line-height: 1.15;
  }

  .paris-story__copy {
    margin-top: clamp(50px, 6vw, 78px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(30px, 4vw, 60px);
  }

  .paris-story h3 {
    margin: 0 0 18px;
    color: #292c35;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(23px, 2.2vw, 31px);
    font-weight: 400;
    line-height: 1.2;
  }

  .paris-story__copy p,
  .paris-service > div:last-child > p {
    margin: 0;
    color: #69635e;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.7;
  }

  .paris-meta {
    width: min(1170px, calc(100% - 48px));
    margin: 46px auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding-top: 24px;
    border-top: 1px solid #dedad4;
    color: #706b65;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .paris-meta a {
    color: #2f323c;
    text-decoration: none;
  }

  .paris-service {
    width: min(1110px, calc(100% - 48px));
    margin: clamp(100px, 10vw, 150px) auto;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(46px, 8vw, 110px);
    align-items: start;
  }

  .paris-service > div:last-child {
    padding-top: 8px;
  }

  .paris-service > div:last-child > p + p {
    margin-top: 22px;
  }

  .paris-service__actions {
    margin-top: 38px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .paris-service__actions a {
    min-height: 50px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #2c3039;
    color: #2c3039;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .paris-service__actions a.is-primary {
    background: #2c3039;
    color: #fff;
  }

  .paris-related {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto clamp(100px, 10vw, 150px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid #dedad4;
  }

  .paris-related a {
    min-height: 180px;
    padding: 34px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #292c35;
    font-family: "Gilda Display", "Playfair Display", Georgia, serif;
    font-size: clamp(20px, 2vw, 27px);
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
  }

  .paris-related a + a {
    border-left: 1px solid #dedad4;
  }

  .paris-related span {
    margin-bottom: 14px;
    color: #8d6e5a;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .paris-related a:hover,
  .paris-related a:focus-visible {
    background: #f4f0ed;
  }

  .paris-meta a:focus-visible,
  .paris-service a:focus-visible,
  .paris-related a:focus-visible {
    outline: 2px solid #8d6e5a;
    outline-offset: 4px;
  }

  @media (max-width: 880px) {
    .paris-story__copy,
    .paris-service {
      grid-template-columns: 1fr;
    }

    .paris-story__copy div,
    .paris-service > div {
      max-width: 690px;
    }
  }

  @media (max-width: 620px) {
    .paris-gallery {
      padding-top: 48px;
    }

    .paris-hero {
      width: min(100% - 28px, 520px);
    }

    .paris-hero__kicker {
      margin-top: 54px;
    }

    .paris-story {
      width: min(100% - 24px, 560px);
      margin-top: 72px;
      padding: 54px 22px;
    }

    .paris-meta,
    .paris-service,
    .paris-related {
      width: min(100% - 28px, 560px);
    }

    .paris-service__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .paris-related {
      grid-template-columns: 1fr;
    }

    .paris-related a {
      min-height: 138px;
    }

    .paris-related a + a {
      border-top: 1px solid #dedad4;
      border-left: 0;
    }
  }
</style>
