---
import { trackingConfig } from "../config/tracking";
const openaiAdsConfigured = trackingConfig.openaiAdsConfigured;
const allowed = (name: string) => trackingConfig.providerRelease[name] === true
  && (name === "openaiAds" ? openaiAdsConfigured : name === "googleAds" ? trackingConfig.googleAdsConfigured : name === "microsoftClarity" ? Boolean(trackingConfig.clarityProjectId) : name === "metaPixel" ? Boolean(trackingConfig.metaPixelId) : trackingConfig.googleTrackingConfigured);
const anyAvailable = Object.keys(trackingConfig.providerRelease).some(allowed);
---

<dialog
  class="consent-dialog"
  data-consent-dialog
  data-consent-available={anyAvailable ? "true" : "false"}
  aria-modal="true"
  aria-labelledby="consent-title"
  aria-describedby="consent-summary"
>
  <div class="consent-dialog__shell">
    <button
      class="consent-dialog__close"
      type="button"
      aria-label="Nur notwendige auswählen und schließen"
      data-consent-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 5 19 19M19 5 5 19"></path>
      </svg>
    </button>

    <div class="consent-dialog__intro" data-consent-intro>
      <img
        class="consent-dialog__logo"
        src="/images/logo-artbild-black.png"
        alt="Artbild Fotografie"
        width="1200"
        height="480"
        decoding="async"
      >
      <h2 id="consent-title" tabindex="-1">COOKIE-EINSTELLUNGEN</h2>
      <p id="consent-summary">
        {!anyAvailable ? <>Die optionalen Statistik- und Werbedienste sind derzeit deaktiviert. Es werden keine dieser Messdienste geladen. Technisch notwendige Funktionen wie das Kontaktformular stehen euch weiterhin zur Verfügung.</> : openaiAdsConfigured ? <>
          Mit Zustimmung nutzen wir Google Analytics und Microsoft Clarity zur Nutzungsanalyse, Google Ads zur Anzeigenmessung. Meta Pixel dient der Anzeigenmessung und personalisierter Werbung. OpenAI misst Anzeigen in ChatGPT. Daten können auch in den USA verarbeitet werden.
          OpenAI misst nur erfolgreich gesendete Anfragen und erhält keine Formularinhalte.
          Eure OpenAI-Auswahl widerspricht persönlicher Werbenutzung dieser Daten.
        </> : <>
          Schön, dass Du da bist. Mit Deiner Zustimmung nutzen wir optionale
          Dienste: Google Analytics und Microsoft Clarity zur Nutzungsanalyse, Google Ads zur Anzeigenmessung. Meta Pixel dient der Anzeigenmessung und personalisierter Werbung. Dabei können Daten durch Google, Microsoft und Meta auch in
          den USA verarbeitet werden.
        </>} Eure Auswahl könnt ihr jederzeit ändern.
      </p>
    </div>

    <div class="consent-dialog__quick-actions" data-consent-quick-actions>
      <div class="consent-dialog__decision-actions">
        <button type="button" data-consent-choice="all">ALLE AKZEPTIEREN</button>
        <button type="button" data-consent-choice="necessary">NUR NOTWENDIGE</button>
      </div>
      <button
        class="consent-dialog__customize"
        type="button"
        data-consent-customize
      >EINSTELLUNGEN</button>
    </div>

    <section
      class="consent-dialog__details"
      aria-labelledby="consent-details-title"
      data-consent-details
      hidden
    >
      <div class="consent-dialog__details-heading">
        <button
          class="consent-dialog__back"
          type="button"
          aria-label="Zur kompakten Ansicht zurückkehren"
          data-consent-back
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m14.5 5-7 7 7 7"></path>
          </svg>
          <span>ZURÜCK</span>
        </button>
        <h3 id="consent-details-title" tabindex="-1">INDIVIDUELLE EINSTELLUNGEN</h3>
      </div>

      <article class="consent-card">
        <div class="consent-card__heading">
          <div>
            <h4>Notwendig</h4>
            <p class="consent-card__status">Immer aktiv</p>
          </div>
          <label class="consent-switch">
            <span class="visually-hidden">Notwendige Funktionen sind immer aktiv</span>
            <input type="checkbox" checked disabled>
            <span aria-hidden="true"></span>
          </label>
        </div>
        <p>Speichert eure Datenschutz-Auswahl für 180 Tage.</p>
        <p class="consent-card__cookie">
          <strong>First-Party-Cookie:</strong> <code>artbild_consent</code>
        </p>
      </article>

      <article class="consent-card">
        <div class="consent-card__heading">
          <div>
            <h4>Statistik</h4>
            <p class="consent-card__status">Google Analytics und Microsoft Clarity</p>
          </div>
          <label class="consent-switch">
            <span class="visually-hidden">Statistik erlauben</span>
            <input type="checkbox" data-consent-group="statistics">
            <span aria-hidden="true"></span>
          </label>
        </div>
        <p>Hilft uns zu verstehen, wie unsere Website genutzt wird.</p>

        <details class="consent-card__details">
          <summary>DETAILS ANZEIGEN</summary>
          <div class="consent-card__details-body">
            <section class="consent-service-choice">
              <div class="consent-service-choice__heading">
                <h5>Google Analytics{!allowed("googleAnalytics") && " · derzeit deaktiviert"}</h5>
                <label class="consent-switch consent-switch--service">
                  <span class="visually-hidden">Google Analytics erlauben</span>
                  <input type="checkbox" data-consent-service="googleAnalytics" disabled={!allowed("googleAnalytics")}>
                  <span aria-hidden="true"></span>
                </label>
              </div>
              <p><strong>Zweck:</strong> Reichweitenmessung und Auswertung ausgewählter Interaktionen.</p>
              <p><strong>Cookies:</strong> <code>_ga</code> und <code>_ga_*</code> · höchstens 180 Tage.</p>
            </section>

            <section class="consent-service-choice">
              <div class="consent-service-choice__heading">
                <h5>Microsoft Clarity{!allowed("microsoftClarity") && " · derzeit deaktiviert"}</h5>
                <label class="consent-switch consent-switch--service">
                  <span class="visually-hidden">Microsoft Clarity erlauben</span>
                  <input type="checkbox" data-consent-service="microsoftClarity" disabled={!allowed("microsoftClarity")}>
                  <span aria-hidden="true"></span>
                </label>
              </div>
              <p><strong>Zweck:</strong> Heatmaps, technische Sitzungswiedergaben und Analyse der Bedienbarkeit.</p>
              <p><strong>First-Party-Cookies:</strong> <code>_clck</code> · bis zu 1 Jahr; <code>_clsk</code> · bis zu 1 Tag.</p>
              <p>
                <strong>Mögliche Third-Party-Cookies:</strong>
                <code>CLID</code>, <code>ANONCHK</code>, <code>MR</code>,
                <code>MUID</code> und <code>SM</code>. Für diese nennt Microsoft
                keine festen Laufzeiten; sie richten sich nach Microsoft sowie
                den Browser- und Cookie-Einstellungen.
              </p>
            </section>
          </div>
        </details>
      </article>

      <article class="consent-card">
        <div class="consent-card__heading">
          <div>
            <h4>Marketing</h4>
            <p class="consent-card__status">Google Ads, Meta Pixel und OpenAI Ads</p>
          </div>
          <label class="consent-switch">
            <span class="visually-hidden">Marketing erlauben</span>
            <input
              type="checkbox"
              data-consent-group="marketing"
            >
            <span aria-hidden="true"></span>
          </label>
        </div>
        <p>Misst Kontaktaktionen und unterstützt die Ausspielung relevanter Werbung.</p>

        <details class="consent-card__details">
          <summary>DETAILS ANZEIGEN</summary>
          <div class="consent-card__details-body">
            <section class="consent-service-choice">
              <div class="consent-service-choice__heading">
                <h5>Google Ads{!allowed("googleAds") && " · derzeit deaktiviert"}</h5>
                <label class="consent-switch consent-switch--service">
                  <span class="visually-hidden">Google Ads erlauben</span>
                  <input type="checkbox" data-consent-service="googleAds" disabled={!allowed("googleAds")}>
                  <span aria-hidden="true"></span>
                </label>
              </div>
              <p><strong>Anbieter:</strong> Google Ireland Limited.</p>
              <p><strong>Zweck:</strong> Erfolgreich gesendete Kontaktanfragen Google-Anzeigen zuordnen. Keine personalisierte Google-Werbung.</p>
              <p><strong>Cookies:</strong> <code>_gcl_*</code> · höchstens 90 Tage. Anzeigenkennung, bereinigte Seitenadresse und technische Verbindungsdaten werden für die Messung verwendet.</p>
              <p><a href="/datenschutz/#google-ads">Weitere Informationen zu Google Ads</a></p>
            </section>
            <section class="consent-service-choice">
              <div class="consent-service-choice__heading">
                <h5>Meta Pixel{!allowed("metaPixel") && " · derzeit deaktiviert"}</h5>
                <label class="consent-switch consent-switch--service">
                  <span class="visually-hidden">Meta Pixel erlauben</span>
                  <input type="checkbox" data-consent-service="metaPixel" disabled={!allowed("metaPixel")}>
                  <span aria-hidden="true"></span>
                </label>
              </div>
              <p><strong>Anbieter:</strong> Meta Platforms Ireland Limited.</p>
              <p><strong>Zweck:</strong> Messung von Seitenaufrufen, Kontaktaktionen und erfolgreichen Anfragen; Zielgruppenbildung und Remarketing.</p>
              <p>Keine Formularinhalte und kein erweiterter Datenabgleich. Nach eurer Meta-Einwilligung nutzen wir die eigenen Cookies _fbp (Browserkennung) und _fbc (Anzeigenklickkennung, falls vorhanden) für bis zu 90 Tage; bei weiterer Nutzung kann diese Laufzeit erneuert werden. Beim Widerruf entfernen wir diese Cookies. Meta kann auch vorhandene Cookies auf seinen eigenen Domains nutzen, soweit euer Browser dies erlaubt.</p>
              <p><a href="/datenschutz/#meta-pixel">Weitere Informationen zu Meta Pixel</a></p>
            </section>
            {<section class="consent-service-choice">
              <div class="consent-service-choice__heading">
                <h5>OpenAI Ads{!allowed("openaiAds") && " · derzeit deaktiviert"}</h5>
                <label class="consent-switch consent-switch--service">
                  <span class="visually-hidden">OpenAI Ads erlauben</span>
                  <input type="checkbox" data-consent-service="openaiAds" disabled={!allowed("openaiAds")}>
                  <span aria-hidden="true"></span>
                </label>
              </div>
              <p><strong>Anbieter:</strong> OpenAI Ireland Ltd. und verbundene Unternehmen.</p>
              <p><strong>Zweck:</strong> Erfolgreich gesendete Kontaktanfragen Anzeigen in ChatGPT zuordnen.</p>
              <p><strong>Eure Auswahl:</strong> Mit der Aktivierung erlaubt ihr diese Messung und widersprecht einer Verwendung dieser Messdaten für künftige persönlich zugeschnittene Werbung. Diesen Widerspruch übermitteln wir mit jedem Ereignis an OpenAI.</p>
              <p><strong>Weitere Daten:</strong> Anzeigenkennung, Zeitpunkt des erfolgreichen Absendens sowie technische Verbindungsdaten. Einzelheiten stehen in der Datenschutzerklärung.</p>
              <p><strong>First-Party-Cookies:</strong> <code>__oppref</code> · bis zu 30 Tage für die Anzeigenzuordnung. Die OpenAI-Messung speichert keine dauerhafte Browserkennung.</p>
              <p>Die Auswahl ist unabhängig von Meta und Statistik. Bei Widerruf stoppen wir das Tracking und entfernen die genannten Kennungen.</p>
              <p><a href="/datenschutz/#openai-ads">Weitere Informationen zu OpenAI Ads</a></p>
            </section>}
          </div>
        </details>
      </article>

      <div class="consent-dialog__save-actions">
        <button type="button" data-consent-save>AUSWAHL SPEICHERN</button>
        <button type="button" data-consent-choice="necessary">ALLE ABLEHNEN</button>
        <button type="button" data-consent-choice="all">ALLE AKZEPTIEREN</button>
      </div>
    </section>

    <nav class="consent-dialog__legal" aria-label="Rechtliche Informationen">
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/impressum/">Impressum</a>
    </nav>
  </div>
</dialog>

<button
  class="consent-settings-button"
  type="button"
  aria-label="Datenschutz-Einstellungen öffnen"
  title="Datenschutz-Einstellungen"
  data-consent-settings
  hidden
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2.8 19 6v5.3c0 4.6-2.8 8.5-7 10-4.2-1.5-7-5.4-7-10V6l7-3.2Z"></path>
    <path d="M9.4 12.1 11 13.7l3.9-4"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-consent-dialog]");
    const settingsButton = document.querySelector("[data-consent-settings]");
    if (!(dialog instanceof HTMLDialogElement) || !(settingsButton instanceof HTMLButtonElement)) {
      return;
    }

    const intro = dialog.querySelector("[data-consent-intro]");
    const details = dialog.querySelector("[data-consent-details]");
    const quickActions = dialog.querySelector("[data-consent-quick-actions]");
    const statisticsInput = dialog.querySelector('[data-consent-group="statistics"]');
    const marketingInput = dialog.querySelector('[data-consent-group="marketing"]');
    const googleAnalyticsInput = dialog.querySelector('[data-consent-service="googleAnalytics"]');
    const microsoftClarityInput = dialog.querySelector('[data-consent-service="microsoftClarity"]');
    const googleAdsInput = dialog.querySelector('[data-consent-service="googleAds"]');
    const metaPixelInput = dialog.querySelector('[data-consent-service="metaPixel"]');
    const openaiAdsInput = dialog.querySelector('[data-consent-service="openaiAds"]');
    const marketingServices = [googleAdsInput, metaPixelInput, openaiAdsInput]
      .filter((input) => input instanceof HTMLInputElement);
    const serviceInputs = [googleAnalyticsInput, microsoftClarityInput, ...marketingServices]
      .filter((input) => input instanceof HTMLInputElement);
    const closeButton = dialog.querySelector("[data-consent-close]");
    const customizeButton = dialog.querySelector("[data-consent-customize]");
    const backButton = dialog.querySelector("[data-consent-back]");
    const saveButton = dialog.querySelector("[data-consent-save]");
    let returnFocus = null;

    const api = () => window.artbildConsentApi;

    const syncGroupsFromServices = () => {
      const googleAnalytics = googleAnalyticsInput instanceof HTMLInputElement
        && googleAnalyticsInput.checked;
      const microsoftClarity = microsoftClarityInput instanceof HTMLInputElement
        && microsoftClarityInput.checked;
      if (statisticsInput instanceof HTMLInputElement) {
        statisticsInput.checked = googleAnalytics && microsoftClarity;
        statisticsInput.indeterminate = googleAnalytics !== microsoftClarity;
      }
      if (marketingInput instanceof HTMLInputElement) {
        marketingInput.checked = marketingServices.every((input) => input.checked);
        marketingInput.indeterminate = marketingServices.some((input) => input.checked)
          && !marketingInput.checked;
      }
    };

    const syncInputs = () => {
      const state = api()?.getState?.() || window.ArtbildConsent || {};
      const services = state.services || {};
      if (googleAnalyticsInput instanceof HTMLInputElement) {
        googleAnalyticsInput.checked = services.googleAnalytics === true
          || (services.googleAnalytics === undefined && state.analytics === true);
      }
      if (microsoftClarityInput instanceof HTMLInputElement) {
        microsoftClarityInput.checked = services.microsoftClarity === true
          || (services.microsoftClarity === undefined && state.clarity === true);
      }
      if (metaPixelInput instanceof HTMLInputElement) {
        metaPixelInput.checked = services.metaPixel === true
          || (services.metaPixel === undefined && state.marketing === true);
      }
      if (googleAdsInput instanceof HTMLInputElement) googleAdsInput.checked = services.googleAds === true;
      if (openaiAdsInput instanceof HTMLInputElement) {
        openaiAdsInput.checked = services.openaiAds === true;
      }
      syncGroupsFromServices();
    };

    const setDetailsVisible = (visible, moveFocus = true) => {
      if (
        !(intro instanceof HTMLElement)
        || !(details instanceof HTMLElement)
        || !(quickActions instanceof HTMLElement)
      ) return;

      intro.hidden = visible;
      details.hidden = !visible;
      quickActions.hidden = visible;
      dialog.dataset.consentView = visible ? "details" : "compact";
      dialog.scrollTop = 0;

      if (!moveFocus) return;
      window.requestAnimationFrame(() => {
        const target = visible
          ? dialog.querySelector("#consent-details-title")
          : dialog.querySelector("#consent-title");
        if (target instanceof HTMLElement) target.focus();
      });
    };

    statisticsInput?.addEventListener("change", () => {
      if (!(statisticsInput instanceof HTMLInputElement)) return;
      if (googleAnalyticsInput instanceof HTMLInputElement) {
        googleAnalyticsInput.checked = !googleAnalyticsInput.disabled && statisticsInput.checked;
      }
      if (microsoftClarityInput instanceof HTMLInputElement) {
        microsoftClarityInput.checked = !microsoftClarityInput.disabled && statisticsInput.checked;
      }
      statisticsInput.indeterminate = false;
    });

    marketingInput?.addEventListener("change", () => {
      if (!(marketingInput instanceof HTMLInputElement)) return;
      marketingServices.forEach((input) => { input.checked = !input.disabled && marketingInput.checked; });
      marketingInput.indeterminate = false;
    });

    serviceInputs.forEach((input) => {
      input.addEventListener("change", syncGroupsFromServices);
    });

    const openDialog = (existingDecision, trigger = null) => {
      if (window.ArtbildConsent?.enabled === false) return;
      if (trigger instanceof HTMLElement) returnFocus = trigger;
      syncInputs();
      setDetailsVisible(existingDecision, false);
      settingsButton.hidden = true;
      document.body.classList.add("has-consent-dialog");
      if (!dialog.open) dialog.showModal();
      dialog.scrollTop = 0;
      const target = existingDecision
        ? dialog.querySelector("#consent-details-title")
        : dialog.querySelector("#consent-title");
      if (target instanceof HTMLElement) target.focus();
    };

    const closeDialog = () => {
      if (!dialog.open) return;
      dialog.close();
      document.body.classList.remove("has-consent-dialog");
      settingsButton.hidden = false;
      const focusTarget = returnFocus instanceof HTMLElement && returnFocus.isConnected
        ? returnFocus
        : settingsButton;
      returnFocus = null;
      focusTarget.focus();
    };

    const save = (state) => {
      api()?.setConsent?.(state);
      closeDialog();
    };

    const saveNecessary = () => {
      save({
        services: {
          googleTagManager: false,
          googleAnalytics: false,
          googleAds: false,
          microsoftClarity: false,
          metaPixel: false,
          openaiAds: false,
        },
      });
    };

    const saveAll = () => {
      save({
        services: {
          googleTagManager: true,
          googleAnalytics: googleAnalyticsInput instanceof HTMLInputElement && !googleAnalyticsInput.disabled,
          googleAds: googleAdsInput instanceof HTMLInputElement && !googleAdsInput.disabled,
          microsoftClarity: microsoftClarityInput instanceof HTMLInputElement && !microsoftClarityInput.disabled,
          metaPixel: metaPixelInput instanceof HTMLInputElement && !metaPixelInput.disabled,
          openaiAds: openaiAdsInput instanceof HTMLInputElement && !openaiAdsInput.disabled,
        },
      });
    };

    dialog.querySelectorAll("[data-consent-choice]").forEach((button) => {
      button.addEventListener("click", () => {
        if (button.getAttribute("data-consent-choice") === "all") {
          saveAll();
        } else {
          saveNecessary();
        }
      });
    });

    customizeButton?.addEventListener("click", () => {
      syncInputs();
      setDetailsVisible(true);
    });

    backButton?.addEventListener("click", () => {
      setDetailsVisible(false, false);
      if (customizeButton instanceof HTMLElement) customizeButton.focus();
    });

    saveButton?.addEventListener("click", () => {
      const googleAnalytics = googleAnalyticsInput instanceof HTMLInputElement
        && googleAnalyticsInput.checked;
      const microsoftClarity = microsoftClarityInput instanceof HTMLInputElement
        && microsoftClarityInput.checked;
      const metaPixel = metaPixelInput instanceof HTMLInputElement && metaPixelInput.checked;
      save({
        services: {
          googleTagManager: false,
          googleAnalytics,
          googleAds: googleAdsInput instanceof HTMLInputElement && googleAdsInput.checked && !googleAdsInput.disabled,
          microsoftClarity,
          metaPixel,
          openaiAds: openaiAdsInput instanceof HTMLInputElement && openaiAdsInput.checked,
        },
      });
    });

    settingsButton.addEventListener("click", () => openDialog(true, settingsButton));
    document.addEventListener("click", (event) => {
      const trigger = event.target instanceof Element
        ? event.target.closest("[data-consent-settings]")
        : null;
      if (!(trigger instanceof HTMLElement) || trigger === settingsButton) return;
      event.preventDefault();
      openDialog(true, trigger);
    });
    closeButton?.addEventListener("click", saveNecessary);

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      saveNecessary();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        saveNecessary();
        return;
      }
      if (event.key !== "Tab") return;

      const focusable = [...dialog.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), summary[tabindex], summary',
      )].filter((element) => (
        element instanceof HTMLElement
        && !element.hidden
        && element.getClientRects().length > 0
      ));
      if (!focusable.length) return;
      // Include the initially focused heading: Safari otherwise lets Shift+Tab
      // escape the dialog before a button has received focus.
      const index = focusable.indexOf(document.activeElement);
      const next = index < 0 ? (event.shiftKey ? focusable.length - 1 : 0)
        : (index + (event.shiftKey ? -1 : 1) + focusable.length) % focusable.length;
      event.preventDefault();
      focusable[next].focus();
    });

    window.addEventListener("artbild:consent_settings_open", () => openDialog(true));

    const initialize = () => {
      if (window.ArtbildConsent?.enabled === false) {
        settingsButton.hidden = true;
        return;
      }
      if (window.ArtbildConsent?.hasDecision) {
        settingsButton.hidden = false;
      } else if (dialog.dataset.consentAvailable === "true") {
        openDialog(false);
      } else {
        settingsButton.hidden = false;
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initialize, { once: true });
    } else {
      initialize();
    }
  })();
</script>

<style>
  .consent-dialog [hidden] {
    display: none;
  }

  .consent-dialog {
    width: min(620px, 92vw);
    max-width: 620px;
    max-height: min(90dvh, 820px);
    padding: 0;
    border: 1px solid rgba(155, 111, 79, .46);
    border-radius: 2px;
    background: #fff;
    color: #171717;
    box-shadow: 0 18px 46px rgba(23, 23, 23, .16);
    overflow-x: hidden;
    overflow-y: auto;
    z-index: 20000;
  }

  .consent-dialog::backdrop {
    background: rgba(23, 23, 23, .58);
  }

  .consent-dialog__shell {
    position: relative;
    padding: clamp(34px, 5vw, 50px);
  }

  .consent-dialog .consent-dialog__close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #171717;
    cursor: pointer;
  }

  .consent-dialog__close svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.7;
  }

  .consent-dialog__intro {
    text-align: center;
  }

  .consent-dialog__logo {
    width: 160px;
    height: auto;
    margin: 0 auto 24px;
  }

  .consent-dialog h2,
  .consent-dialog h3,
  .consent-dialog h4,
  .consent-dialog h5,
  .consent-dialog p,
  .consent-dialog a,
  .consent-dialog button,
  .consent-dialog summary,
  .consent-dialog code {
    font-family: "Playfair Display", Georgia, serif;
  }

  .consent-dialog h2,
  .consent-dialog h3,
  .consent-dialog h4,
  .consent-dialog h5 {
    color: #171717;
    font-weight: 400;
  }

  .consent-dialog h2 {
    margin: 0;
    font-size: clamp(24px, 4vw, 30px);
    letter-spacing: .1em;
    line-height: 1.2;
  }

  .consent-dialog h2:focus,
  .consent-dialog h3:focus {
    outline: none;
  }

  .consent-dialog__intro p {
    max-width: 500px;
    margin: 20px auto 0;
    color: #171717;
    font-size: 17px;
    line-height: 1.58;
  }

  .consent-dialog__quick-actions {
