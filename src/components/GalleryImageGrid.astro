---
import { Image } from "astro:assets";
import GalleryLightbox from "./GalleryLightbox.astro";

interface GalleryImage {
  image: ImageMetadata;
  alt: string;
  aspect?: "landscape" | "portrait" | "wide" | "natural";
  muted?: boolean;
  eager?: boolean;
}

interface Props {
  columns: GalleryImage[][];
  galleryId: string;
  label: string;
  dialogLabel?: string;
  sectionId?: string;
  contentTopic?: string;
  userIntent?: string;
  journeyStage?: string;
  contentFormat?: string;
  position?: string;
}

const {
  columns,
  galleryId,
  label,
  dialogLabel = `${label} in Vollansicht`,
  sectionId = galleryId,
  contentTopic = galleryId,
  userIntent = "beispielbilder_ansehen",
  journeyStage = "auswahl",
  contentFormat = "image_gallery",
  position = "gallery_body",
} = Astro.props;

const galleryItems = columns.flat().filter(Boolean);
---

<section
  class="gallery-image-grid"
  aria-label={label}
  data-track-section={sectionId}
  data-content-topic={contentTopic}
  data-user-intent={userIntent}
  data-journey-stage={journeyStage}
  data-content-format={contentFormat}
  data-position={position}
>
  {galleryItems.map((item, itemIndex) => (
    <figure
      class:list={[
        "gallery-image-grid__item",
        `is-${item.aspect ?? "landscape"}`,
        { "is-muted": item.muted },
      ]}
      style={`--image-aspect: ${item.image.width} / ${item.image.height};`}
      data-gallery-reveal
    >
      <button
        class="gallery-image-grid__button"
        type="button"
        data-gallery-trigger={galleryId}
        data-full-src={item.image.src}
        data-alt={item.alt}
        aria-label={`Bild in Vollansicht öffnen: ${item.alt}`}
        data-track-event="gallery_interaction"
        data-cta-id={`${sectionId}_image_open`}
        data-cta-type="gallery_image_open"
        data-section-id={sectionId}
        data-content-topic={contentTopic}
        data-user-intent={userIntent}
        data-journey-stage={journeyStage}
        data-position={`image_${itemIndex + 1}`}
      >
        <Image
          src={item.image}
          alt={item.alt}
          widths={[360, 620, 920, 1200]}
          sizes="(max-width: 700px) 100vw, (max-width: 1100px) 45vw, 31vw"
          loading={item.eager ? "eager" : "lazy"}
          fetchpriority={item.eager ? "high" : "auto"}
          decoding="async"
        />
      </button>
    </figure>
  ))}
</section>

<GalleryLightbox
  galleryId={galleryId}
  dialogLabel={dialogLabel}
  sectionId={sectionId}
  contentTopic={contentTopic}
  userIntent={userIntent}
  journeyStage={journeyStage}
/>

<script is:inline>
  (() => {
    const items = [...document.querySelectorAll("[data-gallery-reveal]")];
    const reveal = (item) => item.classList.add("is-visible");

    if (!items.length) return;
    if (!("IntersectionObserver" in window)) {
      items.forEach(reveal);
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        reveal(entry.target);
        observer.unobserve(entry.target);
      });
    }, {
      rootMargin: "0px 0px -8% 0px",
      threshold: 0.14,
    });

    items.forEach((item) => observer.observe(item));
  })();
</script>

<style>
  .gallery-image-grid {
    --gallery-gap: clamp(46px, 3.4vw, 76px);
    width: min(1560px, calc(100% - clamp(88px, 15vw, 288px)));
    margin: clamp(88px, 9vw, 132px) auto 0;
    columns: 3 300px;
    column-gap: var(--gallery-gap);
  }

  .gallery-image-grid__item {
    margin: 0 0 var(--gallery-gap);
    aspect-ratio: var(--image-aspect, auto);
    background: transparent;
    overflow: hidden;
    break-inside: avoid;
    page-break-inside: avoid;
    opacity: 0;
    transform: translateY(18px);
    will-change: opacity, transform;
  }

  .gallery-image-grid__button {
    width: 100%;
    height: 100%;
    display: block;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: zoom-in;
  }

  .gallery-image-grid__button:focus-visible {
    outline: 2px solid #2f323c;
    outline-offset: 5px;
  }

  .gallery-image-grid__item.is-visible {
    animation: galleryImageReveal 760ms ease forwards;
  }

  .gallery-image-grid__item :global(img) {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    transition: transform 420ms ease, filter 420ms ease;
  }

  .gallery-image-grid__button:hover :global(img),
  .gallery-image-grid__button:focus-visible :global(img) {
    transform: scale(1.018);
    filter: brightness(.92);
  }

  .gallery-image-grid__item.is-landscape {
    aspect-ratio: var(--image-aspect, 3 / 2);
  }

  .gallery-image-grid__item.is-wide {
    aspect-ratio: var(--image-aspect, 4 / 3);
  }

  .gallery-image-grid__item.is-portrait {
    aspect-ratio: var(--image-aspect, 2 / 3);
  }

  .gallery-image-grid__item.is-natural {
    aspect-ratio: auto;
  }

  .gallery-image-grid__item.is-natural :global(img) {
    height: auto;
    object-fit: contain;
  }

  .gallery-image-grid__item.is-muted :global(img) {
    filter: grayscale(1);
  }

  .gallery-image-grid__item.is-muted .gallery-image-grid__button:hover :global(img),
  .gallery-image-grid__item.is-muted .gallery-image-grid__button:focus-visible :global(img) {
    filter: grayscale(1) brightness(.92);
  }

  @keyframes galleryImageReveal {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 980px) {
    .gallery-image-grid {
      --gallery-gap: clamp(38px, 5.8vw, 58px);
      width: min(100% - 64px, 760px);
      columns: 2 260px;
    }
  }

  @media (max-width: 620px) {
    .gallery-image-grid {
      --gallery-gap: clamp(38px, 10vw, 52px);
      width: min(100% - 56px, 460px);
      columns: 1;
      margin-top: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-image-grid__item {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .gallery-image-grid__item :global(img) {
      transition: none;
    }
  }
</style>
