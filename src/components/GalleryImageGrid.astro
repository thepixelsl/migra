---
import { Image } from "astro:assets";
import GalleryLightbox from "./GalleryLightbox.astro";

interface GalleryImage {
  image: ImageMetadata;
  alt: string;
  fullSrc?: string;
  format?: "webp";
  aspect?: "landscape" | "portrait" | "wide" | "natural";
  muted?: boolean;
  eager?: boolean;
}

interface Props {
  columns: GalleryImage[][];
  galleryId: string;
  label: string;
  dialogLabel?: string;
  sectionId?: string;
  contentTopic?: string;
  userIntent?: string;
  journeyStage?: string;
  contentFormat?: string;
  position?: string;
}

const {
  columns,
  galleryId,
  label,
  dialogLabel = `${label} in Vollansicht`,
  sectionId = galleryId,
  contentTopic = galleryId,
  userIntent = "beispielbilder_ansehen",
  journeyStage = "auswahl",
  contentFormat = "image_gallery",
  position = "gallery_body",
} = Astro.props;

const galleryItems = columns.flat().filter(Boolean);
const cssNumber = (value: number) => Number(value.toFixed(6)).toString();
const clampNumber = (value: number, minimum: number, maximum: number) =>
  Math.min(maximum, Math.max(minimum, value));
const getGalleryItemStyle = (item: GalleryImage) => {
  const ratio = item.image.width / item.image.height;

  return [
    `--image-aspect: ${item.image.width} / ${item.image.height}`,
    `--image-ratio: ${cssNumber(ratio)}`,
    `--image-basis-desktop: clamp(${cssNumber(ratio * 200)}px, ${cssNumber(ratio * 17)}vw, ${cssNumber(ratio * 360)}px)`,
    `--image-basis-tablet: clamp(${cssNumber(ratio * 180)}px, ${cssNumber(ratio * 23)}vw, ${cssNumber(ratio * 230)}px)`,
  ].join("; ");
};
const getGalleryImageSizes = (item: GalleryImage) => {
  const ratio = item.image.width / item.image.height;
  const narrowTabletWidth = cssNumber(clampNumber(ratio * 60, 40, 95));
  const tabletWidth = cssNumber(clampNumber(ratio * 36, 28, 80));
  const desktopWidth = cssNumber(clampNumber(ratio * 30, 20, 70));

  return `(max-width: 620px) calc(100vw - 56px), (max-width: 650px) ${narrowTabletWidth}vw, (max-width: 980px) ${tabletWidth}vw, ${desktopWidth}vw`;
};
---

<section
  class="gallery-image-grid"
  aria-label={label}
  data-track-section={sectionId}
  data-content-topic={contentTopic}
  data-user-intent={userIntent}
  data-journey-stage={journeyStage}
  data-content-format={contentFormat}
  data-position={position}
>
  {galleryItems.map((item, itemIndex) => (
    <figure
      class:list={[
        "gallery-image-grid__item",
        `is-${item.aspect ?? "landscape"}`,
        { "is-muted": item.muted },
      ]}
      style={getGalleryItemStyle(item)}
      data-gallery-index={itemIndex}
    >
      <button
        class="gallery-image-grid__button"
        type="button"
        data-gallery-trigger={galleryId}
        data-full-src={item.fullSrc ?? item.image.src}
        data-alt={item.alt}
        aria-label={`Bild in Vollansicht öffnen: ${item.alt}`}
        data-track-event="gallery_interaction"
        data-cta-id={`${sectionId}_image_open`}
        data-cta-type="gallery_image_open"
        data-section-id={sectionId}
        data-content-topic={contentTopic}
        data-user-intent={userIntent}
        data-journey-stage={journeyStage}
        data-position={`image_${itemIndex + 1}`}
      >
        <Image
          src={item.image}
          alt={item.alt}
          widths={[360, 620, 920, 1200]}
          sizes={getGalleryImageSizes(item)}
          format={item.format}
          loading={item.eager ? "eager" : "lazy"}
          fetchpriority={item.eager ? "high" : "auto"}
          decoding="async"
        />
      </button>
    </figure>
  ))}
</section>

<GalleryLightbox
  galleryId={galleryId}
  dialogLabel={dialogLabel}
  sectionId={sectionId}
  contentTopic={contentTopic}
  userIntent={userIntent}
  journeyStage={journeyStage}
/>

<style>
  .gallery-image-grid {
    --gallery-gap: clamp(46px, 3.4vw, 76px);
    --gallery-gap-offset: clamp(-76px, -3.4vw, -46px);
    width: min(1560px, calc(100% - clamp(88px, 15vw, 288px)));
    margin: clamp(88px, 9vw, 132px) auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--gallery-gap);
  }

  .gallery-image-grid__item {
    min-width: 0;
    margin: 0;
    flex: var(--image-ratio, 1) 1 var(--image-basis-desktop, 300px);
    aspect-ratio: var(--image-aspect, auto);
    background: transparent;
    overflow: hidden;
  }

  .gallery-image-grid::after {
    content: "";
    height: 0;
    flex: 10 1 0;
    margin-inline-start: var(--gallery-gap-offset);
    pointer-events: none;
  }

  .gallery-image-grid__button {
    width: 100%;
    height: 100%;
    display: block;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: zoom-in;
  }

  .gallery-image-grid__button:focus-visible {
    outline: 2px solid #2f323c;
    outline-offset: 5px;
  }

  .gallery-image-grid__item :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    transition: transform 420ms ease, filter 420ms ease;
  }

  .gallery-image-grid__button:hover :global(img),
  .gallery-image-grid__button:focus-visible :global(img) {
    transform: scale(1.018);
    filter: brightness(.92);
  }

  .gallery-image-grid__item.is-landscape {
    aspect-ratio: var(--image-aspect, 3 / 2);
  }

  .gallery-image-grid__item.is-wide {
    aspect-ratio: var(--image-aspect, 4 / 3);
  }

  .gallery-image-grid__item.is-portrait {
    aspect-ratio: var(--image-aspect, 2 / 3);
  }

  .gallery-image-grid__item.is-natural {
    aspect-ratio: var(--image-aspect, auto);
  }

  .gallery-image-grid__item.is-natural :global(img) {
    height: 100%;
    object-fit: contain;
  }

  .gallery-image-grid__item.is-muted :global(img) {
    filter: grayscale(1);
  }

  .gallery-image-grid__item.is-muted .gallery-image-grid__button:hover :global(img),
  .gallery-image-grid__item.is-muted .gallery-image-grid__button:focus-visible :global(img) {
    filter: grayscale(1) brightness(.92);
  }

  @media (max-width: 980px) {
    .gallery-image-grid {
      --gallery-gap: clamp(38px, 5.8vw, 58px);
      --gallery-gap-offset: clamp(-58px, -5.8vw, -38px);
      width: min(100% - 64px, 760px);
    }

    .gallery-image-grid__item {
      flex-basis: var(--image-basis-tablet, 220px);
    }
  }

  @media (max-width: 620px) {
    .gallery-image-grid {
      --gallery-gap: clamp(38px, 10vw, 52px);
      width: min(100% - 56px, 460px);
      margin-top: 80px;
    }

    .gallery-image-grid__item {
      width: 100%;
      flex-basis: 100%;
      flex-grow: 0;
    }

    .gallery-image-grid::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-image-grid__item :global(img) {
      transition: none;
    }
  }
</style>
