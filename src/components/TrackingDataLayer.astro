---
import ConsentBanner from "./ConsentBanner.astro";
import { trackingConfig } from "../config/tracking";
---

{trackingConfig.consentEnabled && (
  <>
    <ConsentBanner />
    <script is:inline>
  (() => {
    if (window.__artbildTrackingReady) return;
    window.__artbildTrackingReady = true;

    const DATA_LAYER_NAME = "dataLayer";
    const observedSections = new WeakSet();
    const observedForms = new WeakSet();
    const startedForms = new WeakSet();
    let trackingReadyPublished = false;

    window[DATA_LAYER_NAME] = window[DATA_LAYER_NAME] || [];

    const sanitize = (value) => {
      if (!value) return undefined;
      return String(value)
        .trim()
        .toLowerCase()
        .replace(/ä/g, "ae")
        .replace(/ö/g, "oe")
        .replace(/ü/g, "ue")
        .replace(/ß/g, "ss")
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "")
        .slice(0, 80) || undefined;
    };

    const pageType = () => {
      const explicit = document.body?.dataset.pageType;
      if (explicit) return sanitize(explicit);

      const path = window.location.pathname;
      if (path === "/") return "home";
      if (path.startsWith("/gallery/")) return "gallery";
      if (path.startsWith("/gallery-category/")) return "gallery_category";
      if (path === "/portfolio/") return "portfolio";
      if (path === "/kontakt/" || path === "/sicherer-kontakt/") return "contact";
      if (path === "/hochzeitsfotograf-preise/") return "pricing";
      if (path === "/blog/") return "blog_index";
      return "content_page";
    };

    const pageId = () => {
      const explicit = document.body?.dataset.pageId;
      if (explicit) return sanitize(explicit);
      return window.location.pathname === "/"
        ? "home"
        : sanitize(window.location.pathname);
    };

    const businessLinkDefinition = (link) => {
      const rawHref = link?.getAttribute?.("href") || "";
      if (!rawHref || rawHref.startsWith("#")) return null;

      if (rawHref.toLowerCase().startsWith("mailto:")) {
        return {
          event: "contact_click",
          key: "email",
          ctaType: "email",
          contentTopic: "kontakt",
          userIntent: "email_kontakt_starten",
          journeyStage: "conversion",
        };
      }
      if (rawHref.toLowerCase().startsWith("tel:")) {
        return {
          event: "contact_click",
          key: "phone",
          ctaType: "phone",
          contentTopic: "kontakt",
          userIntent: "telefon_kontakt_starten",
          journeyStage: "conversion",
        };
      }

      let url;
      try {
        url = new URL(rawHref, window.location.href);
      } catch (_) {
        return null;
      }

      const normalizedPath = url.pathname.replace(/\/+$/, "") || "/";
      const isInternal = url.origin === window.location.origin;
      if (isInternal && normalizedPath === "/hochzeitsfotograf-preise") {
        return {
          event: "view_pricing",
          key: "pricing",
          ctaType: "pricing_link",
          contentTopic: "preise_und_pakete",
          userIntent: "preise_ansehen",
          journeyStage: "decision",
        };
      }
      if (isInternal && normalizedPath === "/kontakt") {
        return {
          event: "contact_click",
          key: "contact",
          ctaType: "contact_page_link",
          contentTopic: "kontakt",
          userIntent: "anfrage_starten",
          journeyStage: "conversion",
        };
      }
      if (isInternal && normalizedPath === "/sicherer-kontakt") {
        return {
          event: "contact_click",
          key: "secure_contact",
          ctaType: "secure_contact_link",
          contentTopic: "kontakt",
          userIntent: "sichere_anfrage_starten",
          journeyStage: "conversion",
        };
      }
      if (
        url.hostname === "wa.me"
        || url.hostname === "api.whatsapp.com"
        || url.hostname === "web.whatsapp.com"
      ) {
        return {
          event: "contact_click",
          key: "whatsapp",
          ctaType: "whatsapp",
          contentTopic: "kontakt",
          userIntent: "whatsapp_kontakt_starten",
          journeyStage: "conversion",
        };
      }
      return null;
    };

    const trackingSectionFor = (link) => {
      const source = link.closest(
        "[data-track-section], [data-form-id], footer, nav, header, section[id], main, article",
      );
      if (!source) return "page";
      return sanitize(
        source.dataset?.trackSection
        || source.dataset?.formId
        || source.id
        || (source.tagName === "NAV" ? "navigation" : source.tagName),
      ) || "page";
    };

    const prepareBusinessLinks = () => {
      const occurrences = new Map();
      document.querySelectorAll("a[href]").forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        if (link.closest("[data-consent-dialog], [data-consent-settings]")) return;

        const definition = businessLinkDefinition(link);
        if (!definition) return;

        const sectionId = sanitize(link.dataset.sectionId) || trackingSectionFor(link);
        const occurrenceKey = `${definition.key}:${sectionId}`;
        const occurrence = (occurrences.get(occurrenceKey) || 0) + 1;
        occurrences.set(occurrenceKey, occurrence);

        link.dataset.trackEvent = definition.event;
        if (!link.dataset.ctaId) {
          link.dataset.ctaId = `business_${definition.key}_${sectionId}_${occurrence}`;
        }
        if (!link.dataset.ctaType) link.dataset.ctaType = definition.ctaType;
        if (!link.dataset.sectionId) link.dataset.sectionId = sectionId;
        if (!link.dataset.contentTopic) link.dataset.contentTopic = definition.contentTopic;
        if (!link.dataset.userIntent) link.dataset.userIntent = definition.userIntent;
        if (!link.dataset.journeyStage) link.dataset.journeyStage = definition.journeyStage;
        if (!link.dataset.position) link.dataset.position = `${sectionId}_${occurrence}`;
      });
    };

    const journeyStage = (value) => {
      const normalized = sanitize(value);
      const stageMap = {
        awareness: "awareness",
        inspiration: "awareness",
        entdeckung: "awareness",
        consideration: "consideration",
        orientierung: "consideration",
        information: "consideration",
        planung: "consideration",
        vertrauen: "consideration",
        decision: "decision",
        auswahl: "decision",
        vergleich: "decision",
        entscheidung: "decision",
        vor_reservierung: "decision",
        validierung: "decision",
        conversion: "conversion",
        anfrage: "conversion",
        retention: "retention",
        bindung: "retention",
        all: "cross_journey",
      };
      return normalized ? stageMap[normalized] || normalized : undefined;
    };

    const contextFrom = (element) => {
      const source = element?.closest?.("[data-track-section]") || element;
      const cta = element?.closest?.("[data-track-event], [data-cta-id], [data-resource-id]");

      return {
        page_id: pageId(),
        page_type: pageType(),
        section_id: sanitize(cta?.dataset.sectionId || source?.dataset.trackSection),
        content_topic: sanitize(cta?.dataset.contentTopic || source?.dataset.contentTopic),
        user_intent: sanitize(cta?.dataset.userIntent || source?.dataset.userIntent),
        journey_stage: journeyStage(
          cta?.dataset.journeyStage || source?.dataset.journeyStage,
        ),
        cta_id: sanitize(cta?.dataset.ctaId),
        cta_type: sanitize(cta?.dataset.ctaType),
        resource_id: sanitize(cta?.dataset.resourceId),
        resource_type: sanitize(cta?.dataset.resourceType),
        content_format: sanitize(source?.dataset.contentFormat),
        position: sanitize(cta?.dataset.position || source?.dataset.position),
        interaction_action: sanitize(
          cta?.dataset.sliderAction
          || cta?.dataset.galleryAction
          || cta?.dataset.interactionAction,
        ),
        slider_id: sanitize(cta?.dataset.sliderId || source?.dataset.sliderId),
        item_index: sanitize(
          cta?.dataset.sliderIndex
          || cta?.dataset.galleryIndex
          || cta?.dataset.itemIndex,
        ),
      };
    };

    const compact = (payload) => Object.fromEntries(
      Object.entries(payload).filter(([, value]) => value !== undefined && value !== ""),
    );

    const isTrackableVisible = (element) => {
      if (!(element instanceof Element)) return false;
      if (element.closest("[hidden], [aria-hidden='true']")) return false;
      return element.getClientRects().length > 0;
    };

    const pushEvent = (payload) => {
      const tagManagerGranted = window.ArtbildConsent?.services?.googleTagManager === true;
      const analyticsGranted = window.ArtbildConsent?.services?.googleAnalytics === true;
      const marketingGranted = window.ArtbildConsent?.services?.metaPixel === true;
      const clarityGranted = window.ArtbildConsent?.services?.microsoftClarity === true;
      if (!tagManagerGranted || (!analyticsGranted && !marketingGranted)) return;

      const eventPayload = compact({
        page_id: pageId(),
        page_type: pageType(),
        ...payload,
      });
      if (!eventPayload.event) return;

      eventPayload.consent_analytics = analyticsGranted
        ? "granted"
        : "denied";
      eventPayload.consent_marketing = marketingGranted
        ? "granted"
        : "denied";
      eventPayload.consent_clarity = clarityGranted
        ? "granted"
        : "denied";
      if (analyticsGranted) {
        const { event, ...parameters } = eventPayload;
        window.gtag?.("event", event, parameters);
      }
      if (marketingGranted) {
        window.artbildMetaPixel?.track?.(eventPayload);
      }
    };

    const publishTrackingReady = () => {
      if (
        trackingReadyPublished
        || window.ArtbildConsent?.services?.googleAnalytics !== true
      ) return;
      trackingReadyPublished = true;
      window.gtag?.("event", "artbild_tracking_ready", {
        consent_mode: "basic",
        tracking_schema: "artbild_v2",
      });
    };

    window.artbildTracking = {
      track: pushEvent,
      flush: () => {},
      grantAnalyticsConsent: () => {
        window.artbildConsentApi?.setConsent?.({
          services: {
            googleTagManager: true,
            googleAnalytics: true,
            microsoftClarity:
              window.ArtbildConsent?.services?.microsoftClarity === true,
            metaPixel: window.ArtbildConsent?.services?.metaPixel === true,
          },
        });
      },
      revokeAnalyticsConsent: () => {
        window.artbildConsentApi?.setConsent?.({
          services: {
            googleTagManager:
              window.ArtbildConsent?.services?.googleTagManager === true,
            googleAnalytics: false,
            microsoftClarity:
              window.ArtbildConsent?.services?.microsoftClarity === true,
            metaPixel: window.ArtbildConsent?.services?.metaPixel === true,
          },
        });
      },
    };

    window.addEventListener("artbild:consent_update", (event) => {
      document.documentElement.dataset.analyticsConsent =
        event.detail?.analytics === true ? "granted" : "denied";
      document.documentElement.dataset.marketingConsent =
        event.detail?.marketing === true ? "granted" : "denied";
      document.documentElement.dataset.clarityConsent =
        event.detail?.clarity === true ? "granted" : "denied";
      if (event.detail?.analytics === true) publishTrackingReady();
    });

    publishTrackingReady();

    const observeSections = () => {
      const sections = [...document.querySelectorAll("[data-track-section]")];
      if (!sections.length) return;

      const emitView = (section) => {
        if (observedSections.has(section)) return;
        if (!isTrackableVisible(section)) return;
        observedSections.add(section);
        pushEvent({
          event: "section_view",
          ...contextFrom(section),
        });
      };

      if (!("IntersectionObserver" in window)) {
        sections.forEach(emitView);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          emitView(entry.target);
          observer.unobserve(entry.target);
        });
      }, {
        rootMargin: "0px 0px -12% 0px",
        threshold: 0.05,
      });

      sections.forEach((section) => observer.observe(section));
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element
        ? event.target.closest("[data-track-event], [data-cta-id], [data-resource-id]")
        : null;
      if (!(target instanceof HTMLElement)) return;
      if (!isTrackableVisible(target)) return;
      if (
        target instanceof HTMLDetailsElement
        && target.dataset.trackEvent === "faq_open"
      ) {
        return;
      }

      const eventName = sanitize(target.dataset.trackEvent) || "cta_click";
      pushEvent({
        event: eventName,
        ...contextFrom(target),
      });
    }, { capture: true });

    document.addEventListener("toggle", (event) => {
      const details = event.target;
      if (!(details instanceof HTMLDetailsElement) || !details.open) return;
      if (details.dataset.trackEvent !== "faq_open") return;
      if (!isTrackableVisible(details)) return;

      pushEvent({
        event: "faq_open",
        ...contextFrom(details),
        faq_id: sanitize(details.dataset.faqId),
      });
    }, true);

    document.addEventListener("focusin", (event) => {
      const form = event.target instanceof Element
        ? event.target.closest("[data-track-form]")
        : null;
      if (!(form instanceof HTMLFormElement) || startedForms.has(form)) return;
      if (!isTrackableVisible(form)) return;
      startedForms.add(form);

      pushEvent({
        event: "form_start",
        ...contextFrom(form),
        form_id: sanitize(form.dataset.formId),
        form_type: sanitize(form.dataset.formType),
      });
    });

    document.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.matches("[data-track-form]")) return;
      if (!isTrackableVisible(form)) return;

      pushEvent({
        event: "form_submit_attempt",
        ...contextFrom(form),
        form_id: sanitize(form.dataset.formId),
        form_type: sanitize(form.dataset.formType),
      });
    }, { capture: true });

    window.addEventListener("artbild:form_success", (event) => {
      pushEvent({
        event: "form_success",
        page_type: pageType(),
        form_id: sanitize(event.detail?.formId),
        form_type: sanitize(event.detail?.formType),
        section_id: sanitize(event.detail?.sectionId),
        content_topic: sanitize(event.detail?.contentTopic),
        journey_stage: "conversion",
      });
    });

    window.addEventListener("artbild:form_error", (event) => {
      pushEvent({
        event: "form_error",
        page_type: pageType(),
        form_id: sanitize(event.detail?.formId),
        form_type: sanitize(event.detail?.formType),
        result: sanitize(event.detail?.result),
        section_id: sanitize(event.detail?.sectionId),
        content_topic: sanitize(event.detail?.contentTopic),
      });
    });

    window.addEventListener("artbild:availability_result", (event) => {
      pushEvent({
        event: "availability_check_result",
        page_type: pageType(),
        result: sanitize(event.detail?.result),
        section_id: "availability_dialog",
        content_topic: "terminverfuegbarkeit",
        user_intent: "termin_pruefen",
        journey_stage: "decision",
      });
    });

    const init = () => {
      prepareBusinessLinks();
      observeSections();

      const emitFormView = (form) => {
        if (observedForms.has(form) || !isTrackableVisible(form)) return;
        observedForms.add(form);
        pushEvent({
          event: "form_view",
          ...contextFrom(form),
          form_id: sanitize(form.dataset.formId),
          form_type: sanitize(form.dataset.formType),
        });
      };

      const forms = [...document.querySelectorAll("[data-track-form]")];
      if (!("IntersectionObserver" in window)) {
        forms.forEach(emitFormView);
      } else {
        const formObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            emitFormView(entry.target);
            formObserver.unobserve(entry.target);
          });
        }, { threshold: 0.15 });
        forms.forEach((form) => formObserver.observe(form));
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
    </script>
  </>
)}
