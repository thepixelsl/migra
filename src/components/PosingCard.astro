---
import PosingImage from './PosingImage.astro';
import PosingPageTurn from './PosingPageTurn.astro';
import { totalPages, type GuideCard } from '../data/posing-guide';
interface Props { card: GuideCard; }
const { card } = Astro.props;
---
<article class="pose-card book-page" id={`pose-${card.id}`} aria-label={`Seite ${card.page}: ${card.title}`}
  data-guide-page={card.page} data-guide-content={`pose_${card.id}`} data-guide-chapter={card.chapter} data-guide-mode="book">
  <header>
    <p class="guide-kicker">{card.group} · {String(card.number).padStart(2, '0')} / {card.count}</p>
    <h2>{card.title}</h2>
  </header>
  <figure><PosingImage card={card} /></figure>
  <div class="pose-copy">
    <p class="pose-location">{card.location}</p>
    <p>{card.description}</p>
    {card.attention && <p><strong>Zur Haltung:</strong>{' '}{card.attention}</p>}
    {card.legend.length > 0 && <ul class="pose-legend">{card.legend.map(label => <li>{label}</li>)}</ul>}
    {card.variation && <details><summary>Eine Variante für dich</summary><p>{card.variation}</p></details>}
  </div>
  <footer class="book-page-footer"><span>ARTBILD · Posing Guide</span><span>{card.page} / {totalPages}</span></footer>
  <PosingPageTurn index={card.page - 1} />
</article>
