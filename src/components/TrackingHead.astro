---
import { trackingConfig } from "../config/tracking";
import consentRuntime from "../lib/consentRuntime.js?raw";

const pathname = Astro.url.pathname;
const normalizedPathname = pathname.replace(/\/+$/, "") || "/";
const trackingExcluded =
  normalizedPathname === "/404"
  || normalizedPathname === "/404.html"
  || normalizedPathname === "/admin-termine"
  || normalizedPathname.startsWith("/admin-termine/");

const publicConfig = trackingExcluded
  ? {
      ...trackingConfig,
      consentEnabled: false,
      environment: "disabled",
      gtmContainerId: "",
      googleAnalyticsId: "",
      googleAdsConfigured: false,
      googleTrackingConfigured: false,
      openaiAdsPixelId: "",
      openaiAdsConfigured: false,
    }
  : trackingConfig;

const serializedConfig = JSON.stringify(publicConfig).replace(/</g, "\\u003c");
---

<script
  id="artbild-tracking-config"
  type="application/json"
  set:html={serializedConfig}
></script>

<script is:inline set:html={consentRuntime}></script>

<script>
  import "../lib/openaiAds.mjs";
</script>
