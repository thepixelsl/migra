---
import { trackingConfig } from "../config/tracking";

const pathname = Astro.url.pathname;
const normalizedPathname = pathname.replace(/\/+$/, "") || "/";
const trackingExcluded =
  normalizedPathname === "/404"
  || normalizedPathname === "/404.html"
  || normalizedPathname === "/admin-termine"
  || normalizedPathname.startsWith("/admin-termine/");

const publicConfig = trackingExcluded
  ? {
      ...trackingConfig,
      consentEnabled: false,
      environment: "disabled",
      gtmContainerId: "",
      googleAnalyticsId: "",
      googleTrackingConfigured: false,
    }
  : trackingConfig;

const serializedConfig = JSON.stringify(publicConfig).replace(/</g, "\\u003c");
---

<script
  id="artbild-tracking-config"
  type="application/json"
  set:html={serializedConfig}
></script>

<script is:inline>
  (() => {
    if (window.__artbildConsentBootstrapped) return;
    window.__artbildConsentBootstrapped = true;

    const configElement = document.getElementById("artbild-tracking-config");
    if (!configElement) return;

    let config;
    try {
      config = JSON.parse(configElement.textContent || "{}");
    } catch (_) {
      return;
    }

    if (!config.consentEnabled) {
      window.ArtbildConsent = {
        enabled: false,
        hasDecision: true,
        analytics: false,
        clarity: false,
        marketing: false,
        services: {
          googleTagManager: false,
          googleAnalytics: false,
          microsoftClarity: false,
          metaPixel: false,
        },
      };
      window.artbildConsent = window.ArtbildConsent;
      return;
    }

    const COOKIE_NAME = "artbild_consent";
    const GOOGLE_ANALYTICS_COOKIE_PREFIXES = ["_ga", "_gid", "_gat"];
    const META_COOKIE_PREFIXES = ["_fbp", "_fbc"];
    const CLARITY_COOKIE_PREFIXES = ["_clck", "_clsk"];

    const hostMatches = (hostname, rule) => {
      if (!rule) return false;
      if (rule.startsWith("*.")) {
        return hostname.endsWith(rule.slice(1));
      }
      return hostname === rule;
    };

    const hostname = window.location.hostname.toLowerCase();
    const hostAllowed = Array.isArray(config.allowedHosts)
      && config.allowedHosts.some((rule) => hostMatches(hostname, String(rule).toLowerCase()));
    const providersEnabled = config.environment !== "disabled" && hostAllowed;
    const directGoogleAnalytics = config.googleAnalyticsDelivery === "direct";

    const readCookie = (name) => {
      const prefix = `${name}=`;
      const value = document.cookie
        .split(";")
        .map((part) => part.trim())
        .find((part) => part.startsWith(prefix));
      return value ? value.slice(prefix.length) : "";
    };

    const readDecision = () => {
      const raw = readCookie(COOKIE_NAME);
      if (!raw) return null;

      try {
        const decision = JSON.parse(decodeURIComponent(raw));
        const services = decision.services;
        if (
          decision.version !== config.consentVersion
          || !services
          || typeof services.googleTagManager !== "boolean"
          || typeof services.googleAnalytics !== "boolean"
          || typeof services.microsoftClarity !== "boolean"
          || typeof services.metaPixel !== "boolean"
        ) {
          return null;
        }
        const googleAnalytics = services.googleAnalytics === true;
        const microsoftClarity = services.microsoftClarity === true;
        const metaPixel = services.metaPixel === true;
        return {
          ...decision,
          services: {
            googleTagManager: googleAnalytics || microsoftClarity || metaPixel,
            googleAnalytics,
            microsoftClarity,
            metaPixel,
          },
        };
      } catch (_) {
        return null;
      }
    };

    const writeDecision = (decision) => {
      const value = encodeURIComponent(JSON.stringify(decision));
      const secure = window.location.protocol === "https:" ? "; Secure" : "";
      document.cookie = `${COOKIE_NAME}=${value}; Path=/; Max-Age=15552000; SameSite=Lax${secure}`;
    };

    const expireCookie = (name) => {
      const secure = window.location.protocol === "https:" ? "; Secure" : "";
      const expires = "Thu, 01 Jan 1970 00:00:00 GMT";
      document.cookie = `${name}=; Path=/; Expires=${expires}; SameSite=Lax${secure}`;

      if (hostname.includes(".") && hostname !== "127.0.0.1") {
        const registrableDomain = hostname.split(".").slice(-2).join(".");
        document.cookie = `${name}=; Path=/; Domain=.${registrableDomain}; Expires=${expires}; SameSite=Lax${secure}`;
      }
    };

    const clearProviderCookies = (prefixes) => {
      document.cookie
        .split(";")
        .map((part) => part.trim().split("=")[0])
        .filter((name) => prefixes.some((prefix) => name.startsWith(prefix)))
        .forEach(expireCookie);
    };

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag() {
      window.dataLayer.push(arguments);
    };

    const storedDecision = readDecision();
    const initialState = {
      googleTagManager: storedDecision?.services.googleTagManager === true,
      googleAnalytics: storedDecision?.services.googleAnalytics === true,
      microsoftClarity: storedDecision?.services.microsoftClarity === true,
      metaPixel: storedDecision?.services.metaPixel === true,
    };

    const googleConsentState = (state) => ({
        analytics_storage: state.googleAnalytics ? "granted" : "denied",
        ad_storage: state.metaPixel ? "granted" : "denied",
        ad_user_data: state.metaPixel ? "granted" : "denied",
        ad_personalization: state.metaPixel ? "granted" : "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
      });

    window.gtag(
      "consent",
      "default",
      googleConsentState({
        googleAnalytics: false,
        microsoftClarity: false,
        metaPixel: false,
      }),
    );
    window.gtag("set", "ads_data_redaction", true);
    window.gtag("set", "url_passthrough", false);

    window.dataLayer.push({
      event: "artbild_tracking_config",
      tracking_environment: config.environment,
      google_analytics_id: config.googleAnalyticsId || undefined,
      google_analytics_delivery: directGoogleAnalytics ? "direct" : "tag_manager",
      meta_delivery: "google_tag_manager",
      clarity_delivery: "google_tag_manager",
      ga4_data_retention_months: config.ga4DataRetentionMonths,
      consent_mode: "basic",
      consent_version: config.consentVersion,
    });

    const publishState = (state, hasDecision) => {
      const services = {
        googleTagManager: state.googleTagManager === true,
        googleAnalytics: state.googleAnalytics === true,
        microsoftClarity: state.microsoftClarity === true,
        metaPixel: state.metaPixel === true,
      };
      const publicState = {
        enabled: true,
        hasDecision,
        analytics: services.googleAnalytics,
        clarity: services.microsoftClarity,
        marketing: services.metaPixel,
        services,
        version: config.consentVersion,
        mode: "basic",
      };

      window.ArtbildConsent = publicState;
      window.artbildConsent = publicState;
      document.documentElement.dataset.analyticsConsent = publicState.analytics
        ? "granted"
        : "denied";
      document.documentElement.dataset.marketingConsent = publicState.marketing
        ? "granted"
        : "denied";
      document.documentElement.dataset.clarityConsent = publicState.clarity
        ? "granted"
        : "denied";
      document.documentElement.dataset.googleTagManagerConsent = services.googleTagManager
        ? "granted"
        : "denied";
      return publicState;
    };

    let googleAnalyticsLoading = false;
    let googleAnalyticsAttempts = 0;
    let googleAnalyticsRetry;

    const loadGoogleAnalytics = () => {
      if (
        !directGoogleAnalytics
        || !providersEnabled
        || config.googleTrackingConfigured !== true
        || window.ArtbildConsent?.services?.googleAnalytics !== true
        || !/^G-[A-Z0-9]{6,}$/i.test(config.googleAnalyticsId || "")
        || googleAnalyticsLoading
        || window.__artbildGoogleAnalyticsLoaded
        || googleAnalyticsAttempts >= 2
      ) return;

      // Queue one configuration per document, including when a failed download is retried.
      if (!window.__artbildGoogleAnalyticsConfigured) {
        window.__artbildGoogleAnalyticsConfigured = true;
        window.gtag("js", new Date());
        window.gtag("config", config.googleAnalyticsId);
      }

      window.clearTimeout(googleAnalyticsRetry);
      googleAnalyticsLoading = true;
      googleAnalyticsAttempts += 1;
      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(config.googleAnalyticsId)}`;
      script.dataset.artbildProvider = "google-analytics";
      script.onload = () => {
        googleAnalyticsLoading = false;
        window.__artbildGoogleAnalyticsLoaded = true;
      };
      script.onerror = () => {
        googleAnalyticsLoading = false;
        script.remove();
        // Retry a definitive load failure once; never retry a still-pending script.
        if (googleAnalyticsAttempts < 2) {
          googleAnalyticsRetry = window.setTimeout(loadGoogleAnalytics, 1500);
        }
      };
      document.head.appendChild(script);
    };

    const loadGoogleTagManager = () => {
      if (
        !providersEnabled
        || config.googleTrackingConfigured !== true
        || !/^GTM-[A-Z0-9]{4,}$/i.test(config.gtmContainerId || "")
        || !/^G-[A-Z0-9]{6,}$/i.test(config.googleAnalyticsId || "")
      ) {
        return;
      }

      if (window.__artbildGoogleTagManagerLoaded) return;
      window.__artbildGoogleTagManagerLoaded = true;

      window.dataLayer.push({
        "gtm.start": Date.now(),
        event: "gtm.js",
      });
      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(config.gtmContainerId)}`;
      script.dataset.artbildProvider = "google-tag-manager";
      document.head.appendChild(script);
    };

    const clarityConsentState = (granted) => ({
      ad_Storage: "denied",
      analytics_Storage: granted ? "granted" : "denied",
    });

    const updateClarityConsent = (granted) => {
      if (typeof window.clarity !== "function") return;
      window.clarity("consentv2", clarityConsentState(granted));
    };

    const safeMetaParameters = (payload) => {
      const allowed = [
        "page_type",
        "section_id",
        "content_topic",
        "journey_stage",
        "cta_id",
        "cta_type",
        "resource_type",
        "position",
        "form_id",
        "form_type",
        "result",
        "interaction_action",
      ];
      return Object.fromEntries(
        allowed
          .filter((key) => payload[key] !== undefined)
          .map((key) => [key, payload[key]]),
      );
    };

    window.artbildMetaPixel = {
      track(payload) {
        if (
          window.ArtbildConsent?.services?.metaPixel !== true
          || typeof window.fbq !== "function"
          || !payload?.event
        ) {
          return;
        }

        const parameters = safeMetaParameters(payload);
        if (payload.event === "form_success" && payload.form_type === "contact_request") {
          window.fbq("track", "Lead", parameters);
          return;
        }
        if (payload.event === "contact_click") {
          window.fbq("track", "Contact", parameters);
          return;
        }
        if (payload.event === "view_pricing") {
          window.fbq("track", "ViewContent", parameters);
        }
      },
    };

    const updateConsent = (nextState) => {
      const currentServices = window.ArtbildConsent?.services || {};
      const requestedServices = nextState?.services || {};
      const requestedValue = (serviceValue, directValue, legacyValue, currentValue) => {
        if (typeof serviceValue === "boolean") return serviceValue;
        if (typeof directValue === "boolean") return directValue;
        if (typeof legacyValue === "boolean") return legacyValue;
        return currentValue === true;
      };
      const state = {
        googleTagManager: false,
        googleAnalytics: requestedValue(
          requestedServices.googleAnalytics,
          nextState?.googleAnalytics,
          nextState?.analytics,
          currentServices.googleAnalytics,
        ),
        microsoftClarity: requestedValue(
          requestedServices.microsoftClarity,
          nextState?.microsoftClarity,
          nextState?.clarity,
          currentServices.microsoftClarity,
        ),
        metaPixel: requestedValue(
          requestedServices.metaPixel,
          nextState?.metaPixel,
          nextState?.marketing,
          currentServices.metaPixel,
        ),
      };
      const googleTagManagerExplicitlyDenied = requestedServices.googleTagManager === false
        || nextState?.googleTagManager === false;
      if (googleTagManagerExplicitlyDenied) {
        state.googleAnalytics = false;
        state.microsoftClarity = false;
        state.metaPixel = false;
      }
      state.googleTagManager = state.googleAnalytics
        || state.microsoftClarity
        || state.metaPixel;
      const googleTagManagerWasGranted = currentServices.googleTagManager === true;
      const googleAnalyticsWasGranted = currentServices.googleAnalytics === true;
      const clarityWasGranted = currentServices.microsoftClarity === true;
      const metaWasGranted = currentServices.metaPixel === true;
      const decision = {
        version: config.consentVersion,
        necessary: true,
        analytics: state.googleAnalytics,
        clarity: state.microsoftClarity,
        marketing: state.metaPixel,
        services: { ...state },
        updatedAt: new Date().toISOString(),
      };

      writeDecision(decision);
      publishState(state, true);
      window.gtag("consent", "update", googleConsentState(state));
      if (state.googleAnalytics) {
        loadGoogleAnalytics();
      } else {
        window.clearTimeout(googleAnalyticsRetry);
      }

      if (state.microsoftClarity) {
        updateClarityConsent(true);
      } else {
        updateClarityConsent(false);
        clearProviderCookies(CLARITY_COOKIE_PREFIXES);
      }

      if (!state.googleAnalytics) {
        clearProviderCookies(GOOGLE_ANALYTICS_COOKIE_PREFIXES);
      }

      if (state.metaPixel) {
        if (typeof window.fbq === "function") {
          window.fbq("consent", "grant");
        }
      } else {
        if (typeof window.fbq === "function") {
          window.fbq("consent", "revoke");
        }
        clearProviderCookies(META_COOKIE_PREFIXES);
      }

      const detail = {
        analytics: state.googleAnalytics,
        clarity: state.microsoftClarity,
        marketing: state.metaPixel,
        services: { ...state },
        necessary: true,
        mode: "basic",
        version: config.consentVersion,
      };
      window.setTimeout(() => {
        window.dataLayer.push({
          event: "artbild_consent_update",
          consent_google_tag_manager: state.googleTagManager ? "granted" : "denied",
          consent_analytics: state.googleAnalytics ? "granted" : "denied",
          consent_clarity: state.microsoftClarity ? "granted" : "denied",
          consent_marketing: state.metaPixel ? "granted" : "denied",
          consent_google_analytics: state.googleAnalytics ? "granted" : "denied",
          consent_microsoft_clarity: state.microsoftClarity ? "granted" : "denied",
          consent_meta_pixel: state.metaPixel ? "granted" : "denied",
          consent_mode: "basic",
        });
        window.dispatchEvent(new CustomEvent("artbild:consent_update", { detail }));
        if (state.googleTagManager) {
          loadGoogleTagManager();
        }
        window.setTimeout(() => {
          updateClarityConsent(state.microsoftClarity);
          if (state.metaPixel && typeof window.fbq === "function") {
            window.fbq("consent", "grant");
          }
        }, 100);
      }, 0);
      const publishedState = { ...window.ArtbildConsent };

      if (
        (
          googleAnalyticsWasGranted
          && !state.googleAnalytics
          && window.__artbildGoogleAnalyticsConfigured === true
        )
        ||
        (
          googleTagManagerWasGranted
          && !state.googleTagManager
          && window.__artbildGoogleTagManagerLoaded === true
        )
        ||
        (
          clarityWasGranted
          && !state.microsoftClarity
          && typeof window.clarity === "function"
        )
        || (
          metaWasGranted
          && !state.metaPixel
          && typeof window.fbq === "function"
        )
      ) {
        window.setTimeout(() => window.location.reload(), 0);
      }

      return publishedState;
    };

    publishState(initialState, Boolean(storedDecision));
    if (storedDecision) {
      window.gtag("consent", "update", googleConsentState(initialState));
    }
    if (!initialState.googleAnalytics) {
      clearProviderCookies(GOOGLE_ANALYTICS_COOKIE_PREFIXES);
    }
    if (!initialState.microsoftClarity) {
      clearProviderCookies(CLARITY_COOKIE_PREFIXES);
    }
    if (!initialState.metaPixel) {
      clearProviderCookies(META_COOKIE_PREFIXES);
    }

    window.artbildConsentApi = {
      getState: () => ({ ...window.ArtbildConsent }),
      setConsent: updateConsent,
      openSettings: () => {
        window.dispatchEvent(new CustomEvent("artbild:consent_settings_open"));
      },
    };

    window.dataLayer.push({
      event: "artbild_consent_state",
      consent_google_tag_manager: initialState.googleTagManager ? "granted" : "denied",
      consent_analytics: initialState.googleAnalytics ? "granted" : "denied",
      consent_clarity: initialState.microsoftClarity ? "granted" : "denied",
      consent_marketing: initialState.metaPixel ? "granted" : "denied",
      consent_google_analytics: initialState.googleAnalytics ? "granted" : "denied",
      consent_microsoft_clarity: initialState.microsoftClarity ? "granted" : "denied",
      consent_meta_pixel: initialState.metaPixel ? "granted" : "denied",
      consent_decision_present: Boolean(storedDecision),
      consent_mode: "basic",
    });

    if (initialState.googleTagManager) {
      loadGoogleAnalytics();
      loadGoogleTagManager();
    }
    window.setTimeout(() => {
      updateClarityConsent(initialState.microsoftClarity);
      if (initialState.metaPixel && typeof window.fbq === "function") {
        window.fbq("consent", "grant");
      }
    }, 500);
  })();
</script>
