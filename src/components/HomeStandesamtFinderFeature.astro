---
import { Image } from "astro:assets";
import standesamtFinderImage from "../assets/braut-fotoshooting-hamburg/ART_9463-Bearbeitet-1-scaled.jpg";
---

<section
  class="home-standesamt-feature home-lower-section"
  aria-labelledby="home-standesamt-feature-title"
  data-track-section="home_standesamtfinder"
  data-content-topic="standesamtfinder_hamburg"
  data-user-intent="standesamt_und_trauort_finden"
  data-journey-stage="planung"
  data-content-format="feature_card"
  data-position="after_planning"
>
  <article class="home-standesamt-feature__card" data-home-reveal>
    <a
      class="home-standesamt-feature__link"
      href="/standesamt-hamburg/"
      aria-label="Standesamtfinder Hamburg öffnen und Hamburger Standesämter, Aussenlocations, Kontaktdaten und Buchungswege entdecken"
      data-track-event="cta_click"
      data-cta-id="home_standesamtfinder_feature"
      data-cta-type="planning_tool"
      data-section-id="home_standesamtfinder"
      data-content-topic="standesamtfinder_hamburg"
      data-user-intent="standesamt_und_trauort_finden"
      data-journey-stage="planung"
      data-position="standesamtfinder_feature"
    >
      <div class="home-standesamt-feature__copy">
        <p class="home-standesamt-feature__eyebrow">
          Standesamt Hamburg - Aussenlocations
        </p>
        <h2 id="home-standesamt-feature-title">
          Hamburger Standesämter &amp; besondere Trauorte
        </h2>
        <div class="home-standesamt-feature__text">
          <p>
            Wusstet Ihr dass Ihr auch auf einem Alsterschiff, im Berner Schloss,
            im Hamburger Rathaus und in weiteren Hamburger Villen und Schlössern
            standesamtlich heiraten könnt?
          </p>
        </div>
        <span class="home-standesamt-feature__cta">
          Standesämter &amp; Trauorte entdecken
          <span aria-hidden="true">↗</span>
        </span>
      </div>

      <figure class="home-standesamt-feature__media">
        <Image
          src={standesamtFinderImage}
          alt="Braut im fließenden Hochzeitskleid auf einem Hotelbett im Hotel Atlantic Hamburg"
          widths={[360, 480, 640, 768, 960, 1280]}
          sizes="(max-width: 620px) min(calc(86vw - 55px), 360px), (max-width: 959px) min(calc(82vw - 36px), 560px), (max-width: 1180px) 52vw, 620px"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={86}
        />
        <figcaption>Brautportrait · Hotel Atlantic Hamburg</figcaption>
      </figure>
    </a>
  </article>
</section>

<style>
  .home-standesamt-feature {
    padding-top: clamp(42px, 5vw, 74px);
    border-top: 0;
    color: var(--ink, #202633);
  }

  .home-standesamt-feature__card {
    width: min(1120px, 100%);
    margin: 0 auto;
    background: transparent;
  }

  .home-standesamt-feature__link {
    display: grid;
    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .home-standesamt-feature__media {
    position: relative;
    z-index: 2;
    grid-row: 1;
    grid-column: 1;
    width: calc(100% + clamp(52px, 5vw, 76px) - 38px);
    height: calc(clamp(640px, 50vw, 720px) - 38px);
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #d8dfe1;
  }

  .home-standesamt-feature__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 44%;
    transition: transform 320ms ease;
  }

  .home-standesamt-feature__media figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    margin: 0;
    padding: 18px 20px 14px;
    background: linear-gradient(180deg, transparent, rgb(20 25 32 / .72));
    color: #fff;
    font-family: var(--font-sans, "Raleway", sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .home-standesamt-feature__copy {
    display: flex;
    position: relative;
    z-index: 1;
    grid-row: 1;
    grid-column: 2;
    min-width: 0;
    min-height: clamp(500px, 43vw, 620px);
    padding:
      clamp(48px, 4vw, 58px)
      clamp(38px, 3.6vw, 56px)
      clamp(48px, 4vw, 58px)
      clamp(100px, 8vw, 124px);
    flex-direction: column;
    justify-content: center;
    background: #f3f1ec;
    box-shadow: 0 28px 70px rgb(27 33 43 / .08);
  }

  .home-standesamt-feature__eyebrow {
    margin: 0 0 18px;
    color: #80563d;
    font-family: var(--font-sans, "Raleway", sans-serif);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .2em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .home-standesamt-feature h2 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display, "Gilda Display", "Playfair Display", serif);
    font-size: clamp(36px, 3.4vw, 48px);
    font-weight: 400;
    letter-spacing: -.025em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .home-standesamt-feature__text {
    display: grid;
    max-width: 38ch;
    gap: 12px;
    margin-top: 22px;
  }

  .home-standesamt-feature__text p {
    margin: 0;
    color: var(--muted, #6d665f);
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(15px, 1.15vw, 16.5px);
    line-height: 1.62;
  }

  .home-standesamt-feature__cta {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    gap: 18px;
    margin-top: 32px;
    border-bottom: 1px solid #80563d;
    font-family: var(--font-sans, "Raleway", sans-serif);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .home-standesamt-feature__cta span {
    font-size: 18px;
    transition: transform 220ms ease;
  }

  .home-standesamt-feature__link:hover .home-standesamt-feature__media :global(img) {
    transform: scale(1.012);
  }

  .home-standesamt-feature__link:hover .home-standesamt-feature__cta span {
    transform: translate(2px, -2px);
  }

  .home-standesamt-feature__link:focus-visible {
    outline: 3px solid #80563d;
    outline-offset: 5px;
  }

  @media (max-width: 959px) {
    .home-standesamt-feature__card {
      width: 100%;
    }

    .home-standesamt-feature__link {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
    }

    .home-standesamt-feature__media {
      width: min(82%, 560px);
      height: auto;
      margin: -34px 0 0 auto;
      aspect-ratio: 4 / 5;
      box-shadow: 0 24px 58px rgb(27 33 43 / .12);
    }

    .home-standesamt-feature__media figcaption {
      right: auto;
      bottom: 18px;
      left: 18px;
      width: auto;
      padding: 8px 10px;
      background: rgb(27 33 43 / .76);
    }

    .home-standesamt-feature__copy {
      z-index: 1;
      width: min(92%, 680px);
      min-height: 0;
      margin: 0;
      padding: 58px 44px 72px;
    }

    .home-standesamt-feature h2 {
      max-width: 15ch;
      font-size: clamp(36px, 6.4vw, 48px);
    }

    .home-standesamt-feature__text {
      max-width: 48ch;
      margin-top: 22px;
    }

    .home-standesamt-feature__cta {
      margin-top: 28px;
    }
  }

  @media (max-width: 620px) {
    .home-standesamt-feature__media {
      width: min(86%, 360px);
      margin: -28px auto 0;
    }

    .home-standesamt-feature__media figcaption {
      bottom: 14px;
      left: 14px;
    }

    .home-standesamt-feature__copy {
      width: calc(100% - 12px);
      padding: 48px 24px 64px;
    }

    .home-standesamt-feature h2 {
      font-size: clamp(31px, 9.3vw, 40px);
    }

    .home-standesamt-feature__text {
      gap: 12px;
    }

    .home-standesamt-feature__text p {
      font-size: 15px;
      line-height: 1.62;
    }

    .home-standesamt-feature__cta {
      gap: 12px;
      font-size: 10px;
      letter-spacing: .11em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-standesamt-feature__media :global(img),
    .home-standesamt-feature__cta span {
      transition: none;
    }

    .home-standesamt-feature__link:hover .home-standesamt-feature__media :global(img),
    .home-standesamt-feature__link:hover .home-standesamt-feature__cta span {
      transform: none;
    }
  }
</style>
