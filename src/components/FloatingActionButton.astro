---
const whatsappText = encodeURIComponent("Hallo York!\nBist Du noch buchbar am:");
const whatsappHref = `https://wa.me/4915161438120?text=${whatsappText}`;
---

<div
  class="floating-action"
  data-floating-action
  data-show-delay="400"
  data-availability-endpoint="/api/availability"
  data-availability-max-months="24"
  data-availability-request-timeout="8000"
  data-availability-min-loading="600"
  data-track-section="floating_action_button"
  data-content-topic="kontaktmoeglichkeiten"
  data-user-intent="kontakt_aufnehmen"
  data-journey-stage="anfrage"
  data-content-format="floating_action"
  data-position="floating_bottom_right"
>
  <button
    class="floating-action__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="floating-action-menu"
    aria-label="Schnellkontakt öffnen"
    data-floating-action-toggle
    data-track-event="cta_click"
    data-cta-id="fab_toggle"
    data-cta-type="floating_action_toggle"
    data-section-id="floating_action_button"
    data-content-topic="kontaktmoeglichkeiten"
    data-user-intent="schnellkontakt_oeffnen"
    data-journey-stage="anfrage"
    data-position="floating_bottom_right"
  >
    <img
      class="floating-action__badge"
      src="/images/fab/kontakt-icon-128.png"
      srcset="/images/fab/kontakt-icon-64.png 64w, /images/fab/kontakt-icon-128.png 128w"
      sizes="128px"
      alt="Kontakt Icon"
      width="128"
      height="128"
      decoding="async"
      loading="eager"
    >
  </button>

  <div
    class="floating-action__menu"
    id="floating-action-menu"
    aria-hidden="true"
    data-floating-action-panel
  >
    <nav
      class="floating-action__view"
      aria-label="Schnellkontakt"
      data-floating-action-contact-view
      data-track-section="fab_contact_options"
      data-content-topic="kontaktmoeglichkeiten"
      data-user-intent="kontaktweg_waehlen"
      data-journey-stage="anfrage"
      data-content-format="contact_options"
      data-position="fab_menu"
    >
      <a
        class="floating-action__item is-availability"
        href="/kontakt/"
        data-floating-action-availability-open
        data-track-event="cta_click"
        data-cta-id="fab_termin_pruefen"
        data-cta-type="availability_check"
        data-section-id="fab_contact_options"
        data-content-topic="terminverfuegbarkeit"
        data-user-intent="termin_pruefen"
        data-journey-stage="anfrage"
        data-position="fab_option_1"
      >
        <span class="floating-action__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path fill="currentColor" d="M7 2h2v2h6V2h2v2h2a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h2V2Zm12 8H5v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9ZM6 6a1 1 0 0 0-1 1v1h14V7a1 1 0 0 0-1-1H6Z"></path>
          </svg>
        </span>
        <span>Termin noch frei?</span>
      </a>

      <a
        class="floating-action__item is-wa"
        href={whatsappHref}
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp Chat öffnen"
        data-floating-action-link
        data-track-event="contact_click"
        data-cta-id="fab_whatsapp"
        data-cta-type="messenger"
        data-section-id="fab_contact_options"
        data-content-topic="kontaktmoeglichkeiten"
        data-user-intent="whatsapp_starten"
        data-journey-stage="anfrage"
        data-position="fab_option_2"
      >
        <span class="floating-action__icon" aria-hidden="true">
          <img
            class="floating-action__wa-logo"
            src="/images/fab/whatsapp-chat.png"
            srcset="/images/fab/whatsapp-chat.png 64w, /images/fab/whatsapp-chat-2x.png 128w"
            sizes="30px"
            alt="WhatsApp"
            width="30"
            height="30"
            loading="lazy"
            decoding="async"
          >
        </span>
        <span>WhatsApp</span>
      </a>

      <a
        class="floating-action__item is-form"
        href="/kontakt/"
        data-floating-action-link
        data-track-event="contact_click"
        data-cta-id="fab_contact_form"
        data-cta-type="contact_form"
        data-section-id="fab_contact_options"
        data-content-topic="anfrageformular"
        data-user-intent="formular_oeffnen"
        data-journey-stage="anfrage"
        data-position="fab_option_3"
      >
        <span class="floating-action__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-6l-4 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 4h12v2H6V8Zm0 4h12v2H6v-2Z"></path>
          </svg>
        </span>
        <span>Kontaktformular</span>
      </a>

      <a
        class="floating-action__item is-mail"
        href="mailto:info@artbild-fotografie.de?subject=Anfrage%20%C3%BCber%20Website"
        aria-label="E-Mail an Artbild-Fotografie schreiben"
        data-floating-action-link
        data-track-event="contact_click"
        data-cta-id="fab_email"
        data-cta-type="email"
        data-section-id="fab_contact_options"
        data-content-topic="kontaktmoeglichkeiten"
        data-user-intent="email_schreiben"
        data-journey-stage="anfrage"
        data-position="fab_option_4"
      >
        <span class="floating-action__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 3.5-8 5-8-5V6l8 5 8-5v1.5Z"></path>
          </svg>
        </span>
        <span>E-Mail</span>
      </a>
    </nav>

    <section
      class="floating-action__view floating-action__availability"
      role="dialog"
      aria-labelledby="floating-action-availability-title"
      aria-hidden="true"
      hidden
      data-floating-action-availability-view
      data-track-section="fab_availability_check"
      data-content-topic="terminverfuegbarkeit"
      data-user-intent="termin_pruefen"
      data-journey-stage="anfrage"
      data-content-format="availability_form"
      data-position="fab_dialog"
    >
      <header class="floating-action__dialog-header">
        <button
          class="floating-action__icon-button"
          type="button"
          aria-label="Zurück zum Kontaktmenü"
          data-floating-action-back
          data-track-event="cta_click"
          data-cta-id="fab_availability_back"
          data-cta-type="dialog_navigation"
          data-section-id="fab_availability_check"
          data-content-topic="terminverfuegbarkeit"
          data-user-intent="zurueck_zum_kontaktmenue"
          data-journey-stage="anfrage"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="m15.4 5.4-1.4-1.4-8 8 8 8 1.4-1.4L8.8 12l6.6-6.6Z"></path>
          </svg>
        </button>
        <h2 id="floating-action-availability-title">Terminprüfung</h2>
        <button
          class="floating-action__icon-button"
          type="button"
          aria-label="Schnellkontakt schließen"
          data-floating-action-close
          data-track-event="cta_click"
          data-cta-id="fab_availability_close"
          data-cta-type="dialog_close"
          data-section-id="fab_availability_check"
          data-content-topic="terminverfuegbarkeit"
          data-user-intent="schnellkontakt_schliessen"
          data-journey-stage="anfrage"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4 6.4 5Z"></path>
          </svg>
        </button>
      </header>

      <div class="floating-action__dialog-body">
        <p class="floating-action__intro">Für welchen Tag möchtet ihr die Verfügbarkeit prüfen?</p>

        <form
          data-floating-action-availability-form
          data-track-form
          data-form-id="fab_availability_check"
          data-form-type="availability_check"
          data-track-section="fab_availability_check_form"
          data-content-topic="terminverfuegbarkeit"
          data-user-intent="termin_pruefen"
          data-journey-stage="anfrage"
          data-content-format="availability_form"
          data-position="fab_dialog"
          novalidate
        >
          <label for="floating-action-availability-date">Hochzeitsdatum</label>
          <input
            id="floating-action-availability-date"
            name="date"
            type="date"
            required
            aria-describedby="floating-action-availability-error"
            data-floating-action-date
          >
          <div class="floating-action__honeypot" aria-hidden="true">
            <label for="floating-action-availability-website">Website</label>
            <input
              id="floating-action-availability-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              data-floating-action-website
            >
          </div>
          <p
            class="floating-action__error"
            id="floating-action-availability-error"
            role="alert"
            hidden
            data-floating-action-error
          ></p>
          <button
            class="floating-action__primary"
            type="submit"
            data-floating-action-submit
            data-track-event="cta_click"
            data-cta-id="fab_availability_submit"
            data-cta-type="availability_submit"
            data-section-id="fab_availability_check_form"
            data-content-topic="terminverfuegbarkeit"
            data-user-intent="termin_pruefen"
            data-journey-stage="anfrage"
          >
            Termin prüfen
          </button>
        </form>

        <div class="floating-action__conversation" hidden data-floating-action-conversation>
          <p class="floating-action__bubble floating-action__bubble--user" data-floating-action-date-bubble></p>
          <div class="floating-action__status" data-floating-action-status>
            <span class="floating-action__dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>Kalender wird geprüft</span>
          </div>
          <div class="floating-action__result" tabindex="-1" hidden data-floating-action-result>
            <h3>Ergebnis der Terminprüfung</h3>
            <p class="floating-action__bubble floating-action__bubble--result" aria-hidden="true" data-floating-action-result-text></p>
            <p class="visually-hidden" aria-live="polite" data-floating-action-live></p>
            <a
              class="floating-action__primary"
              href="/kontakt/"
              hidden
              data-floating-action-action
              data-track-event="contact_click"
              data-cta-id="fab_availability_result_contact"
              data-cta-type="contact_form"
              data-section-id="fab_availability_check"
              data-content-topic="terminverfuegbarkeit"
              data-user-intent="termin_anfragen"
              data-journey-stage="anfrage"
            ></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  const floatingActionRoots = document.querySelectorAll("[data-floating-action]");

  floatingActionRoots.forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.floatingActionReady === "true") return;
    root.dataset.floatingActionReady = "true";

    const elements = {
      toggle: root.querySelector("[data-floating-action-toggle]"),
      panel: root.querySelector("[data-floating-action-panel]"),
      contactView: root.querySelector("[data-floating-action-contact-view]"),
      availabilityOpen: root.querySelector("[data-floating-action-availability-open]"),
      availabilityView: root.querySelector("[data-floating-action-availability-view]"),
      back: root.querySelector("[data-floating-action-back]"),
      close: root.querySelector("[data-floating-action-close]"),
      form: root.querySelector("[data-floating-action-availability-form]"),
      date: root.querySelector("[data-floating-action-date]"),
      website: root.querySelector("[data-floating-action-website]"),
      error: root.querySelector("[data-floating-action-error]"),
      submit: root.querySelector("[data-floating-action-submit]"),
      conversation: root.querySelector("[data-floating-action-conversation]"),
      dateBubble: root.querySelector("[data-floating-action-date-bubble]"),
      status: root.querySelector("[data-floating-action-status]"),
      result: root.querySelector("[data-floating-action-result]"),
      resultText: root.querySelector("[data-floating-action-result-text]"),
      live: root.querySelector("[data-floating-action-live]"),
      action: root.querySelector("[data-floating-action-action]"),
    };

    if (
      !(elements.toggle instanceof HTMLButtonElement)
      || !(elements.panel instanceof HTMLElement)
      || !(elements.contactView instanceof HTMLElement)
    ) {
      return;
    }

    const states = {
      MENU: "menu",
      DATE_SELECTION: "date_selection",
      SUBMITTING: "submitting",
      AVAILABLE: "available",
      UNAVAILABLE: "unavailable",
      TECHNICAL_ERROR: "technical_error",
      RATE_LIMITED: "rate_limited",
      TEMPORARILY_DISABLED: "temporarily_disabled",
    };

    const showDelay = numberFromData("showDelay", 400);
    const maxMonths = numberFromData("availabilityMaxMonths", 24);
    const requestTimeout = numberFromData("availabilityRequestTimeout", 8000);
    const minimumLoading = numberFromData("availabilityMinLoading", 600);
    const endpoint = root.dataset.availabilityEndpoint || "/api/availability";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let currentState = states.MENU;
    let opened = false;
    let operationId = 0;
    let activeRequest = null;
    let scrollTimer = null;

    function numberFromData(key, fallback) {
      const value = Number.parseInt(root.dataset[key] || "", 10);
      return Number.isFinite(value) ? value : fallback;
    }

    function localDateFromValue(value) {
      const parts = value.split("-").map(Number);
      if (parts.length !== 3 || parts.some((part) => !Number.isFinite(part))) return null;
      const date = new Date(parts[0], parts[1] - 1, parts[2]);
      return date.getFullYear() === parts[0] && date.getMonth() === parts[1] - 1 && date.getDate() === parts[2]
        ? date
        : null;
    }

    function valueFromLocalDate(date) {
      const year = String(date.getFullYear());
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function todayLocal() {
      const now = new Date();
      return new Date(now.getFullYear(), now.getMonth(), now.getDate());
    }

    function maximumLocalDate() {
      const today = todayLocal();
      const originalDay = today.getDate();
      const maximum = new Date(today.getFullYear(), today.getMonth() + maxMonths, 1);
      const lastDay = new Date(maximum.getFullYear(), maximum.getMonth() + 1, 0).getDate();
      maximum.setDate(Math.min(originalDay, lastDay));
      return maximum;
    }

    function formatDate(date) {
      return new Intl.DateTimeFormat("de-DE", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      }).format(date);
    }

    function delay(milliseconds) {
      return new Promise((resolve) => window.setTimeout(resolve, Math.max(0, milliseconds)));
    }

    function setDateBounds() {
      if (!(elements.date instanceof HTMLInputElement)) return;
      elements.date.min = valueFromLocalDate(todayLocal());
      elements.date.max = valueFromLocalDate(maximumLocalDate());
    }

    function setState(nextState) {
      currentState = nextState;
      root.dataset.state = nextState;
      const isMenu = nextState === states.MENU;
      const isSubmitting = nextState === states.SUBMITTING;

      elements.contactView.hidden = !isMenu;
      elements.contactView.setAttribute("aria-hidden", isMenu ? "false" : "true");

      if (elements.availabilityView instanceof HTMLElement) {
        elements.availabilityView.hidden = isMenu;
        elements.availabilityView.setAttribute("aria-hidden", isMenu ? "true" : "false");
      }

      if (elements.date instanceof HTMLInputElement) elements.date.disabled = isSubmitting;
      if (elements.submit instanceof HTMLButtonElement) elements.submit.disabled = isSubmitting;
    }

    function abortActiveRequest() {
      if (!activeRequest) return;
      window.clearTimeout(activeRequest.timeoutId);
      activeRequest.controller.abort();
      activeRequest = null;
    }

    function resetAvailability() {
      abortActiveRequest();
      operationId += 1;

      if (
        !(elements.form instanceof HTMLFormElement)
        || !(elements.error instanceof HTMLElement)
        || !(elements.date instanceof HTMLInputElement)
        || !(elements.conversation instanceof HTMLElement)
        || !(elements.dateBubble instanceof HTMLElement)
        || !(elements.status instanceof HTMLElement)
        || !(elements.result instanceof HTMLElement)
        || !(elements.resultText instanceof HTMLElement)
        || !(elements.live instanceof HTMLElement)
        || !(elements.action instanceof HTMLAnchorElement)
        || !(elements.submit instanceof HTMLButtonElement)
      ) {
        return;
      }

      elements.form.reset();
      elements.form.hidden = false;
      elements.error.hidden = true;
      elements.error.textContent = "";
      elements.date.removeAttribute("aria-invalid");
      elements.conversation.hidden = true;
      elements.dateBubble.textContent = "";
      elements.status.hidden = false;
      elements.result.hidden = true;
      elements.resultText.textContent = "";
      elements.live.textContent = "";
      elements.action.hidden = true;
      elements.action.textContent = "";
      elements.action.href = "/kontakt/";
      elements.date.disabled = false;
      elements.submit.disabled = false;
      setDateBounds();
    }

    function openMenu() {
      resetAvailability();
      setState(states.MENU);
      root.classList.add("is-open");
      elements.toggle.setAttribute("aria-expanded", "true");
      elements.toggle.setAttribute("aria-label", "Schnellkontakt schließen");
      elements.panel.setAttribute("aria-hidden", "false");
      document.body.classList.add("has-floating-action-open");
      opened = true;
    }

    function closeMenu(returnFocus = false) {
      resetAvailability();
      setState(states.MENU);
      root.classList.remove("is-open");
      elements.toggle.setAttribute("aria-expanded", "false");
      elements.toggle.setAttribute("aria-label", "Schnellkontakt öffnen");
      elements.panel.setAttribute("aria-hidden", "true");
      document.body.classList.remove("has-floating-action-open");
      opened = false;
      if (returnFocus) elements.toggle.focus();
    }

    function openAvailability() {
      resetAvailability();
      setState(states.DATE_SELECTION);
      if (elements.date instanceof HTMLInputElement) elements.date.focus();
    }

    function returnToMenu() {
      resetAvailability();
      setState(states.MENU);
      if (elements.availabilityOpen instanceof HTMLElement) elements.availabilityOpen.focus();
    }

    function validateDate() {
      if (!(elements.date instanceof HTMLInputElement) || !(elements.error instanceof HTMLElement)) return null;

      const date = localDateFromValue(elements.date.value);
      let message = "";
      if (!date) message = "Bitte wählt ein gültiges Datum aus.";
      else if (date < todayLocal()) message = "Bitte wählt ein heutiges oder zukünftiges Datum aus.";
      else if (date > maximumLocalDate()) message = `Bitte wählt ein Datum innerhalb der nächsten ${maxMonths} Monate aus.`;

      elements.error.textContent = message;
      elements.error.hidden = message === "";
      elements.date.setAttribute("aria-invalid", message === "" ? "false" : "true");
      return message === "" ? date : null;
    }

    function resultFor(state, formattedDate) {
      const results = {
        [states.AVAILABLE]: {
          text: `Nach aktuellem Kalenderstand ist der ${formattedDate} noch verfügbar. Verbindlich wird der Termin erst nach meiner persönlichen Bestätigung und erfolgreicher Buchung.`,
          action: "Jetzt unverbindlich anfragen",
        },
        [states.UNAVAILABLE]: {
          text: `Am ${formattedDate} bin ich leider nicht mehr verfügbar.`,
          action: "Persönlich nachfragen",
        },
        [states.TECHNICAL_ERROR]: {
          text: "Die automatische Terminprüfung ist gerade nicht zuverlässig möglich. Bitte sendet mir euren Wunschtermin über das Kontaktformular - ich prüfe ihn persönlich.",
          action: "Termin persönlich anfragen",
        },
        [states.RATE_LIMITED]: {
          text: "Ich kann gerade keine weiteren Termine automatisch prüfen. Sendet mir euren Wunschtermin bitte über das Kontaktformular - ich prüfe ihn persönlich.",
          action: "Zum Kontaktformular",
        },
        [states.TEMPORARILY_DISABLED]: {
          text: "Die automatische Terminprüfung ist gerade nicht verfügbar. Bitte sendet mir euren Wunschtermin über das Kontaktformular - ich prüfe ihn persönlich.",
          action: "Termin persönlich anfragen",
        },
      };
      return results[state] || results[states.TECHNICAL_ERROR];
    }

    function typeResult(text, expectedOperation) {
      if (!(elements.resultText instanceof HTMLElement)) return Promise.resolve();
      elements.resultText.textContent = "";
      if (reducedMotion.matches) {
        elements.resultText.textContent = text;
        return Promise.resolve();
      }

      return new Promise((resolve) => {
        let index = 0;
        const nextCharacter = () => {
          if (expectedOperation !== operationId) {
            resolve();
            return;
          }
          index += 1;
          elements.resultText.textContent = text.slice(0, index);
          if (index < text.length) window.setTimeout(nextCharacter, 12);
          else resolve();
        };
        nextCharacter();
      });
    }

    function showResult(state, formattedDate, expectedOperation, serverResult = {}) {
      if (
        !(elements.status instanceof HTMLElement)
        || !(elements.result instanceof HTMLElement)
        || !(elements.live instanceof HTMLElement)
        || !(elements.action instanceof HTMLAnchorElement)
        || !(elements.date instanceof HTMLInputElement)
      ) {
        return;
      }

      const result = resultFor(state, formattedDate);
      if (typeof serverResult.message === "string") result.text = serverResult.message;
      if (typeof serverResult.action_label === "string") result.action = serverResult.action_label;

      setState(state);
      elements.status.hidden = true;
      elements.result.hidden = false;
      elements.result.focus();

      typeResult(result.text, expectedOperation).then(() => {
        if (expectedOperation !== operationId || currentState !== state) return;
        const contactUrl = new URL("/kontakt/", window.location.origin);
        contactUrl.searchParams.set("termin", elements.date.value);
        elements.live.textContent = result.text;
        elements.action.textContent = result.action;
        elements.action.href = typeof serverResult.action_href === "string" ? serverResult.action_href : contactUrl.pathname + contactUrl.search;
        elements.action.hidden = false;
      });
    }

    async function requestAvailability(dateValue, signal) {
      const requestUrl = new URL(endpoint, window.location.origin);
      requestUrl.searchParams.set("date", dateValue);

      const response = await window.fetch(requestUrl, {
        method: "GET",
        credentials: "omit",
        signal,
      });
      const text = await response.text();
      if (!text) throw new Error("empty_response");
      const data = JSON.parse(text);
      if (!data || (typeof data.available !== "boolean" && typeof data.status !== "string")) {
        throw new Error("unexpected_response");
      }
      return data;
    }

    async function submitAvailability(event) {
      event.preventDefault();
      if (currentState === states.SUBMITTING) return;
      if (elements.website instanceof HTMLInputElement && elements.website.value) return;

      const date = validateDate();
      if (!date) {
        if (elements.date instanceof HTMLInputElement) elements.date.focus();
        return;
      }

      if (
        !(elements.form instanceof HTMLFormElement)
        || !(elements.conversation instanceof HTMLElement)
        || !(elements.dateBubble instanceof HTMLElement)
        || !(elements.status instanceof HTMLElement)
        || !(elements.result instanceof HTMLElement)
        || !(elements.date instanceof HTMLInputElement)
      ) {
        return;
      }

      abortActiveRequest();
      const expectedOperation = operationId + 1;
      operationId = expectedOperation;
      const formattedDate = formatDate(date);
      const requestContext = {
        controller: new window.AbortController(),
        timedOut: false,
        timeoutId: null,
      };
      activeRequest = requestContext;
      requestContext.timeoutId = window.setTimeout(() => {
        requestContext.timedOut = true;
        requestContext.controller.abort();
      }, Math.max(1000, requestTimeout));

      setState(states.SUBMITTING);
      elements.form.hidden = true;
      elements.conversation.hidden = false;
      elements.dateBubble.textContent = formattedDate;
      elements.status.hidden = false;
      elements.result.hidden = true;

      try {
        const [response] = await Promise.all([
          requestAvailability(elements.date.value, requestContext.controller.signal),
          delay(minimumLoading),
        ]);

        if (expectedOperation !== operationId || currentState !== states.SUBMITTING) return;
        window.clearTimeout(requestContext.timeoutId);
        if (activeRequest === requestContext) activeRequest = null;

        if (response.error === "invalid_date" || response.status === "invalid_date") {
          window.dispatchEvent(new CustomEvent("artbild:availability_result", {
            detail: { result: "invalid_date" },
          }));
          if (elements.error instanceof HTMLElement) {
            setState(states.DATE_SELECTION);
            elements.form.hidden = false;
            elements.conversation.hidden = true;
            elements.error.textContent = response.message || "Bitte wählt ein gültiges Datum aus.";
            elements.error.hidden = false;
            elements.date.setAttribute("aria-invalid", "true");
            elements.date.focus();
          }
          return;
        }

        const state = typeof response.available === "boolean"
          ? (response.available ? states.AVAILABLE : states.UNAVAILABLE)
          : response.status;
        window.dispatchEvent(new CustomEvent("artbild:availability_result", {
          detail: {
            result: state === states.AVAILABLE
              ? "available"
              : state === states.UNAVAILABLE
                ? "unavailable"
                : "unknown",
          },
        }));
        showResult(state, formattedDate, expectedOperation, response);
      } catch (error) {
        window.clearTimeout(requestContext.timeoutId);
        if (activeRequest === requestContext) activeRequest = null;
        if (expectedOperation !== operationId || currentState !== states.SUBMITTING) return;
        if (error && error.name === "AbortError" && !requestContext.timedOut) return;
        window.dispatchEvent(new CustomEvent("artbild:availability_result", {
          detail: { result: "technical_error" },
        }));
        showResult(states.TECHNICAL_ERROR, formattedDate, expectedOperation);
      }
    }

    setState(states.MENU);
    setDateBounds();
    window.setTimeout(() => root.classList.add("is-visible"), Math.max(0, showDelay));
    root.addEventListener("touchstart", () => root.classList.add("is-visible"), { passive: true });

    elements.toggle.addEventListener("click", (event) => {
      event.preventDefault();
      opened ? closeMenu(false) : openMenu();
    });

    if (elements.availabilityOpen instanceof HTMLAnchorElement) {
      elements.availabilityOpen.addEventListener("click", (event) => {
        event.preventDefault();
        openAvailability();
      });
    }

    document.querySelectorAll("[data-floating-action-external-open]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openMenu();
        if (elements.availabilityOpen instanceof HTMLElement) elements.availabilityOpen.focus();
      });
    });

    document.querySelectorAll("[data-floating-action-external-availability]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openMenu();
        openAvailability();
      });
    });

    if (elements.back instanceof HTMLButtonElement) elements.back.addEventListener("click", returnToMenu);
    if (elements.close instanceof HTMLButtonElement) elements.close.addEventListener("click", () => closeMenu(true));
    if (elements.form instanceof HTMLFormElement) elements.form.addEventListener("submit", submitAvailability);

    root.querySelectorAll("[data-floating-action-link]").forEach((link) => {
      link.addEventListener("click", () => closeMenu(false));
    });

    window.addEventListener("scroll", () => {
      if (!opened) root.classList.remove("is-visible");
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        if (!opened) root.classList.add("is-visible");
      }, 250);
    }, { passive: true });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && opened) closeMenu(true);
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) return;
      if (opened && !root.contains(event.target)) closeMenu(false);
    }, true);
  });
</script>

