---
// Original data source: York Augustin's ND-Filter-Tabelle.xlsx and the matching table graphic.
// Both assets agree and correct two inconsistent cells in the legacy WordPress HTML table.
const columns = [
  "Belichtungszeit ohne Filter",
  "ND 0.3",
  "ND 0.6",
  "ND 0.9",
  "ND 1.2",
  "ND 1.8",
  "ND 2.1",
  "ND 3.0",
];

const rows = [
  ["Anzahl der Blenden", "1", "2", "3", "4", "6", "7", "10"],
  ["Verlängerungsfaktor", "x 2", "x 4", "x 8", "x 16", "x 64", "x 128", "x 1000"],
  ["1/2000 Sekunde", "1/1000 s", "1/500 s", "1/250 s", "1/125 s", "1/30 s", "1/15 s", "1/2 s"],
  ["1/1000 Sekunde", "1/500 s", "1/250 s", "1/125 s", "1/60 s", "1/15 s", "1/8 s", "1 s"],
  ["1/500 Sekunde", "1/250 s", "1/125 s", "1/60 s", "1/30 s", "1/8 s", "1/4 s", "2 s"],
  ["1/250 Sekunde", "1/125 s", "1/60 s", "1/30 s", "1/15 s", "1/4 s", "1/2 s", "4 s"],
  ["1/60 Sekunde", "1/30 s", "1/15 s", "1/8 s", "1/4 s", "1 s", "2 s", "16 s"],
  ["1/30 Sekunde", "1/15 s", "1/8 s", "1/4 s", "1/2 s", "2 s", "4 s", "30 s"],
  ["1/15 Sekunde", "1/8 s", "1/4 s", "1/2 s", "1 s", "4 s", "8 s", "1 m 10 s"],
  ["1/8 Sekunde", "1/4 s", "1/2 s", "1 s", "2 s", "8 s", "15 s", "2 m 15 s"],
  ["1/4 Sekunde", "1/2 s", "1 s", "2 s", "4 s", "15 s", "30 s", "4 m 30 s"],
  ["1/2 Sekunde", "1 s", "2 s", "4 s", "8 s", "30 s", "1 m", "9 m"],
  ["1 Sekunde", "2 s", "4 s", "8 s", "16 s", "1 m", "1 m 30 s", "18 m"],
  ["2 Sekunden", "4 s", "8 s", "15 s", "30 s", "2 m", "4 m", "> 20 m"],
  ["4 Sekunden", "8 s", "15 s", "30 s", "1 m", "4 m", "8 m", "> 20 m"],
  ["8 Sekunden", "15 s", "30 s", "1 m", "2 m", "8 m", "15 m", "> 20 m"],
];
---

<section class="nd-filter-table">
  <div class="nd-filter-table__copy">
    <h2 id="nd-filter-table-title">ND-Filter Tabelle</h2>
    <p>
      Diese Tabelle zeigt die zu wählenden Belichtungszeiten für Langzeitbelichtungen mit
      Filtern. Solche Filter werden Graufilter, ND-Filter oder auch Neutraldichtefilter genannt.
      Die so genannten Verlaufsfilter, Grauverlaufsfilter oder (GND = Graduated Neutral Density
      Filter) werden hier nicht berücksichtigt.
    </p>

    <h2>Kameraeinstellungen</h2>
    <p>
      Es ist wichtig, den manuellen Modus der Kamera zu wählen um das gewünschte Bildergebnis zu
      erzielen.
    </p>
    <p>
      Das Licht wird nun wesentlich verringert.<br>
      Deshalb ist auch sinnvoll das Bild zu fokussieren bevor man den ND-Filter in den Filterhalter
      schiebt und dann den AF (Autofokus) am Objektiv abzuschalten.
    </p>
    <p>
      Bei ausreichender Lichteinstrahlung kann ein erneutes Fokussieren dennoch möglich sein,
      obwohl sich ein starker ND-Filter vor dem Objektiv befindet.
    </p>
  </div>

  <div
    class="nd-filter-table__region"
    role="region"
    aria-labelledby="nd-filter-table-title"
    tabindex="0"
  >
    <table>
      <caption class="visually-hidden">ND-Filter Tabelle</caption>
      <thead>
        <tr>
          {columns.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map(([label, ...values]) => (
          <tr>
            <th scope="row">{label}</th>
            {values.map((value) => <td>{value}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .nd-filter-table {
    width: 100%;
    margin: 0 auto clamp(54px, 7vw, 96px);
  }

  .nd-filter-table__copy {
    width: min(820px, 100%);
    margin: 0 auto;
    color: #5f5953;
    font-size: clamp(20px, 1.8vw, 25px);
    line-height: 1.8;
  }

  .nd-filter-table__copy h2 {
    margin: 2.2em 0 .65em;
    color: var(--ink);
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .nd-filter-table__copy h2:first-child {
    margin-top: 0;
  }

  .nd-filter-table__copy p {
    margin: 0 0 1.25em;
  }

  .nd-filter-table__region {
    width: 100%;
    max-width: 100%;
    margin-top: clamp(32px, 5vw, 58px);
    overflow-x: auto;
    border: 1px solid #d8d0c7;
    background: #fff;
    overscroll-behavior-inline: contain;
    scrollbar-gutter: stable;
    -webkit-overflow-scrolling: touch;
  }

  .nd-filter-table__region:focus-visible {
    outline: 3px solid #202633;
    outline-offset: 5px;
  }

  table {
    width: 100%;
    min-width: 900px;
    border-spacing: 0;
    border-collapse: separate;
    color: #4f4943;
    font-family: "Raleway", Arial, sans-serif;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
    white-space: nowrap;
  }

  th,
  td {
    padding: 13px 15px;
    border-right: 1px solid #ded7cf;
    border-bottom: 1px solid #ded7cf;
    text-align: right;
  }

  tr > :last-child {
    border-right: 0;
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  thead th {
    position: relative;
    z-index: 2;
    background: #202633;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  thead th:first-child,
  tbody th {
    position: sticky;
    left: 0;
    text-align: left;
  }

  thead th:first-child {
    z-index: 4;
  }

  tbody th {
    z-index: 1;
    min-width: 190px;
    font-weight: 700;
  }

  tbody tr:nth-child(odd) > * {
    background: #f7f3ee;
  }

  tbody tr:nth-child(even) > * {
    background: #fff;
  }

  @media (max-width: 900px) {
    .nd-filter-table__copy {
      font-size: 21px;
      line-height: 1.75;
    }

    table {
      min-width: 820px;
      font-size: 14px;
    }

    th,
    td {
      padding: 12px;
    }

    tbody th {
      min-width: 175px;
    }
  }
</style>
