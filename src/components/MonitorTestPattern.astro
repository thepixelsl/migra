---
import { fineTones, scaleTones } from "../data/monitor-test-tones.mjs";

interface Props {
  prefix: string;
  heading?: "h2" | "h3";
}

const { prefix, heading: Heading = "h2" } = Astro.props;
const groups = [
  { key: "scale", title: "Von Schwarz bis Weiß", values: scaleTones, showValues: false },
  { key: "dark", title: "Nahe Schwarz", values: fineTones.dark, showValues: true },
  { key: "light", title: "Nahe Weiß", values: fineTones.light, showValues: true },
];
---
<div class="monitor-pattern">
  {groups.map(({ key, title, values, showValues }) => (
    <section class:list={["monitor-group", { "monitor-group--scale": !showValues }]} aria-labelledby={`${prefix}-${key}`}>
      <Heading id={`${prefix}-${key}`}>{title}</Heading>
      <div class="monitor-strip" role="img" aria-label={`Benachbarte Graufelder. sRGB-Werte: ${values.join(", ")}.`}>
        {values.map((value) => (
          <span data-tone={value} style={`background-color:rgb(${value},${value},${value})`}></span>
        ))}
      </div>
      {showValues && <div class="monitor-labels" aria-hidden="true">
        {values.map((value) => <span>{value}</span>)}
      </div>}
    </section>
  ))}
</div>

<style>
  .monitor-pattern{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(18px,3vw,28px);background:#b8b8b8;color:#171717;padding:clamp(16px,3vw,30px);font-family:"Raleway",Arial,sans-serif;color-scheme:light}
  .monitor-group--scale{grid-column:1/-1}
  h2,h3{font-family:"Gilda Display",Georgia,serif;font-size:clamp(20px,2.4vw,29px);font-weight:400;line-height:1.2;margin:0 0 10px}
  .monitor-strip,.monitor-labels{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr)}
  .monitor-strip{height:clamp(56px,7vw,96px)}
  .monitor-labels{margin-top:6px;font-size:12px;font-variant-numeric:tabular-nums;text-align:center}
  @media(max-width:650px){.monitor-pattern{grid-template-columns:minmax(0,1fr)}}
</style>
