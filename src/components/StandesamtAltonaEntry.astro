---
import { Image } from "astro:assets";
import pricingContent from "../data/pricing-page.json";
import { resolvePricingPackages } from "../lib/pricing-content.mjs";
import ceremony from "../assets/standesamt-altona/trauung_standesamt_altona_hamburg0213-1024x684.jpg";
import rings from "../assets/standesamt-altona/trauung_standesamt_altona_hamburg0259-1024x684.jpg";
import family from "../assets/standesamt-altona/trauung_standesamt_altona_hamburg0576-Bearbeitet-2-1024x684.jpg";
import couple from "../assets/standesamt-altona/trauung_standesamt_altona_hamburg0746-1024x684.jpg";

const offer = resolvePricingPackages(pricingContent).find(item => item.id === "standesamt-paket");
if (!offer) throw new Error("Der Altona-Einstieg benötigt das bestehende Standesamt-Paket.");

const photos = [
  { image: ceremony, alt: "Brautpaar sitzt während der Trauung im Standesamt Altona am Tisch vor den Fenstern", caption: "Bei der Trauung im Standesamt Altona." },
  { image: rings, alt: "Nahaufnahme der Hände beim Ringtausch während der standesamtlichen Trauung in Altona", caption: "Ein kleiner Moment, der bleibt: der Ringtausch." },
  { image: family, alt: "Brautpaar und Hochzeitsgäste stehen für ein Gruppenfoto am Altonaer Balkon zusammen", caption: "Gruppenfoto mit der Hochzeitsgesellschaft am Altonaer Balkon." },
  { image: couple, alt: "Brautpaar küsst sich mit rotem Brautstrauß im Gegenlicht am Altonaer Balkon", caption: "Zeit zu zweit beim Paarshooting am Altonaer Balkon." },
];
---

<section
  class="altona-entry"
  id="standesamt-altona-fotografie"
  aria-labelledby="finder-funnel-heading"
  data-track-section="standesamt_fotografie_funnel"
  data-content-topic="standesamtliche_hochzeitsfotografie"
  data-user-intent="fotografische_begleitung_pruefen"
  data-journey-stage="auswahl"
  data-content-format="editorial_photo_section"
  data-position="after_finder"
>
  <div class="altona-entry__intro">
    <header class="altona-entry__copy">
      <p class="altona-entry__kicker">Eine Hochzeit in Hamburg-Altona</p>
      <h2 id="finder-funnel-heading">Eure Trauung in Altona.<br />Persönlich begleitet.</h2>
      <p class="altona-entry__lead">Die Trauung, die Umarmungen danach und ein Moment nur für euch zwei. In der Reportage von Roberta und Daniel seht ihr, wie eine standesamtliche Begleitung in Altona aussehen kann.</p>
      <p class="altona-entry__context">Ihr habt das Rathaus Altona als Trauort gewählt? Fragt hier eure fotografische Begleitung an.</p>
    </header>

    <div class="altona-entry__offer" aria-labelledby="altona-offer-heading">
      <p class="altona-entry__kicker">Fotografische Begleitung</p>
      <h3 id="altona-offer-heading">{offer.name}</h3>
      <p class="altona-entry__duration">{offer.duration}</p>
      <p class="altona-entry__price">{offer.priceLabel}</p>
      {offer.showIntro !== false && <p class="altona-entry__offer-intro">{offer.intro}</p>}
      <a
        class="altona-entry__primary"
        href="/kontakt/?anlass=standesamt-altona#kontaktformular"
        data-track-event="cta_click"
        data-cta-id="standesamt_altona_begleitung_anfragen"
        data-cta-type="contact_form"
        data-section-id="standesamt_fotografie_funnel"
        data-content-topic="standesamtliche_hochzeitsfotografie"
        data-user-intent="fotografische_begleitung_anfragen"
        data-journey-stage="anfrage"
      >Fotografische Begleitung anfragen<span aria-hidden="true">→</span></a>
      <p class="altona-entry__request-note">Eure Anfrage geht an mich als Fotograf. Offizielle Trautermine bucht ihr über die jeweiligen Links im Finder.</p>
      <details class="altona-entry__features">
        <summary>Leistungen dieses Pakets</summary>
        <ul>{offer.features.map(feature => <li>{feature}</li>)}</ul>
      </details>
    </div>
  </div>

  <div class="altona-entry__photos" aria-label="Vier Einblicke in die Altona-Reportage">
    {photos.map((photo, index) => (
      <figure>
        <Image
          src={photo.image}
          alt={photo.alt}
          width={photo.image.width}
          widths={[400, 640, 960]}
          sizes="(max-width: 640px) calc(100vw - 44px), (max-width: 1280px) calc((100vw - 76px) / 2), 574px"
          format="webp"
          quality={88}
          loading="lazy"
          decoding="async"
        />
        <figcaption><span aria-hidden="true">0{index + 1}</span>{photo.caption}</figcaption>
      </figure>
    ))}
  </div>

  <div class="altona-entry__inquiry">
    <p>Erzählt mir kurz von eurer Trauung in Altona und eurem Wunschtermin.</p>
    <a
      class="altona-entry__primary"
      href="/kontakt/?anlass=standesamt-altona#kontaktformular"
      data-track-event="cta_click"
      data-cta-id="standesamt_altona_begleitung_anfragen_unten"
      data-cta-type="contact_form"
      data-section-id="standesamt_fotografie_funnel"
      data-content-topic="standesamtliche_hochzeitsfotografie"
      data-user-intent="fotografische_begleitung_anfragen"
      data-journey-stage="anfrage"
      data-position="after_altona_photos"
    >Fotografische Begleitung anfragen<span aria-hidden="true">→</span></a>
  </div>

  <nav class="altona-entry__links" aria-label="Mehr zur fotografischen Begleitung in Altona">
    <a
      href="/gallery/standesamtliche-trauung-standesamt-altona-hochzeitsfotograf-hamburg/"
      data-track-event="cta_click"
      data-cta-id="standesamt_fotografie_reportage"
      data-cta-type="gallery_link"
      data-section-id="standesamt_fotografie_funnel"
      data-content-topic="standesamtliche_hochzeitsfotografie"
      data-user-intent="beispielbilder_ansehen"
      data-journey-stage="auswahl"
    >Die vollständige Altona-Reportage ansehen<span aria-hidden="true">→</span></a>
    <a
      href="/hochzeitsfotograf-preise/#paket-standesamt-paket"
      data-track-event="cta_click"
      data-cta-id="standesamt_fotografie_preise"
      data-cta-type="pricing_link"
      data-section-id="standesamt_fotografie_funnel"
      data-content-topic="preise_pakete"
      data-user-intent="preise_pruefen"
      data-journey-stage="vergleich"
    >Paket und Preisdetails ansehen<span aria-hidden="true">→</span></a>
  </nav>
</section>

<style>
  .altona-entry { margin-top: clamp(72px, 9vw, 120px); padding-top: clamp(46px, 6vw, 76px); border-top: 1px solid #dedad4; color: #292d29; }
  .altona-entry__intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(40px, 7vw, 96px); align-items: start; }
  .altona-entry__kicker { margin: 0 0 20px; color: #82766a; font-family: "Raleway", Arial, sans-serif; font-size: 10px; font-weight: 600; line-height: 1.8; letter-spacing: .18em; text-transform: uppercase; }
  .altona-entry h2, .altona-entry h3 { font-family: "Gilda Display", "Playfair Display", Georgia, serif; font-weight: 400; }
  .altona-entry h2 { margin: 0; font-size: clamp(40px, 5vw, 64px); line-height: 1.1; letter-spacing: -.025em; }
  .altona-entry__lead { max-width: 45ch; margin: 28px 0 0; font-size: clamp(16px, 1.35vw, 18px); line-height: 1.85; }
  .altona-entry__context { max-width: 54ch; margin: 22px 0 0; color: #6f6a64; font-size: 13px; line-height: 1.8; }
  .altona-entry__offer { min-width: 0; padding: 4px 0 4px clamp(24px, 3vw, 40px); border-left: 1px solid #dedad4; }
  .altona-entry__offer h3 { margin: 0; font-size: 32px; line-height: 1.2; }
  .altona-entry__duration { margin: 14px 0 0; font-size: 14px; line-height: 1.7; }
  .altona-entry__price { margin: 4px 0 16px; font-family: "Gilda Display", "Playfair Display", Georgia, serif; font-size: clamp(29px, 3vw, 36px); line-height: 1.25; }
  .altona-entry__offer-intro { margin: 0 0 24px; color: #6f6a64; font-size: 14px; line-height: 1.8; }
  .altona-entry__primary { display: flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 22px; box-sizing: border-box; padding: 17px 22px; background: #343f35; color: #fff; font-family: "Raleway", Arial, sans-serif; font-size: 12px; font-weight: 600; line-height: 1.6; text-decoration: none; }
  .altona-entry__primary:hover { background: #495447; }
  .altona-entry__request-note { margin: 14px 0 20px; color: #6f6a64; font-size: 12px; line-height: 1.8; }
  .altona-entry__features { padding-top: 5px; border-top: 1px solid #dedad4; }
  .altona-entry__features summary { min-height: 44px; padding: 12px 0 8px; box-sizing: border-box; cursor: pointer; font-size: 13px; line-height: 1.7; }
  .altona-entry__features ul { margin: 12px 0 0; padding-left: 18px; color: #6f6a64; font-size: 13px; line-height: 1.9; }
  .altona-entry__features li + li { margin-top: 5px; }
  .altona-entry__photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 4vw, 48px) clamp(22px, 3vw, 36px); margin-top: clamp(44px, 6vw, 72px); }
  .altona-entry__photos figure { min-width: 0; margin: 0; }
  .altona-entry__photos img { display: block; width: 100%; height: auto; }
  .altona-entry__photos figcaption { display: flex; align-items: baseline; gap: 14px; margin-top: 14px; color: #6f6a64; font-size: 12px; line-height: 1.75; }
  .altona-entry__photos figcaption span { flex: 0 0 auto; color: #9b806a; font-size: 10px; letter-spacing: .1em; }
  .altona-entry__inquiry { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: clamp(30px, 4vw, 48px); }
  .altona-entry__inquiry p { max-width: 42ch; margin: 0; font-size: 16px; line-height: 1.7; }
  .altona-entry__inquiry .altona-entry__primary { min-width: min(100%, 340px); }
  .altona-entry__links { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 40px; margin-top: clamp(26px, 4vw, 44px); padding-block: 16px; border-block: 1px solid #dedad4; }
  .altona-entry__links a { display: flex; min-height: 44px; align-items: center; justify-content: space-between; gap: 20px; color: #292d29; font-family: "Raleway", Arial, sans-serif; font-size: 12px; font-weight: 500; line-height: 1.8; text-decoration: none; }
  .altona-entry__links a:hover { color: #8a654a; }
  .altona-entry a:focus-visible, .altona-entry summary:focus-visible { outline: 2px solid #343f35; outline-offset: 5px; }
  @media (max-width: 860px) {
    .altona-entry__intro { grid-template-columns: minmax(0, 1fr); gap: 34px; }
    .altona-entry__offer { padding: 28px 0 0; border-left: 0; border-top: 1px solid #dedad4; }
    .altona-entry__offer-intro { max-width: 55ch; }
    .altona-entry__primary { width: fit-content; max-width: 100%; }
  }
  @media (max-width: 640px) {
    .altona-entry__photos { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .altona-entry__primary { width: 100%; }
    .altona-entry__inquiry { flex-direction: column; align-items: stretch; }
    .altona-entry__links { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .altona-entry__links a { justify-content: space-between; }
  }
</style>
