[Unit]
Description=Artbild Preisseite - private Google API Datenerfassung
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/creative-hub-stack/migra-repo
EnvironmentFile=%h/.config/artbild-pricing-report/environment
ExecStart=%h/.local/share/creative-hub/runtime/node-v24.21.0-linux-x64/bin/node scripts/collect-pricing-report.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/artbild-pricing-reports
TimeoutStartSec=600
