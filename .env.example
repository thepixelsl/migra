# Consent-Banner und Anbietersteuerung:
# disabled   = kein Banner, keine Drittanbieter
# staging    = Banner und Anbieter nur bei vollständigen IDs und erlaubtem Host
# test       = automatisierte Tests mit ausschließlich künstlichen IDs
# production = echte IDs sind verpflichtend; Test-/Platzhalterwerte brechen den Build ab
PUBLIC_TRACKING_ENV=production

# Kommagetrennte Hostnamen ohne Protokoll oder Pfad.
# Production-Standard: artbild-fotografie.de,www.artbild-fotografie.de
PUBLIC_TRACKING_ALLOWED_HOSTS=artbild-fotografie.de,www.artbild-fotografie.de

# Öffentliche technische Kennungen. Sie sind im ausgelieferten HTML sichtbar und
# gehören in die Build-Umgebung, nicht in .dev.vars oder in den Quellcode.
PUBLIC_GTM_CONTAINER_ID=GTM-5TM37JC
PUBLIC_GA4_MEASUREMENT_ID=G-TSWGFD1YKF

# Geplanter GA4-Wert. Vor Production mit der Einstellung der GA4-Property
# abgleichen; diese Variable konfiguriert die Property nicht automatisch.
PUBLIC_GA4_DATA_RETENTION_MONTHS=14

# Änderung dieser Version fordert alle Besucher erneut zur Auswahl auf.
PUBLIC_CONSENT_VERSION=2026-09-02.1
