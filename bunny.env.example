# Public runtime settings
HOST=0.0.0.0
PORT=8080
DEV_NOINDEX=true
# Only these hosts may become indexable when DEV_NOINDEX=false.
BUNNY_INDEXABLE_HOSTS=artbild-fotografie.de,www.artbild-fotografie.de

# Bunny Database: add the full-access credentials as secrets
BUNNY_DATABASE_URL=libsql://your-database-id.lite.bunnydb.net
BUNNY_DATABASE_AUTH_TOKEN=replace-with-full-access-token

# Protected appointment administration
ADMIN_USERNAME=replace-with-dev-username
ADMIN_PASSWORD=replace-with-a-long-random-password
# Mandatory independent key: exactly 32 random bytes encoded as unpadded base64url (43 characters).
# Keep this stable: it encrypts the saved TOTP secret. Do not rotate without re-encryption.
ADMIN_SESSION_SECRET=replace-with-43-character-base64url-key
# Separate one-time enrollment authorization, same random format. Remove after enrollment.
ADMIN_MFA_SETUP_TOKEN=replace-with-different-43-character-base64url-token
# Exact browser origin, no path. Use the production value for production deployments.
ADMIN_PUBLIC_ORIGIN=https://artbild-fotografie.de
ADMIN_EMAIL=info@example.com

# Optional: verified labels for known agent clients (store as a secret)
AGENT_API_CLIENTS_JSON={"OpenAI Terminassistent":"replace-with-a-long-random-agent-token"}

# Contact form and mail delivery
CONTACT_TO=info@example.com
CONTACT_FROM=mail@example.com
CONTACT_HASH_SALT=replace-with-a-long-random-string

# Direct STRATO SMTP delivery (requires outbound port 465)
STRATO_SMTP_USER=mail@example.com
STRATO_SMTP_PASS=replace-with-mailbox-password
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
